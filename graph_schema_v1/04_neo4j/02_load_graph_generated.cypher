MERGE (n:Note {note_id: 'SYN-6977163-006'}) SET n.claim_id = '6977163', n.note_date = '2025-11-14', n.note_type = 'Contact - Provider', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'FYI\nFrom: Lena (front desk) <lena@upstatejointrehabcenter.example>\nSent: Fri, Nov 14, 2025 10:39\nTo: Olivia Grant\nSubject: RE: Claim 6977163 - Lopez\n\nHi Olivia,\nAttached is the note from Mia Lopez\'s visit on 11/13/25.\nWe are requesting 6 PT visits, please advise.\n\nRegards,\nLena (front desk)', n.word_count = 45, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
