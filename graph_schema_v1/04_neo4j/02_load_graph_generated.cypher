MERGE (n:Note {note_id: 'SYN-6977197-089'}) SET n.claim_id = '6977197', n.note_date = '2026-05-26', n.note_type = 'Attorney Correspondence', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'FYI\nFrom: Carla Brennan <carla@brennanlaw.example>\nSent: Tue, May 26, 2026 17:56\nTo: Olivia Grant\nSubject: RE: Claim 6977197 - Morris\n\nHi Olivia,\nWe request authorization for the treatment recommended by Dr Lindqvist.\nWe will be asking for a hearing if there is no response within 10 days.\n\nThank you,\nCarla Brennan', n.word_count = 51, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
