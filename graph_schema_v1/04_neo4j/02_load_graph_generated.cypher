MERGE (n:Chunk {chunk_id: 'SYN-6977098-057-C01'}) SET n.parent_id = 'SYN-6977098-057', n.parent_kind = 'Note', n.position = 1, n.text = 'clmt, rt lower leg contusion, DOI Dec 27. file is open. seeing Dr Fischer at North Shore Occupational Health; pain 2/10 per last note; calf tight, pain w/ walking. back to full duty; restr: no kneeling or squatting, limited stairs. conciliation held Feb 23, no agreement, Board keeps it open. nothing. we get the nothing, then close diary 16MAR26. DOI Dec 27, Jordan backed work van into bollard in lot at facility parking area. first seen at North Shore Occupational Health on Dec 31, dx contusion of the rt lower leg, xray neg for fracture. On modified duty from Dec 29. Back to full duty from Feb 19.', n.char_start = 0, n.char_end = 603, n.word_count = 108;
