MERGE (n:Note {note_id: 'SYN-6977175-092'}) SET n.claim_id = '6977175', n.note_date = '2026-07-27', n.note_type = 'File Review', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = 'clmt, neck, back and wrists strain, DOI Nov 11. file is open, no Board date yet. seeing Dr Romano at North Shore Occupational Health; pain 0/10 per last note; mild stiffness only. working regular duty, no issues; restr: released to full duty, no restrictions. no Board activity. nothing. call clmt, f/u w/ Dr Romano, review again Aug 17. DOI Nov 11, clmt was struck by a coworker during a pallet move at facility parking area. first seen at North Shore Occupational Health on Nov 14, dx strain of the neck, back and wrists, lumbar xray no acute findings. Victor Brandt is worker\'s attorney. No wage payments, medical bills only, approx $630 paid to date', n.word_count = 114, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977175-093'}) SET n.claim_id = '6977175', n.note_date = '2026-08-10', n.note_type = 'Attorney Correspondence', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = 'Victor Brandt called Aug 10 re: clmt. requesting copies of medical, wage statement and C-2F for claim 6977175. wants to know if State Insurance Fund will authorize more tx. said hearing may be needed if no response in 2 wks. demand for payment of ortho consult, $235.75. RFA-1 filed for neck, back and wrists tx. we will respond by letter. Maya to respond.\nDOI Nov 11, clmt was struck by coworker during a pallet move at facility parking area. First seen at North Shore Occupational Health on Nov 14, dx strain of the neck, back and wrists, lumbar xray no acute findings', n.word_count = 102, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
