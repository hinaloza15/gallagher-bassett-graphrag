MERGE (n:Chunk {chunk_id: 'SYN-6977098-088-C01'}) SET n.parent_id = 'SYN-6977098-088', n.parent_kind = 'Note', n.position = 1, n.text = 'see below.\nFrom: Rita Haddad <rita@harborviewcommunityhealth.example>\nSent: Thu, Jul 9, 2026 13:24\nTo: Maya Patel\nSubject: RE: Claim 6977098 - Lee\n\nHi Maya,\nOur payroll shows Jordan earned about $645 a week before the injury.\nClmt was out on vacation last week, no call to us.\n\nThanks,\nRita Haddad', n.char_start = 0, n.char_end = 297, n.word_count = 49;
MERGE (n:Chunk {chunk_id: 'SYN-6977098-089-C01'}) SET n.parent_id = 'SYN-6977098-089', n.parent_kind = 'Note', n.position = 1, n.text = 'see below\nFrom: Greg (front desk) <greg@northshoreoccupationalhealth.example>\nSent: Thu, Jul 9, 2026 17:36\nTo: Maya Patel\nSubject: RE: Claim 6977098 - Lee\n\nHi Maya,\nAttached is the note from Jordan Lee\'s visit on 10MAR26.\nPlease confirm authorization for the ortho consult.\n\nThank you,\nGreg (front desk)', n.char_start = 0, n.char_end = 303, n.word_count = 46;
