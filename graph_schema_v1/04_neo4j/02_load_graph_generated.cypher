MERGE (n:Chunk {chunk_id: 'SYN-6977140-050-C01'}) SET n.parent_id = 'SYN-6977140-050', n.parent_kind = 'Note', n.position = 1, n.text = 'January 26 therapy session #9 - Hector Osei, PT. Tolerated tx well. Pain 4/10 pre-tx, 4/10 after. Did penddulums, scapular stabilization, theraband rows + ice. ROM: ROM imporving, still guarded overhead. Goal: Reach overhead without pain. Reviewed HEP, pt demonstrates correctly.', n.char_start = 0, n.char_end = 279, n.word_count = 41;
MERGE (n:Chunk {chunk_id: 'SYN-6977140-051-C01'}) SET n.parent_id = 'SYN-6977140-051', n.parent_kind = 'Note', n.position = 1, n.text = 'bill review Jan 29: office visit from Rochester Work Injury Clinic $388 paid per fee schedule', n.char_start = 0, n.char_end = 93, n.word_count = 16;
MERGE (n:Chunk {chunk_id: 'SYN-6977140-052-C01'}) SET n.parent_id = 'SYN-6977140-052', n.parent_kind = 'Note', n.position = 1, n.text = 'January 29 - RTW: Maya is working regular duty, no issues. company should have new restrictions in writing.', n.char_start = 0, n.char_end = 107, n.word_count = 18;
MERGE (n:Chunk {chunk_id: 'SYN-6977140-053-C01'}) SET n.parent_id = 'SYN-6977140-053', n.parent_kind = 'Note', n.position = 1, n.text = 'Called Maya, reached on 2nd try. pain about 4/10 today per clmt. says she saw Dr Brennan on Jan 20. asked who pays for Rochester Work Injury Clinic visits, told State Insurance Fund pays per fee schedule and to keep receipts. taking tylenol as needed. said she was struck by a coworker durjjg a pallet move. asked about mileage reimbursement, told to send C-257 w/ receipts. next appt w/ Dr Brennan is 2/6. clmt got a bill for $291.00 from Rochester Work Injury Clinic, I told her not to pay it, we will check it. advised to keep appts.', n.char_start = 0, n.char_end = 536, n.word_count = 99;
MERGE (n:Chunk {chunk_id: 'SYN-6977140-054-C01'}) SET n.parent_id = 'SYN-6977140-054', n.parent_kind = 'Note', n.position = 1, n.text = 'Feb 5 - RTW: Maya is back to full duty. full duty release expected 2/6. company should have new restrictions in writing.', n.char_start = 0, n.char_end = 120, n.word_count = 22;
