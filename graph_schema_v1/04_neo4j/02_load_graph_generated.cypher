MERGE (n:Note {note_id: 'SYN-6977160-073'}) SET n.claim_id = '6977160', n.note_date = '2026-04-06', n.note_type = 'Attorney Correspondence', n.author_name = 'Daniel Brooks', n.author_role = 'adjuster', n.text = 'Need to respond to this.\nFrom: Alicia Romano <alicia@romanolaw.example>\nSent: Mon, Apr 6, 2026 9:22\nTo: Daniel Brooks\nSubject: RE: Claim 6977160 - Nguyen\n\nHi Daniel,\nWe will be asking for a hearing if there is no response within 10 days.\nMy client has not been paid for office visit, please advise.\n\nRegards,\nAlicia Romano', n.word_count = 55, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977160-074'}) SET n.claim_id = '6977160', n.note_date = '2026-04-06', n.note_type = 'Contact - Employer', n.author_name = 'Daniel Brooks', n.author_role = 'adjuster', n.text = 'April 6 ER call, Ravi Brandt. Ravi Brandt says Chloe Nguyen has been late a few times lately. Employer says Chloe missed 2 days last month.', n.word_count = 26, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
