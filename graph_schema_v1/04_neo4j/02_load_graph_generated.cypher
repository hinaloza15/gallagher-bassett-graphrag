MERGE (n:Note {note_id: 'SYN-6977144-071'}) SET n.claim_id = '6977144', n.note_date = '2026-03-31', n.note_type = 'File Review', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'STATUS: Priya Shah, neck and low back contusion, DOI 12/26/25. file is open.\nMEDICAL: seeing Dr Okafor at Empire Physical Medicine; pain 1/10 per last note; pain in the neck and low back, worse by end of shift.\nWORK: working regular duty, no issues; restr: released to full duty, no restrictions.\nPAY: no lost time, no wage payments, medical bills only.\nLEGAL: no Board activity.\nPENDING: nothing.\nPLAN: we get the nothing, then close the diary 4/14/26.\nHISTORY: DOI 12/26/25, Priya tripped on something on the floor and went down at service site. First seen at Empire Physical Medicine on 12/30/25, dx contusion of the neck and low back, lumbar xray no acute findings. On modified duty from 12/29/25. Back to full duty from 2/22/26. PT at Riverbend Physical Therapy started 1/12/26, 12 of 12 authorized visits used so far. MRI ordered 1/26/26, result February 7: mild disc bulge L4-5, no stenosis. No wage payments, medical bills only, approx $1,415 paid to date. Contacts: adjuster Priya Shah, ER contact Paula Nakamura, ER supervisor Tasha Okafor, treating Dr Okafor, PT Victor Haddad at Riverbend Physical Therapy. Coverage: WEGMANS FOOD MARKETS on the risk, Monroe county, service site.', n.word_count = 196, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977144-072'}) SET n.claim_id = '6977144', n.note_date = '2026-04-01', n.note_type = 'Diary Entry', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = '4/1/26 diary - no change No concerns re: Compliance Will call Empire Physical Medicine if nothing by 4/11/26.', n.word_count = 18, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977144-073'}) SET n.claim_id = '6977144', n.note_date = '2026-04-01', n.note_type = 'Bill Question', n.author_name = 'Wendell Pratt', n.author_role = 'assistant', n.text = 'Apr 1 bill rvw (Priya): Rx from Empire Physical Medicine $129.00 reduced to fee schedule. duplicate bill rec\'d, flagged. still need records from Empire Physical Medicine for this -WP', n.word_count = 29, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977144-074'}) SET n.claim_id = '6977144', n.note_date = '2026-04-03', n.note_type = 'Bill Question', n.author_name = 'Wendell Pratt', n.author_role = 'assistant', n.text = 'FYI -WP\nFrom: Carla (front desk) <carla@empirephysicalmedicine.example>\nSent: Fri, Apr 3, 2026 7:40\nTo: Priya Shah\nSubject: RE: Claim 6977144 - Shah\n\nHi Priya,\nAttached is the note from Priya Shah\'s vist on Mar 18.\nOur billing for $111.50 was sent on Mar 18, please cofnirm receipt.\n\nThanks,\nCarla (front desk)', n.word_count = 51, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977144-075'}) SET n.claim_id = '6977144', n.note_date = '2026-04-13', n.note_type = 'Contact - Injured Worker', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'Called Priya Shah, reached on 2nd try. Asked who pays for Empire Physical Medicine visits, told Wegmans Food Markets pays per fee schedule and to keep receipts. Asked about the status of the claim, explained it is still open. Said she tripped on something on the floor and went down. Address and phone confirmed same as file. Next appt with Dr Okafor is as needed. Asked her to call Paula Nakamura about the light duty at the company.\nDOI 12/26/25, Priya tripped on something on the floor and went down at service site.', n.word_count = 93, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977144-076'}) SET n.claim_id = '6977144', n.note_date = '2026-04-21', n.note_type = 'Status Report', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'Subject: Status Report - Claim 6977144 - Priya Shah\nHi Tom,\n\nPlease see the update below on Priya Shah\'s claim (Riverside Food Services, DOI 12/26/25, service site). I have kept the history short, call me if you want more.\n\nCLAIM HISTORY\nDOI 12/26/25, Priya Shah tripped on something on the floor and went down at service site. First seen at Empire Physical Medicine on 12/30/25, dx contusion of the neck and low back, lumbar xray no acute findings. On modified duty from Dec 29. Back to full duty from 2/22/26. PT at Riverbend Physical Therapy started 1/12/26, 12 of 12 authorized visits used so far. MRI ordered 1-26-2026, result 2/7/26: mild disc bulge L4-5, no stenosis. No wage payments, medical bills only, approx $1,415 paid to date. Contacts: adjuster Priya Shah, ER contact Paula Nakamura, ER supervisor Tasha Okafor, treating Dr Okafor, PT Victor Haddad at Riverbend Physical Therapy. Coverage: Wegmans Food Markets on the risk, Monroe county, service site.\n\nCURRENT MEDICAL: treating with Dr Okafor at Empire Physical Medicine. Pain was 0/10 at the last visit (Mar 18) and Priya reports feeling much better, occasional soreness. Restrictions: released to full duty, no restrictions.\nWORK STATUS: Priya is back to full duty.\nBENEFITS: no lost time, no wage benefits due at this point. Medical bills are being paid per the fee schedule.\nLEGAL: no hearings or conciliation set, nothing from the Board that needs a response.\nCONTACTS: adjuster Priya Shah, ER contact Paula Nakamura (Riverside Food Services), ER supervisor Tasha Okafor, treating Dr Okafor at Empire Physical Medicine. PT is Victor Haddad at Riverbend Physical Therapy.\nCOVERAGE: Wegmans Food Markets is on the risk. Claim is in Monroe county, injury location service site. No prior claims found on Priya.\nOUTSTANDING: nothing.\nRESERVES: no change recommended right now, med reserve $4,500. We will revisit after the next medical report.\nPLAN: continue to monitor, speak with Priya and the company again this month, and send the next update by 5/5/26. Please let me know if you need anything else in the meantime.\n\nThanks,\nPriya Shah', n.word_count = 343, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977144-077'}) SET n.claim_id = '6977144', n.note_date = '2026-04-23', n.note_type = 'Contact - Injured Worker', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'Spoke with Priya Shah 23APR26. Asked about mileage reimbursement, told to send C-257 with receipts.', n.word_count = 15, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
