MERGE (n:Chunk {chunk_id: 'SYN-6977100-007-C01'}) SET n.parent_id = 'SYN-6977100-007', n.parent_kind = 'Note', n.position = 1, n.text = '11/25/25 Board update: Conciliation conference is on 01/09/2026. Claim 6977100, conciliation conference. Marcus Reed asked if he has to attend - told to check the notice.', n.char_start = 0, n.char_end = 170, n.word_count = 26;
MERGE (n:Chunk {chunk_id: 'SYN-6977100-008-C01'}) SET n.parent_id = 'SYN-6977100-008', n.parent_kind = 'Note', n.position = 1, n.text = 'Called Marcus Reed reached on 2nd try. Worried about the company cutting hours. Asked about mileage reimbursement told to send C-257 with receipts.', n.char_start = 0, n.char_end = 147, n.word_count = 23;
MERGE (n:Chunk {chunk_id: 'SYN-6977100-009-C01'}) SET n.parent_id = 'SYN-6977100-009', n.parent_kind = 'Note', n.position = 1, n.text = 'Dr Osei progress . Restr: No gripping or lifting over 5 lbs w/ that hand. Pt states compliant w/ tx.', n.char_start = 0, n.char_end = 100, n.word_count = 20;
MERGE (n:Chunk {chunk_id: 'SYN-6977100-010-C01'}) SET n.parent_id = 'SYN-6977100-010', n.parent_kind = 'Note', n.position = 1, n.text = 'See below.\nFrom: Carla Lindqvist <carla@hudsonpublicservices.example>\nSent: Tue, Nov 25, 2025 15:13\nTo: Priya Shah\nSubject: RE: Claim 6977100 - Reed\n\nHi Priya,\nOur payroll shows Marcus Reed earned about $1095 a week before the injury.\nJob description attached.\nIncident report was sent on 11/27/25.\n\nThanks,\nCarla Lindqvist', n.char_start = 0, n.char_end = 323, n.word_count = 48;
MERGE (n:Chunk {chunk_id: 'SYN-6977100-011-C01'}) SET n.parent_id = 'SYN-6977100-011', n.parent_kind = 'Note', n.position = 1, n.text = '11/26/25 - Brooklyn Occ Medicine called. Dr Osei\'s office says next appt 12/23.', n.char_start = 0, n.char_end = 79, n.word_count = 13;
MERGE (n:Chunk {chunk_id: 'SYN-6977100-012-C01'}) SET n.parent_id = 'SYN-6977100-012', n.parent_kind = 'Note', n.position = 1, n.text = 'Spoke with Marcus Reed 11/27/25. Pain about 4/10 today per Marcus. Says he saw Dr Osei on 11/25/25. Said he tripped on something on the floor and went down. Asked about mileage reimbursement, told to send C-257 with receipts. Trouble sleeping because of the pain. Asked if Priya is still the adjuster, confirmed. Next appt with Dr Osei is 12/23. Advised to keep appts.\nDOI 11/21/25, Marcus triped on something on the floor and went down at service site. First seen at Brooklyn Occupational Medicine on 11/25/25, dx hand injury of the right hand, xray neg.', n.char_start = 0, n.char_end = 555, n.word_count = 96;
MERGE (n:Chunk {chunk_id: 'SYN-6977100-013-C01'}) SET n.parent_id = 'SYN-6977100-013', n.parent_kind = 'Note', n.position = 1, n.text = 'Capital Open MRI report rec\'d Xray neg Ordered by Dr Osei Report faxed to Wesco Insurance Co Radiologist says full report in 2 days Marcus had to reschedule once Copy to Priya Bill for $423.00 from Capital Open MRI, sent to bill review.', n.char_start = 0, n.char_end = 236, n.word_count = 43;
MERGE (n:Chunk {chunk_id: 'SYN-6977100-014-C01'}) SET n.parent_id = 'SYN-6977100-014', n.parent_kind = 'Note', n.position = 1, n.text = 'RTW: Asked Dr Osei for updated work status.', n.char_start = 0, n.char_end = 43, n.word_count = 8;
MERGE (n:Chunk {chunk_id: 'SYN-6977100-015-C01'}) SET n.parent_id = 'SYN-6977100-015', n.parent_kind = 'Note', n.position = 1, n.text = 'No activity, diary +30. Will call Brooklyn Occupational Medicine if nothing by 12-10-2025.', n.char_start = 0, n.char_end = 90, n.word_count = 13;
MERGE (n:Chunk {chunk_id: 'SYN-6977100-016-C01'}) SET n.parent_id = 'SYN-6977100-016', n.parent_kind = 'Note', n.position = 1, n.text = 'Spoke with Marcus Reed 11/27/25 Asked who pays for Brooklyn Occupational Medicine visits, told WESCO INSURANCE CO pays per fee schedule and to keep receipts Marcus confirmed DOI 11/21/25 at service site.', n.char_start = 0, n.char_end = 203, n.word_count = 32;
MERGE (n:Chunk {chunk_id: 'SYN-6977100-017-C01'}) SET n.parent_id = 'SYN-6977100-017', n.parent_kind = 'Note', n.position = 1, n.text = 'Spoke with Marcus . Working w/ restrictions. Said he tripped on something on the floor and went down. Asked him to call Carla Lindqvist aboht the light duty at the comapny.', n.char_start = 0, n.char_end = 172, n.word_count = 31;
MERGE (n:Chunk {chunk_id: 'SYN-6977100-018-C01'}) SET n.parent_id = 'SYN-6977100-018', n.parent_kind = 'Note', n.position = 1, n.text = 'Recorded statement Marcus Marcus states he tripped on something on the floor and went down at service site around around noon. No one saw it, a coworker came over after. Denies prior problems with hand. No other jobs. Dominant hand is the right. Marcus said it was end of a long shift. Photos requested, none were taken. Supervisor statement requested from Carla Brennan. Asked Marcus if he had any trouble with hand before, said no. Marcus says he told Carla Brennan before the end of the shift. Pain level that day was about 4/10 per Marcus. Marcus says nobody has offered light duty yet.\nDOI 11/21/25, Marcus tripped on something on the floor and went down at service site. First seen at Brooklyn Occupational Medicine on Nov 25, dx hand injury of the right hand, xray neg. On modified duty from 11/24/25. Still waiting on wage statement from the company and initial medical report from Brooklyn Occupational Medicine.', n.char_start = 0, n.char_end = 921, n.word_count = 158;
MERGE (n:Chunk {chunk_id: 'SYN-6977100-019-C01'}) SET n.parent_id = 'SYN-6977100-019', n.parent_kind = 'Note', n.position = 1, n.text = 'Statement from Carla Brennan at Hudson Public Services: I was on shift 11/21/2025. Marcus Reed told me he tripped on something on the floor and went down. No prior complaints that i recall. Marcus finished the shift but was favoring it. I offered to call an ambulance, he said no. Marcus has been reliable, no attendance issues.\nDOI 11/21/2025, Marcus tripped on something on the floor and went down at service site. First seen at Brooklyn Occupational Medicine on 11/25/2025, dx hand injury of the right hand, xray neg.', n.char_start = 0, n.char_end = 520, n.word_count = 89;
MERGE (n:Chunk {chunk_id: 'SYN-6977100-020-C01'}) SET n.parent_id = 'SYN-6977100-020', n.parent_kind = 'Note', n.position = 1, n.text = '12/2/25 - Brooklyn Occupational Medicine called. Asked Dr Osei for an updated work status fax request sent. Records rec\'d from Brooklyn Occupational Medicine 5 pages. Dr Osei wants Marcus Reed to continue wrist ROM grip strengthening putty.', n.char_start = 0, n.char_end = 240, n.word_count = 37;
MERGE (n:Chunk {chunk_id: 'SYN-6977100-021-C01'}) SET n.parent_id = 'SYN-6977100-021', n.parent_kind = 'Note', n.position = 1, n.text = 'Diary 12/3/25: Nothing new from the company or Brooklyn Occupational Medicine.', n.char_start = 0, n.char_end = 78, n.word_count = 11;
MERGE (n:Chunk {chunk_id: 'SYN-6977100-022-C01'}) SET n.parent_id = 'SYN-6977100-022', n.parent_kind = 'Note', n.position = 1, n.text = 'Email from Carla Lindqvist 03DEC25. Carla Lindqvist says wage info coming from payroll. Carla Brennan says Marcus Reed has been calling out lately.', n.char_start = 0, n.char_end = 147, n.word_count = 23;
MERGE (n:Chunk {chunk_id: 'SYN-6977100-023-C01'}) SET n.parent_id = 'SYN-6977100-023', n.parent_kind = 'Note', n.position = 1, n.text = 'Spoke with front desk at Brooklyn Occupational Medicine, they will fax the note.', n.char_start = 0, n.char_end = 80, n.word_count = 13;
MERGE (n:Chunk {chunk_id: 'SYN-6977100-024-C01'}) SET n.parent_id = 'SYN-6977100-024', n.parent_kind = 'Note', n.position = 1, n.text = 'From: Marcus Reed <marcus@mail.example>\nSent: Wed, Dec 3, 2025 15:27\nTo: Priya Shah\nSubject: RE: Claim 6977100 - Reed\n\nhello,\nplease let me know when my next check is coming.\nplease call me back, my number is the same.\ni got a bill for $62.75, not sure if i pay it.\n\nthank you\nMarcus', n.char_start = 0, n.char_end = 283, n.word_count = 54;
MERGE (n:Chunk {chunk_id: 'SYN-6977100-025-C01'}) SET n.parent_id = 'SYN-6977100-025', n.parent_kind = 'Note', n.position = 1, n.text = 'See below.\nFrom: Nora (front desk) <nora@brooklynoccupationalmedicine.example>\nSent: Thu, Dec 4, 2025 14:20\nTo: Priya Shah\nSubject: RE: Claim 6977100 - Reed\n\nHi Priya,\nRestrictions remain: no gripping or lifting over 5 lbs with that hand.\nMarcus Reed is being seen for hand injury of the hand.\nAttached is the note from Marcus Reed\'s visit on 11/25/25.\nNext visit is scheduled for 12/23.\n\nRegards,\nNora (front desk)', n.char_start = 0, n.char_end = 415, n.word_count = 67;
MERGE (n:Chunk {chunk_id: 'SYN-6977100-026-C01'}) SET n.parent_id = 'SYN-6977100-026', n.parent_kind = 'Note', n.position = 1, n.text = 'Compensability 12/04/2025: Disputing for now, we need causation support, C-7 sent to the Board. No lost time to date, medical only so far. Statement taken 11/25/25. The company report matches Marcus\'s account. No witnesses per Carla Brennan. Will revisit once the medical comes in. Marcus\'s account is consistent with Dr Osei\'s first note. We will diary for the wage statement. No signs of a prior injury in the records so far.\nDOI 21NOV25, Marcus tripped on something on the floor and went down at service site. First seen at Brooklyn Occupational Medicine on 11/25/25, dx hand injury of the right hand, xray neg. On modified duty from Nov 24. Still waiting on initial medical report from Brooklyn Occupational Medicine and records from prior provider.', n.char_start = 0, n.char_end = 753, n.word_count = 124;
MERGE (n:Chunk {chunk_id: 'SYN-6977100-027-C01'}) SET n.parent_id = 'SYN-6977100-027', n.parent_kind = 'Note', n.position = 1, n.text = '12/8/25 - auth note: Approved 6 PT visits at Lakeview Physical Therapy auth # 99810.', n.char_start = 0, n.char_end = 84, n.word_count = 15;
MERGE (n:Chunk {chunk_id: 'SYN-6977100-028-C01'}) SET n.parent_id = 'SYN-6977100-028', n.parent_kind = 'Note', n.position = 1, n.text = 'RTW: Restr per Dr Osei: No gripping or lifting over 5 lbs with that hand. Marcus Reed did 6 days of modified duty then called out. next appt 12/26.', n.char_start = 0, n.char_end = 147, n.word_count = 29;
MERGE (n:Chunk {chunk_id: 'SYN-6977100-029-C01'}) SET n.parent_id = 'SYN-6977100-029', n.parent_kind = 'Note', n.position = 1, n.text = '12/8/25 - spoke with Marcus Reed by phone. Worried about the company cutting hours. Marcus asked about hiring an atty, told that is up to him, gave the Board number.', n.char_start = 0, n.char_end = 165, n.word_count = 30;
MERGE (n:Chunk {chunk_id: 'SYN-6977100-030-C01'}) SET n.parent_id = 'SYN-6977100-030', n.parent_kind = 'Note', n.position = 1, n.text = 'Work status: Marcus Reed is working modified duty. Restr per Dr Osei: No gripping or littfing over 5 lbs with that hand. Marcus says he isnt ready pain 4/10. next appt 12/24.', n.char_start = 0, n.char_end = 174, n.word_count = 32;
