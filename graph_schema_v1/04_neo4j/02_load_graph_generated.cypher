MERGE (n:Chunk {chunk_id: 'SYN-6977118-034-C01'}) SET n.parent_id = 'SYN-6977118-034', n.parent_kind = 'Note', n.position = 1, n.text = 'PT visit 2/6 January 19 (Lakeview PT). Pt reports low back and both shoulders sore and stiff. Reviewed HEP, pt demonstrates correctly.', n.char_start = 0, n.char_end = 134, n.word_count = 22;
MERGE (n:Chunk {chunk_id: 'SYN-6977118-035-C01'}) SET n.parent_id = 'SYN-6977118-035', n.parent_kind = 'Note', n.position = 1, n.text = 'Correction to my Jan 16 note - next appt w/ the Dr is 2/9 not 2/8.', n.char_start = 0, n.char_end = 66, n.word_count = 16;
