MERGE (n:Chunk {chunk_id: 'SYN-6977156-079-C01'}) SET n.parent_id = 'SYN-6977156-079', n.parent_kind = 'Note', n.position = 1, n.text = 'STATUS: IW, low back, hip and both knees strain, DOI 12/21/2025. file is still open.\nMEDICAL: seeing DR Haddad at North Shore Occ Health; pain 3/10 per last note; low back, hip and both knees sore and stiff.\nWORK: back on light duty; restr: no lifting over 20 lbs, limit bending.\nPAY: paying $710.00/wk, approx $11,360 paid to date.\nLEGAL: second hearing 04/14/2026 held, judge reserved decision.\nPENDING: nothing.\nPLAN: we get the nothing, then close the diary 05/22/2026.\nHISTORY: DOI 12/21/2025, Emma missed the last few steps and fell at operations facility. First seen at North Shore Occupational Health on 12-25-2025, dx strain of the low back, hip and both knees, lumbar xray no acute findings. Off work from 12/22/2025. On modified duty from 01/15/2026.', n.char_start = 0, n.char_end = 761, n.word_count = 126;
MERGE (n:Chunk {chunk_id: 'SYN-6977156-080-C01'}) SET n.parent_id = 'SYN-6977156-080', n.parent_kind = 'Note', n.position = 1, n.text = 'Dr note rec\'d from North Shore Occupational Health: MRI: Mild disc bulge L4-5, no stenosis Restr: No lifting over 20 lbs, limit bending No new injury reported.', n.char_start = 0, n.char_end = 159, n.word_count = 27;
