MERGE (n:Note {note_id: 'SYN-6977175-042'}) SET n.claim_id = '6977175', n.note_date = '2025-12-18', n.note_type = 'Contact - Injured Worker', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = '18DEC25 outbound call to Caleb. clmt sattes neck, back and wrists sore and stiff. asked who pays for North Shore Occupational Health visits, told State Insurance Fund pays per fee schedule and to keep receipts.', n.word_count = 35, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977175-043'}) SET n.claim_id = '6977175', n.note_date = '2025-12-18', n.note_type = 'Work Status', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = 'work status: clmt is working regular duty, no issues. restr per Dr Romano: no lifting over 10 lbs, no repeated bending. full duty release expected 1/5. asked Dr Romano for updated work status. the company should have the new restrictions in writing.', n.word_count = 42, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977175-044'}) SET n.claim_id = '6977175', n.note_date = '2025-12-22', n.note_type = 'File Review', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = 'STATUS: clmt, neck, back and wrists strain, DOI 11/11/2025. file is open.\nMEDICAL: seeing Dr Romano at North Shore Occupational Health; pain 6/10 per last note; sore all over, stiff in the mornings.\nWORK: working regular duty, no issues; restr: no lifting over 20 lbs, limit bending.\nPAY: no lost time, no wage payments, medical bills only.\nLEGAL: no Board activity.\nPENDING: nothing.\nPLAN: call clmt, follow up with Dr Romano, review again Jan 21.\nHISTORY: DOI Nov 11, clmt was struck by a coworker during a pallet move at facility parking area. First seen at North Shore Occupational Health on Nov 14, dx strain of the neck, back and wrists, lumbar xray no acute findings. Victor Brandt is the worker\'s attorney. No wage payments, medical bills only, approx $410 paid to date.', n.word_count = 133, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977175-045'}) SET n.claim_id = '6977175', n.note_date = '2025-12-23', n.note_type = 'Contact Attempt', n.author_name = 'Gita Rao', n.author_role = 'assistant', n.text = 'LM for Carla Iyer re: wage stmt -GR', n.word_count = 8, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977175-046'}) SET n.claim_id = '6977175', n.note_date = '2025-12-24', n.note_type = 'Bill Question', n.author_name = 'Gita Rao', n.author_role = 'assistant', n.text = 'bill review 12/24/2025: ortho consult from North Shore Occupational Health $212.00 paid. -GR', n.word_count = 13, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977175-047'}) SET n.claim_id = '6977175', n.note_date = '2025-12-24', n.note_type = 'Status Report', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = 'Subject: Status Report - Claim 6977175 - Calebb Ward\nHi Greg,\n\nPlease see the update below on Caleb Ward\'s claim (Brooklyn Retail Group, DOI Nov 11, facility parking area). I have kept the history short, call me if you want more.\n\nCLAIM HISTORY\nDOI Nov 11, clmt was struck by a coworker during a pallet move at facility parking area. First seen at North Shore Occupational Health on Nov 14, dx strain of the neck, back and wrists, lumbar xray no acute findings. Victor Brandt is the worker\'s attorney. No wage payments, medical bills only, approx $410 paid to date. Contacts: adjuster Maya Patel, ER contact Carla Iyer, ER supervisor Alicia Fischer, treating Dr Romano. Coverage: SIF on the risk, Warren county, facility parking area.\n\nCURRENT MEDICAL: treating with Dr Romano at North Shore Occupational Health. Pain was 6/10 at the last visit (Dec 10) and clmt reports pain in the neck, worse by end of shift. Restrictions: no lifting over 20 lbs, limit bending.\nWORK STATUS: clmt is back to full duty.\nBENEFITS: no lost time, no wage benefits due at this point. Medical bills are being paid per the fee schedule.\nLEGAL: no hearings or conciliation set, nothing from the Board that needs a response.\nclmt is represented by Victor Brandt, who has asked for the claim file and our position on added treatment. We are responding by letter.\nCONTACTS: adjuster Maya Patel, ER contact Carla Iyer (Brooklyn Retail Group), ER supervisor Alicia Fischer, treating Dr Romano at North Shore Occupational Health.\nCOVERAGE: SIF is on the risk. Claim is in Warren county, injury location facility parking area. No prior claims found on clmt.\nOUTSTANDING: nothing.\nRESERVES: no change recommended right now, med reserve $22,000. We will revisit after the next medical report.\nPLAN: continue to monitor, speak with Caleb and the company again this month, and send the next update by Jan 7. Please let me know if you need anything else in the meantime.\n\nThanks,\nMaya Patel', n.word_count = 331, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977175-048'}) SET n.claim_id = '6977175', n.note_date = '2026-01-05', n.note_type = 'Medical Update', n.author_name = 'Dr Romano', n.author_role = 'treating provider', n.text = 'North Shore Occupational Health f/u . Restr: No lifting over 20 lbs, limiit benxing.', n.word_count = 14, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
