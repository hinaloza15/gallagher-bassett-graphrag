MERGE (n:Note {note_id: 'SYN-6977100-107'}) SET n.claim_id = '6977100', n.note_date = '2026-08-24', n.note_type = 'Reserve Review', n.author_name = 'Carol Jennings', n.author_role = 'supervisor', n.text = 'August 24 reserves - Olivia\'s file: med reserve $4,500. reserves unchanged. increased med reserve bc more PT requested. Olivia requested more authority. ok to approve the added PT. paid to date approx $12,000.\nDOI November 21, EE tripped on something on floor and went down at service site. first seen at Brooklyn Occupational Medicine on November 25, dx hand injury of the rt hand, xray neg. On modifiied duty from November 24. Back to full duty from February 10. PT at Lakeview Physical Therapy started December 9, 8 of 8 authorized visits used so far. -CJ', n.word_count = 96, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
