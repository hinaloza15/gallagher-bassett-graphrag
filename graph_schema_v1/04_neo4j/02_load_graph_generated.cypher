MERGE (n:Chunk {chunk_id: 'SYN-6977156-066-C01'}) SET n.parent_id = 'SYN-6977156-066', n.parent_kind = 'Note', n.position = 1, n.text = '03/31/2026: eCase check - hearing held 03/03/2026, adjourned for wage info. copy to SIF and employer. IME repprt neds to be in by then. -MH', n.char_start = 0, n.char_end = 139, n.word_count = 25;
MERGE (n:Chunk {chunk_id: 'SYN-6977156-067-C01'}) SET n.parent_id = 'SYN-6977156-067', n.parent_kind = 'Note', n.position = 1, n.text = 'forwarding to file\nFrom: Lena Alvarez <lena@alvarezlaw.example>\nSent: Wed, Apr 1, 2026 16:16\nTo: Marcus Hill\nSubject: RE: Claim 6977156 - Rivera\n\nHi Marcus,\nKindly confirm State Ins Fund\'s position on the low back, hip and both knees treatment.\nPlease send the claim file, medical and wage records for my client Emma Rivera, claim 6977156.\n\nThanks,\nLena Alvarez', n.char_start = 0, n.char_end = 361, n.word_count = 58;
