MERGE (n:Chunk {chunk_id: 'SYN-6977175-082-C01'}) SET n.parent_id = 'SYN-6977175-082', n.parent_kind = 'Note', n.position = 1, n.text = 'STATUS: clmt, neck, back and wrists strain, DOI Nov 11. file is open, no Board date yet.\nMEDICAL: seeing Dr Romano at North Shore Occupational Health; pain 0/10 per last note; feeling much better, occasional soreness.\nWORK: back to full duty; restr: released to full duty, no restrictions.\nPAY: no lost time, no wage payments, medical bills only.\nLEGAL: no Board activity.\nPENDING: nothing.\nPLAN: we get the nothing, then close the diary May 27.\nHISTORY: DOI 11-11-2025, clmt was struck by a coworker during a pallet move at facility parking area. First seen at North Shore Occupational Health on November 14, dx strain of the neck, back and wrists, lumbar xray no acute findings. Victor Brandt is the worker\'s attorney. No wage payments, medical bills only, approx $630 paid to date.', n.char_start = 0, n.char_end = 784, n.word_count = 132;
MERGE (n:Chunk {chunk_id: 'SYN-6977175-083-C01'}) SET n.parent_id = 'SYN-6977175-083', n.parent_kind = 'Note', n.position = 1, n.text = 'need to respond to this. -CJ\nFrom: Carol Jennings <carol@gbclaims.example>\nSent: Mon, May 11, 2026 13:36\nTo: Maya Patel\nSubject: RE: Claim 6977175 - Ward\n\nHi Maya,\nPlease confirm the reserve is still $4,500.\nPlease see the file for Caleb Ward, claim 6977175.\nWe need the nothing before the next review.\n\nThanks,\nCarol Jennings', n.char_start = 0, n.char_end = 326, n.word_count = 54;
