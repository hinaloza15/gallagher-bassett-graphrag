MERGE (n:Chunk {chunk_id: 'SYN-6977178-073-C01'}) SET n.parent_id = 'SYN-6977178-073', n.parent_kind = 'Note', n.position = 1, n.text = 'email from Julian 05/13/2026: calling about my claim 6977178. can someone tell me if Brooklyn Occupational Medicine got paid. i have a bill from Lakeview Pharmacy. my appt got moved to prn. i cant sleep bc of my hip/buttock', n.char_start = 0, n.char_end = 223, n.word_count = 39;
