MERGE (n:Chunk {chunk_id: 'SYN-6977163-070-C01'}) SET n.parent_id = 'SYN-6977163-070', n.parent_kind = 'Note', n.position = 1, n.text = 'Rec\'d this today, will call.\nFrom: Alicia Fischer <alicia@orangesupplycooperative.example>\nSent: Mon, Mar 9, 2026 16:50\nTo: Olivia Grant\nSubject: RE: Claim 6977163 - Lopez\n\nHi Olivia,\nAttached is the wage sattement for Mia Lopez.\nPlease send us the restrictions in writing.\n\nThanks,\nAlicia Fischer', n.char_start = 0, n.char_end = 297, n.word_count = 44;
MERGE (n:Chunk {chunk_id: 'SYN-6977163-071-C01'}) SET n.parent_id = 'SYN-6977163-071', n.parent_kind = 'Note', n.position = 1, n.text = 'can we approve this? -GR\nFrom: Mia Lopez <mia@mail.example>\nSent: Mon, Mar 9, 2026 7:42\nTo: Olivia Grant\nSubject: RE: Claim 6977163 - Lopez\n\nhi,\nmy ears is still bothering me, about 0 out of 10.\nplease let me know when my next check is coming.\nplease call me back, my number is the same.\n\nthank you\nMia', n.char_start = 0, n.char_end = 302, n.word_count = 58;
