MERGE (n:Chunk {chunk_id: 'SYN-6977100-107-C01'}) SET n.parent_id = 'SYN-6977100-107', n.parent_kind = 'Note', n.position = 1, n.text = 'August 24 reserves - Olivia\'s file: med reserve $4,500. reserves unchanged. increased med reserve bc more PT requested. Olivia requested more authority. ok to approve the added PT. paid to date approx $12,000.\nDOI November 21, EE tripped on something on floor and went down at service site. first seen at Brooklyn Occupational Medicine on November 25, dx hand injury of the rt hand, xray neg. On modifiied duty from November 24. Back to full duty from February 10. PT at Lakeview Physical Therapy started December 9, 8 of 8 authorized visits used so far. -CJ', n.char_start = 0, n.char_end = 558, n.word_count = 96;
MERGE (n:Chunk {chunk_id: 'SYN-6977100-108-C01'}) SET n.parent_id = 'SYN-6977100-108', n.parent_kind = 'Note', n.position = 1, n.text = 'STATUS: cx, right hand hand injury, DOI 11/21/25. file is open, no Board date yet.\nMEDICAL: seeing Dr Osei at Brooklyn Occupational Medicine; pain 0/10 per last note; feeling much better, occasional soreness.\nWORK: back to full duty; restr: released to full duty, no restrictions.\nPAY: no lost time, no wage payments, medical bills only.\nLEGAL: conciliation held 1/9/26, issue narrowed to causation.\nPENDING: nothing.\nPLAN: we get the nothing, then close the diary 9-25-2026.\nHISTORY: DOI 11/21/25, cx tripped on something on the floor and went down at service site. First seen at Brooklyn Occupational Medicine on 11/25/25, dx hand injury of the right hand, xray neg. On modified duty from 11/24/25. Back to full duty from 2/10/26.', n.char_start = 0, n.char_end = 732, n.word_count = 119;
MERGE (n:Chunk {chunk_id: 'SYN-6977100-109-C01'}) SET n.parent_id = 'SYN-6977100-109', n.parent_kind = 'Note', n.position = 1, n.text = 'Closing note cx back to full duty since 3/23/26, no f/u needed. Board closed the case, nothing open. No activity in 60 days, closing diary. If cx calls with a flare up, reopen and send back to Dr Osei. All bills paid, nothing pending. Total paid on the file approx $12,000.\nDOI 11/21/25, cx tripped on something on the floor and went down at service site. First seen at Brooklyn Occ Medicine on 11/25/25, dx hand injury of the right hand, xray neg. On modified duty from 11/24/25.', n.char_start = 0, n.char_end = 480, n.word_count = 88;
MERGE (n:Chunk {chunk_id: 'SYN-6977100-110-C01'}) SET n.parent_id = 'SYN-6977100-110', n.parent_kind = 'Note', n.position = 1, n.text = '9/7/26 - clmt called says hand flared up again. told clmt to see Dr Osei first. sent to Olivia to reeview. -Jamal', n.char_start = 0, n.char_end = 113, n.word_count = 22;
MERGE (n:Chunk {chunk_id: 'SYN-6977118-004-C01'}) SET n.parent_id = 'SYN-6977118-004', n.parent_kind = 'Note', n.position = 1, n.text = 'Dec 30 - new file, Nina Foster reported injury DOI Dec 27. Nina says she got the low back and both shoulders caught between a pallet and a rack handling stock at office stairwell. Sx: Low back and both shoulders sore and stiff.', n.char_start = 0, n.char_end = 227, n.word_count = 43;
MERGE (n:Chunk {chunk_id: 'SYN-6977118-005-C01'}) SET n.parent_id = 'SYN-6977118-005', n.parent_kind = 'Note', n.position = 1, n.text = 'See below.\nFrom: Nora (front desk) <nora@upstatejointrehabcenter.example>\nSent: Tue, Dec 30, 2025 13:26\nTo: Elena Cruz\nSubject: RE: Claim 6977118 - Foster\n\nHi Elena,\nAttached is the note from Nina Foster\'s visit on Dec 30.\nNext visit is scheduled for 1/1.\nWork status: back to full duty.\nNina Foster is being seen for sprain of the low back and both shoulders.\n\nThank you,\nNora (front desk)', n.char_start = 0, n.char_end = 390, n.word_count = 66;
MERGE (n:Chunk {chunk_id: 'SYN-6977118-006-C01'}) SET n.parent_id = 'SYN-6977118-006', n.parent_kind = 'Note', n.position = 1, n.text = 'prior claims check 12/30/2025 - nothing under Foster. -Tina', n.char_start = 0, n.char_end = 59, n.word_count = 9;
MERGE (n:Chunk {chunk_id: 'SYN-6977118-007-C01'}) SET n.parent_id = 'SYN-6977118-007', n.parent_kind = 'Note', n.position = 1, n.text = 'Dec 31 - spoke with Lena Brandt at the company Nina Foster is on unpaid leave The company wants to know if the claim is accepted, told them it is open, no Board date yet Lena Brandt says wage info coming from payroll Greg Sato says Nina has been late a few times lately Safety review done, no changes to the office stairwell yet Told Lena Brandt we cant discuss reserves Lena Brandt will send the job description Payroll has not sent the wage statement.', n.char_start = 0, n.char_end = 453, n.word_count = 85;
MERGE (n:Chunk {chunk_id: 'SYN-6977118-008-C01'}) SET n.parent_id = 'SYN-6977118-008', n.parent_kind = 'Note', n.position = 1, n.text = 'Nina Foster called in re: Claim 6977118. Nina states low back and both shoulders sore and stiff. Asked about the status of the claim, explained it is still open. Back to full duty.', n.char_start = 0, n.char_end = 180, n.word_count = 33;
MERGE (n:Chunk {chunk_id: 'SYN-6977118-009-C01'}) SET n.parent_id = 'SYN-6977118-009', n.parent_kind = 'Note', n.position = 1, n.text = 'Spoke with front desk at Upstate Joint & Rehab Center they will fax the note.', n.char_start = 0, n.char_end = 77, n.word_count = 15;
MERGE (n:Chunk {chunk_id: 'SYN-6977118-010-C01'}) SET n.parent_id = 'SYN-6977118-010', n.parent_kind = 'Note', n.position = 1, n.text = 'Jan 2 Northeast Diagnostic Imaging report rec\'d. Lumbar xray no acute findinngs. Radiologist says full report in 2 days. Bill for $175 from Northeast Diagnostic Imaging sent to bill reiew.', n.char_start = 0, n.char_end = 188, n.word_count = 30;
MERGE (n:Chunk {chunk_id: 'SYN-6977118-011-C01'}) SET n.parent_id = 'SYN-6977118-011', n.parent_kind = 'Note', n.position = 1, n.text = 'Jan 2 auth: Approved 6 PT visits at Lakeview PT, auth # 27286. MRI auth\'d, Northeast Diagnostic Imaging to schedule.', n.char_start = 0, n.char_end = 116, n.word_count = 20;
MERGE (n:Chunk {chunk_id: 'SYN-6977118-012-C01'}) SET n.parent_id = 'SYN-6977118-012', n.parent_kind = 'Note', n.position = 1, n.text = 'SUP STMT 1/5/26 - Greg Sato. I was on shift 12/27/25. Nina Foster told me she got the low back and both shoulders caught between a pallet and a rack handling stock.', n.char_start = 0, n.char_end = 164, n.word_count = 32;
MERGE (n:Chunk {chunk_id: 'SYN-6977118-013-C01'}) SET n.parent_id = 'SYN-6977118-013', n.parent_kind = 'Note', n.position = 1, n.text = 'Dr Whitaker progress 1/5/26.\nSUBJECTIVE: pt c/o low back and both shoulders sore and stiff. pain 6/10.\nOBJECTIVE: TTP lumbar paraspinals, neg SLR. lumbar xray no acute findings. ROM: lumbar flexion limited, extension ok.\nASSESSMENT: sprain of the low back and both shoulders, no change.\nPLAN: ice, heat, nsaids. restr: no lifting over 10 lbs, no repeated bending. work status: working regular duty, no issues. f/u 1/15.', n.char_start = 0, n.char_end = 419, n.word_count = 67;
MERGE (n:Chunk {chunk_id: 'SYN-6977118-014-C01'}) SET n.parent_id = 'SYN-6977118-014', n.parent_kind = 'Note', n.position = 1, n.text = 'Statement from Nina Foster: Nina states she got the low back and both shoulders caught between a pallet and a rack handling stock at office stairwell around around noon Nina said it was end of a long shift Nina understood the statement is recorded.', n.char_start = 0, n.char_end = 248, n.word_count = 44;
MERGE (n:Chunk {chunk_id: 'SYN-6977118-015-C01'}) SET n.parent_id = 'SYN-6977118-015', n.parent_kind = 'Note', n.position = 1, n.text = 'Need to respond to this.\nFrom: Lena Brandt <lena@orangesupplycooperative.example>\nSent: Wed, Jan 7, 2026 15:19\nTo: Elena Cruz\nSubject: RE: Claim 6977118 - Foster\n\nHi Elena,\nNina Foster was out on PTO this week last week, no call to us.\nPlease send us the restrictions in writing.\nIncident report was sent on 12/31/2025.\n\nRegards,\nLena Brandt', n.char_start = 0, n.char_end = 341, n.word_count = 56;
MERGE (n:Chunk {chunk_id: 'SYN-6977118-016-C01'}) SET n.parent_id = 'SYN-6977118-016', n.parent_kind = 'Note', n.position = 1, n.text = 'Compensability Jan 7: Accepting as work related, the company confirms Nina was on shift. No lost time to date, medical only so far. Statement taken Jan 1. The company report matches Nina\'s account. No witnesses per Greg Sato. Will revisit once the medical comes in. Nina\'s account is consistent with Dr Whitaker\'s first note. We will diary for the wage statement. No signs of a prior injury in the records so far.\nDOI Dec 27, Nina got the low back and both shoulders caught between a pallet and a rack handling stock at office stairwell. First seen at Upstate Joint & Rehab Center on Jan 1, dx sprain of the low back and both shoulders, lumbar xray no acute findings. Still waiting on wage statement from the company and initial medical report from Upstate Joint & Rehab Center.', n.char_start = 0, n.char_end = 778, n.word_count = 138;
MERGE (n:Chunk {chunk_id: 'SYN-6977118-017-C01'}) SET n.parent_id = 'SYN-6977118-017', n.parent_kind = 'Note', n.position = 1, n.text = 'Rec\'d this today, will call.\nFrom: Lena Brandt <lena@orangesupplycooperative.example>\nSent: Fri, Jan 9, 2026 13:04\nTo: Elena Cruz\nSubject: RE: Claim 6977118 - Foster\n\nHi Elena,\nJob description attached.\nPlease send us the restrictions in writing.\nOur payroll shows Nina Foster earned about $1090 a week before the injury.\nAttached is the wage statement for Nina Foster.\n\nThanks,\nLena Brandt', n.char_start = 0, n.char_end = 390, n.word_count = 60;
MERGE (n:Chunk {chunk_id: 'SYN-6977118-018-C01'}) SET n.parent_id = 'SYN-6977118-018', n.parent_kind = 'Note', n.position = 1, n.text = 'Jan 9 - spoke with Nina Foster by phone Still hard to bend or lift Asked if Elena is still the adjuster, confirmed Asked her to call Lena Brandt about the light duty at the company.', n.char_start = 0, n.char_end = 181, n.word_count = 36;
MERGE (n:Chunk {chunk_id: 'SYN-6977118-019-C01'}) SET n.parent_id = 'SYN-6977118-019', n.parent_kind = 'Note', n.position = 1, n.text = 'VM from Nina: my appt got moved to 1/15', n.char_start = 0, n.char_end = 39, n.word_count = 9;
MERGE (n:Chunk {chunk_id: 'SYN-6977118-020-C01'}) SET n.parent_id = 'SYN-6977118-020', n.parent_kind = 'Note', n.position = 1, n.text = 'Jan 9 checked eCase nothing new. Last med report Jan 1.', n.char_start = 0, n.char_end = 55, n.word_count = 11;
MERGE (n:Chunk {chunk_id: 'SYN-6977118-021-C01'}) SET n.parent_id = 'SYN-6977118-021', n.parent_kind = 'Note', n.position = 1, n.text = 'Auth note: Approved 6 PT visits at Lakeview PT, auth # 13305. Dr Whitaker requested more PT, we are checking against the guideline. MG-2 rec\'d for low back and both shoulders, reviewing. MRI auth\'d, Northeast Diagnostic Imaging to schedule. Waiting on the MRI report from Northeast Diagnostic Imaging.', n.char_start = 0, n.char_end = 301, n.word_count = 48;
MERGE (n:Chunk {chunk_id: 'SYN-6977118-022-C01'}) SET n.parent_id = 'SYN-6977118-022', n.parent_kind = 'Note', n.position = 1, n.text = 'Email from Lena Brandt Jan 9. Nina is on light duty. The company wants to know if the claim is accepted, told them it is open, no Board date yet. Lena Brandt says wage info coming from payroll. Greg Sato says Nina has been late a few times lately. Asked Lena Brandt about restrictions: No lifting over 10 lbs, no repeated bending. The company reported it to POLICE on Jan 2. The company says Nina missed 8 days last month. Lena Brandt says no other injuries like this at the site. Payroll has not sent the wage statement. I asked Lena Brandt to put the light duty offer in writing.\nDOI Dec 27, Nina got the low back and both shoulders caught between a pallet and a rack handling stock at office stairwell. First seen at Upstate Joint & Rehab Center on Jan 1, dx sprain of the low back and both shoulders, lumbar xray no acute findings. Still waiting on wage statement from the company and initial medical report from Upstate Joint & Rehab Center.', n.char_start = 0, n.char_end = 946, n.word_count = 176;
MERGE (n:Chunk {chunk_id: 'SYN-6977118-023-C01'}) SET n.parent_id = 'SYN-6977118-023', n.parent_kind = 'Note', n.position = 1, n.text = 'Pharmacy note (Corner Rx): Flexeril filled, qty 30, $23.25', n.char_start = 0, n.char_end = 58, n.word_count = 9;
MERGE (n:Chunk {chunk_id: 'SYN-6977118-024-C01'}) SET n.parent_id = 'SYN-6977118-024', n.parent_kind = 'Note', n.position = 1, n.text = '01/12/2026 pharmacy note (Corner Rx): Need to confirm flexeril is still needed per Dr Whitaker', n.char_start = 0, n.char_end = 94, n.word_count = 15;
MERGE (n:Chunk {chunk_id: 'SYN-6977118-025-C01'}) SET n.parent_id = 'SYN-6977118-025', n.parent_kind = 'Note', n.position = 1, n.text = 'January 12 therapy session #1 - Lena Castillo, PT Tolerated tx well Pt reports low back and both shoulders sore and stif Pain 6/10 pre-tx, 6/10 after Did core stabilization, hamstring stretching, bridging + ice Progressing w/ HEP Strength 4/5 Pt arrived late, shoortened session.', n.char_start = 0, n.char_end = 279, n.word_count = 45;
MERGE (n:Chunk {chunk_id: 'SYN-6977118-026-C01'}) SET n.parent_id = 'SYN-6977118-026', n.parent_kind = 'Note', n.position = 1, n.text = 'bill review MRI from Upstate Joint & Rehab Center $64.75 reduced to fee schedule -Tina', n.char_start = 0, n.char_end = 86, n.word_count = 15;
MERGE (n:Chunk {chunk_id: 'SYN-6977118-027-C01'}) SET n.parent_id = 'SYN-6977118-027', n.parent_kind = 'Note', n.position = 1, n.text = 'Jan 12 - spoke with Nina Foster by phone. Pain about 6/10 today per Nina. Asked who pays for Upstate Joint and Rehab Center visits, told POLICE pays per fee schedule and to keep receipts. Worried about the company cutting hours. Nina confirmed DOI Dec 27 at office stairwell. Still hard to bend or lift. Address and phone confirmed same as file. Nina got a bill for $409.75 from Upstate Joint & Rehab Center, I told her not to pay it, we will check it. Asked her to call Lena Brandt about the light duty at the company. Told to call with any changes.', n.char_start = 0, n.char_end = 550, n.word_count = 104;
MERGE (n:Chunk {chunk_id: 'SYN-6977118-028-C01'}) SET n.parent_id = 'SYN-6977118-028', n.parent_kind = 'Note', n.position = 1, n.text = 'Dr note rec\'d Jan 15 from Upstate Joint & Rehab Center: Tx: Brace/splint prn, ice. Pt asks about bend or lift, advised to modify.', n.char_start = 0, n.char_end = 129, n.word_count = 24;
MERGE (n:Chunk {chunk_id: 'SYN-6977118-029-C01'}) SET n.parent_id = 'SYN-6977118-029', n.parent_kind = 'Note', n.position = 1, n.text = '1-16-2026 - auth note: Approved 6 PT visits at Lakeview PT, auth # 78464 Dr Whitaker requested more PT, we are checking against the guideline MG-2 rec\'d for low back and both shoulders, reviewing MRI auth\'d, Northeast Diagnostic Imaging to schedule Waiting on the MRI report from Northeast Diagnostic Imaging.', n.char_start = 0, n.char_end = 309, n.word_count = 50;
MERGE (n:Chunk {chunk_id: 'SYN-6977118-030-C01'}) SET n.parent_id = 'SYN-6977118-030', n.parent_kind = 'Note', n.position = 1, n.text = 'Called Nina Foster, reached on 2nd try. Nina states low back and both shoulders sore and stiff. Wants a copy of the C-3, will mail. Worried about the company cutting hours. Said she got the low back and both shoulders caught between a pallet and a rack handling stock. Next appt with Dr Whitaker is 2/8. Nina understood.\nDOI Dec 27, Nina got the low back and both shoulders caught between a pallet and a rack handling stock at office stairwell. First seen at Upstate Joint & Rehab Center on Jan 1, dx sprain of the low back and both shoulders, lumbar xray no acute findings.', n.char_start = 0, n.char_end = 574, n.word_count = 106;
MERGE (n:Chunk {chunk_id: 'SYN-6977118-031-C01'}) SET n.parent_id = 'SYN-6977118-031', n.parent_kind = 'Note', n.position = 1, n.text = '16JAN26 file check - records from prior provider still outstanding.', n.char_start = 0, n.char_end = 67, n.word_count = 10;
MERGE (n:Chunk {chunk_id: 'SYN-6977118-032-C01'}) SET n.parent_id = 'SYN-6977118-032', n.parent_kind = 'Note', n.position = 1, n.text = 'Diary - no change. Will call Upstate Joint & Rehab Center if nothing by Jan 28.', n.char_start = 0, n.char_end = 79, n.word_count = 16;
