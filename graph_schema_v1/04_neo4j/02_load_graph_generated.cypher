MERGE (n:Chunk {chunk_id: 'SYN-6977182-099-C01'}) SET n.parent_id = 'SYN-6977182-099', n.parent_kind = 'Note', n.position = 1, n.text = '08/24/2026 - closing review: IW back to full duty since 02/09/2026, no f/u needed. board closed case, nothing open. no activity in 60 days, closing diary. treated at Rochester Work Injury Clinic, released, no restrictions. if IW calls w/ a flare up, reopen and send back to DR Doyle. all bills paid, nothing pending. final med report rec\'d, strain resolved. total paid on file approx $8,500.\nDOI 10/20/2025, IW was moving heavy tote and felt something give at operations facility. first seen at Rochester Work Injury Clinic on 10/27/2025, dx strain of rt forearm, xray neg. No wage payments, medical bills only, approx $630 paid to date. Contacts: adjuster Marcus Hill, ER contact Paula Nakamura, ER supervisor Lena Brennan, treating DR Doyle. Coverage: Wegmans Food Markets on the risk, Monroe county, operations facility.', n.char_start = 0, n.char_end = 823, n.word_count = 133;
