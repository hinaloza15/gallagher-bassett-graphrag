MERGE (n:Chunk {chunk_id: 'SYN-6977156-059-C01'}) SET n.parent_id = 'SYN-6977156-059', n.parent_kind = 'Note', n.position = 1, n.text = 'Therapy session #15 - Lena Mehta, PT. Tolerated tx well. Pt reports pain in the low back, worse by end of shift. Pain 4/10 pre-tx, 3/10 after. Progressing w/ HEP. Missed last appt, rescheduled. ROM: Lumbar flexion limited, extension ok. Goal: Lift 30 lbs floor to waist. Pt asked if more visits will be approved. Cont plan of care.', n.char_start = 0, n.char_end = 331, n.word_count = 59;
MERGE (n:Chunk {chunk_id: 'SYN-6977156-060-C01'}) SET n.parent_id = 'SYN-6977156-060', n.parent_kind = 'Note', n.position = 1, n.text = 'Dr note rec\'d Mar 12 from North Shore Occ Health:\nSUBJECTIVE: pt c/o pain in the low back, worse by end of shift. pain 4/10. pt states compliant w/ tx.\nOBJECTIVE: paraspinal spasm, FROM limited. MRI: mild disc bulge L4-5, no stenosis. ROM: lumbar flexion limited, extension ok.\nASSESSMENT: strain of the low back, hip and both knees, no change.\nPLAN: PT, home exercise program. restr: no lifting over 20 lbs, limit bending. work status: working modified duty. f/u 4/1.', n.char_start = 0, n.char_end = 468, n.word_count = 80;
