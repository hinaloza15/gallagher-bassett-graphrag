MERGE (n:Note {note_id: 'SYN-6977144-012'}) SET n.claim_id = '6977144', n.note_date = '2025-12-31', n.note_type = 'Contact - Provider', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'Empire Physical Medicine called. Dr Okafor\'s office says next appt 1/23. Asked Dr Okafor for an updated work status, fax request sent. Empire Physical Medicine billing called about a denied visit, referred to WEGMANS FOOD MARKETS. Empire Physical Medicine says Priya no showed the last appt. Need the C-4.2 from Dr Okafor. Dr Okafor wants Priya to continue core stabilization, hamstring stretching, bridging. Empire Physical Medicine sent a bill for $316.50, forwarded to bill review.', n.word_count = 75, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
