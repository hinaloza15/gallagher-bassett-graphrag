MERGE (n:Note {note_id: 'SYN-6977118-007'}) SET n.claim_id = '6977118', n.note_date = '2025-12-31', n.note_type = 'Contact - Employer', n.author_name = 'Elena Cruz', n.author_role = 'adjuster', n.text = 'Dec 31 - spoke with Lena Brandt at the company Nina Foster is on unpaid leave The company wants to know if the claim is accepted, told them it is open, no Board date yet Lena Brandt says wage info coming from payroll Greg Sato says Nina has been late a few times lately Safety review done, no changes to the office stairwell yet Told Lena Brandt we cant discuss reserves Lena Brandt will send the job description Payroll has not sent the wage statement.', n.word_count = 85, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977118-008'}) SET n.claim_id = '6977118', n.note_date = '2025-12-31', n.note_type = 'Contact - Injured Worker', n.author_name = 'Elena Cruz', n.author_role = 'adjuster', n.text = 'Nina Foster called in re: Claim 6977118. Nina states low back and both shoulders sore and stiff. Asked about the status of the claim, explained it is still open. Back to full duty.', n.word_count = 33, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
