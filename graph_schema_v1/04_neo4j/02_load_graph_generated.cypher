MERGE (n:Note {note_id: 'SYN-6977100-012'}) SET n.claim_id = '6977100', n.note_date = '2025-11-27', n.note_type = 'Contact - Injured Worker', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'Spoke with Marcus Reed 11/27/25. Pain about 4/10 today per Marcus. Says he saw Dr Osei on 11/25/25. Said he tripped on something on the floor and went down. Asked about mileage reimbursement, told to send C-257 with receipts. Trouble sleeping because of the pain. Asked if Priya is still the adjuster, confirmed. Next appt with Dr Osei is 12/23. Advised to keep appts.\nDOI 11/21/25, Marcus triped on something on the floor and went down at service site. First seen at Brooklyn Occupational Medicine on 11/25/25, dx hand injury of the right hand, xray neg.', n.word_count = 96, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977100-013'}) SET n.claim_id = '6977100', n.note_date = '2025-11-27', n.note_type = 'Imaging Result', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'Capital Open MRI report rec\'d Xray neg Ordered by Dr Osei Report faxed to Wesco Insurance Co Radiologist says full report in 2 days Marcus had to reschedule once Copy to Priya Bill for $423.00 from Capital Open MRI, sent to bill review.', n.word_count = 43, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
