MERGE (n:Note {note_id: 'SYN-6977194-026'}) SET n.claim_id = '6977194', n.note_date = '2025-12-03', n.note_type = 'Contact - Provider', n.author_name = 'Daniel Brooks', n.author_role = 'adjuster', n.text = 'FYI\nFrom: Mei (front desk) <mei@capitalregionoccupationalhealth.example>\nSent: Wed, Dec 3, 2025 10:23\nTo: Daniel Brooks\nSubject: RE: Claim 6977194 - Bailey\n\nHi Daniel,\nOur biling for $370.75 was sent on 11/24/2025, please confirm receipt.\nRestrictions remain: no stsnding over 2 hrs, no ladders, no kneeling.\nAttached is the note from Naomi Bailey\'s visit on November 24.\n\nThank you,\nMei (front desk)', n.word_count = 61, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977194-027'}) SET n.claim_id = '6977194', n.note_date = '2025-12-08', n.note_type = 'Therapy Update', n.author_name = 'Joan Haddad', n.author_role = 'physical therapist', n.text = 'PT visit 2/6 12-8-2025 (Summit Rehab & Sports PT). Tolerated tx well. Pt reports knee swelling, feels unstable on stairs. Pain 5/10 pre-tx, 5/10 after. Did quad sets, straight leg raises, step-ups, stationary bike + ice. Progressing w/ HEP. ROM: Knee/ankle ROM near full, some pain at end range. Strength 4+/5. Pt asked if more visits will be approved.', n.word_count = 59, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977194-028'}) SET n.claim_id = '6977194', n.note_date = '2025-12-11', n.note_type = 'Therapy Update', n.author_name = 'Joan Haddad', n.author_role = 'physical therapist', n.text = 'PT visit 3/6 12/11/25 (Summit Rehab and Sports PT). Pt reports knee swelling, feels unstabble on stairs.', n.word_count = 17, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977194-029'}) SET n.claim_id = '6977194', n.note_date = '2025-12-15', n.note_type = 'Therapy Update', n.author_name = 'Joan Haddad', n.author_role = 'physical therapist', n.text = '12/15/25 therapy session #4 - Joan Haddad PT. Tolerated tx well. Pain 5/10 pre-tx 5/10 after. Did quad sets straight leg raises step-ups stationary bike + ice. Progressing w/ HEP. Goal: Stand a full shift w/o pain. Reviewed HEP pt demonstrates correctly.', n.word_count = 42, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977194-030'}) SET n.claim_id = '6977194', n.note_date = '2025-12-15', n.note_type = 'Medical Update', n.author_name = 'Dr Fischer', n.author_role = 'treating provider', n.text = 'OFFICE NOTE 12/15/2025 (Dr Fischer): Pain 5/10. ROM: Knee/ankle ROM near full, some pain at end range. Pt asks about stand or walk for long, advised to modify.', n.word_count = 28, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977194-031'}) SET n.claim_id = '6977194', n.note_date = '2025-12-15', n.note_type = 'Contact - Injured Worker', n.author_name = 'Daniel Brooks', n.author_role = 'adjuster', n.text = 'Spoke with Naomi December 15. Pain about 5/10 today per Naomi. Says she saw Dr Fischer on November 24. Wants a copy of the C-3, will mail. Worried about employer cutting hours. Taking ibuprofen as needed. Working regular duty, no issues. Said she got grabbed by another person during a transfer. Asked about mkleage reimbursement, told to send C-257 with receipts. Still hard to stand or walk for long. Address and phone confirmed same as file. Asked if Daniel is still the adjuster, confirmed. Naomi got a bill for $53.00 from Capital Region Occupational Health, I told her not to pay it, we will check it. Asked her to call Frank Kowalski about the light duty at employer.\nDOI June 29, Naomi got grabbed by another person during a transfer at warehouse. First seen at Capital Region Occupational Health on 11/24/2025, dx strain of the right knee, xray neg for fracture. PT at Summit Rehab & Sports PT stated December 3, 4 of 6 authorized visits used so far. No wage payments, medical bills only, approx $690 paid to date. Contacts: Adjuster Daniel Brooks, ER contact Frank Kowalski, ER supervisor Dev Alvarez, treating Dr Fischer, PT Joan Haddad at Summit Rehab & Sports PT. Coverage: SIF on the risk, Warren county, warehouse. Still waiting on records from prior provider.', n.word_count = 219, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977194-032'}) SET n.claim_id = '6977194', n.note_date = '2025-12-16', n.note_type = 'Reserve Review', n.author_name = 'Ray Delgado', n.author_role = 'supervisor', n.text = 'reserves - Daniel\'s file: increased med reserve because IME pending ok to set up the IME paid to date approx $6,000.', n.word_count = 21, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977194-033'}) SET n.claim_id = '6977194', n.note_date = '2025-12-19', n.note_type = 'Authorization', n.author_name = 'Daniel Brooks', n.author_role = 'adjuster', n.text = 'December 19 - auth note: Approved 6 PT visits at Summit Rehab & Sports PT, auth # 75603. Dr Fischer requested more PT, we are checking against the guideline. MG-2 rec\'d for knee, reviewing.', n.word_count = 34, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977194-034'}) SET n.claim_id = '6977194', n.note_date = '2025-12-22', n.note_type = 'Contact - Injured Worker', n.author_name = 'Daniel Brooks', n.author_role = 'adjuster', n.text = 'Spoke with Naomi December 22. Says she saw Dr Fischer on December 15. Asked her to call Frank Kowalski about the light duty at emplkyer.', n.word_count = 25, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977194-035'}) SET n.claim_id = '6977194', n.note_date = '2025-12-22', n.note_type = 'Contact - Employer', n.author_name = 'Daniel Brooks', n.author_role = 'adjuster', n.text = 'Need to respond to this.\nFrom: Frank Kowalski <frank@albanypublicworks.example>\nSent: Mon, Dec 22, 2025 7:52\nTo: Daniel Brooks\nSubject: RE: Claim 6977194 - Bailey\n\nHi Daniel,\nPlease confirm whether the claim has been accepted.\nOur payroll shows Naomi Bailey earned about $1040 a week before the injury.\nPlease send us the restrictions in writing.\nOur insurer is SIF, adjuster is Daniel.\n\nThanks,\nFrank Kowalski', n.word_count = 64, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977194-036'}) SET n.claim_id = '6977194', n.note_date = '2025-12-24', n.note_type = 'Authorization', n.author_name = 'Daniel Brooks', n.author_role = 'adjuster', n.text = 'From: Tasha (front desk) <tasha@capitalregionoccupationalhealth.example>\nSent: Wed, Dec 24, 2025 11:56\nTo: Daniel Brooks\nSubject: RE: Claim 6977914 - Bailey\n\nHi Daniel,\nRestrictions remain: no kneeling or squatting, limited stairs.\nWork status: working regular duty, no issues.\nAttached is the note from Naomi Bailey\'s visit on 12/15/2025.\n\nThank you,\nTasha (front desk)', n.word_count = 52, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
