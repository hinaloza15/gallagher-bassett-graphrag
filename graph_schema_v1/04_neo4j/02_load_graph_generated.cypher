MERGE (n:Chunk {chunk_id: 'SYN-6977163-099-C01'}) SET n.parent_id = 'SYN-6977163-099', n.parent_kind = 'Note', n.position = 1, n.text = 'June 16 reserves - Olivia\'s file: Olivia requested more authority. ok to set up the IME. paid to date approx $22,000.', n.char_start = 0, n.char_end = 117, n.word_count = 21;
MERGE (n:Chunk {chunk_id: 'SYN-6977163-100-C01'}) SET n.parent_id = 'SYN-6977163-100', n.parent_kind = 'Note', n.position = 1, n.text = 'Subject: Status Report - Claim 6977163 - Mia Lopez\nHi Ravi,\n\nPlease see the update below on Mia Lopez\'s claim (Orange Supply Cooperative, DOI 5/1/15, retail store). I have kept the history short, call me if you want more.\n\nCLAIM HISTORY\nDOI 5/1/15, cx has had noise exposure for years on the production floor at retail store. First seen at Upstate Joint & Rehab Center on 11/17/25, dx hearing loss of the ears, audiogram shows high-frequency loss. On modified duty from 11/13/25. Back to full duty from 12/11/25. IME with Dr Nakamura on 1/30/26, report 2/12/26 says finds partial disability, recommends more PT. Lena Castillo is the worker\'s attorney. Hearing held 2/2/26. Second hearing 3/31/26. No wage payments, medical bills only, approx $410 paid to date.', n.char_start = 0, n.char_end = 760, n.word_count = 126;
MERGE (n:Chunk {chunk_id: 'SYN-6977163-100-C02'}) SET n.parent_id = 'SYN-6977163-100', n.parent_kind = 'Note', n.position = 2, n.text = 'CURRENT MEDICAL: treating with Dr Haddad at Upstate Joint & Rehab Center. Pain was 0/10 at the last visit (Dec 9) and cx reports mild stiffness only. Restrictions: released to full duty, no restrictions.\nWORK STATUS: cx is back to full duty.\nBENEFITS: no lost time, no wage benefits due at this point. Medical bills are being paid per the fee schedule.\nLEGAL: second hearing 3/31/26 held, judge reserved decision.\nIME: Dr Nakamura saw cx and the report says finds partial disability, recommends more PT. We are reviewing whether to dispute any of the ongoing treatment.\ncx is represented by Lena Castillo, who has asked for the claim file and our position on added treatment. We are responding by letter.\nCONTACTS: adjuster Olivia Grant, ER contact Alicia Fischer (Orange Supply Cooperative), ER supervisor Carla Fischer, treating Dr Haddad at Upstate Joint & Rehab Center.\nCOVERAGE: NEW HAMPSHIRE INSURANCE CO is on the risk. Claim is in Allegany county, injury location retail store. No prior claims found on cx.\nOUTSTANDING: nothing.\nRESERVES: no change recommended right now, med reserve $4,500. We will revisit after the next medical report.\nPLAN: continue to monitor, speak with cx and the employer again this month, and send the next update by 7/19/26. Please let me know if you need anything else in the meantime.', n.char_start = 762, n.char_end = 2083, n.word_count = 219;
MERGE (n:Chunk {chunk_id: 'SYN-6977163-100-C03'}) SET n.parent_id = 'SYN-6977163-100', n.parent_kind = 'Note', n.position = 3, n.text = 'Thanks,\nOlivia Grant', n.char_start = 2085, n.char_end = 2105, n.word_count = 3;
MERGE (n:Chunk {chunk_id: 'SYN-6977163-101-C01'}) SET n.parent_id = 'SYN-6977163-101', n.parent_kind = 'Note', n.position = 1, n.text = 'STATUS: cx, ears hearing loss, DOI 5/1/15. file is open, no Board date yet.\nMEDICAL: seeing Dr Haddad at Upstate Joint and Rehab Center; pain 0/10 per last note; feeling much better, occasional soreness.\nWORK: back to full duty; restr: released to full duty, no restrictions.\nPAY: no lost time, no wage payments, medical bills only.\nLEGAL: second hearing 3/31/26 held, judge reserved decision.\nPENDING: nothing.\nPLAN: continue to monitor, next review 7/13/26.\nHISTORY: DOI 5/1/15, cx has had noise exposure for years on the production floor at retail store. First seen at Upstate Joint & Rehab Center on 11/17/25, dx hearing loss of the ears, audiogram shows high-frequency loss. On modified duty from 11/13/25. Back to full duty from 12/11/25. IME with Dr Nakamura on 1/30/26, report 2/12/26 says finds partial disability, recommends more PT. Lena Castillo is the worker\'s attorney. Hearing held 02/02/2026. Second hearing 3/31/26. No wage payments, medical bills only, approx $410 paid to date. Contacts: adjuster Olivia Grant, ER contact Alicia Fischer, ER supervisor Carla Fischer, treating Dr Haddad. Coverage: NEW HAMPSHIRE INSURANCE CO on the risk, Allegany county, retail store.', n.char_start = 0, n.char_end = 1186, n.word_count = 186;
MERGE (n:Chunk {chunk_id: 'SYN-6977163-102-C01'}) SET n.parent_id = 'SYN-6977163-102', n.parent_kind = 'Note', n.position = 1, n.text = 'bill review PT visits from Upstate Joint & Rehab Center $318.00 reduced to fee schedule. NEW HAMPSHIRE INSURANCE CO paid per fee schedule. mileage request (C-257) rec\'d from EE, forwarded. -GR', n.char_start = 0, n.char_end = 192, n.word_count = 31;
MERGE (n:Chunk {chunk_id: 'SYN-6977163-103-C01'}) SET n.parent_id = 'SYN-6977163-103', n.parent_kind = 'Note', n.position = 1, n.text = 'STATUS: cx, ears hearing loss, DOI 5/1/15. file is open.\nMEDICAL: seeing Dr Haddad at Upstate Joint and Rehab Center; pain 0/10 per last note; no complaints.\nWORK: back to full duty; restr: released to full duty, no restrictions.\nPAY: no lost time, no wage payments, medical bills only.\nLEGAL: second hearing 3/31/26 held, judge reserved decision.\nPENDING: nothing.\nPLAN: call cx, follow up with Dr Haddad, review again 8/17/26.\nHISTORY: DOI 5/1/15, cx has had noise exposure for years on the production floor at retail store. First seen at Upstate Joint & Rehab Center on 11/17/25, dx hearing loss of the ears, audiogram shows high-frequency loss. On modified duty from 11/13/25. Back to full duty from 12/11/25.', n.char_start = 0, n.char_end = 713, n.word_count = 118;
MERGE (n:Chunk {chunk_id: 'SYN-6977163-104-C01'}) SET n.parent_id = 'SYN-6977163-104', n.parent_kind = 'Note', n.position = 1, n.text = 'voicemail from Mia: my boss Carla Fischer keeeps asking when i can come back. my appt got moved to as needde. -GR', n.char_start = 0, n.char_end = 113, n.word_count = 22;
