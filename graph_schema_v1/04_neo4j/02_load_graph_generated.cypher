MERGE (n:Note {note_id: 'SYN-6977100-083'}) SET n.claim_id = '6977100', n.note_date = '2026-03-03', n.note_type = 'Reserve Review', n.author_name = 'Carol Jennings', n.author_role = 'supervisor', n.text = 'Mar 3 reserves - Priya\'s file: med reserve $8,500 increased med reserve bc more PT requested Priya requested more authority -CJ', n.word_count = 21, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977100-084'}) SET n.claim_id = '6977100', n.note_date = '2026-03-09', n.note_type = 'File Review', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'File review 3/9/26. Marcus has a hand injury of the right hand from 11/21/25, claim is still open. Marcus is seeing Dr Osei at Brooklyn Occupational Medicine and last reported pain at 3/10, swelling at the knuckles, hurts to make a fist. Restrictions are: Lifting to 20 lbs, splint as needed. Marcus is working regular duty, no issues. No lost time and no wage payments due. Pending: Nothing. Plan: Call Marcus, follow up with Dr Osei, review again 4/8/26.\nDOI 11/21/2025, Marcus tripped on something on the floor and went down at service site. First seen at Brooklyn Occupational Medicine on 11/25/25, dx hand injury of the right hand, xray neg. On modified duty from 24NOV25. Back to full duty from 2/10/26. PT at Lakeview Physical Therapy started 12/9/25, 8 of 8 authorized visits used so far. Conciliation held 1/9/26. No wage payments, medical bills only, approx $1,135 paid to date. Contacts: Adjuster Priya Shah, ER contact Carla Lindqvist, ER supervisor Carla Brennan, treating Dr Osei, PT Beth Mehta at Lakeview Physical Therapy. Coverage: Wesco Insurance Co on the risk, Nassau county, service site.', n.word_count = 184, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977100-085'}) SET n.claim_id = '6977100', n.note_date = '2026-03-16', n.note_type = 'Pharmacy', n.author_name = 'Aziz Karimi', n.author_role = 'specialist', n.text = 'Rx check 3/16/26: PPO pharmacy network rule explained to Marcus. -AK', n.word_count = 11, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977100-086'}) SET n.claim_id = '6977100', n.note_date = '2026-03-25', n.note_type = 'Medical Update', n.author_name = 'Dr Osei', n.author_role = 'treating provider', n.text = 'Dr Osei progress 3/25/26.\nSUBJECTIVE: pt c/o swelling at the knuckles, hurts to make a fist. pain 2/10. pt states compliant w/ tx.\nOBJECTIVE: grip 4/5, cap refill ok. xray neg. ROM: wrist ROM limited by pain, grip weak.\nASSESSMENT: hand injury of the right hand, improving.\nPLAN: PT, home exercise program. restr: lifting to 20 lbs, splint as needed. work status: working regular duty, no issues. f/u prn.', n.word_count = 69, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977100-087'}) SET n.claim_id = '6977100', n.note_date = '2026-03-26', n.note_type = 'Status Report', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'Subject: Status Report - Claim 6977100 - Marcus Reed\nHi Rita,\n\nPlease see the update below on Marcus Reed\'s claim (Hudson Public Services, DOI 11/21/25, service site). I have kept the history short, call me if you want more.\n\nCLAIM HISTORY\nDOI 11/21/25, Marcus Reed tripped on something on the floor and went down at service site. First seen at Brooklyn Occupational Medicine on 11/25/25, dx hand injury of the right hand, xray neg. On modified duty from 11/24/25. Back to full duty from 2/10/26. PT at Lakeview Physical Therapy started 12/9/25, 8 of 8 authorized visits used so far. Conciliation held 1/9/26. No wage payments, medical bills only, approx $1,190 paid to date. Contacts: adjuster Priya Shah, ER contact Carla Lindqvist, ER supervisor Carla Brennan, treating Dr Osei, PT Beth Mehta at Lakeview Physical Therapy. Coverage: Wesco Insurance Co on the risk, Nassau county, service site.\n\nCURRENT MEDICAL: treating with Dr Osei at Brooklyn Occupational Medicine. Pain was 2/10 at the last visit (3-23-2026) and Marcus reports swelling at the knuckles, hurts to make a fist. Restrictions: lifting to 20 lbs, splint as needed.\nWORK STATUS: Marcus is working regular duty, no issues.\nBENEFITS: no lost time, no wage benefits due at this point. Medical bills are being paid per the fee schedule.\nLEGAL: conciliation held 1/9/26, issue narrowed to medical bills.\nCONTACTS: adjuster Priya Shah, ER contact Carla Lindqvist (Hudson Public Services), ER supervisor Carla Brennan, treating Dr Osei at Brooklyn Occupational Medicine. PT is Beth Mehta at Lakeview Physical Therapy.\nCOVERAGE: Wesco Insurance Co is on the risk. Claim is in Nassau county, injury location service site. No prior claims found on Marcus.\nOUTSTANDING: nothing.\nRESERVES: no change recommended right now, med reserve $8,500. We will revisit after the next medical report.\nPLAN: continue to monitor, speak with Marcus and the company again this month, and send the next update by 4/9/26. Please let me know if you need anything else in the meantime.\n\nThanks,\nPriya Shah', n.word_count = 330, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977100-088'}) SET n.claim_id = '6977100', n.note_date = '2026-03-30', n.note_type = 'Contact Attempt', n.author_name = 'Jamal Webb', n.author_role = 'assistant', n.text = 'emailed Carla Lindqvist, no reply yet -Jamal', n.word_count = 7, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
