MERGE (n:Chunk {chunk_id: 'SYN-6977137-026-C01'}) SET n.parent_id = 'SYN-6977137-026', n.parent_kind = 'Note', n.position = 1, n.text = 'See below.\nFrom: Joan (front desk) <joan@hudsonvalleyorthorehab.example>\nSent: Tue, Jan 13, 2026 9:52\nTo: Olivia Grant\nSubject: RE: Claim 6977137 - Bennett\n\nHi Olivia,\nNext visit is scheduled for 1/19.\nOur billing for $448 was sent on 12/29/25, please confirm receipt.\nAttached is the note from Noah Bennett\'s visit on 12/29/25.\nRestrictions remain: no standing over 2 hrs, no ladders, no kneeling.\n\nThanks,\nJoan (front desk)', n.char_start = 0, n.char_end = 425, n.word_count = 66;
