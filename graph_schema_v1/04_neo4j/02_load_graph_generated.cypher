MERGE (n:Note {note_id: 'SYN-6977160-052'}) SET n.claim_id = '6977160', n.note_date = '2026-02-23', n.note_type = 'Hearing / Legal', n.author_name = 'Daniel Brooks', n.author_role = 'adjuster', n.text = 'February 23 Board update: Next hearing is on November 10 notice to employer and Alicia Romano. Nothing else scheduled that I can see.', n.word_count = 23, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977160-053'}) SET n.claim_id = '6977160', n.note_date = '2026-02-23', n.note_type = 'Supervisor Direction', n.author_name = 'Ray Delgado', n.author_role = 'supervisor', n.text = 'see below\nFrom: Ray Delgado <ray@gbclaims.example>\nSent: Mon, Feb 23, 2026 11:51\nTo: Daniel Brooks\nSubject: RE: Claim 6977160 - Nguyen\n\nHi Daniel,\nSend a status report to State Ins Fund by March 3.\nPlease see the file for Chloe Nguyen, claim 6977160.\nWe need the IME report before the next review.\nPlease confirm the reserve is still $8,500.\n\nRegards,\nRay Delgado', n.word_count = 62, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977160-054'}) SET n.claim_id = '6977160', n.note_date = '2026-02-26', n.note_type = 'Contact - Employer', n.author_name = 'Daniel Brooks', n.author_role = 'adjuster', n.text = 'February 26 ER call, Ravi Brandt. Chloe is on PTO this week. Employer wants to know if the claim is accepted, told them it is scheduled for a hearing. Frank Nakamura says wage info coming from payroll. Asked Frank Nakamura about restr: No lifting over 20 lbs, limit bending. Employer reported it to SIF on December 14. Employer concerned about overtime coverage. Safety review done, no changes to the warehouse yet. Employer says Chloe missed 9 days last month. Told Frank Nakamura we cant discuss reserves. Asked employer for a copy of the incident report. Frank Nakamura will send the job description. Payroll has not sent the wage statement. I asked Frank Nakamura to put the light duty offer in writing.\nDOI 09DEC25, Chloe was hit at an intersection driving the company vehicle at warehouse. First seen at Upstate Hearing & Balance Center on December 12, dx strain of the low back, hip and both knees, lumbar xray no acute findings. On modified duty from Dec 10. Back to full duty from February 18. MRI ordered Jan 7, result January 18: Mild disc bulge L4-5, no stenosis. IME with Dr Fischer on February 20, report pending. Alicia Romano is the worker\'s attorney. Hearing held February 20. No wage payments, medical bills only, approx $520 paid to date. Contacts: Adjuster Daniel Brooks, ER contact Frank Nakamura, ER supervisor Ravi Brandt, treating Dr Haddad. Coverage: SIF on the risk, Rockland county, warehouse. Still waiting on IME report.', n.word_count = 245, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977160-055'}) SET n.claim_id = '6977160', n.note_date = '2026-02-26', n.note_type = 'Nurse Case Manager Note', n.author_name = 'Susan Park RN', n.author_role = 'nurse', n.text = 'Case mgr note Feb 26 (Susan): Reviewed restrictions: No lifting over 20 lbs, limit bending. Pt agreed to f/u appt 3/2. Med adherence ok (tylenol). Will update Daniel. ER contact: Frank Nakamura. Pain 3/10 per pt.\nDOI 12/9/25, Chloe Nguyen was hit at an intersection driving the company vehicle at warehouse. First seen at Upstate Hearing & Balance Center on December 12, dx strain of the low back, hip and both knees, lumbar xray no acute findings. On modified duty from 12/10/25. Back to full duty from 2/18/26.', n.word_count = 88, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977160-056'}) SET n.claim_id = '6977160', n.note_date = '2026-02-26', n.note_type = 'Work Status', n.author_name = 'Daniel Brooks', n.author_role = 'adjuster', n.text = 'Work status: Chloe is working regular duty, no issues. Restr per Dr Haddad: No lifting over 20 lbs, limit bending. Full duty release expected 3/2. Asked Dr Haddad for updated work status. Employer should have the new restr in writing.', n.word_count = 40, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977160-057'}) SET n.claim_id = '6977160', n.note_date = '2026-03-04', n.note_type = 'Medical Update', n.author_name = 'Dr Haddad', n.author_role = 'treating provider', n.text = 'Dr Haddad progress 3/4/26.\nSUBJECTIVE: pt c/o sore all over, stiff in the mornings. pain 3/10. pt states compliant w/ tx.\nOBJECTIVE: paraspinal spasm, FROM limited. MRI: mild disc bulge L4-5, no stenosis. ROM: lumbar flexion limited, extension ok.\nASSESSMENT: strain of the low back, hip and both knees, improving.\nPLAN: tylenol, activity modification. restr: lifting up to 30 lbs ok, no prolonged bending. work status: working regular duty, no issues. f/u 3/17.', n.word_count = 73, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977160-058'}) SET n.claim_id = '6977160', n.note_date = '2026-03-04', n.note_type = 'Nurse Case Manager Note', n.author_name = 'Susan Park RN', n.author_role = 'nurse', n.text = 'Case mgr note (Susan): Reviewed restrictions: Lifting up to 30 lbs ok no prolonged bending. next appt 3/20.', n.word_count = 18, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
