MERGE (n:Note {note_id: 'SYN-6977100-024'}) SET n.claim_id = '6977100', n.note_date = '2025-12-03', n.note_type = 'Worker Message', n.author_name = 'Jamal Webb', n.author_role = 'assistant', n.text = 'From: Marcus Reed <marcus@mail.example>\nSent: Wed, Dec 3, 2025 15:27\nTo: Priya Shah\nSubject: RE: Claim 6977100 - Reed\n\nhello,\nplease let me know when my next check is coming.\nplease call me back, my number is the same.\ni got a bill for $62.75, not sure if i pay it.\n\nthank you\nMarcus', n.word_count = 54, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977100-025'}) SET n.claim_id = '6977100', n.note_date = '2025-12-04', n.note_type = 'Authorization', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'See below.\nFrom: Nora (front desk) <nora@brooklynoccupationalmedicine.example>\nSent: Thu, Dec 4, 2025 14:20\nTo: Priya Shah\nSubject: RE: Claim 6977100 - Reed\n\nHi Priya,\nRestrictions remain: no gripping or lifting over 5 lbs with that hand.\nMarcus Reed is being seen for hand injury of the hand.\nAttached is the note from Marcus Reed\'s visit on 11/25/25.\nNext visit is scheduled for 12/23.\n\nRegards,\nNora (front desk)', n.word_count = 67, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977100-026'}) SET n.claim_id = '6977100', n.note_date = '2025-12-04', n.note_type = 'Compensability Review', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'Compensability 12/04/2025: Disputing for now, we need causation support, C-7 sent to the Board. No lost time to date, medical only so far. Statement taken 11/25/25. The company report matches Marcus\'s account. No witnesses per Carla Brennan. Will revisit once the medical comes in. Marcus\'s account is consistent with Dr Osei\'s first note. We will diary for the wage statement. No signs of a prior injury in the records so far.\nDOI 21NOV25, Marcus tripped on something on the floor and went down at service site. First seen at Brooklyn Occupational Medicine on 11/25/25, dx hand injury of the right hand, xray neg. On modified duty from Nov 24. Still waiting on initial medical report from Brooklyn Occupational Medicine and records from prior provider.', n.word_count = 124, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977100-027'}) SET n.claim_id = '6977100', n.note_date = '2025-12-08', n.note_type = 'Authorization', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = '12/8/25 - auth note: Approved 6 PT visits at Lakeview Physical Therapy auth # 99810.', n.word_count = 15, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977100-028'}) SET n.claim_id = '6977100', n.note_date = '2025-12-08', n.note_type = 'Work Status', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'RTW: Restr per Dr Osei: No gripping or lifting over 5 lbs with that hand. Marcus Reed did 6 days of modified duty then called out. next appt 12/26.', n.word_count = 29, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977100-029'}) SET n.claim_id = '6977100', n.note_date = '2025-12-08', n.note_type = 'Contact - Injured Worker', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = '12/8/25 - spoke with Marcus Reed by phone. Worried about the company cutting hours. Marcus asked about hiring an atty, told that is up to him, gave the Board number.', n.word_count = 30, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977100-030'}) SET n.claim_id = '6977100', n.note_date = '2025-12-08', n.note_type = 'Work Status', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'Work status: Marcus Reed is working modified duty. Restr per Dr Osei: No gripping or littfing over 5 lbs with that hand. Marcus says he isnt ready pain 4/10. next appt 12/24.', n.word_count = 32, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
