MERGE (n:Note {note_id: 'SYN-6977175-096'}) SET n.claim_id = '6977175', n.note_date = '2026-08-24', n.note_type = 'File Review', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = 'STATUS: Caleb, neck, back and wrists strain, DOI 11/11/2025. file is closed by the Board.\nMEDICAL: seeing Dr Romano at North Shore Occupational Health; pain 0/10 per last note; mild stiffness only.\nWORK: back to full duty; restr: released to full duty, no restrictions.\nPAY: no lost time, no wage payments, medical bills only.\nLEGAL: no Board activity.\nPENDING: nothing.\nPLAN: call clmt, follow up with Dr Romano, review again Sep 23.\nHISTORY: DOI Nov 11, clmt was struck by a coworker during a pallet move at facility parking area. First seen at North Shore Occupational Health on Nov 14, dx strain of the neck, back and wrists, lumbar xray no acute findings. Victor Brandt is the worker\'s attorney. No wage payments, medical bills only, approx $630 paid to date.', n.word_count = 130, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977175-097'}) SET n.claim_id = '6977175', n.note_date = '2026-08-28', n.note_type = 'Closure / Reopen', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = 'closing note Aug 28: Caleb back to full duty since Feb 19, no f/u needed. treated at North Shore Occupational Health, released, no restrictions. if clmt calls w/ a flare up, reopen and send back to Dr Romano.', n.word_count = 38, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
