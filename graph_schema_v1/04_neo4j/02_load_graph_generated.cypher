MERGE (n:Note {note_id: 'SYN-6977100-102'}) SET n.claim_id = '6977100', n.note_date = '2026-08-03', n.note_type = 'File Review', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'STATUS: cx, right hand hand injury, DOI 11/21/25. file is open, no Board date yet.\nMEDICAL: seeing Dr Osei at Brooklyn Occupational Medicine; pain 0/10 per last note; mild stiffness only.\nWORK: back to full duty; restr: released to full duty, no restrictions.\nPAY: no lost time, no wage payments, medical bills only.\nLEGAL: conciliation held 1/9/26, no agreement, Board keeps it open.\nPENDING: nothing.\nPLAN: call cx, follow up with Dr Osei, review again 8/24/26.\nHISTORY: DOI 11/21/25, cx tripped on something on the floor and went down at service site. First seen at Brooklyn Occupational Medicine on 11/25/2025, dx hand injury of the right hand, xray neg. On modified duty from 11/24/25. Back to full duty from 2/10/26. PT at Lakeview Physical Therapy started 12/9/25, 8 of 8 authorized visits used so far. Conciliation held 1/9/26. No wage payments, medical bills only, approx $1,190 paid to date. Contacts: adjuster Olivia Grant, ER contact Carla Lindqvist, ER supervisor Carla Brennan, treating Dr Osei, PT Beth Mehta at Lakeview Physical Therapy. Coverage: WESCO INSURANCE CO on the risk, Nassau county, service site.', n.word_count = 182, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977100-103'}) SET n.claim_id = '6977100', n.note_date = '2026-08-10', n.note_type = 'Supervisor Direction', n.author_name = 'Carol Jennings', n.author_role = 'supervisor', n.text = 'August 10 file review, Olivia: set reserve review for 30 days. dont close untul the Board nootice is rec\'d. call EE this week, hasnt been contacted since March 23. -CJ', n.word_count = 30, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977100-104'}) SET n.claim_id = '6977100', n.note_date = '2026-08-20', n.note_type = 'Contact - Injured Worker', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'Spoke with cx by phone. Cx states mild stiffness only. Address and phone confirmed same as file. Cx asked about hiring an attorney, told that is up to him, gave the Board number. Cx got a bill for $56.75 from Brooklyn Occupational Medicine, I told him not to pay it, we will check it. Asked him to call Carla Lindqvist about the light duty at the employer.\nDOI 11/21/25, cx tripped on something on the floor and went down at service site. First seen at Brooklyn Occupational Medicine on 11/25/25, dx hand injury of the right hand, xray neg.', n.word_count = 99, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977100-105'}) SET n.claim_id = '6977100', n.note_date = '2026-08-21', n.note_type = 'Supervisor Direction', n.author_name = 'Carol Jennings', n.author_role = 'supervisor', n.text = 'can we approve this?\nFrom: Carol Jennings <carol@gbclaims.example>\nSent: Fri, Aug 21, 2026 14:58\nTo: Olivia Grant\nSubject: RE: Claim 6977100 - Reed\n\nHi Olivia,\nLet me know if you need authority for the office viit.\nPlease see the file for Marcus Reed, claim 6977100.\nPlease confirm the reserve is stiill $12,000.\n\nThank you,\nCarol Jennings', n.word_count = 56, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
