MERGE (n:Note {note_id: 'SYN-6977163-010'}) SET n.claim_id = '6977163', n.note_date = '2025-11-14', n.note_type = 'Diary Entry', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = '11/14/25 checked eCase, nothing new Cx working w/ restrictions.', n.word_count = 9, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977163-011'}) SET n.claim_id = '6977163', n.note_date = '2025-11-14', n.note_type = 'Work Status', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = '14NOV25 - RTW: Cx is working w/ restrictions Restr per Dr Haddad: Hearing protection, avoid high-noise areas Mia did 4 days of modified duty then called out Alicia Fischer says light duty available, hours reduced Asked Dr Haddad for updated work status Cx says she isnt ready, pain 8/10 Mia worried about the commute The employer should have the new restrictions in writing.', n.word_count = 63, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977163-012'}) SET n.claim_id = '6977163', n.note_date = '2025-11-17', n.note_type = 'Work Status', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'RTW: Restr per Dr Haddad: Hearing protection, avoid high-noise areas. Asked Dr Haddad for updated work status. Cx says she isnt reay, pain 8/10.', n.word_count = 24, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977163-013'}) SET n.claim_id = '6977163', n.note_date = '2025-11-17', n.note_type = 'Contact - Employer', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'Rec\'d this today, will call.\nFrom: Alicia Fischer <alicia@orangesupplycooperative.example>\nSent: Mon, Nov 17, 2025 16:01\nTo: Olivia Grant\nSubject: RE: Claim 6977163 - Lopez\n\nHi Olivia,\nOur payroll shows cx earned about $665 a week before the injury.\nWe can offer light duty starting Nov 30, 4 hrs/day.\nPlease confirm whether the claim has been accepted.\nMia was out on light duty last week, no call to us.\n\nThank you,\nAlicia Fischer', n.word_count = 72, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977163-014'}) SET n.claim_id = '6977163', n.note_date = '2025-11-17', n.note_type = 'Medical Update', n.author_name = 'Dr Haddad', n.author_role = 'treating provider', n.text = 'Dr note rec\'d from Upstate Joint & Rehab Center: Pt c/o ringing and muffled hearing both ears. Audiogram shows high-frequency loss. Meds: OTC pain relievers prn. Pt states compliant w/ tx. C-4.2 to follow. Continue walking program.', n.word_count = 37, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977163-015'}) SET n.claim_id = '6977163', n.note_date = '2025-11-17', n.note_type = 'Supervisor Incident Statement', n.author_name = 'Carla Fischer', n.author_role = 'ER supervisor', n.text = 'SUP STMT Nov 17 - Carla Fischer. I was on shift May 1. Mia Lopez told me she has had noise exposure for years on the production floor.', n.word_count = 28, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977163-016'}) SET n.claim_id = '6977163', n.note_date = '2025-11-17', n.note_type = 'Statement / Investigation', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = '11/17/25 statement from cx: Cx states she has had noise exposure for years on the production floor at retail store around end of shift. She reported to Carla Fischer right away, told to see Upstate Joint & Rehab Center. Denies prior problems with ears. No other jobs. Cx said it was slow that morning. Supervisor statement requested from Carla Fischer. Cx understood the statement is recorded. Asked cx if she had any trouble with ears before, said no. Cx says she told Carla Fischer before the end of the shift. Pain level that day was about 8/10 per Mia.\nDOI 5/1/15, cx has had noise exposure for years on the production floor at retail store. First seen at Upstate Joint & Rehab Center on Nov 17, dx hearing loss of the ears, audiogram shows high-frequency loss. On modified duty from 11/13/25. Lena Castillo is the worker\'s attorney. Still waiting on wage statement from the employer and initial medical report from Upstate Joint & Rehab Center.', n.word_count = 165, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977163-017'}) SET n.claim_id = '6977163', n.note_date = '2025-11-17', n.note_type = 'Contact - Injured Worker', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'Spoke with Mia 11/17/25. Asked who pays for Upstate Joint & Rehab Center visits, told New Hampshire Insurance Co pays per fee schedule and to keep receipts. Taking OTC pain relievers as needed. Said she has had noise exposure for years on the production floor. Asked about mileage reimbursement, told to send C-257 with receipts. Next appt with Dr Haddad is 12/9.\nDOI 5/1/15, cx has had noise exposure for years on the production floor at retail store. First seen at Upstate Joint & Rehab Center on 11/17/25, dx hearing loss of the ears, audiogram shows high-frequency loss.', n.word_count = 98, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977163-018'}) SET n.claim_id = '6977163', n.note_date = '2025-11-17', n.note_type = 'Contact Attempt', n.author_name = 'Gita Rao', n.author_role = 'assistant', n.text = 'trjed EE again, VM full.', n.word_count = 5, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977163-019'}) SET n.claim_id = '6977163', n.note_date = '2025-11-18', n.note_type = 'Work Status', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = '11/18/25 work status: Restr per Dr Haddad: Hearing protection, avoid high-noise areas Alicia Fischer says light duty available, hours reduced Full duty release expected 12/9.', n.word_count = 25, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977163-020'}) SET n.claim_id = '6977163', n.note_date = '2025-11-19', n.note_type = 'Contact - Provider', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'Rec\'d this today, will call.\nFrom: Nora (front desk) <nora@upstatejointrehabcenter.example>\nSent: Wed, Nov 19, 2025 17:23\nTo: Olivia Grant\nSubject: RE: Claim 6977163 - Lopez\n\nHi Olivia,\nAttached is the note from Mia Lopez\'s visit on 11/17/25.\nWork status: working w/ restrictions.\nOur billing for $258.00 was sent on 11/17/25, please confirm receipt.\n\nThank you,\nNora (front desk)', n.word_count = 58, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977163-021'}) SET n.claim_id = '6977163', n.note_date = '2025-11-19', n.note_type = 'Diary Entry', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'Diary 11/19/25: Nothing new from the employer or Upstate Joint & Rehab Center. Cx working modified duty. No concerns re: Compliance. Will call Upstate Joint & Rehab Center if nothing by 11/28/25.', n.word_count = 32, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977163-022'}) SET n.claim_id = '6977163', n.note_date = '2025-11-21', n.note_type = 'Contact - Employer', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'FYI\nFrom: Alicia Fischer <alicia@orangesupplycooperative.example>\nSent: Fri, Nov 21, 2025 7:28\nTo: Olivia Grant\nSubject: RE: Claim 6977163 - Lopez\n\nHi Olivia,\nIncident report was sent on 11/14/25.\nOur payroll shwos cx earned aobut $665 a weak before the injury.\n\nRegards,\nAlicia Fischer', n.word_count = 43, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977163-023'}) SET n.claim_id = '6977163', n.note_date = '2025-11-21', n.note_type = 'Contact Attempt', n.author_name = 'Gita Rao', n.author_role = 'assistant', n.text = 'left message for Dr Haddad\'s office C-4.2 rec\'d -GR', n.word_count = 9, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977163-024'}) SET n.claim_id = '6977163', n.note_date = '2025-11-25', n.note_type = 'Contact - Injured Worker', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'Spoke with cx by phone. Cx states ringing and muffled hearing both ears. Trouble sleeping because of the pain. Asked her to call Alicia Fischer about the light duty at the employer.', n.word_count = 32, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977163-025'}) SET n.claim_id = '6977163', n.note_date = '2025-11-25', n.note_type = 'Worker Message', n.author_name = 'Gita Rao', n.author_role = 'assistant', n.text = 'forwarding to file -GR\nFrom: Mia Lopez <mia@mail.example>\nSent: Tue, Nov 25, 2025 17:52\nTo: Olivia Grant\nSubject: RE: Claim 6977163 - Lopez\n\nHello\nmy boss Carla Fischer has not given me light duty yet.\ni went to Upstate Joint & Rehab Center on 11/17/2025.\nplease call me back, my number is the same.\n\nthank you\nMia', n.word_count = 57, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977163-026'}) SET n.claim_id = '6977163', n.note_date = '2025-11-26', n.note_type = 'Compensability Review', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'Decision on claim 6977163: Disputing for now, we need causation support, C-7 sent to the Board. No lost time to date, medical only so far. Statement taken 11/17/25. The employer report matches cx\'s account. No witnesses per Carla Fischer. Cx reported late, notice issue. Will revisit once the medical comes in. Cx\'s account is consistent with Dr Haddad\'s first note. We will diary for the wage statement. No signs of a prior injury in the records so far.\nDOI 5/1/15, cx has had noise exposure for years on the production floor at retail store. First seen at Upstate Joint & Rehab Center on 11/17/25, dx hearing loss of the ears, audiogram shows high-frequency loss. On modified duty from 11/13/25. Lena Castillo is the worker\'s attorney. Still waiting on records from prior provider.', n.word_count = 132, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977163-027'}) SET n.claim_id = '6977163', n.note_date = '2025-11-28', n.note_type = 'Diary Entry', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = '11/28/25 diary - no change. Mia working w/ restrictions.', n.word_count = 9, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977163-028'}) SET n.claim_id = '6977163', n.note_date = '2025-11-28', n.note_type = 'Contact - Provider', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = '11/28/25 - Upstate Joint & Rehab Center called. Asked Dr Haddad for an', n.word_count = 13, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = true;
MERGE (n:Note {note_id: 'SYN-6977163-029'}) SET n.claim_id = '6977163', n.note_date = '2025-11-28', n.note_type = 'Contact - Injured Worker', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = '11/28/25 - spoke with cx by phone. Taking OTC pain relievers as needed. Cx confirmed DOI 5/1/15 at retail store. Cx says she is not sure she can do the light duty offered, I told her to talk to Dr Haddad.', n.word_count = 41, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977163-030'}) SET n.claim_id = '6977163', n.note_date = '2025-11-28', n.note_type = 'Contact - Provider', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'Upstate Joint & Rehab Center called. Dr Haddad wants Mia to continue walking program.', n.word_count = 14, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977163-031'}) SET n.claim_id = '6977163', n.note_date = '2025-11-28', n.note_type = 'Contact - Employer', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'Need to respond to this.\nFrom: Alicia Fischer <alicia@orangesupplycooperative.example>\nSent: Fri, Nov 28, 2025 15:51\nTo: Olivia Grant\nSubject: RE: Claim 6977163 - Lopez\n\nHi Olivia,\nOur insurer is New Hampshire Insurance Co, adjuster is Olivia.\nMia Lopez has not returned our calls about the modified duty offer.\nWe can offer light duty starting 12/8/25, 4 hrs/day.\nPlease send us the restrictions in writing.\n\nThank you,\nAlicia Fischer', n.word_count = 68, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
