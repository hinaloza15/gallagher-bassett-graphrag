MERGE (n:Note {note_id: 'SYN-6977178-059'}) SET n.claim_id = '6977178', n.note_date = '2026-03-30', n.note_type = 'Worker Message', n.author_name = 'Gita Rao', n.author_role = 'assistant', n.text = 'email from Julian calling about my claim 6977178. can someone tell me if Brooklyn Occupational Medicine got paid. my boss Joan Brennan keeps asking when i can come back.', n.word_count = 29, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977178-060'}) SET n.claim_id = '6977178', n.note_date = '2026-03-31', n.note_type = 'Worker Message', n.author_name = 'Gita Rao', n.author_role = 'assistant', n.text = 'FYI\nFrom: Julian Bell <julian@mail.example>\nSent: Tue, Mar 31, 2026 9:44\nTo: Priya Shah\nSubject: RE: Claim 6977178 - Bell\n\nhi,\nmy boss Joan Brennan has not given me light duty yet.\nthis is Julian Bell, claim 6977178.\ni got a bill for $130, not sure if i pay it.\nplease call me back, my number is the same.\n\n\nJulian', n.word_count = 60, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977178-061'}) SET n.claim_id = '6977178', n.note_date = '2026-03-31', n.note_type = 'Contact - Employer', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = '3/31/26 ER call, Joan Brennan. Julian Bell is on sick time. The company wants to know if the claim is accepted, told them it is open. Joan Brennan says Julian has been on time lately. Joan Nakamura will send the job description. I asked Joan Nakamura to put the light duty offer in writing. HR to follow up friday.\nDOI 12/16/25, Julian slipped on ice in the lot and went down at service site. First seen at Brooklyn Occupational Medicine on 12/19/25, dx contusion of the left hip/buttock, xray neg for fracture.', n.word_count = 92, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
