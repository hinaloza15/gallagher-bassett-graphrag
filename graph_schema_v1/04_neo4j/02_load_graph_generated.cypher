MERGE (n:Chunk {chunk_id: 'SYN-6977156-045-C01'}) SET n.parent_id = 'SYN-6977156-045', n.parent_kind = 'Note', n.position = 1, n.text = '02/19/2026 pmt note (Marcus): Direct deposit set up for Emma. paid $701.00/wk.', n.char_start = 0, n.char_end = 78, n.word_count = 12;
