MERGE (n:Chunk {chunk_id: 'SYN-6977140-017-C01'}) SET n.parent_id = 'SYN-6977140-017', n.parent_kind = 'Note', n.position = 1, n.text = 'no activity diary +30. will call Rochester Work Injury Clinic if nothing by December 24.', n.char_start = 0, n.char_end = 88, n.word_count = 15;
MERGE (n:Chunk {chunk_id: 'SYN-6977140-018-C01'}) SET n.parent_id = 'SYN-6977140-018', n.parent_kind = 'Note', n.position = 1, n.text = 'forwarding to file\nFrom: Alicia (front desk) <alicia@rochesterworkinjuryclinic.example>\nSent: Mon, Dec 15, 2025 9:41\nTo: Maya Patel\nSubject: RE: Claim 6977140 - Patel\n\nHi Maya,\nWe are requesting 6 PT visits, please advise.\nWork status: working regular duty, no issues.\nRestrictions remain: no overhead reaching, no lifting over 10 lbs.\nPlease confirm authorization for the office visit.\n\nRegards,\nAlicia (front desk)', n.char_start = 0, n.char_end = 416, n.word_count = 61;
