MERGE (n:Note {note_id: 'SYN-6977175-055'}) SET n.claim_id = '6977175', n.note_date = '2026-02-06', n.note_type = 'Bill Question', n.author_name = 'Gita Rao', n.author_role = 'assistant', n.text = 'forwarding to file. -GR\nFrom: Mei (front desk) <mei@northshoreoccupationalhealth.example>\nSent: Fri, Feb 6, 2026 17:06\nTo: Maya Patel\nSubject: RE: Claim 6977175 - Ward\n\nHi Maya,\nWork status: working regular duty, no issues.\nOur billing for $197.00 was sent on 02/05/2026, please confirm receipt.\nRestrictions remain: lifting up to 30 lbs ok, no prolonged bending.\n\nRegards,\nMei (front desk)', n.word_count = 59, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977175-056'}) SET n.claim_id = '6977175', n.note_date = '2026-02-06', n.note_type = 'Medical Update', n.author_name = 'Dr Romano', n.author_role = 'treating provider', n.text = 'OFFICE NOTE Feb 6 (Dr Romano):\nSUBJECTIVE: pt c/o pain in the neck, worse by end of shift. pain 5/10. pt states compliant w/ tx.\nOBJECTIVE: guarded flexion, strength 5/5. lumbar xray no acute findings. ROM: lumbar flexion limited, extension ok.\nASSESSMENT: strain of the neck, back and wrists, no change.\nPLAN: PT, home exercise program. restr: lifting up to 30 lbs ok, no prolonged bending. work status: working regular duty, no issues. f/u 2/19.', n.word_count = 75, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
