MERGE (n:Chunk {chunk_id: 'SYN-6977140-025-C01'}) SET n.parent_id = 'SYN-6977140-025', n.parent_kind = 'Note', n.position = 1, n.text = 'December 29 therapy session #3 - Hector Osei, PT. Tolerated tx well. Pt reports upper arm pain, limited overhead reach. Pain 5/10 pre-tx, 5/10 after. Did pendulums, scapular stabilization, theraband rows + ice. Progressing w/ HEP. ROM: ROM improving, still guarded overhead. Strength 4/5. Goal: Reach overhead without pain. Pt asked if more visits will be approved. Reviewed HEP, pt demonstrates correctly. Pt arrived early, no problems. Cont plan of care.', n.char_start = 0, n.char_end = 456, n.word_count = 71;
