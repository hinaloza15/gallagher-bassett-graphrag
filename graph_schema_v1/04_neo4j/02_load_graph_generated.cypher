MERGE (n:Note {note_id: 'SYN-6977182-098'}) SET n.claim_id = '6977182', n.note_date = '2026-08-19', n.note_type = 'File Review', n.author_name = 'Marcus Hill', n.author_role = 'adjuster', n.text = 'STATUS: Aaron, rt forearm strain, DOI 10/20/2025. file is closed per the Board.\nMEDICAL: seeing DR Doyle at Rochester Work Injury Clinic; pain 0/10 per last note; no complaints.\nWORK: working regular duty, no issues; restr: released to full duty, no restrictions.\nPAY: no lost time, no wage payments, medical bills only.\nLEGAL: no Board activity.\nPENDING: nothing.\nPLAN: continue to monitor, next review September 2.\nHISTORY: DOI 10/20/2025, IW was moving a heavy tote and felt something give at operations facility. First seen at Rochester Work Injury Clinic on 10/27/2025, dx strain of the rt forearm, xray neg. No wage payments, medical bills only, approx $630 paid to date. Contacts: adjuster Marcus Hill, ER contact Paula Nakamura, ER supervisor Lena Brennan, treating DR Doyle.', n.word_count = 125, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977182-099'}) SET n.claim_id = '6977182', n.note_date = '2026-08-24', n.note_type = 'Closure / Reopen', n.author_name = 'Marcus Hill', n.author_role = 'adjuster', n.text = '08/24/2026 - closing review: IW back to full duty since 02/09/2026, no f/u needed. board closed case, nothing open. no activity in 60 days, closing diary. treated at Rochester Work Injury Clinic, released, no restrictions. if IW calls w/ a flare up, reopen and send back to DR Doyle. all bills paid, nothing pending. final med report rec\'d, strain resolved. total paid on file approx $8,500.\nDOI 10/20/2025, IW was moving heavy tote and felt something give at operations facility. first seen at Rochester Work Injury Clinic on 10/27/2025, dx strain of rt forearm, xray neg. No wage payments, medical bills only, approx $630 paid to date. Contacts: adjuster Marcus Hill, ER contact Paula Nakamura, ER supervisor Lena Brennan, treating DR Doyle. Coverage: Wegmans Food Markets on the risk, Monroe county, operations facility.', n.word_count = 133, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977194-004'}) SET n.claim_id = '6977194', n.note_date = '2025-11-19', n.note_type = 'Prior Claims Check', n.author_name = 'Jamal Webb', n.author_role = 'assistant', n.text = 'prrior claims check 11/19/25 - nothing under Bailey. -Jamal', n.word_count = 9, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977194-005'}) SET n.claim_id = '6977194', n.note_date = '2025-11-19', n.note_type = 'First Report Summary', n.author_name = 'Daniel Brooks', n.author_role = 'adjuster', n.text = 'November 19 - new file, Naomi Bailey reported injury DOI June 27. Naomi says she got grabbed buy another person during a transfer at warehouse. Sx: Knee swelling, feels unstable on stairs. Claim # 6977194, Warren county.', n.word_count = 37, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977194-006'}) SET n.claim_id = '6977194', n.note_date = '2025-11-20', n.note_type = 'Contact - Injured Worker', n.author_name = 'Daniel Brooks', n.author_role = 'adjuster', n.text = 'November 20 - spoke with Naomi by phone. Back to full duty. Naomi confirmed DOI June 29 at warehouse. Address and phone confirmed same as file. Asked if Daniel is still the adjuster, confirmed. Next appt with Dr Fischer is 11/24. Naomi got a bill for $84.00 from Capital Region Occupational Health, I told her not to pay it, we will check it. Asked her to call Frank Kowalski about the light duty at employer.\nDOI June 29, Naomi got grabbed by another person during a transfer at warehouse.', n.word_count = 89, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977194-007'}) SET n.claim_id = '6977194', n.note_date = '2025-11-20', n.note_type = 'Contact - Employer', n.author_name = 'Daniel Brooks', n.author_role = 'adjuster', n.text = 'Can we approve this?\nFrom: Frank Kowalski <frank@albanypublicworks.example>\nSent: Thu, Nov 20, 2025 9:26\nTo: Daniel Brooks\nSubject: RE: Claim 6977194 - Bailey\n\nHi Daniel,\nJob description attached.\nIncident report was sent on November 22.\n\nThank you,\nFrank Kowalski', n.word_count = 39, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977194-008'}) SET n.claim_id = '6977194', n.note_date = '2025-11-21', n.note_type = 'Contact - Provider', n.author_name = 'Daniel Brooks', n.author_role = 'adjuster', n.text = 'Spoke with front desk at Capital Region Occupational Health, they will fax the note. Dr Fischer\'s office says next appt 11/24. Asked Dr Fischer for an updated work status, fax request sent. Capital Region Occupational Health billing called about a denied visit, referred to State Ins Fund. Capital Region Occupational Health says Naomi Bailey no showed the last appt. Need the C-4.2 from Dr Fischer. Dr Fischer wants Naomi to continue quad sets, straight leg raises, step-ups, stationary bike. Capital Region Occupational Health sent a bill for $234.00, forwarded to bill review.', n.word_count = 92, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977194-009'}) SET n.claim_id = '6977194', n.note_date = '2025-11-24', n.note_type = 'Worker Message', n.author_name = 'Jamal Webb', n.author_role = 'assistant', n.text = 'text msg rec\'d 11/24/25 from Naomi: my boss Dev Alvarez keeps asking when i can come back.', n.word_count = 17, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977194-010'}) SET n.claim_id = '6977194', n.note_date = '2025-11-24', n.note_type = 'Imaging Result', n.author_name = 'Daniel Brooks', n.author_role = 'adjuster', n.text = 'From: Tom (front desk) <tom@capitalregionoccupationalhealth.example>\nSent: Mon, Nov 24, 2025 15:45\nTo: Daniel Brooks\nSubject: RE: Claim 6797194 - Bailey\n\nHi Daniel,\nRestrictions remain: no standing over 2 hrs, no ladders, no kneeling.\nWe are requesting 6 PT visits, please advise.\nWork status: back to full duty.\nNext visit is scheduled for 12/15.\n\nRegards,\nTom (front desk)', n.word_count = 57, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977194-011'}) SET n.claim_id = '6977194', n.note_date = '2025-11-24', n.note_type = 'Statement / Investigation', n.author_name = 'Daniel Brooks', n.author_role = 'adjuster', n.text = 'November 24 statement from Naomi: Naomi states she got grabbed by another person during a transfer at warehouse around 10 am. No one saw it, a coworker came over after. Denies prior problems with knee. Naomi said it was end of a long shift. Photos requested, none were taken. Supervisor statement requested from Dev Alvarez. Naomi understood the statement is recorded. Asked Naomi if she had any trouble with knee before, said no. Naomi drove home, went to Capital Region Occupational Health the next morning. Asked about any activities outside work, nothing unusual.\nDOI Jun 29, Naomi got grabbed by another person during a transfer at warehouse. First seen at Capital Region Occupational Health on November 24, dx strain of the right knee, xray neg for fracture. Still waiting on wage statement from employer and initial medical report from Capital Region Occupational Health.', n.word_count = 143, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977194-012'}) SET n.claim_id = '6977194', n.note_date = '2025-11-24', n.note_type = 'Contact - Injured Worker', n.author_name = 'Daniel Brooks', n.author_role = 'adjuster', n.text = 'Naomi Bailey called in re: Claim 6977194. Said she got grabbed by another person during a transfer. Trouble sleeping because of the pain. Still hard to stand or walk for long. next appt 12/12.', n.word_count = 34, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977194-013'}) SET n.claim_id = '6977194', n.note_date = '2025-11-24', n.note_type = 'Supervisor Incident Statement', n.author_name = 'Dev Alvarez', n.author_role = 'ER supervisor', n.text = 'Statement 11/24/25 from Dev Alvarez at Albany Public Works: I was on shift 6/29/25. Naomi told me she got grabbed by another person during a transfer. I did not see it happen. No other witnesses that i know of. Location was warehouse. Incident form given to Frank Kowalski. We have a camera but not sure it covers warehouse. No prior complaints that i recall. Naomi finished the shift but was favoring it. I offered to call an ambuoanxe, she said no. The floor was dry that day as far as i know. Naomi has been reliable, no attendance issues.\nDOI 29JUN25, Naomi got grabbed by another person during a transfer at warehouse. First seen at Capital Region Occupational Health on 11/24/25, dx strain of the right knee, xray neg for fracture. Still waiting on wage statement from the employer and initial medical report from Capital Region Occupational Health.', n.word_count = 148, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977194-014'}) SET n.claim_id = '6977194', n.note_date = '2025-11-24', n.note_type = 'Contact - Provider', n.author_name = 'Daniel Brooks', n.author_role = 'adjuster', n.text = 'November 24 called Capital Region Occupational Health for records 5-7 business days. Dr Fischer\'s office says next appt 12/15. Capital Region Occupational Health billing called about a deenied visit referred to State Insurance Fund. Need the C-4.2 from Dr Fischer.', n.word_count = 40, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
