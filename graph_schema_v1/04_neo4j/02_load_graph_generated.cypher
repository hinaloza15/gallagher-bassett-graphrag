MERGE (n:Note {note_id: 'SYN-6977160-014'}) SET n.claim_id = '6977160', n.note_date = '2025-12-15', n.note_type = 'Supervisor Incident Statement', n.author_name = 'Ravi Brandt', n.author_role = 'ER supervisor', n.text = 'Statement 12/15/2025 from Ravi Brandt at City Operations Department: I was on shift 12/09/2025. Chloe told me she was hit at an intersection driving the company vehicle. I did not see it happen. Incident form given to Frank Nakamura. We have a camera but not sure it covers warehouse. No prior complaints that i recall. Chloe finished the shift but was favoring it. I offered to call an ambulance, she said no. The floor was dry that day as far as i know. Chloe has been reliable, no attendance issues.\nDOI 12/09/2025, Chloe was hit at an intersection driving the company vehicle at warehouse. First seen at Upstate Hearing & Balance Center on 12/12/2025, dx strain of the low back, hip and both knees, lumbar xray no acute findings. On modified duty from 12/10/2025. Alicia Romano is the worker\'s attorney. Still waiting on wage statement from the employer and initial medical report from Upstate Hearing & Balance Center.', n.word_count = 158, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
