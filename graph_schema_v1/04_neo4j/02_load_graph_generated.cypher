MERGE (n:Chunk {chunk_id: 'SYN-6977194-020-C01'}) SET n.parent_id = 'SYN-6977194-020', n.parent_kind = 'Note', n.position = 1, n.text = '11-27-2025 work status: Naomi Bailey is working regular duty, no issues Full duty release expected 12/15 Asked Dr Fischer four updated work status.', n.char_start = 0, n.char_end = 147, n.word_count = 23;
MERGE (n:Chunk {chunk_id: 'SYN-6977194-021-C01'}) SET n.parent_id = 'SYN-6977194-021', n.parent_kind = 'Note', n.position = 1, n.text = 'Compensability accepting as work related, employer confirms Naomi was on shift. Naomi reported late, notice issue. No signs of a prior injury in the records so far.', n.char_start = 0, n.char_end = 164, n.word_count = 27;
MERGE (n:Chunk {chunk_id: 'SYN-6977194-022-C01'}) SET n.parent_id = 'SYN-6977194-022', n.parent_kind = 'Note', n.position = 1, n.text = 'Rec\'d this toady, will call.\nFrom: Mei (front desk) <mei@capitalregionoccupationalhealth.example>\nSent: Fri, Nov 28, 2025 16:04\nTo: Daniel Brooks\nSubject: RE: Claim 6971794 - Bailey\n\nHi Daniel,\nNaomi Bailey is being seen for strain of the knee.\nWork status: working regular duty, no issues.\n\nThank you,\nMei (front desk)', n.char_start = 0, n.char_end = 319, n.word_count = 49;
