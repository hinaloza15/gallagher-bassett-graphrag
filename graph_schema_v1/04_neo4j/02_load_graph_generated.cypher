MERGE (n:Chunk {chunk_id: 'SYN-6977144-052-C01'}) SET n.parent_id = 'SYN-6977144-052', n.parent_kind = 'Note', n.position = 1, n.text = 'From: Paula Nakamura <paula@riversidefoodservices.example>\nSent: Thu, Feb 19, 2026 12:20\nTo: Priya Shah\nSubject: RE: Claim 6977144 - Shah\n\nHi Priya,\nAttached is the wage statement for Priya Shah.\nIncident report was sent on 1/1/26.\n\nThanks,\nPaula Nakamura', n.char_start = 0, n.char_end = 255, n.word_count = 38;
MERGE (n:Chunk {chunk_id: 'SYN-6977144-053-C01'}) SET n.parent_id = 'SYN-6977144-053', n.parent_kind = 'Note', n.position = 1, n.text = 'Spoke with Priya Shah 2/19/26. Priya got a bill for $241 from Empire Physical Medicine I told her not to pay it we will chheck it. next appt 2/28.', n.char_start = 0, n.char_end = 146, n.word_count = 29;
MERGE (n:Chunk {chunk_id: 'SYN-6977144-054-C01'}) SET n.parent_id = 'SYN-6977144-054', n.parent_kind = 'Note', n.position = 1, n.text = 'From: Paula Nakamura <paula@riversidefoodservices.example>\nSent: Fri, Feb 20, 2026 17:10\nTo: Priya Shah\nSubject: RE: Claim 6977144 - Shah\n\nHi Priya,\nPlease confirm whether the claim has been accepted.\nAttached is the wage statement for Priya Shah.\nPriya Shah has not returned our calls about the modified duty offer.\nOur insurer is Wegmans Food Markets, adjuster is Priya.\n\nThanks,\nPaula Nakamura', n.char_start = 0, n.char_end = 396, n.word_count = 61;
MERGE (n:Chunk {chunk_id: 'SYN-6977144-055-C01'}) SET n.parent_id = 'SYN-6977144-055', n.parent_kind = 'Note', n.position = 1, n.text = 'Called Priya Shah, reached on 2nd try. Priya states pain in the neck and low back, worse by end of shift. Asked about the status of the claim, explained it is open. Working w/ restrictions. Priya confirmed DOI 12/26/25 at service site. Address and phone confirmed same as file. Priya got a bill for $43.00 from Empire Physical Medicine, I told her not to pay it, we will check it. Will call back.\nDOI 12/26/25, Priya tripped on something on the floor and went down at service site.', n.char_start = 0, n.char_end = 481, n.word_count = 88;
MERGE (n:Chunk {chunk_id: 'SYN-6977144-056-C01'}) SET n.parent_id = 'SYN-6977144-056', n.parent_kind = 'Note', n.position = 1, n.text = 'Feb 20 therapy session #8 - Victor Haddad, PT. Tolerated tx well. Pt reports pain in the neck and low back, worse by end of shift. Pain 2/10 pre-tx, 1/10 after. Did core stabilization, hamstring stretching, bridging + ice. ROM: Lumbar flexion limited, extension ok. Goal: Lift 30 lbs floor to waist. Reviewed HEP, pt demonstrates correctly. Pt arrived early, no problems. Auth pending w/ WEGMANS FOOD MARKETS.', n.char_start = 0, n.char_end = 409, n.word_count = 68;
MERGE (n:Chunk {chunk_id: 'SYN-6977144-057-C01'}) SET n.parent_id = 'SYN-6977144-057', n.parent_kind = 'Note', n.position = 1, n.text = 'Subject: Status Report - Claim 6977144 - Priya Shah\nHi Paula,\n\nPlease see the update below on Priya Shah\'s claim (Riverside Food Services, DOI 12/26/25, service site). I have kept the history short, call me if you want more.\n\nCLAIM HISTORY\nDOI 12/26/25, Priya Shah tripped on something on the floor and went down at service site. First seen at Empire Physical Medicine on 12/30/25, dx contusion of the neck and low back, lumbar xray no acute findings. On modified duty from 12/29/25. Back to full duty from 2/22/26. PT at Riverbend Physical Therapy started 1/12/26, 8 of 12 authorized visits used so far. MRI ordered 1/26/26, result 2/7/26: mild disc bulge L4-5, no stenosis. No wage payments, medical bills only, approx $1,025 paid to date. Contacts: adjuster Priya Shah, ER contact Paula Nakamura, ER supervisor Tasha Okafor, treating Dr Okafor, PT Victor Haddad at Riverbend Physical Therapy. Coverage: Wegmans Food Markets on the risk, Monroe county, service site.', n.char_start = 0, n.char_end = 968, n.word_count = 159;
MERGE (n:Chunk {chunk_id: 'SYN-6977144-057-C02'}) SET n.parent_id = 'SYN-6977144-057', n.parent_kind = 'Note', n.position = 2, n.text = 'CURRENT MEDICAL: treating with Dr Okafor at Empire Physical Medicine. Pain was 2/10 at the last visit (2/9/26) and Priya reports sore all over, stiff in the mornings. Restrictions: no lifting over 20 lbs, limit bending.\nWORK STATUS: Priya is working regular duty, no issues.\nBENEFITS: no lost time, no wage benefits due at this point. Medical bills are being paid per the fee schedule.\nLEGAL: no hearings or conciliation set, nothing from the Board that needs a response.\nCONTACTS: adjuster Priya Shah, ER contact Paula Nakamura (Riverside Food Services), ER supervisor Tasha Okafor, treating Dr Okafor at Empire Physical Medicine. PT is Victor Haddad at Riverbend Physical Therapy.\nCOVERAGE: Wegmans Food Markets is on the risk. Claim is in Monroe county, injury location service site. No prior claims found on Priya.\nOUTSTANDING: nothing.\nRESERVES: no change recommended right now, med reserve $4,500. We will revisit after the next medical report.\nPLAN: continue to monitor, speak with Priya and the company again this month, and send the next update by Mar 25. Please let me know if you need anything else in the meantime.\n\nThanks,\nPriya Shah', n.char_start = 970, n.char_end = 2116, n.word_count = 187;
MERGE (n:Chunk {chunk_id: 'SYN-6977144-058-C01'}) SET n.parent_id = 'SYN-6977144-058', n.parent_kind = 'Note', n.position = 1, n.text = '2/23/26 - RTW: Restr per Dr Okafor: No lifting over 20 lbs, limit bending. The company should have the new restrictions in writing.', n.char_start = 0, n.char_end = 131, n.word_count = 23;
MERGE (n:Chunk {chunk_id: 'SYN-6977144-059-C01'}) SET n.parent_id = 'SYN-6977144-059', n.parent_kind = 'Note', n.position = 1, n.text = 'Dr Okafor progress February 25.\nSUBJECTIVE: pt c/o pain in the neck and low back, worse by end of shift. pain 1/10. pt states compliant w/ tx.\nOBJECTIVE: paraspinal spasm, FROM limited. MRI: mild disc bulge L4-5, no stenosis. ROM: lumbar flexion limited, extension ok.\nASSESSMENT: contusion of the neck and low back, improving.\nPLAN: PT, home exercise program. restr: no lifting over 20 lbs, limit bending. work status: working regular duty, no issues. f/u 3/18.', n.char_start = 0, n.char_end = 462, n.word_count = 76;
MERGE (n:Chunk {chunk_id: 'SYN-6977144-060-C01'}) SET n.parent_id = 'SYN-6977144-060', n.parent_kind = 'Note', n.position = 1, n.text = 'PT visit 9/12 Feb 25 (Riverbend Physical Therapy) Pt reports pain in the neck and low back, worse by end of shift Did core stabilization, hamstring stretching, bridging + ice Progressing w/ HEP Missed last appt, rescheduled ROM: Lumbar flexion limited, extension ok Reviewed HEP, pt demonstrates correctly Will reassess at visit 12.', n.char_start = 0, n.char_end = 332, n.word_count = 53;
