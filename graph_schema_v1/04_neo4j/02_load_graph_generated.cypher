MERGE (n:Chunk {chunk_id: 'SYN-6977175-036-C01'}) SET n.parent_id = 'SYN-6977175-036', n.parent_kind = 'Note', n.position = 1, n.text = 'can we approve this?\nFrom: Carla (front desk) <carla@northshoreoccupationalhealth.example>\nSent: Mon, Dec 15, 2025 15:11\nTo: Maya Patel\nSubject: RE: Claim 6977175 - Ward\n\nHi Maya,\nWe are requesting 6 PT visits, please advise.\nAttached is the note from Caleb Ward\'s visit on 12/10/2025.\nNext visit is scheduled for 1/5.\n\nThank you,\nCarla (front desk)', n.char_start = 0, n.char_end = 349, n.word_count = 55;
