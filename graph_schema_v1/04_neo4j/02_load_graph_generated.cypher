MERGE (n:Note {note_id: 'SYN-6977175-052'}) SET n.claim_id = '6977175', n.note_date = '2026-01-19', n.note_type = 'Attorney Correspondence', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = 'From: Victor Brandt <victor@brandtlaw.example>\nSent: Mon, Jan 19, 2026 7:18\nTo: Maya Patel\nSubject: RE: Claim 6977175 - Ward\n\nHi Maya,\nMy client has not been paid for xray, please advise.\nWe will be askinng for a hearing if there is no response within 10 days.\nThe nothing is still outstanding on our end.\n\nThanks,\nVictor Brandt', n.word_count = 57, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
