MERGE (n:Chunk {chunk_id: 'SYN-6977121-089-C01'}) SET n.parent_id = 'SYN-6977121-089', n.parent_kind = 'Note', n.position = 1, n.text = 'forwaridng to file.\nFrom: Paula (front desk) <paula@capitalregionoccupationalhealth.example>\nSent: Wed, Jul 22, 2026 9:28\nTo: Maya Patel\nSubject: RE: Claim 6977121 - Morgan\n\nHi Maya,\nRestrictions remain: released to full duty, no restrictions.\nOur billing for $306.50 was sent on 03/26/2026, please confirm receipt.\n\nThank you,\nPaula (front desk)', n.char_start = 0, n.char_end = 346, n.word_count = 49;
