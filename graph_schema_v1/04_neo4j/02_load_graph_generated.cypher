MERGE (n:Note {note_id: 'SYN-6977144-007'}) SET n.claim_id = '6977144', n.note_date = '2025-12-30', n.note_type = 'Contact - Employer', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'ER call, Tasha Okafor. Asked Paula Nakamura about restrictions: No lifting over 10 lbs, no repeated bending. Safety review done, no changes to the service site yet. Paula Nakamura will send the job description. Payroll has not sent the wage statement. I asked Paula Nakamura to put the light duty offer in writing. No further questions.\nDOI 12/26/25, Priya Shah tripped on something on the floor and went down at service site. First seen at Empire Phys Med on December 30, dx contusion of the neck and low back, lumbar xray no acute findings.', n.word_count = 94, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977144-008'}) SET n.claim_id = '6977144', n.note_date = '2025-12-31', n.note_type = 'Medical Update', n.author_name = 'Dr Okafor', n.author_role = 'treating provider', n.text = 'Dr note rec\'d Dec 31 from Empire Physical Medicine:\nSUBJECTIVE: pt c/o neck and low back sore and stiff. pain 4/10.\nOBJECTIVE: TTP lumbar paraspinals, neg SLR. lumbar xray no acute findings. ROM: lumbar flexion limited, extension ok.\nASSESSMENT: contusion of the neck and low back, no change.\nPLAN: tylenol, activity modification. restr: no lifting over 10 lbs, no repeated bending. work status: working modified duty. f/u 1/20.', n.word_count = 68, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977144-009'}) SET n.claim_id = '6977144', n.note_date = '2025-12-31', n.note_type = 'Diary Entry', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = '12/31/25 diary - no change. Waiting on the initial medical report from Empire Physical Medicine.', n.word_count = 15, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
