MERGE (n:Note {note_id: 'SYN-6977100-004'}) SET n.claim_id = '6977100', n.note_date = '2025-11-24', n.note_type = 'First Report Summary', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'First report: Marcus Reed / Hudson Public Services, DOI 11/21/25, Wesco Insurance Co. Marcus says he tripped on something on the floor and went down at service site. Reported to Carla Brennan same day. Sx: Hand swelling, pain w/ gripping. Treating at Brooklyn Occ Medicine with Dr Osei. The company sent the C-2F, rec\'d 11/25/25. Dx per first visit: Hand injury. No prior claims that I can see. Marcus still working, light tasks only. We have not received any wage info yet. The company says Marcus has worked there a while, no prior injuries per Carla Lindqvist. We need the job description and wage statement from the company. Claim # 6977100, Nassau county. Wage info still needed.\nDOI 11/21/25, Marcus tripped on something on the floor and went down at service site. On modified duty from 11/24/25.', n.word_count = 137, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
