MERGE (n:Note {note_id: 'SYN-6977144-024'}) SET n.claim_id = '6977144', n.note_date = '2026-01-12', n.note_type = 'Contact - Injured Worker', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'Spoke with Priya Shah by phone. Asked about the status of the claim explained it is open no Board date yet. Taking tylenol as needed. Said she tripped on something on the floor and went down. Asked about mileage reimbursement told to send C-257 with receipts. Address and phone confirmed same as file. Next appt with Dr Okafor is 1/20. Priya got a bill four $176.00 from Empire Physical Medicine I told her not to pay it we will check it. Advised to keep appts.', n.word_count = 85, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
