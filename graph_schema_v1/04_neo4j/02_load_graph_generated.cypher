MERGE (n:Note {note_id: 'SYN-6977140-044'}) SET n.claim_id = '6977140', n.note_date = '2026-01-20', n.note_type = 'Authorization', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = 'auth: approved 12 PT visits at Lakeview Physical Therapy, auth # 14466 Dr Brennan requested more PT, we are checking against guideline', n.word_count = 22, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977140-045'}) SET n.claim_id = '6977140', n.note_date = '2026-01-20', n.note_type = 'Medical Update', n.author_name = 'Dr Brennan', n.author_role = 'treating provider', n.text = 'Dr Brennan progress 01/20/2026.\nSUBJECTIVE: pt c/o sore bicep area, weak lifting. pain 4/10. pt states compliant w/ tx.\nOBJECTIVE: mild swelling, strength 4/5. xray neg. ROM: ROM improving, still guarded overhead.\nASSESSMENT: strain of the left upper arm, no change.\nPLAN: PT, home exercise program. restr: no overhead work, lifting to 15 lbs. work status: back to full duty. f/u 2/6.', n.word_count = 62, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977140-046'}) SET n.claim_id = '6977140', n.note_date = '2026-01-22', n.note_type = 'Therapy Update', n.author_name = 'Hector Osei', n.author_role = 'physical therapist', n.text = 'PT visit 8/12 January 22 (Lakeview Physical Therapy) Pain 4/10 pre-tx, 3/10 after Progressing w/ HEP ROM: ROM improving, still guarded overhead.', n.word_count = 22, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977140-047'}) SET n.claim_id = '6977140', n.note_date = '2026-01-22', n.note_type = 'Status Report', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = 'Subject: Status Report - Claim 6977140 - Maya Patel\nHi Carla,\n\nPlease see the update below on Maya Patel\'s claim (Hudson Valley Hospitality, DOI Dec 2, facility parking area). I have kept the history short, call me if you want more.\n\nCLAIM HISTORY\nDOI Dec 2, clmt was struck by a coworker during a pallet move at facility parking area. First seen at Rochester Work Injury Clinic on Dec 8, dx strain of the lt upper arm, xray neg. PT at Lakeview Physical Therapy started Dec 19, 8 of 12 authorized visits used so far. No wage payments, medical bills only, approx $1,080 paid to date. Contacts: adjuster Maya Patel, ER contact Lena Castillo, ER supervisor Nora Brennan, treating Dr Brennan, PT Hector Osei at Lakeview Physical Therapy. Coverage: State Insurance Fund on the risk, Queens county, facility parking area.\n\nCURRENT MEDICAL: treating with Dr Brennan at Rochester Work Injury Clinic. Pain was 4/10 at the last visit (Jan 20) and clmt reports sore bicep area, weak lifting. Restrictions: no overhead work, lifting to 15 lbs.\nWORK STATUS: clmt is working regular duty, no issues.\nBENEFITS: no lost time, no wage benefits due at this point. Medical bills are being paid per the fee schedule.\nLEGAL: no hearings or conciliation set, nothing from the Board that needs a response.\nCONTACTS: adjuster Maya Patel, ER contact Lena Castillo (Hudson Valley Hospitality), ER supervisor Nora Brennan, treating Dr Brennan at Rochester Work Injury Clinic. PT is Hector Osei at Lakeview Physical Therapy.\nCOVERAGE: State Insurance Fund is on the risk. Claim is in Queens county, injury location facility parking area. No prior claims found on clmt.\nOUTSTANDING: nothing.\nRESERVES: no change recommended right now, med reserve $12,000. We will revisit after the next medical report.\nPLAN: continue to monitor, speak with clmt and the company again this month, and send the next update by Feb 5. Please let me know if you need anything else in the meantime.\n\nThanks,\nMaya Patel', n.word_count = 329, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977140-048'}) SET n.claim_id = '6977140', n.note_date = '2026-01-23', n.note_type = 'Contact - Injured Worker', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = 'spoke w/ clmt 1-23-2026. back to full duty.', n.word_count = 8, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
