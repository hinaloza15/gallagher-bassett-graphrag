MERGE (n:Chunk {chunk_id: 'SYN-6977197-004-C01'}) SET n.parent_id = 'SYN-6977197-004', n.parent_kind = 'Note', n.position = 1, n.text = 'Need to respond to this.\nFrom: Dev Sato <dev@metrocleanservices.example>\nSent: Wed, Dec 17, 2025 16:24\nTo: Olivia Grant\nSubject: RE: Claim 6977197 - Morris\n\nHi Olivia,\nOur insurer is STARBUCKS CORPORATION, adjuster is Olivia.\nCamila Morris has not returned our calsl about the modified duty offer.\n\nThanks,\nDev Sato', n.char_start = 0, n.char_end = 315, n.word_count = 49;
MERGE (n:Chunk {chunk_id: 'SYN-6977197-005-C01'}) SET n.parent_id = 'SYN-6977197-005', n.parent_kind = 'Note', n.position = 1, n.text = 'New assignment 12/17/25, DOI 12/15/25 at retail store. Cx says she slipped on a spill near the counter at retail store. Reported to Lena Haddad same day. Treating at Hudson Valley Ortho & Rehab with Dr Lindqvist. No prior claims that I can see. Cx still working, light tasks only. C-3 not yet rec\'d. I will call Camila and the employer today. We have not rec\'d any wage info yet. Coverage confirmed, STARBUCKS CORPORATION is on the risk. We need the job description and wage statement from the employer. Claim # 6977197, Nassau county. Diary 14 days.\nDOI 12/15/25, cx slipped on a spill near the counter at retail store. On modified duty from 12/17/25. Carla Brennan is the worker\'s attorney.', n.char_start = 0, n.char_end = 692, n.word_count = 121;
MERGE (n:Chunk {chunk_id: 'SYN-6977197-006-C01'}) SET n.parent_id = 'SYN-6977197-006', n.parent_kind = 'Note', n.position = 1, n.text = 'prior claims check nothing under Morris. -Jamal', n.char_start = 0, n.char_end = 47, n.word_count = 7;
MERGE (n:Chunk {chunk_id: 'SYN-6977197-007-C01'}) SET n.parent_id = 'SYN-6977197-007', n.parent_kind = 'Note', n.position = 1, n.text = 'Called Camila, reached on 2nd try.', n.char_start = 0, n.char_end = 34, n.word_count = 6;
MERGE (n:Chunk {chunk_id: 'SYN-6977197-008-C01'}) SET n.parent_id = 'SYN-6977197-008', n.parent_kind = 'Note', n.position = 1, n.text = 'OFFICE NOTE December 18 (Dr Lindqvist):\nSUBJECTIVE: pt c/o knee sore, swelling after standing. pain 8/10.\nOBJECTIVE: mild effusion, gait guarded. xray neg for fracture. ROM: knee/ankle ROM near full, some pain at end range.\nASSESSMENT: strain of the left knee, no change.\nPLAN: brace/splint prn, ice. restr: no standing over 2 hrs, no ladders, no kneeling. work status: back on light duty. f/u 1/6.', n.char_start = 0, n.char_end = 398, n.word_count = 65;
MERGE (n:Chunk {chunk_id: 'SYN-6977197-009-C01'}) SET n.parent_id = 'SYN-6977197-009', n.parent_kind = 'Note', n.position = 1, n.text = 'Email from Dev Sato 12/18/25 The employer concerned about overtime coverage.', n.char_start = 0, n.char_end = 76, n.word_count = 11;
MERGE (n:Chunk {chunk_id: 'SYN-6977197-010-C01'}) SET n.parent_id = 'SYN-6977197-010', n.parent_kind = 'Note', n.position = 1, n.text = 'Statement 12/19/2025 from Lena Haddad at MetroClean Services: I was on shift 12/15/2025. Camila told me she slipped on a spill near the counter. No other witnesses that i know of. Location was retail store. We have a camera but not sure it covers retail store. No prior complaints that i recall. Camila finished the shift but was favoring it. I offered to call an ambulance, she said no. We did a safety huddle the next morning. I can send the schedule for that week if needed.\nDOI 12/15/2025, Camila slipped on a spill near the counter at retail store. First seen at Hudson Valley Ortho & Rehab on 12/18/2025, dx strain of the left knee, xray neg for fracture. On modified duty from 12/17/2025. Carla Brennan is the worker\'s atty. Still waiting on wage statement from the company and initial medical report from Hudson Valley Ortho & Rehab.', n.char_start = 0, n.char_end = 841, n.word_count = 149;
MERGE (n:Chunk {chunk_id: 'SYN-6977197-011-C01'}) SET n.parent_id = 'SYN-6977197-011', n.parent_kind = 'Note', n.position = 1, n.text = '12/19/25 - Dr Lindqvist\'s office Asked Dr Lindqvist for an updated work status, fax request sent Hudson Valley Ortho & Rehab billing called about a denied visit, referred to STARBUCKS CORPORATION Hudson Valley Ortho & Rehab rec\'d our auth, visits scheduled.', n.char_start = 0, n.char_end = 257, n.word_count = 41;
MERGE (n:Chunk {chunk_id: 'SYN-6977197-012-C01'}) SET n.parent_id = 'SYN-6977197-012', n.parent_kind = 'Note', n.position = 1, n.text = 'RTW: Cx did 6 days of modified duty then called out. Dev Sato says light duty available, hours reduced. Asked Dr Lindqvist for updated work status. Cx says she isnt ready, pain 8/10. Cx worried about the commute. The employer should have the new restrictions in writing.', n.char_start = 0, n.char_end = 270, n.word_count = 47;
MERGE (n:Chunk {chunk_id: 'SYN-6977197-013-C01'}) SET n.parent_id = 'SYN-6977197-013', n.parent_kind = 'Note', n.position = 1, n.text = 'Imaging note 12/22/25: Xray neg for fracture.', n.char_start = 0, n.char_end = 45, n.word_count = 7;
MERGE (n:Chunk {chunk_id: 'SYN-6977197-014-C01'}) SET n.parent_id = 'SYN-6977197-014', n.parent_kind = 'Note', n.position = 1, n.text = 'Statement from cx: Cx states she slipped on a spill near the counter at retail store around 2pm. No other jobs. Dominant hand is the right. Camila said it was slow that morning. Asked cx if she had any trouble with knee before, said no.\nDOI 12/15/25, cx slipped on a spill near the counter at retail store. First seen at Hudson Valley Ortho & Rehab on December 18, dx strain of the left knee, xray neg for fracture. On modified duty from 12/17/25. Carla Brennan is the worker\'s attorney.', n.char_start = 0, n.char_end = 487, n.word_count = 90;
MERGE (n:Chunk {chunk_id: 'SYN-6977197-015-C01'}) SET n.parent_id = 'SYN-6977197-015', n.parent_kind = 'Note', n.position = 1, n.text = 'Per email, will follow up\nFrom: Kevin (front desk) <kevin@hudsonvalleyorthorehab.example>\nSent: Tue, Dec 23, 2025 11:43\nTo: Olivia Grant\nSubject: RE: Claim 6977197 - Morris\n\nHi Olivia,\nWork status: working w/ restrictions.\nCamila Morris is being seen for strain of the knee.\nAttached is the note from Camila Morris\'s visit on Dec 18.\n\nThank you,\nKevin (front desk)', n.char_start = 0, n.char_end = 364, n.word_count = 58;
