MERGE (n:Note {note_id: 'SYN-6977100-066'}) SET n.claim_id = '6977100', n.note_date = '2026-01-09', n.note_type = 'Contact - Injured Worker', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'Marcus called in re: Claim 6977100. Asked about mileage reimbursement, told to send C-257 with receipts. Marcus got a bill for $132.50 from Brooklyn Occupational Medicine, I told him not to pay it, we will check it.', n.word_count = 37, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977100-067'}) SET n.claim_id = '6977100', n.note_date = '2026-01-12', n.note_type = 'Therapy Update', n.author_name = 'Beth Mehta', n.author_role = 'physical therapist', n.text = 'Rehab note January 12: Visit 8 of 8. Pt reports sore across the palm, weak grip. Goal: Carry 20 lbs without pain.', n.word_count = 22, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977100-068'}) SET n.claim_id = '6977100', n.note_date = '2026-01-12', n.note_type = 'Hearing / Legal', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'Legal note conciliation held Jan 9, no agreement, Board keeps it open.', n.word_count = 12, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977100-069'}) SET n.claim_id = '6977100', n.note_date = '2026-01-12', n.note_type = 'Status Report', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'Subject: Status Report - Claim 6977100 - Marcus Reed\nHi Paula,\n\nPlease see the update below on Marcus Reed\'s claim (Hudson Public Services, DOI 11/21/25, service site). I have kept the history short, call me if you want more.\n\nCLAIM HISTORY\nDOI 11/21/25, Marcus Reed tripped on something on the floor and went down at service site. First seen at Brooklyn Occupational Medicine on 11/25/25, dx hand injury of the right hand, xray neg. On modified duty from Nov 24. PT at Lakeview Physical Therapy started 12/9/25, 8 of 8 authorized visits used so far. Conciliation held 1/9/26. No wage payments, medical bills only, approx $970 paid to date. Contacts: adjuster Priya Shah, ER contact Carla Lindqvist, ER supervisor Carla Brennan, treating Dr Osei, PT Beth Mehta at Lakeview Physical Therapy. Coverage: Wesco Insurance Co on the risk, Nassau county, service site.\n\nCURRENT MEDICAL: treating with Dr Osei at Brooklyn Occupational Medicine. Pain was 4/10 at the last visit (12/23/25) and Marcus reports sore across the palm, weak grip. Restrictions: no repetitive gripping, lifting to 10 lbs.\nWORK STATUS: Marcus is working modified duty.\nBENEFITS: no lost time, no wage benefits due at this point. Medical bills are being paid per the fee schedule.\nLEGAL: conciliation held 1/9/26, no agreement, Board keeps it open.\nCONTACTS: adjuster Priya Shah, ER contact Carla Lindqvist (Hudson Public Services), ER supervisor Carla Brennan, treating Dr Osei at Brooklyn Occupational Medicine. PT is Beth Mehta at Lakeview Physical Therapy.\nCOVERAGE: Wesco Insurance Co is on the risk. Claim is in Nassau county, injury location service site. No prior claims found on Marcus.\nOUTSTANDING: nothing.\nRESERVES: no change recommended right now, med reserve $4,500. We will revisit after the next medical report.\nPLAN: continue to monitor, speak with Marcus and the company again this month, and send the next update by 2/11/26. Please let me know if you need anything else in the meantime.\n\nThanks,\nPriya Shah', n.word_count = 321, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977100-070'}) SET n.claim_id = '6977100', n.note_date = '2026-01-14', n.note_type = 'Medical Update', n.author_name = 'Dr Osei', n.author_role = 'treating provider', n.text = 'Dr Osei progress . Pt c/o sore across the palm, weak grip. C-4.2 to follow. Continue wrist ROM, grip strengthening, putty.', n.word_count = 21, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
