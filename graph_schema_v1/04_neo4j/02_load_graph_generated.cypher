MERGE (n:Chunk {chunk_id: 'SYN-6977163-074-C01'}) SET n.parent_id = 'SYN-6977163-074', n.parent_kind = 'Note', n.position = 1, n.text = 'Per email, will follow up\nFrom: Alicia Fischer <alicia@orangesupplycooperative.example>\nSent: Wed, Mar 11, 2026 9:31\nTo: Olivia Grant\nSubject: RE: Claim 6977163 - Lopez\n\nHi Olivia,\nMia Lopez has not returned our calls abkut the modified duty offer.\nOur insurer is New Hampshire Insurance Co, adjutser is Olivia.\n\nThanks,\nAlicia Fischer', n.char_start = 0, n.char_end = 335, n.word_count = 51;
MERGE (n:Chunk {chunk_id: 'SYN-6977163-075-C01'}) SET n.parent_id = 'SYN-6977163-075', n.parent_kind = 'Note', n.position = 1, n.text = 'Need to respond to this.\nFrom: Lena Castillo <lena@castillolaw.example>\nSent: Wed, Mar 11, 2026 8:14\nTo: Olivia Grant\nSubject: RE: Claim 6977163 - Lopez\n\nHi Olivia,\nMy client has not been paid for Rx, please advise.\nMy client is available for a call, my office number is on file.\nThe nothing is still outstanding on our end.\nWe will be asking for a hearing if there is no response within 10 days.\n\nRegards,\nLena Castillo', n.char_start = 0, n.char_end = 420, n.word_count = 75;
