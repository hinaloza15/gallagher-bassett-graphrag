MERGE (n:Note {note_id: 'SYN-6977197-027'}) SET n.claim_id = '6977197', n.note_date = '2026-01-07', n.note_type = 'Therapy Update', n.author_name = 'Carla Castillo', n.author_role = 'physical therapist', n.text = 'January 7 therapy session #2 - Carla Castillo, PT. Tolerated tx well. Progressing w/ HEP. Missed last appt, rescheduled. ROM: Knee/ankle ROM near full, some pain at end range. Goal: Stand a full shift without pain. Reviewed HEP, pt demonstrates correctly. Auth pending w/ Starbucks Corporation.', n.word_count = 46, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
