MERGE (n:Chunk {chunk_id: 'SYN-6977140-094-C01'}) SET n.parent_id = 'SYN-6977140-094', n.parent_kind = 'Note', n.position = 1, n.text = 'FYI\nFrom: Maya Patel <maya@mail.example>\nSent: Mon, Aug 31, 2026 14:37\nTo: Maya Patel\nSubject: RE: Claim 6977140 - Patel\n\nHello\nmy upper arm is still bothering me, about 0 out of 10.\nplease call me back, my number is the same.\n\n\nMaya', n.char_start = 0, n.char_end = 233, n.word_count = 43;
MERGE (n:Chunk {chunk_id: 'SYN-6977140-095-C01'}) SET n.parent_id = 'SYN-6977140-095', n.parent_kind = 'Note', n.position = 1, n.text = 'email from Maya August 31: my upper arm still hurts when i reach overhead or lift. i have a bill from Lakeview Pharmacy. my boss Nora Brennan keeps asking when i can come back. my number changed, new one is on file now. the tylenol is not really helping. i need to know who to talk to about mileage. i cant sleep bc of my upper arm. please call me. -WP', n.char_start = 0, n.char_end = 352, n.word_count = 71;
