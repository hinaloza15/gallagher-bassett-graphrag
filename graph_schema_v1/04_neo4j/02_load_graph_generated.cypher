MERGE (n:Chunk {chunk_id: 'SYN-6977182-071-C01'}) SET n.parent_id = 'SYN-6977182-071', n.parent_kind = 'Note', n.position = 1, n.text = 'STATUS: IW, rt forearm strain, DOI Oct 20. file is still open.\nMEDICAL: seeing DR Doyle at Rochester Work Injury Clinic; pain 4/10 per last note; pulling pain in the forearm.\nWORK: back to full duty; restr: lifting to 20 lbs, splint as needed.\nPAY: no lost time, no wage payments, medical bills only.\nLEGAL: no Board activity.\nPENDING: nothing.\nPLAN: call IW, follow up with DR Doyle, review again 02/18/2026.\nHISTORY: DOI 10/20/2025, IW was moving a heavy tote and felt something give at operations facility. First seen at Rochester Work Injury Clinic on 10/27/2025, dx strain of the rt forearm, xray neg. No wage payments, medical bills only, approx $575 paid to date. Contacts: adjuster Marcus Hill, ER contact Paula Nakamura, ER supervisor Lena Brennan, treating DR Doyle. Coverage: WEGMANS FOOD MARKETS on the risk, Monroe county, operations facility.', n.char_start = 0, n.char_end = 856, n.word_count = 141;
