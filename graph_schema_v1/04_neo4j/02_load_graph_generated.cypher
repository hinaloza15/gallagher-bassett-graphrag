MERGE (n:Chunk {chunk_id: 'SYN-6977156-053-C01'}) SET n.parent_id = 'SYN-6977156-053', n.parent_kind = 'Note', n.position = 1, n.text = 'STATUS: Emma, low back, hip and both knees strain, DOI 12/21/2025. file is still open.\nMEDICAL: seeing DR Haddad at North Shore Occupational Health; pain 4/10 per last note; pain in the low back, worse by end of shift.\nWORK: working w/ restrictions; restr: no lifting over 20 lbs, limit bending.\nPAY: paying $710.00/wk, approx $5,680 paid to date.\nLEGAL: first hearing is on 03/03/2026, notice went to all parties.\nPENDING: nothing.\nPLAN: call IW, follow up with DR Haddad, review again 03/11/2026.\nHISTORY: DOI 12/21/2025, IW missed the last few steps and fell at operations facility. First seen at North Shore Occupational Health on 12/25/2025, dx strain of the low back, hip and both knees, lumbar xray no acute findings. Off work from 12/22/2025. On modified duty from 01/15/2026.', n.char_start = 0, n.char_end = 784, n.word_count = 130;
