MERGE (n:Note {note_id: 'SYN-6977137-042'}) SET n.claim_id = '6977137', n.note_date = '2026-02-04', n.note_type = 'Contact - Employer', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'Rec\'d this today, will call.\nFrom: Mei Doyle <mei@buffalocarenetwork.example>\nSent: Wed, Feb 4, 2026 14:01\nTo: Olivia Grant\nSubject: RE: Claim 6977137 - Bennett\n\nHi Olivia,\nOur payroll shows cx earned about $985 a week before the injury.\nJob description attached.\n\nThank you,\nMei Doyle', n.word_count = 45, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977137-043'}) SET n.claim_id = '6977137', n.note_date = '2026-02-04', n.note_type = 'Contact - Injured Worker', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = '2/4/26 - spoke with Noah by phone. Says he saw Dr Sato on 1/19/26. Wants a copy of the C-3, will mail. Cx confirmed DOI 12/23/2025 at retail store. Asked when the next check is due, told Noah checks are $657.00/wk. Address and phone confirmed same as file. Cx says he is not sure he can do the light duty offered, I told him to talk to Dr Sato.\nDOI 12/23/25, cx tripped on something on the floor and went down at retail store. First seen at Hudson Valley Ortho & Rehab on 12/29/25, dx sprain of the right knee, xray neg for fracture.', n.word_count = 104, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977137-044'}) SET n.claim_id = '6977137', n.note_date = '2026-02-04', n.note_type = 'Contact - Injured Worker', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'February 4 outbound call to Noah. Asked if Olivia is still the adjuster confirmed.', n.word_count = 14, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977137-045'}) SET n.claim_id = '6977137', n.note_date = '2026-02-06', n.note_type = 'Status Report', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'Subject: Status Report - Claim 6977137 - Noah Bennett\nHi Sam,\n\nPlease see the update below on Noah Bennett\'s claim (Buffalo Care Network, DOI 12/23/25, retail store). I have kept the history short, call me if you want more.\n\nCLAIM HISTORY\nDOI 12/23/25, Noah tripped on something on the floor and went down at retail store. First seen at Hudson Valley Ortho & Rehab on 12/29/25, dx sprain of the right knee, xray neg for fracture. Off work from 12/25/25. On modified duty from 1/10/26. PT at Summit Rehab & Sports PT started 1/5/26, 9 of 18 authorized visits used so far. MRI ordered 1/13/26, result 1/24/26: mild effusion, possible meniscus signal change. Admin determination notice 1/22/26. Weekly payments of $657 started Jan 3, approx $3,285 paid to date. Contacts: adjuster Olivia Grant, ER contact Mei Doyle, ER supervisor Nora Okafor, treating Dr Sato, PT Dev Whitaker at Summit Rehab & Sports PT.\n\nCURRENT MEDICAL: treating with Dr Sato at Hudson Valley Ortho & Rehab. Pain was 7/10 at the last visit (1/19/26) and cx reports knee swelling, feels unstable on stairs. Restrictions: no standing over 2 hrs, no ladders, no kneeling.\nWORK STATUS: Noah is working modified duty.\nBENEFITS: we are paying $657.00/wk.\nLEGAL: no hearings or conciliation set, nothing from the Board that needs a response.\nCONTACTS: adjuster Olivia Grant, ER contact Mei Doyle (Buffalo Care Network), ER supervisor Nora Okafor, treating Dr Sato at Hudson Valley Ortho & Rehab. PT is Dev Whitaker at Summit Rehab & Sports PT.\nCOVERAGE: State Ins Fund is on the risk. Claim is in Franklin county, injury location retail store. No prior claims found on cx.\nOUTSTANDING: records from prior provider.\nRESERVES: no change recommended right now, med reserve $15,000. We will revisit after the next medical report.\nPLAN: continue to monitor, speak with cx and the employer again this month, and send the next update by 2/27/26. Please let me know if you need anything else in the meantime.\n\nThanks,\nOlivia Grant', n.word_count = 332, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977137-046'}) SET n.claim_id = '6977137', n.note_date = '2026-02-06', n.note_type = 'Pharmacy', n.author_name = 'Aziz Karimi', n.author_role = 'specialist', n.text = 'Rx chck 2/6/26: Refill request for naproxen -AK', n.word_count = 8, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
