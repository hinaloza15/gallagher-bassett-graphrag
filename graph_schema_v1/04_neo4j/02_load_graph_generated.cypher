MERGE (n:Chunk {chunk_id: 'SYN-6977100-035-C01'}) SET n.parent_id = 'SYN-6977100-035', n.parent_kind = 'Note', n.position = 1, n.text = 'need to respond to this. -Jamal\nFrom: Sam (front desk) <sam@brooklynoccupationalmedicine.example>\nSent: Wed, Dec 10, 2025 12:38\nTo: Priya Shah\nSubject: RE: Claim 6977100 - Reed\n\nHi Priya,\nAttached is the note from Marcus Reed\'s visit on 11/25/25.\nPlease confirm authorization for the xray.\n\nRegards,\nSam (front desk)', n.char_start = 0, n.char_end = 316, n.word_count = 48;
MERGE (n:Chunk {chunk_id: 'SYN-6977100-036-C01'}) SET n.parent_id = 'SYN-6977100-036', n.parent_kind = 'Note', n.position = 1, n.text = 'Marcus Reed called in re: Claim 6977100. Working w/ restrictions. Asked about mileage reimbursement, told to send C-257 with receipts. Still hard to grip or carry. Marcus says he is not sure he can do the light duty offered, I told him to talk to Dr Osei. Marcus got a bill for $248.00 from Brooklyn Occupational Medicine, I told him not to pay it, we will check it. Marcus understood.\nDOI 11/21/25, Marcus tripped on something on the floor and went down at service site.', n.char_start = 0, n.char_end = 471, n.word_count = 85;
