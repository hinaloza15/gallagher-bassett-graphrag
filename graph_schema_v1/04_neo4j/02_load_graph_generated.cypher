MERGE (n:Note {note_id: 'SYN-6977197-024'}) SET n.claim_id = '6977197', n.note_date = '2026-01-06', n.note_type = 'Medical Update', n.author_name = 'Dr Lindqvist', n.author_role = 'treating provider', n.text = 'Dr note rec\'d 01/06/2026 from Hudson Valley Ortho & Rehab:\nSUBJECTIVE: pt c/o knee swelling, feels unstable on stairs. pain 7/10.\nOBJECTIVE: tender, FROM w/ pain at end range. xray neg for fracture. ROM: knee/ankle ROM near full, some pain at end range.\nASSESSMENT: strain of the left knee, no change.\nPLAN: brace/splint prn, ice. restr: no standing over 2 hrs, no ladders, no kneeling. work status: working w/ restrictions. f/u 1/26.', n.word_count = 72, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977197-025'}) SET n.claim_id = '6977197', n.note_date = '2026-01-06', n.note_type = 'Contact - Injured Worker', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'Spoke with Camila . Pain about 7/10 today per Camila. Asked about mileage reimbursement, told to send C-257 with receipts.', n.word_count = 20, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
