MERGE (n:Note {note_id: 'SYN-6977156-041'}) SET n.claim_id = '6977156', n.note_date = '2026-02-03', n.note_type = 'Worker Message', n.author_name = 'Tina Morales', n.author_role = 'assistant', n.text = 'text msg rec\'d 02/03/2026 from Emma: can someone tell me if North Shore Occupational Health got paid. when is my next payment', n.word_count = 22, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977156-042'}) SET n.claim_id = '6977156', n.note_date = '2026-02-04', n.note_type = 'Status Report', n.author_name = 'Marcus Hill', n.author_role = 'adjuster', n.text = 'Subject: Status Report - Claim 6977156 - Emma Rivera\nHi Tom,\n\nPlease see the update below on Emma Rivera\'s claim (Harborview Community Health, DOI 12/21/2025, operations facility). I have kept the history short, call me if you want more.\n\nCLAIM HISTORY\nDOI 12/21/2025, IW missed the last few steps and fell at operations facility. First seen at North Shore Occupational Health on 12/25/2025, dx strain of the low back, hip and both knees, lumbar xray no acute findings. Off work from 12/22/2025. On modified duty from 01/15/2026. PT at Summit Rehab & Sports PT started 01/06/2026, 7 of 16 authorized visits used so far. MRI ordered 01/12/2026, result 01/24/2026: mild disc bulge L4-5, no stenosis. Lena Alvarez is the worker\'s attorney. Weekly payments of $710 started 12/31/2025, approx $3,550 paid to date. Contacts: adjuster Marcus Hill, ER contact Tasha Kowalski, ER supervisor Greg Romano, treating DR Haddad, PT Lena Mehta at Summit Rehab & Sports PT.\n\nCURRENT MEDICAL: treating with DR Haddad at North Shore Occupational Health. Pain was 5/10 at the last visit (01/12/2026) and IW reports low back, hip and both knees sore and stiff. Restrictions: no lifting over 10 lbs, no repeated bending.\nWORK STATUS: IW is back on light duty.\nBENEFITS: we are paying $710.00/wk.\nLEGAL: first hearing is on March 3, notice went to all parties.\nIW is represented by Lena Alvarez, who has asked for the claim file and our position on added treatment. We are responding by letter.\nCONTACTS: adjuster Marcus Hill, ER contact Tasha Kowalski (Harborview Community Health), ER supervisor Greg Romano, treating DR Haddad at North Shore Occupational Health. PT is Lena Mehta at Summit Rehab & Sports PT.\nCOVERAGE: SIF is on the risk. Claim is in Queens county, injury location operations facility. No prior claims found on Emma.\nOUTSTANDING: records from prior provider.\nRESERVES: no change recommended right now, med reserve $12,000. We will revisit after the next medical report.\nPLAN: continue to monitor, speak with IW and employer again this month, and send the next update by 02/18/2026. Please let me know if you need anything else in the meantime.\n\nThanks,\nMarcus Hill', n.word_count = 355, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
