MERGE (n:Note {note_id: 'SYN-6977121-094'}) SET n.claim_id = '6977121', n.note_date = '2026-08-31', n.note_type = 'File Review', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = 'clmt, neck, upper back and shoulder strain, DOI Dec 19. file is closed by the Board. seeing Dr Lindqvist at Capital Region Occupational Health; pain 0/10 per last note; feeling much better, occasional soreness. back to full duty; restr: released to full duty, no restrictions. no Board activity. nothing. we get nothing, then close diary Sep 14. DOI Dec 19, clmt was repositioning stock and felt a pull at warehouse. first seen at Capital Region Occupational Health on Dec 24, dx strain of neck, upper back and shoulder, xray neg. no wage payments, medical bills only, approx $630 paid to date. Contacts: adjuster Maya Patel, ER contact Victor Alvarez, ER supervisor Alicia Whitaker, treating Dr Lindqvist. Coverage: Hartford Casualty Insurance Co on the risk, Queens county, warehouse.', n.word_count = 127, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977121-095'}) SET n.claim_id = '6977121', n.note_date = '2026-09-03', n.note_type = 'Closure / Reopen', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = 'closing review: clmt back to full duty since Mar 26, no f/u needed. board closed case, nothing open. no activity in 60 days, closing diary. treated at Capital Region Occupational Health, released, no restrictions. if clmt calls w/ a flare up, reopen and send back to Dr Lindqvist.\nDOI December 19, clmt was repositioning stock and felt pull at warehouse. First seen at Capital Region Occupational Health on Dec 24, dx strain of neck, upper back and shoulder, xray neg. No wage payments, medical bills only, approx $630 paid to date.', n.word_count = 91, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977137-004'}) SET n.claim_id = '6977137', n.note_date = '2025-12-25', n.note_type = 'First Report Summary', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'New assignment 12/25/25, DOI Dec 23 at retail store. Noah says he tripped on something on the floor and went down at retail store. Sx: Knee sore, swelling after standing. Dx per first visit: Sprain. Noah is out of work per Dr Sato. C-3 not yet rec\'d. I will call cx and the employer today. We have not rec\'d any wage info yet. Coverage confirmed, State Insurance Fund is on the risk. Diary 14 days.\nDOI 12/23/25, cx tripped on something on the floor and went down at retail store.', n.word_count = 90, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977137-005'}) SET n.claim_id = '6977137', n.note_date = '2025-12-25', n.note_type = 'Prior Claims Check', n.author_name = 'Gita Rao', n.author_role = 'assistant', n.text = 'prior claims: none, 6977137 is only one on file.', n.word_count = 9, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977137-006'}) SET n.claim_id = '6977137', n.note_date = '2025-12-26', n.note_type = 'Contact - Employer', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'Forwarding to file.\nFrom: Mei Doyle <mei@buffalocarenetwork.example>\nSent: Fri, Dec 26, 2025 8:17\nTo: Olivia Grant\nSubject: RE: Claim 6977137 - Bennett\n\nHi Olivia,\nOur insurer is State Ins Fund, afjuster is Olivia.\nIncident report was sent on 12/25/25.\nOur payroll shows cx earned about $985 a week before the injury.\n\nRegards,\nMei Doyle', n.word_count = 54, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977137-007'}) SET n.claim_id = '6977137', n.note_date = '2025-12-26', n.note_type = 'Contact - Injured Worker', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'Called cx, reached on 2nd try Cx confirmed DOI 12/23/25 at retail stoer Asked him to call Mei Doyle about the light duty at the employer.', n.word_count = 26, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977137-008'}) SET n.claim_id = '6977137', n.note_date = '2025-12-29', n.note_type = 'Work Status', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = '12/29/25 work status: Full duty release expected 1/19. Cx says he isnt ready, pain 6/10. The employer should have the new restrictions in writing.', n.word_count = 24, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977137-009'}) SET n.claim_id = '6977137', n.note_date = '2025-12-29', n.note_type = 'Supervisor Incident Statement', n.author_name = 'Nora Okafor', n.author_role = 'ER supervisor', n.text = 'SUP STMT Dec 29 - Nora Okafor. I was on shift Dec 23. Noah Bennett told me he tripped on something on the floor and went down. Location was retail store. Incident form given to Mei Doyle. No prior complaints that i recall. The floor was dry that day as far as i know. Noah has been reliable, no attendance issues.\nDOI Dec 23, Noah tripped on something on the floor and went down at retail store. First seen at Hudson Valley Ortho & Rehab on Dec 29, dx sprain of the right knee, xray neg for fracture.', n.word_count = 98, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977137-010'}) SET n.claim_id = '6977137', n.note_date = '2025-12-29', n.note_type = 'Contact - Provider', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'See below.\nFrom: Greg (front desk) <greg@hudsonvalleyorthorehab.example>\nSent: Mon, Dec 29, 2025 10:19\nTo: Olivia Grant\nSubject: RE: Claim 6977137 - Bennett\n\nHi Olivia,\nOur billing for $196.50 was sent on 12/25/25, please confirm receipt.\nWork status: still off work.\n\nRegards,\nGreg (front desk)', n.word_count = 44, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977137-011'}) SET n.claim_id = '6977137', n.note_date = '2025-12-29', n.note_type = 'Imaging Result', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = '12/29/25 Valley Radiology report rec\'d. Xray neg for fracture. Copy to Olivia. Bill for $203.75 from Valley Radiology, sent to bill review.', n.word_count = 22, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977137-012'}) SET n.claim_id = '6977137', n.note_date = '2025-12-30', n.note_type = 'Medical Update', n.author_name = 'Dr Sato', n.author_role = 'treating provider', n.text = 'Hudson Valley Ortho & Rehab f/u December 30.\nSUBJECTIVE: pt c/o knee swelling, feels unstable on stairs. pain 6/10. pt states compliant w/ tx.\nOBJECTIVE: swelling, TTP over the area, no deformity. xray neg for fracture. ROM: knee/ankle ROM near full, some pain at end range.\nASSESSMENT: sprain of the right knee, no change.\nPLAN: ice, heat, nsaids. restr: no standing over 2 hrs, no ladders, no kneeling. work status: remains off work per the Dr. f/u 1/19.', n.word_count = 78, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977137-013'}) SET n.claim_id = '6977137', n.note_date = '2025-12-31', n.note_type = 'Worker Message', n.author_name = 'Gita Rao', n.author_role = 'assistant', n.text = 'text msg rec\'d 12/31/2025 from Noah: calling about my claim 6977137. my knee still hurts when i stand or walk for long. my boss Nora Okafor keeps asking when i can come back -GR', n.word_count = 34, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977137-014'}) SET n.claim_id = '6977137', n.note_date = '2025-12-31', n.note_type = 'Statement / Investigation', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'Recorded statement cx 12/31/25: Cx states he tripped on something on the floor and went down at retail store around 2pm. No one saw it, a coworker came over after. Denies prior problems with knee. No other jobs. Cx said it was raining out. Photos requested, none were taken. Supervisor statement requested from Nora Okafor. Asked cx if he had any trouble with knee before, said no. Cx has been with the employer a few years, regular schedule. Cx says he told Nora Okafor before the end of the shift. Pain level that day was about 6/10 per cx. Cx says nobody has offered light duty yet. Asked about any activities outside work, nothing unusual.\nDOI 12/23/25, cx tripped on something on the floor and went down at retail store. First seen at Hudson Valley Ortho & Rehab on 12/29/25, dx sprain of the right knee, xray neg for fracture. Off work from Dec 25. Still waiting on wage statement from the employer and initial medical report from Hudson Valley Ortho & Rehab.', n.word_count = 173, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977137-015'}) SET n.claim_id = '6977137', n.note_date = '2025-12-31', n.note_type = 'Diary Entry', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'Diary 12/31/25: Nothing new from the employer or Hudson Valley Ortho & Rehab.', n.word_count = 13, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
