MERGE (n:Chunk {chunk_id: 'SYN-6977182-063-C01'}) SET n.parent_id = 'SYN-6977182-063', n.parent_kind = 'Note', n.position = 1, n.text = 'rec\'d this today, will call -MH\nFrom: Paula Nakamura <paula@hudsonvalleyhospitality.example>\nSent: Wed, Jan 21, 2026 13:40\nTo: Marcus Hill\nSubject: RE: Claim 6977182 - Wood\n\nHi Marcus,\nOur insurer is WEGMANS FOOD MARKETS, adjuster is Marcus.\nAaron Wood has not returned our calls about the modified duty offer.\nWe can offer light duty starting 01/27/2026, 4 hrs/day.\nAttached is the wage statement for Aaron Wood.\n\nThank you,\nPaula Nakamura', n.char_start = 0, n.char_end = 440, n.word_count = 69;
