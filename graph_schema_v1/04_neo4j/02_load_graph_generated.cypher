MERGE (n:Chunk {chunk_id: 'SYN-6977197-023-C01'}) SET n.parent_id = 'SYN-6977197-023', n.parent_kind = 'Note', n.position = 1, n.text = 'January 5 - auth note: Dr Lindqvist requested more PT, we are checking against the guideline RFA-1 filed by Carla Brennan for added tx Waiting on the MRI report from Northeast Diagnostic Imaging.', n.char_start = 0, n.char_end = 195, n.word_count = 33;
MERGE (n:Chunk {chunk_id: 'SYN-6977197-024-C01'}) SET n.parent_id = 'SYN-6977197-024', n.parent_kind = 'Note', n.position = 1, n.text = 'Dr note rec\'d 01/06/2026 from Hudson Valley Ortho & Rehab:\nSUBJECTIVE: pt c/o knee swelling, feels unstable on stairs. pain 7/10.\nOBJECTIVE: tender, FROM w/ pain at end range. xray neg for fracture. ROM: knee/ankle ROM near full, some pain at end range.\nASSESSMENT: strain of the left knee, no change.\nPLAN: brace/splint prn, ice. restr: no standing over 2 hrs, no ladders, no kneeling. work status: working w/ restrictions. f/u 1/26.', n.char_start = 0, n.char_end = 434, n.word_count = 72;
MERGE (n:Chunk {chunk_id: 'SYN-6977197-025-C01'}) SET n.parent_id = 'SYN-6977197-025', n.parent_kind = 'Note', n.position = 1, n.text = 'Spoke with Camila . Pain about 7/10 today per Camila. Asked about mileage reimbursement, told to send C-257 with receipts.', n.char_start = 0, n.char_end = 122, n.word_count = 20;
MERGE (n:Chunk {chunk_id: 'SYN-6977197-026-C01'}) SET n.parent_id = 'SYN-6977197-026', n.parent_kind = 'Note', n.position = 1, n.text = 'Imaging note 1/6/26: Xray neg for fracture. Ordered by Dr Lindqvist. Report faxed to Starbucks Corporation. Radiologist says full report in 2 days. Cx had to reschedule once. Copy to Olivia. Bill for $442.50 from Northeast Diagnostic Imaging, sent to bill review.', n.char_start = 0, n.char_end = 263, n.word_count = 42;
MERGE (n:Chunk {chunk_id: 'SYN-6977197-027-C01'}) SET n.parent_id = 'SYN-6977197-027', n.parent_kind = 'Note', n.position = 1, n.text = 'January 7 therapy session #2 - Carla Castillo, PT. Tolerated tx well. Progressing w/ HEP. Missed last appt, rescheduled. ROM: Knee/ankle ROM near full, some pain at end range. Goal: Stand a full shift without pain. Reviewed HEP, pt demonstrates correctly. Auth pending w/ Starbucks Corporation.', n.char_start = 0, n.char_end = 294, n.word_count = 46;
MERGE (n:Chunk {chunk_id: 'SYN-6977197-028-C01'}) SET n.parent_id = 'SYN-6977197-028', n.parent_kind = 'Note', n.position = 1, n.text = 'tried clmt again, VM full. -Jamal', n.char_start = 0, n.char_end = 33, n.word_count = 6;
