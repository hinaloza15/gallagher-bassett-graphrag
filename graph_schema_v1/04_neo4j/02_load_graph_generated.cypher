MERGE (n:Chunk {chunk_id: 'SYN-6977137-036-C01'}) SET n.parent_id = 'SYN-6977137-036', n.parent_kind = 'Note', n.position = 1, n.text = 'reserve review med reserve $22,000. indemnity reserve $4,500. reserves unchanged. Olivia requested more authority. ok to keep the reserve as is. paid to date approx $22,000. we should revisit after the next medical.\nDOI December 23, EE tripped on something on floor and went down at retail store. first seen at Hudson Valley Ortho & Rehab on 12/29/2025, dx sprain of rt knee, xray neg for fracture. Off work from December 25. On modified duty from January 10. PT at Summit Rehab & Sports PT started January 5, 7 of 6 authorized visits used so far -CJ', n.char_start = 0, n.char_end = 550, n.word_count = 97;
MERGE (n:Chunk {chunk_id: 'SYN-6977137-037-C01'}) SET n.parent_id = 'SYN-6977137-037', n.parent_kind = 'Note', n.position = 1, n.text = 'Forwarding to file.\nFrom: Sam (front desk) <sam@hudsonvalleyorthorehab.example>\nSent: Wed, Jan 28, 2026 16:49\nTo: Olivia Grant\nSubject: RE: Claim 6977137 - Bennett\n\nHi Olivia,\nNoah Bennett is being seen for sprain of the knee.\nOur billing for $425.00 was sent on Jan 19, please confirm receipt.\nWe are requesting 18 PT visits, please advise.\nAttached is the note from Noah Bennett\'s visit on January 19.\n\nThank you,\nSam (front desk)', n.char_start = 0, n.char_end = 432, n.word_count = 71;
