MERGE (n:Chunk {chunk_id: 'SYN-6977182-051-C01'}) SET n.parent_id = 'SYN-6977182-051', n.parent_kind = 'Note', n.position = 1, n.text = 'STATUS: IW, rt forearm strain, DOI 10/20/2025. file is open.\nMEDICAL: seeing DR Doyle at Rochester Work Injury Clinic; pain 4/10 per last note; forearm tender, weak grip.\nWORK: working regular duty, no issues; restr: no repetitive gripping, lifting to 10 lbs.\nPAY: no lost time, no wage payments, medical bills only.\nLEGAL: no Board activity.\nPENDING: nothing.\nPLAN: continue to monitor, next review January 15.\nHISTORY: DOI 10/20/2025, IW was moving a heavy tote and felt something give at operations facility. First seen at Rochester Work Injury Clinic on 10/27/2025, dx strain of the rt forearm, xray neg. No wage payments, medical bills only, approx $520 paid to date. Contacts: adjuster Marcus Hill, ER contact Paula Nakamura, ER supervisor Lena Brennan, treating DR Doyle. Coverage: Wegmans Food Markets on the risk, Monroe county, operations facility.', n.char_start = 0, n.char_end = 858, n.word_count = 136;
