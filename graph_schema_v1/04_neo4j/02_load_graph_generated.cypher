MERGE (n:Note {note_id: 'SYN-6977197-030'}) SET n.claim_id = '6977197', n.note_date = '2026-01-12', n.note_type = 'Reserve Review', n.author_name = 'Carol Jennings', n.author_role = 'supervisor', n.text = 'reserve review January 12: paid to date approx $15,000. we should revisit after the next medical. -CJ', n.word_count = 17, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977197-031'}) SET n.claim_id = '6977197', n.note_date = '2026-01-13', n.note_type = 'Contact - Injured Worker', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = '1/13/26 outbound call to Camila. Said she slipped on a spill near the counter. Trouble sleeping because of the pain. Still hard to stand or walk for long. Cx says she is not sure she can do the light duty offered, I told her to talk to Dr Lindqvist. Wants to know if she has to go to the IME, told yes and the letter went out.\nDOI 12/15/25, cx slipped on a spill near the counter at retail store. First seen at Hudson Valley Ortho and Rehab on 12/18/25, dx strain of the left knee, xray neg for fracture.', n.word_count = 100, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977197-032'}) SET n.claim_id = '6977197', n.note_date = '2026-01-13', n.note_type = 'Contact - Injured Worker', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'Spoke with Camila by phone. Cx confirmed DOI 12/15/25 at retail store.', n.word_count = 12, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977197-033'}) SET n.claim_id = '6977197', n.note_date = '2026-01-13', n.note_type = 'Contact - Injured Worker', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = '1/13/26 outbound call to Camila. Cx states knee swelling, feels unstable on stairs. Says she saw Dr Lindqvist on 1/6/26. Wants a copy of the C-3, will mail. Asked about the status of the claim, explained it is open. Taking tylenol as needed. Cx says she is not sure she can do the light duty offered, I told her to talk to Dr Lindqvist. Wants to know if she has to go to the IME, told yes and the letter went out. Next appt with Dr Lindqvist is 1/26. Will call back.', n.word_count = 92, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977197-034'}) SET n.claim_id = '6977197', n.note_date = '2026-01-16', n.note_type = 'Contact - Injured Worker', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'Spoke with cx . Says she saw Dr Lindqvist on 1/6/26. Asked who pays for Hudson Valley Ortho & Rehab visits, told Starbucks Corporation pays per fee schedule and to keep receipts. Wants a copy of the C-3, will mail. Asked about the status of the claim, explained it is open, no Board date yet. Worried about the employer cutting hours. Taking tylenol as needed. Back on light duty. Camila confirmed DOI 12/15/25 at retail store. Still hard to stand or walk for long. Cx says she is not sure she can do the light duty offered, I told her to talk to Dr Lindqvist. Wants to know if she has to go to the IME, told yes and the letter went out. Cx says Carla Brennan will call me. Next appt with Dr Lindqvist is 1/26. Will call back.\nDOI 12/15/25, cx slipped on a spill near the counter at retail store. First seen at Hudson Valley Ortho & Rehab on 12/18/25, dx strain of the left knee, xray neg for fracture. On modified duty from 12/17/25. PT at Summit Rehab & Sports PT started 12/31/25, 3 of 6 authorized visits used so far. MRI ordered 1-6-2026, report still pending. Carla Brennan is the worker\'s attorney. No wage payments, medical bills only, approx $620 paid to date. Contacts: Adjuster Olivia Grant, ER contact Dev Sato, ER supervisor Lena Haddad, treating Dr Lindqvist, PT Carla Castillo at Summit Rehab & Sports PT. Coverage: Starbucks Corporation on the risk, Nassau county, retail store. Still waiting on records from prior provider and MRI report.', n.word_count = 262, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977197-035'}) SET n.claim_id = '6977197', n.note_date = '2026-01-19', n.note_type = 'Imaging Result', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'Need to respond to this.\nFrom: Lena (front desk) <lena@hudsonvalleyorthorehab.example>\nSent: Mon, Jan 19, 2026 12:57\nTo: Olivia Grant\nSubject: RE: Claim 6977197 - Morris\n\nHi Olivia,\nCamila Morris is being seen for strain of the knee.\nWork status: working modified duty.\nAttached is the note from Camila Morris\'s visit on 1/6/26.\nNext visit is scheduled for 1/26.\n\nThanks,\nLena (front desk)', n.word_count = 62, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
