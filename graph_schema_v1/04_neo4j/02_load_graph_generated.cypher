MERGE (n:Note {note_id: 'SYN-6977098-092'}) SET n.claim_id = '6977098', n.note_date = '2026-07-14', n.note_type = 'File Review', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = 'STATUS: clmt, rt lower leg contusion, DOI Dec 27. file is open.\nMEDICAL: seeing Dr Fischer at North Shore Occupational Health; pain 0/10 per last note; no complaints.\nWORK: back to full duty; restr: released to full duty, no restrictions.\nPAY: no lost time, no wage payments, medical bills only.\nLEGAL: conciliation held Feb 23, no agreement, Board keeps it open.\nPENDING: nothing.\nPLAN: call Jordan, follow up with Dr Fischer, review again Aug 4.\nHISTORY: DOI Dec 27, Jordan backed the work van into a bollard in the lot at facility parking area. First seen at North Shore Occupational Health on Dec 31, dx contusion of the rt lower leg, xray neg for fracture. On modified duty from 12/29/2025. Back to full duty from Feb 19.', n.word_count = 127, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
