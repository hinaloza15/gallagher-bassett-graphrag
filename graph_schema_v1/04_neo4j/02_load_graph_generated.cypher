MERGE (n:Chunk {chunk_id: 'SYN-6977182-065-C01'}) SET n.parent_id = 'SYN-6977182-065', n.parent_kind = 'Note', n.position = 1, n.text = 'called IW, reached on 2nd try. says he saw DR Doyle on 01/14/2026. asked about the status of claim, explained it is open, no Board date yet. worried about employer cutting hours. taking tylenol as needed. said he was moving a heavy tote and felt something give.\nDOI 10/20/2025, Aaron was moving heavy tote and felt something give at operations facility. first seen at Rochester Work Injury Clinic on 10/27/2025, dx strain of rt forearm, xray neg. no wage payments, medical bills only, approx $575 paid to date. -MH', n.char_start = 0, n.char_end = 514, n.word_count = 89;
