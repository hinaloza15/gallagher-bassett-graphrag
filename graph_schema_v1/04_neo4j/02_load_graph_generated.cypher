MERGE (n:Chunk {chunk_id: 'SYN-6977160-049-C01'}) SET n.parent_id = 'SYN-6977160-049', n.parent_kind = 'Note', n.position = 1, n.text = 'February 18 - RTW: Chloe Nguyen is back to full duty Full duty release expected 3/2 Asked Dr Haddad for updated work status.', n.char_start = 0, n.char_end = 124, n.word_count = 23;
MERGE (n:Chunk {chunk_id: 'SYN-6977160-050-C01'}) SET n.parent_id = 'SYN-6977160-050', n.parent_kind = 'Note', n.position = 1, n.text = 'Legal note February 20: Hearing held February 20, adjourned for medical records. Chloe Nguyen asked if she has to attend - told to check the notice. Chloe notified by letter.', n.char_start = 0, n.char_end = 174, n.word_count = 30;
MERGE (n:Chunk {chunk_id: 'SYN-6977160-051-C01'}) SET n.parent_id = 'SYN-6977160-051', n.parent_kind = 'Note', n.position = 1, n.text = '2-20-2026 - IME update: Dr Haddad may disagree.', n.char_start = 0, n.char_end = 47, n.word_count = 8;
MERGE (n:Chunk {chunk_id: 'SYN-6977160-052-C01'}) SET n.parent_id = 'SYN-6977160-052', n.parent_kind = 'Note', n.position = 1, n.text = 'February 23 Board update: Next hearing is on November 10 notice to employer and Alicia Romano. Nothing else scheduled that I can see.', n.char_start = 0, n.char_end = 133, n.word_count = 23;
MERGE (n:Chunk {chunk_id: 'SYN-6977160-053-C01'}) SET n.parent_id = 'SYN-6977160-053', n.parent_kind = 'Note', n.position = 1, n.text = 'see below\nFrom: Ray Delgado <ray@gbclaims.example>\nSent: Mon, Feb 23, 2026 11:51\nTo: Daniel Brooks\nSubject: RE: Claim 6977160 - Nguyen\n\nHi Daniel,\nSend a status report to State Ins Fund by March 3.\nPlease see the file for Chloe Nguyen, claim 6977160.\nWe need the IME report before the next review.\nPlease confirm the reserve is still $8,500.\n\nRegards,\nRay Delgado', n.char_start = 0, n.char_end = 363, n.word_count = 62;
MERGE (n:Chunk {chunk_id: 'SYN-6977160-054-C01'}) SET n.parent_id = 'SYN-6977160-054', n.parent_kind = 'Note', n.position = 1, n.text = 'February 26 ER call, Ravi Brandt. Chloe is on PTO this week. Employer wants to know if the claim is accepted, told them it is scheduled for a hearing. Frank Nakamura says wage info coming from payroll. Asked Frank Nakamura about restr: No lifting over 20 lbs, limit bending. Employer reported it to SIF on December 14. Employer concerned about overtime coverage. Safety review done, no changes to the warehouse yet. Employer says Chloe missed 9 days last month. Told Frank Nakamura we cant discuss reserves. Asked employer for a copy of the incident report. Frank Nakamura will send the job description. Payroll has not sent the wage statement. I asked Frank Nakamura to put the light duty offer in writing.\nDOI 09DEC25, Chloe was hit at an intersection driving the company vehicle at warehouse. First seen at Upstate Hearing & Balance Center on December 12, dx strain of the low back, hip and both knees, lumbar xray no acute findings. On modified duty from Dec 10. Back to full duty from February 18. MRI ordered Jan 7, result January 18: Mild disc bulge L4-5, no stenosis. IME with Dr Fischer on February 20, report pending. Alicia Romano is the worker\'s attorney. Hearing held February 20. No wage payments, medical bills only, approx $520 paid to date. Contacts: Adjuster Daniel Brooks, ER contact Frank Nakamura, ER supervisor Ravi Brandt, treating Dr Haddad. Coverage: SIF on the risk, Rockland county, warehouse. Still waiting on IME report.', n.char_start = 0, n.char_end = 1449, n.word_count = 245;
MERGE (n:Chunk {chunk_id: 'SYN-6977160-055-C01'}) SET n.parent_id = 'SYN-6977160-055', n.parent_kind = 'Note', n.position = 1, n.text = 'Case mgr note Feb 26 (Susan): Reviewed restrictions: No lifting over 20 lbs, limit bending. Pt agreed to f/u appt 3/2. Med adherence ok (tylenol). Will update Daniel. ER contact: Frank Nakamura. Pain 3/10 per pt.\nDOI 12/9/25, Chloe Nguyen was hit at an intersection driving the company vehicle at warehouse. First seen at Upstate Hearing & Balance Center on December 12, dx strain of the low back, hip and both knees, lumbar xray no acute findings. On modified duty from 12/10/25. Back to full duty from 2/18/26.', n.char_start = 0, n.char_end = 512, n.word_count = 88;
MERGE (n:Chunk {chunk_id: 'SYN-6977160-056-C01'}) SET n.parent_id = 'SYN-6977160-056', n.parent_kind = 'Note', n.position = 1, n.text = 'Work status: Chloe is working regular duty, no issues. Restr per Dr Haddad: No lifting over 20 lbs, limit bending. Full duty release expected 3/2. Asked Dr Haddad for updated work status. Employer should have the new restr in writing.', n.char_start = 0, n.char_end = 234, n.word_count = 40;
MERGE (n:Chunk {chunk_id: 'SYN-6977160-057-C01'}) SET n.parent_id = 'SYN-6977160-057', n.parent_kind = 'Note', n.position = 1, n.text = 'Dr Haddad progress 3/4/26.\nSUBJECTIVE: pt c/o sore all over, stiff in the mornings. pain 3/10. pt states compliant w/ tx.\nOBJECTIVE: paraspinal spasm, FROM limited. MRI: mild disc bulge L4-5, no stenosis. ROM: lumbar flexion limited, extension ok.\nASSESSMENT: strain of the low back, hip and both knees, improving.\nPLAN: tylenol, activity modification. restr: lifting up to 30 lbs ok, no prolonged bending. work status: working regular duty, no issues. f/u 3/17.', n.char_start = 0, n.char_end = 462, n.word_count = 73;
MERGE (n:Chunk {chunk_id: 'SYN-6977160-058-C01'}) SET n.parent_id = 'SYN-6977160-058', n.parent_kind = 'Note', n.position = 1, n.text = 'Case mgr note (Susan): Reviewed restrictions: Lifting up to 30 lbs ok no prolonged bending. next appt 3/20.', n.char_start = 0, n.char_end = 107, n.word_count = 18;
MERGE (n:Chunk {chunk_id: 'SYN-6977160-059-C01'}) SET n.parent_id = 'SYN-6977160-059', n.parent_kind = 'Note', n.position = 1, n.text = 'Spoke with Chloe Nguyen March 5 Asked about the status of the claim, explained it is scheduled for a hearing Worried abuot employer cutting hous Next appt with Dr Haddad is 3/17.', n.char_start = 0, n.char_end = 178, n.word_count = 32;
MERGE (n:Chunk {chunk_id: 'SYN-6977160-060-C01'}) SET n.parent_id = 'SYN-6977160-060', n.parent_kind = 'Note', n.position = 1, n.text = 'Correction to my March 4 note - next appt w/ the Dr is 3/17 not 3/20.', n.char_start = 0, n.char_end = 69, n.word_count = 16;
MERGE (n:Chunk {chunk_id: 'SYN-6977160-061-C01'}) SET n.parent_id = 'SYN-6977160-061', n.parent_kind = 'Note', n.position = 1, n.text = 'Peer review rec\'d 10MAR26 (Dr Fischer). Purpose: Causation + need for further tx for low back, hip and both knees. IME report in: Says tx is reasonable and ongoing. Chloe not happy with the exam, says it lasted 10 min. Dr Haddad may disagree. Need to decide if we dispute. Chloe told to bring imaging and ID. IME fee $22,000.\nDOI December 9, Chloe was hit at an intersection driving the company vehicle at warehouse. First seen at Upstate Hearing & Balance Center on December 12, dx strain of the low back, hip and both knees, lumbar xray no acute findings. On modified duty from December 10. Back to full duty from February 18. MRI ordered January 7, result January 18: Mild disc bulge L4-5, no stenosis. IME with Dr Fischer on February 20, report March 10 says says tx is reasonable and ongoing. Alicia Romano is the worker\'s attorney. Hearing held 20FEB26. No wage payments, medical bills only, approx $575 paid to date. Contacts: Adjuster Daniel Brooks, ER contact Frank Nakamura, ER supervisor Ravi Brandt, treating Dr Haddad. Coverage: State Insurance Fund on the risk, Rockland county, warehouse.', n.char_start = 0, n.char_end = 1103, n.word_count = 189;
MERGE (n:Chunk {chunk_id: 'SYN-6977160-062-C01'}) SET n.parent_id = 'SYN-6977160-062', n.parent_kind = 'Note', n.position = 1, n.text = 'File review March 11. Chloe has a strain of the low back, hip and both knees from 12-9-2025, claim is scheduled for a hearing. Chloe is seeing Dr Haddad at Upstate Hearing & Balance Center and last reported pain at 3/10, pain in the low back, worse by end of shift. Restr are: Lifting up to 30 lbs ok, no prolonged bending. Chloe is working regular duty, no issues. No lost time and no wage payments due. Pending: Nothing. Plan: Call Chloe, follow up with Dr Haddad, review again 04/01/2026.\nDOI December 9, Chloe was hit at an intersection driving the company vehicle at warehouse. First seen at Upstate Hearing & Balance Center on December 12, dx strain of the low back, hip and both knees, lumbar xray no acute findings. On modified duty from December 10. Back to full duty from February 18.', n.char_start = 0, n.char_end = 794, n.word_count = 144;
MERGE (n:Chunk {chunk_id: 'SYN-6977160-063-C01'}) SET n.parent_id = 'SYN-6977160-063', n.parent_kind = 'Note', n.position = 1, n.text = 'Case mgr note (Susan): Reviewed restrictions: Lifting up to 30 lbs ok, no prolonged bending. Pt agreed to f/u appt 3/17. Pain 3/10 per pt.', n.char_start = 0, n.char_end = 138, n.word_count = 25;
MERGE (n:Chunk {chunk_id: 'SYN-6977160-064-C01'}) SET n.parent_id = 'SYN-6977160-064', n.parent_kind = 'Note', n.position = 1, n.text = 'OFFICE NOTE 3/18/26 (Dr Haddad):\nSUBJECTIVE: pt c/o sore all over, stiff in the mornings. pain 3/10. pt states compliant w/ tx.\nOBJECTIVE: paraspinal spasm, FROM limited. MRI: mild disc bulge L4-5, no stenosis. ROM: lumbar flexion limited, extension ok.\nASSESSMENT: strain of the low back, hip and both knees, improving.\nPLAN: tylenol, activity modification. restr: lifting up to 30 lbs ok, no prolonged bending. work status: working regular duty, no issues. f/u 4/3.', n.char_start = 0, n.char_end = 467, n.word_count = 74;
