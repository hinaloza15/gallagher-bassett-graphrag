MERGE (n:Note {note_id: 'SYN-6977118-011'}) SET n.claim_id = '6977118', n.note_date = '2026-01-02', n.note_type = 'Authorization', n.author_name = 'Elena Cruz', n.author_role = 'adjuster', n.text = 'Jan 2 auth: Approved 6 PT visits at Lakeview PT, auth # 27286. MRI auth\'d, Northeast Diagnostic Imaging to schedule.', n.word_count = 20, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977118-012'}) SET n.claim_id = '6977118', n.note_date = '2026-01-05', n.note_type = 'Supervisor Incident Statement', n.author_name = 'Greg Sato', n.author_role = 'ER supervisor', n.text = 'SUP STMT 1/5/26 - Greg Sato. I was on shift 12/27/25. Nina Foster told me she got the low back and both shoulders caught between a pallet and a rack handling stock.', n.word_count = 32, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977118-013'}) SET n.claim_id = '6977118', n.note_date = '2026-01-05', n.note_type = 'Medical Update', n.author_name = 'Dr Whitaker', n.author_role = 'treating provider', n.text = 'Dr Whitaker progress 1/5/26.\nSUBJECTIVE: pt c/o low back and both shoulders sore and stiff. pain 6/10.\nOBJECTIVE: TTP lumbar paraspinals, neg SLR. lumbar xray no acute findings. ROM: lumbar flexion limited, extension ok.\nASSESSMENT: sprain of the low back and both shoulders, no change.\nPLAN: ice, heat, nsaids. restr: no lifting over 10 lbs, no repeated bending. work status: working regular duty, no issues. f/u 1/15.', n.word_count = 67, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977118-014'}) SET n.claim_id = '6977118', n.note_date = '2026-01-06', n.note_type = 'Statement / Investigation', n.author_name = 'Elena Cruz', n.author_role = 'adjuster', n.text = 'Statement from Nina Foster: Nina states she got the low back and both shoulders caught between a pallet and a rack handling stock at office stairwell around around noon Nina said it was end of a long shift Nina understood the statement is recorded.', n.word_count = 44, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977118-015'}) SET n.claim_id = '6977118', n.note_date = '2026-01-07', n.note_type = 'Contact - Employer', n.author_name = 'Elena Cruz', n.author_role = 'adjuster', n.text = 'Need to respond to this.\nFrom: Lena Brandt <lena@orangesupplycooperative.example>\nSent: Wed, Jan 7, 2026 15:19\nTo: Elena Cruz\nSubject: RE: Claim 6977118 - Foster\n\nHi Elena,\nNina Foster was out on PTO this week last week, no call to us.\nPlease send us the restrictions in writing.\nIncident report was sent on 12/31/2025.\n\nRegards,\nLena Brandt', n.word_count = 56, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977118-016'}) SET n.claim_id = '6977118', n.note_date = '2026-01-07', n.note_type = 'Compensability Review', n.author_name = 'Elena Cruz', n.author_role = 'adjuster', n.text = 'Compensability Jan 7: Accepting as work related, the company confirms Nina was on shift. No lost time to date, medical only so far. Statement taken Jan 1. The company report matches Nina\'s account. No witnesses per Greg Sato. Will revisit once the medical comes in. Nina\'s account is consistent with Dr Whitaker\'s first note. We will diary for the wage statement. No signs of a prior injury in the records so far.\nDOI Dec 27, Nina got the low back and both shoulders caught between a pallet and a rack handling stock at office stairwell. First seen at Upstate Joint & Rehab Center on Jan 1, dx sprain of the low back and both shoulders, lumbar xray no acute findings. Still waiting on wage statement from the company and initial medical report from Upstate Joint & Rehab Center.', n.word_count = 138, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977118-017'}) SET n.claim_id = '6977118', n.note_date = '2026-01-09', n.note_type = 'Contact - Employer', n.author_name = 'Elena Cruz', n.author_role = 'adjuster', n.text = 'Rec\'d this today, will call.\nFrom: Lena Brandt <lena@orangesupplycooperative.example>\nSent: Fri, Jan 9, 2026 13:04\nTo: Elena Cruz\nSubject: RE: Claim 6977118 - Foster\n\nHi Elena,\nJob description attached.\nPlease send us the restrictions in writing.\nOur payroll shows Nina Foster earned about $1090 a week before the injury.\nAttached is the wage statement for Nina Foster.\n\nThanks,\nLena Brandt', n.word_count = 60, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977118-018'}) SET n.claim_id = '6977118', n.note_date = '2026-01-09', n.note_type = 'Contact - Injured Worker', n.author_name = 'Elena Cruz', n.author_role = 'adjuster', n.text = 'Jan 9 - spoke with Nina Foster by phone Still hard to bend or lift Asked if Elena is still the adjuster, confirmed Asked her to call Lena Brandt about the light duty at the company.', n.word_count = 36, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977118-019'}) SET n.claim_id = '6977118', n.note_date = '2026-01-09', n.note_type = 'Worker Message', n.author_name = 'Tina Morales', n.author_role = 'assistant', n.text = 'VM from Nina: my appt got moved to 1/15', n.word_count = 9, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977118-020'}) SET n.claim_id = '6977118', n.note_date = '2026-01-09', n.note_type = 'Diary Entry', n.author_name = 'Elena Cruz', n.author_role = 'adjuster', n.text = 'Jan 9 checked eCase nothing new. Last med report Jan 1.', n.word_count = 11, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977118-021'}) SET n.claim_id = '6977118', n.note_date = '2026-01-09', n.note_type = 'Authorization', n.author_name = 'Elena Cruz', n.author_role = 'adjuster', n.text = 'Auth note: Approved 6 PT visits at Lakeview PT, auth # 13305. Dr Whitaker requested more PT, we are checking against the guideline. MG-2 rec\'d for low back and both shoulders, reviewing. MRI auth\'d, Northeast Diagnostic Imaging to schedule. Waiting on the MRI report from Northeast Diagnostic Imaging.', n.word_count = 48, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977118-022'}) SET n.claim_id = '6977118', n.note_date = '2026-01-09', n.note_type = 'Contact - Employer', n.author_name = 'Elena Cruz', n.author_role = 'adjuster', n.text = 'Email from Lena Brandt Jan 9. Nina is on light duty. The company wants to know if the claim is accepted, told them it is open, no Board date yet. Lena Brandt says wage info coming from payroll. Greg Sato says Nina has been late a few times lately. Asked Lena Brandt about restrictions: No lifting over 10 lbs, no repeated bending. The company reported it to POLICE on Jan 2. The company says Nina missed 8 days last month. Lena Brandt says no other injuries like this at the site. Payroll has not sent the wage statement. I asked Lena Brandt to put the light duty offer in writing.\nDOI Dec 27, Nina got the low back and both shoulders caught between a pallet and a rack handling stock at office stairwell. First seen at Upstate Joint & Rehab Center on Jan 1, dx sprain of the low back and both shoulders, lumbar xray no acute findings. Still waiting on wage statement from the company and initial medical report from Upstate Joint & Rehab Center.', n.word_count = 176, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977118-023'}) SET n.claim_id = '6977118', n.note_date = '2026-01-12', n.note_type = 'Pharmacy', n.author_name = 'Pam Whitfield', n.author_role = 'specialist', n.text = 'Pharmacy note (Corner Rx): Flexeril filled, qty 30, $23.25', n.word_count = 9, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977118-024'}) SET n.claim_id = '6977118', n.note_date = '2026-01-12', n.note_type = 'Pharmacy', n.author_name = 'Pam Whitfield', n.author_role = 'specialist', n.text = '01/12/2026 pharmacy note (Corner Rx): Need to confirm flexeril is still needed per Dr Whitaker', n.word_count = 15, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977118-025'}) SET n.claim_id = '6977118', n.note_date = '2026-01-12', n.note_type = 'Therapy Update', n.author_name = 'Lena Castillo', n.author_role = 'physical therapist', n.text = 'January 12 therapy session #1 - Lena Castillo, PT Tolerated tx well Pt reports low back and both shoulders sore and stif Pain 6/10 pre-tx, 6/10 after Did core stabilization, hamstring stretching, bridging + ice Progressing w/ HEP Strength 4/5 Pt arrived late, shoortened session.', n.word_count = 45, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977118-026'}) SET n.claim_id = '6977118', n.note_date = '2026-01-12', n.note_type = 'Bill Question', n.author_name = 'Tina Morales', n.author_role = 'assistant', n.text = 'bill review MRI from Upstate Joint & Rehab Center $64.75 reduced to fee schedule -Tina', n.word_count = 15, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977118-027'}) SET n.claim_id = '6977118', n.note_date = '2026-01-12', n.note_type = 'Contact - Injured Worker', n.author_name = 'Elena Cruz', n.author_role = 'adjuster', n.text = 'Jan 12 - spoke with Nina Foster by phone. Pain about 6/10 today per Nina. Asked who pays for Upstate Joint and Rehab Center visits, told POLICE pays per fee schedule and to keep receipts. Worried about the company cutting hours. Nina confirmed DOI Dec 27 at office stairwell. Still hard to bend or lift. Address and phone confirmed same as file. Nina got a bill for $409.75 from Upstate Joint & Rehab Center, I told her not to pay it, we will check it. Asked her to call Lena Brandt about the light duty at the company. Told to call with any changes.', n.word_count = 104, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
