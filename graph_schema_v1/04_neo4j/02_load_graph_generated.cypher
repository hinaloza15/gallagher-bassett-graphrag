MERGE (n:Chunk {chunk_id: 'SYN-6977121-026-C01'}) SET n.parent_id = 'SYN-6977121-026', n.parent_kind = 'Note', n.position = 1, n.text = 'From: Hector (front desk) <hector@capitalregionoccupationalhealth.example>\nSent: Tue, Jan 6, 2026 14:20\nTo: Daniel Brooks\nSubject: RE: Claim 6977121 - Morgan\n\nHi Daniel,\nPlease confirm authorization for the xray.\nLeo Morgan is being seen for strain of the neck, upper back and shoulder.\nRestrictions remain: no overhead reaching, no lifting over 10 lbs.\n\nRegards,\nHector (front desk)', n.char_start = 0, n.char_end = 383, n.word_count = 56;
