MERGE (n:Chunk {chunk_id: 'SYN-6977098-047-C01'}) SET n.parent_id = 'SYN-6977098-047', n.parent_kind = 'Note', n.position = 1, n.text = 'FYI\nFrom: Hector (front desk) <hector@northshoreoccupationalhealth.example>\nSent: Wed, Feb 11, 2026 14:58\nTo: Maya Patel\nSubject: RE: Claim 6977098 - Lee\n\nHi Maya,\nOur billing for $414 was sent on Jan 27, please confirm receipt.\nPlease confirm authorization for the PT visits.\nNext visit is scheduled for 2/23.\n\nThank you,\nHector (front desk)', n.char_start = 0, n.char_end = 342, n.word_count = 53;
