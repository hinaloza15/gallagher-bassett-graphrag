MERGE (n:Chunk {chunk_id: 'SYN-6977163-011-C01'}) SET n.parent_id = 'SYN-6977163-011', n.parent_kind = 'Note', n.position = 1, n.text = '14NOV25 - RTW: Cx is working w/ restrictions Restr per Dr Haddad: Hearing protection, avoid high-noise areas Mia did 4 days of modified duty then called out Alicia Fischer says light duty available, hours reduced Asked Dr Haddad for updated work status Cx says she isnt ready, pain 8/10 Mia worried about the commute The employer should have the new restrictions in writing.', n.char_start = 0, n.char_end = 374, n.word_count = 63;
MERGE (n:Chunk {chunk_id: 'SYN-6977163-012-C01'}) SET n.parent_id = 'SYN-6977163-012', n.parent_kind = 'Note', n.position = 1, n.text = 'RTW: Restr per Dr Haddad: Hearing protection, avoid high-noise areas. Asked Dr Haddad for updated work status. Cx says she isnt reay, pain 8/10.', n.char_start = 0, n.char_end = 144, n.word_count = 24;
MERGE (n:Chunk {chunk_id: 'SYN-6977163-013-C01'}) SET n.parent_id = 'SYN-6977163-013', n.parent_kind = 'Note', n.position = 1, n.text = 'Rec\'d this today, will call.\nFrom: Alicia Fischer <alicia@orangesupplycooperative.example>\nSent: Mon, Nov 17, 2025 16:01\nTo: Olivia Grant\nSubject: RE: Claim 6977163 - Lopez\n\nHi Olivia,\nOur payroll shows cx earned about $665 a week before the injury.\nWe can offer light duty starting Nov 30, 4 hrs/day.\nPlease confirm whether the claim has been accepted.\nMia was out on light duty last week, no call to us.\n\nThank you,\nAlicia Fischer', n.char_start = 0, n.char_end = 432, n.word_count = 72;
MERGE (n:Chunk {chunk_id: 'SYN-6977163-014-C01'}) SET n.parent_id = 'SYN-6977163-014', n.parent_kind = 'Note', n.position = 1, n.text = 'Dr note rec\'d from Upstate Joint & Rehab Center: Pt c/o ringing and muffled hearing both ears. Audiogram shows high-frequency loss. Meds: OTC pain relievers prn. Pt states compliant w/ tx. C-4.2 to follow. Continue walking program.', n.char_start = 0, n.char_end = 231, n.word_count = 37;
MERGE (n:Chunk {chunk_id: 'SYN-6977163-015-C01'}) SET n.parent_id = 'SYN-6977163-015', n.parent_kind = 'Note', n.position = 1, n.text = 'SUP STMT Nov 17 - Carla Fischer. I was on shift May 1. Mia Lopez told me she has had noise exposure for years on the production floor.', n.char_start = 0, n.char_end = 134, n.word_count = 28;
MERGE (n:Chunk {chunk_id: 'SYN-6977163-016-C01'}) SET n.parent_id = 'SYN-6977163-016', n.parent_kind = 'Note', n.position = 1, n.text = '11/17/25 statement from cx: Cx states she has had noise exposure for years on the production floor at retail store around end of shift. She reported to Carla Fischer right away, told to see Upstate Joint & Rehab Center. Denies prior problems with ears. No other jobs. Cx said it was slow that morning. Supervisor statement requested from Carla Fischer. Cx understood the statement is recorded. Asked cx if she had any trouble with ears before, said no. Cx says she told Carla Fischer before the end of the shift. Pain level that day was about 8/10 per Mia.\nDOI 5/1/15, cx has had noise exposure for years on the production floor at retail store. First seen at Upstate Joint & Rehab Center on Nov 17, dx hearing loss of the ears, audiogram shows high-frequency loss. On modified duty from 11/13/25. Lena Castillo is the worker\'s attorney. Still waiting on wage statement from the employer and initial medical report from Upstate Joint & Rehab Center.', n.char_start = 0, n.char_end = 949, n.word_count = 165;
MERGE (n:Chunk {chunk_id: 'SYN-6977163-017-C01'}) SET n.parent_id = 'SYN-6977163-017', n.parent_kind = 'Note', n.position = 1, n.text = 'Spoke with Mia 11/17/25. Asked who pays for Upstate Joint & Rehab Center visits, told New Hampshire Insurance Co pays per fee schedule and to keep receipts. Taking OTC pain relievers as needed. Said she has had noise exposure for years on the production floor. Asked about mileage reimbursement, told to send C-257 with receipts. Next appt with Dr Haddad is 12/9.\nDOI 5/1/15, cx has had noise exposure for years on the production floor at retail store. First seen at Upstate Joint & Rehab Center on 11/17/25, dx hearing loss of the ears, audiogram shows high-frequency loss.', n.char_start = 0, n.char_end = 574, n.word_count = 98;
MERGE (n:Chunk {chunk_id: 'SYN-6977163-018-C01'}) SET n.parent_id = 'SYN-6977163-018', n.parent_kind = 'Note', n.position = 1, n.text = 'trjed EE again, VM full.', n.char_start = 0, n.char_end = 24, n.word_count = 5;
MERGE (n:Chunk {chunk_id: 'SYN-6977163-019-C01'}) SET n.parent_id = 'SYN-6977163-019', n.parent_kind = 'Note', n.position = 1, n.text = '11/18/25 work status: Restr per Dr Haddad: Hearing protection, avoid high-noise areas Alicia Fischer says light duty available, hours reduced Full duty release expected 12/9.', n.char_start = 0, n.char_end = 174, n.word_count = 25;
MERGE (n:Chunk {chunk_id: 'SYN-6977163-020-C01'}) SET n.parent_id = 'SYN-6977163-020', n.parent_kind = 'Note', n.position = 1, n.text = 'Rec\'d this today, will call.\nFrom: Nora (front desk) <nora@upstatejointrehabcenter.example>\nSent: Wed, Nov 19, 2025 17:23\nTo: Olivia Grant\nSubject: RE: Claim 6977163 - Lopez\n\nHi Olivia,\nAttached is the note from Mia Lopez\'s visit on 11/17/25.\nWork status: working w/ restrictions.\nOur billing for $258.00 was sent on 11/17/25, please confirm receipt.\n\nThank you,\nNora (front desk)', n.char_start = 0, n.char_end = 380, n.word_count = 58;
MERGE (n:Chunk {chunk_id: 'SYN-6977163-021-C01'}) SET n.parent_id = 'SYN-6977163-021', n.parent_kind = 'Note', n.position = 1, n.text = 'Diary 11/19/25: Nothing new from the employer or Upstate Joint & Rehab Center. Cx working modified duty. No concerns re: Compliance. Will call Upstate Joint & Rehab Center if nothing by 11/28/25.', n.char_start = 0, n.char_end = 195, n.word_count = 32;
MERGE (n:Chunk {chunk_id: 'SYN-6977163-022-C01'}) SET n.parent_id = 'SYN-6977163-022', n.parent_kind = 'Note', n.position = 1, n.text = 'FYI\nFrom: Alicia Fischer <alicia@orangesupplycooperative.example>\nSent: Fri, Nov 21, 2025 7:28\nTo: Olivia Grant\nSubject: RE: Claim 6977163 - Lopez\n\nHi Olivia,\nIncident report was sent on 11/14/25.\nOur payroll shwos cx earned aobut $665 a weak before the injury.\n\nRegards,\nAlicia Fischer', n.char_start = 0, n.char_end = 286, n.word_count = 43;
MERGE (n:Chunk {chunk_id: 'SYN-6977163-023-C01'}) SET n.parent_id = 'SYN-6977163-023', n.parent_kind = 'Note', n.position = 1, n.text = 'left message for Dr Haddad\'s office C-4.2 rec\'d -GR', n.char_start = 0, n.char_end = 51, n.word_count = 9;
MERGE (n:Chunk {chunk_id: 'SYN-6977163-024-C01'}) SET n.parent_id = 'SYN-6977163-024', n.parent_kind = 'Note', n.position = 1, n.text = 'Spoke with cx by phone. Cx states ringing and muffled hearing both ears. Trouble sleeping because of the pain. Asked her to call Alicia Fischer about the light duty at the employer.', n.char_start = 0, n.char_end = 181, n.word_count = 32;
MERGE (n:Chunk {chunk_id: 'SYN-6977163-025-C01'}) SET n.parent_id = 'SYN-6977163-025', n.parent_kind = 'Note', n.position = 1, n.text = 'forwarding to file -GR\nFrom: Mia Lopez <mia@mail.example>\nSent: Tue, Nov 25, 2025 17:52\nTo: Olivia Grant\nSubject: RE: Claim 6977163 - Lopez\n\nHello\nmy boss Carla Fischer has not given me light duty yet.\ni went to Upstate Joint & Rehab Center on 11/17/2025.\nplease call me back, my number is the same.\n\nthank you\nMia', n.char_start = 0, n.char_end = 314, n.word_count = 57;
MERGE (n:Chunk {chunk_id: 'SYN-6977163-026-C01'}) SET n.parent_id = 'SYN-6977163-026', n.parent_kind = 'Note', n.position = 1, n.text = 'Decision on claim 6977163: Disputing for now, we need causation support, C-7 sent to the Board. No lost time to date, medical only so far. Statement taken 11/17/25. The employer report matches cx\'s account. No witnesses per Carla Fischer. Cx reported late, notice issue. Will revisit once the medical comes in. Cx\'s account is consistent with Dr Haddad\'s first note. We will diary for the wage statement. No signs of a prior injury in the records so far.\nDOI 5/1/15, cx has had noise exposure for years on the production floor at retail store. First seen at Upstate Joint & Rehab Center on 11/17/25, dx hearing loss of the ears, audiogram shows high-frequency loss. On modified duty from 11/13/25. Lena Castillo is the worker\'s attorney. Still waiting on records from prior provider.', n.char_start = 0, n.char_end = 783, n.word_count = 132;
MERGE (n:Chunk {chunk_id: 'SYN-6977163-027-C01'}) SET n.parent_id = 'SYN-6977163-027', n.parent_kind = 'Note', n.position = 1, n.text = '11/28/25 diary - no change. Mia working w/ restrictions.', n.char_start = 0, n.char_end = 56, n.word_count = 9;
MERGE (n:Chunk {chunk_id: 'SYN-6977163-028-C01'}) SET n.parent_id = 'SYN-6977163-028', n.parent_kind = 'Note', n.position = 1, n.text = '11/28/25 - Upstate Joint & Rehab Center called. Asked Dr Haddad for an', n.char_start = 0, n.char_end = 70, n.word_count = 13;
MERGE (n:Chunk {chunk_id: 'SYN-6977163-029-C01'}) SET n.parent_id = 'SYN-6977163-029', n.parent_kind = 'Note', n.position = 1, n.text = '11/28/25 - spoke with cx by phone. Taking OTC pain relievers as needed. Cx confirmed DOI 5/1/15 at retail store. Cx says she is not sure she can do the light duty offered, I told her to talk to Dr Haddad.', n.char_start = 0, n.char_end = 204, n.word_count = 41;
MERGE (n:Chunk {chunk_id: 'SYN-6977163-030-C01'}) SET n.parent_id = 'SYN-6977163-030', n.parent_kind = 'Note', n.position = 1, n.text = 'Upstate Joint & Rehab Center called. Dr Haddad wants Mia to continue walking program.', n.char_start = 0, n.char_end = 85, n.word_count = 14;
MERGE (n:Chunk {chunk_id: 'SYN-6977163-031-C01'}) SET n.parent_id = 'SYN-6977163-031', n.parent_kind = 'Note', n.position = 1, n.text = 'Need to respond to this.\nFrom: Alicia Fischer <alicia@orangesupplycooperative.example>\nSent: Fri, Nov 28, 2025 15:51\nTo: Olivia Grant\nSubject: RE: Claim 6977163 - Lopez\n\nHi Olivia,\nOur insurer is New Hampshire Insurance Co, adjuster is Olivia.\nMia Lopez has not returned our calls about the modified duty offer.\nWe can offer light duty starting 12/8/25, 4 hrs/day.\nPlease send us the restrictions in writing.\n\nThank you,\nAlicia Fischer', n.char_start = 0, n.char_end = 435, n.word_count = 68;
