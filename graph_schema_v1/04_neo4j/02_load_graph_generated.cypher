MERGE (n:Note {note_id: 'SYN-6977156-081'}) SET n.claim_id = '6977156', n.note_date = '2026-05-01', n.note_type = 'Nurse Case Manager Note', n.author_name = 'Susan Park RN', n.author_role = 'nurse', n.text = 'NCM Susan 5/1/26: Pt reports sore all over, stiff in the mornings. Reviewed restrictions: Lifting up to 30 lbs ok, no prolonged bending.', n.word_count = 23, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977156-082'}) SET n.claim_id = '6977156', n.note_date = '2026-05-04', n.note_type = 'Benefits Payment', n.author_name = 'Pam Whitfield', n.author_role = 'specialist', n.text = '05/04/2026 pmt note (Marcus): Check re-issued, address changed. Clmt called about a late check, $300.50 outstanding.', n.word_count = 16, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977156-083'}) SET n.claim_id = '6977156', n.note_date = '2026-05-08', n.note_type = 'Status Report', n.author_name = 'Marcus Hill', n.author_role = 'adjuster', n.text = 'Subject: Status Report - Claim 6977156 - Emma Rivera\nHi Kevin,\n\nPlease see the update below on Emma Rivera\'s claim (Harborview Community Health, DOI 12/21/2025, operations facility). I have kept the history short, call me if you want more.\n\nCLAIM HISTORY\nDOI 12/21/2025, IW missed the last few steps and fell at operations facility. First seen at North Shore Occupational Health on 12/25/2025, dx strain of the low back, hip and both knees, lumbar xray no acute findings. Off work from 12/22/2025. On modified duty from Jan 15. PT at Summit Rehab & Sports PT started 1/6/26, 16 of 16 authorized visits used so far. MRI ordered 01/12/2026, result 01/24/2026: mild disc bulge L4-5, no stenosis. IME with Dr Iyer on 05MAR26, report 03/20/2026 says supports a work-related injury, no ongoing disability. Lena Alvarez is the worker\'s attorney. Hearing held 03/03/2026.\n\nCURRENT MEDICAL: treating with DR Haddad at North Shore Occupational Health. Pain was 2/10 at the last visit (04/29/2026) and IW reports sore all over, stiff in the mornings. Restrictions: lifting up to 30 lbs ok, no prolonged bending.\nWORK STATUS: Emma is back on light duty.\nBENEFITS: we are paying $710.00/wk.\nLEGAL: judge\'s decision rec\'d after the 04/14/2026 hearing, nothing more needed from us.\nIME: Dr Iyer saw IW and the report says supports a work-related injury, no ongoing disability. We are reviewing whether to dispute any of the ongoing treatment.\nIW is represented by Lena Alvarez, who has asked for the claim file and our position on added treatment. We are responding by letter.\nCONTACTS: adjuster Marcus Hill, ER contact Tasha Kowalski (Harborview Community Health), ER supervisor Greg Romano, treating DR Haddad at North Shore Occupational Health. PT is Lena Mehta at Summit Rehab & Sports PT.\nCOVERAGE: State Ins Fund is on the risk. Claim is in Queens county, injury location operations facility. No prior claims found on Emma.\nOUTSTANDING: nothing.\nRESERVES: no change recommended right now, med reserve $15,000. We will revisit after the next medical report.\nPLAN: continue to monitor, speak with IW and employer again this month, and send the next update by 05/22/2026. Please let me know if you need anything else in the meantime.\n\nThanks,\nMarcus Hill', n.word_count = 366, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977156-084'}) SET n.claim_id = '6977156', n.note_date = '2026-05-15', n.note_type = 'Nurse Case Manager Note', n.author_name = 'Susan Park RN', n.author_role = 'nurse', n.text = '5/15/26 Susan spoke w/ pt. Barrier to RTW: Waiting on specialist appt. ER contact: Tasha Kowalski. Pt attended 16 of 16 PT visits so far.', n.word_count = 25, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
