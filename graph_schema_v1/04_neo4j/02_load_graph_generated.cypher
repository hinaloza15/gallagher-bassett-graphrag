MERGE (n:Chunk {chunk_id: 'SYN-6977163-089-C01'}) SET n.parent_id = 'SYN-6977163-089', n.parent_kind = 'Note', n.position = 1, n.text = 'Rec\'d this today, will call.\nFrom: Alicia Fischer <alicia@orangesupplycooperative.example>\nSent: Mon, Apr 6, 2026 8:34\nTo: Olivia Grant\nSubject: RE: Claim 6977163 - Lopez\n\nHi Olivia,\nPlease send us the restrictions in writing.\nCx was out on light duty last week, no call to us.\nOur insurer is New Hampshire Insurance Co, adjuster is Olivia.\nPlease confirm whether the claim has been accepted.\n\nThanks,\nAlicia Fischer', n.char_start = 0, n.char_end = 416, n.word_count = 66;
MERGE (n:Chunk {chunk_id: 'SYN-6977163-090-C01'}) SET n.parent_id = 'SYN-6977163-090', n.parent_kind = 'Note', n.position = 1, n.text = 'STATUS: cx, ears hearing loss, DOI 5/1/15. file is open, no Board date yet.\nMEDICAL: seeing Dr Haddad at Upstate Joint & Rehab Center; pain 0/10 per last note; feeling much better, occasional soreness.\nWORK: working regular duty, no issues; restr: released to full duty, no restrictions.\nPAY: no lost time, no wage payments, medical bills only.\nLEGAL: judge\'s decision rec\'d after the 3/31/26 hearing, nothing more needed from us.\nPENDING: nothing.\nPLAN: we get the nothing, then close the diary 4/30/26.\nHISTORY: DOI 5/1/15, cx has had noise exposure for years on the production floor at retail store. First seen at Upstate Joint & Rehab Center on 11/17/25, dx hearing loss of the ears, audiogram shows high-frequency loss. On modified duty from 11/13/25. Back to full duty from 12/11/25. IME with Dr Nakamura on 1-30-2026, report 2/12/26 says finds partial disability, recommends more PT. Lena Castillo is the worker\'s attorney. Hearing held 2/2/26. Second hearing 3/31/26. No wage payments, medical bills only, approx $410 paid to date. Contacts: adjuster Olivia Grant, ER contact Alicia Fischer, ER supervisor Carla Fischer, treating Dr Haddad. Coverage: NEW HAMPSHIRE INSURANCE CO on the risk, Allegany county, retail store.', n.char_start = 0, n.char_end = 1229, n.word_count = 195;
