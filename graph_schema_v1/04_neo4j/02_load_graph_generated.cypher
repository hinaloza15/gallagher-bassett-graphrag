MERGE (n:Note {note_id: 'SYN-6977156-087'}) SET n.claim_id = '6977156', n.note_date = '2026-05-18', n.note_type = 'Contact - Employer', n.author_name = 'Marcus Hill', n.author_role = 'adjuster', n.text = 'From: Tasha Kowalski <tasha@harborviewcommunityhealth.example>\nSent: Mon, May 18, 2026 17:22\nTo: Marcus Hill\nSubject: RE: Claim 6977156 - Rivera\n\nHi Marcus,\nOur payroll shows IW earned about $1065 a week before the injury.\nJob description attached.\nEmma Rivera has not returned our calls about the modified duty offer.\n\nThank you,\nTasha Kowalski', n.word_count = 52, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
