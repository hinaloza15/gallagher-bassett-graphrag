MERGE (n:Note {note_id: 'SYN-6977156-079'}) SET n.claim_id = '6977156', n.note_date = '2026-04-22', n.note_type = 'File Review', n.author_name = 'Marcus Hill', n.author_role = 'adjuster', n.text = 'STATUS: IW, low back, hip and both knees strain, DOI 12/21/2025. file is still open.\nMEDICAL: seeing DR Haddad at North Shore Occ Health; pain 3/10 per last note; low back, hip and both knees sore and stiff.\nWORK: back on light duty; restr: no lifting over 20 lbs, limit bending.\nPAY: paying $710.00/wk, approx $11,360 paid to date.\nLEGAL: second hearing 04/14/2026 held, judge reserved decision.\nPENDING: nothing.\nPLAN: we get the nothing, then close the diary 05/22/2026.\nHISTORY: DOI 12/21/2025, Emma missed the last few steps and fell at operations facility. First seen at North Shore Occupational Health on 12-25-2025, dx strain of the low back, hip and both knees, lumbar xray no acute findings. Off work from 12/22/2025. On modified duty from 01/15/2026.', n.word_count = 126, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
