MERGE (n:Chunk {chunk_id: 'SYN-6977175-080-C01'}) SET n.parent_id = 'SYN-6977175-080', n.parent_kind = 'Note', n.position = 1, n.text = 'need to respond to this. -GR\nFrom: Dana (front desk) <dana@northshoreoccupationalhealth.example>\nSent: Mon, Apr 20, 2026 9:29\nTo: Maya Patel\nSubject: RE: Claim 6977175 - Ward\n\nHi Maya,\nAttached is the note from Caleb Ward\'s visit on 02/19/2026.\nPlease confirm authorization for the office visit.\n\nThank you,\nDana (front desk)', n.char_start = 0, n.char_end = 325, n.word_count = 50;
