MERGE (n:Chunk {chunk_id: 'SYN-6977144-071-C01'}) SET n.parent_id = 'SYN-6977144-071', n.parent_kind = 'Note', n.position = 1, n.text = 'STATUS: Priya Shah, neck and low back contusion, DOI 12/26/25. file is open.\nMEDICAL: seeing Dr Okafor at Empire Physical Medicine; pain 1/10 per last note; pain in the neck and low back, worse by end of shift.\nWORK: working regular duty, no issues; restr: released to full duty, no restrictions.\nPAY: no lost time, no wage payments, medical bills only.\nLEGAL: no Board activity.\nPENDING: nothing.\nPLAN: we get the nothing, then close the diary 4/14/26.\nHISTORY: DOI 12/26/25, Priya tripped on something on the floor and went down at service site. First seen at Empire Physical Medicine on 12/30/25, dx contusion of the neck and low back, lumbar xray no acute findings. On modified duty from 12/29/25. Back to full duty from 2/22/26. PT at Riverbend Physical Therapy started 1/12/26, 12 of 12 authorized visits used so far. MRI ordered 1/26/26, result February 7: mild disc bulge L4-5, no stenosis. No wage payments, medical bills only, approx $1,415 paid to date. Contacts: adjuster Priya Shah, ER contact Paula Nakamura, ER supervisor Tasha Okafor, treating Dr Okafor, PT Victor Haddad at Riverbend Physical Therapy. Coverage: WEGMANS FOOD MARKETS on the risk, Monroe county, service site.', n.char_start = 0, n.char_end = 1191, n.word_count = 196;
MERGE (n:Chunk {chunk_id: 'SYN-6977144-072-C01'}) SET n.parent_id = 'SYN-6977144-072', n.parent_kind = 'Note', n.position = 1, n.text = '4/1/26 diary - no change No concerns re: Compliance Will call Empire Physical Medicine if nothing by 4/11/26.', n.char_start = 0, n.char_end = 109, n.word_count = 18;
