MERGE (n:Note {note_id: 'SYN-6977178-056'}) SET n.claim_id = '6977178', n.note_date = '2026-03-24', n.note_type = 'Bill Question', n.author_name = 'Gita Rao', n.author_role = 'assistant', n.text = 'bill review 03/24/2026: ortho consult from Brooklyn Occupational Medicine $380.00 paid per fee schedule. Amtrust Insurance Company paid per fee schedule. mileage request (C-257) rec\'d from EE, forwarded. duplicate bill rec\'d, flagged. EE called worried about bill from Lakeview Pharmacy. $83 reduced to fee schedule $108.00. -GR', n.word_count = 47, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
