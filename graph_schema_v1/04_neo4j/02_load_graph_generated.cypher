MERGE (n:Note {note_id: 'SYN-6977100-010'}) SET n.claim_id = '6977100', n.note_date = '2025-11-25', n.note_type = 'Contact - Employer', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'See below.\nFrom: Carla Lindqvist <carla@hudsonpublicservices.example>\nSent: Tue, Nov 25, 2025 15:13\nTo: Priya Shah\nSubject: RE: Claim 6977100 - Reed\n\nHi Priya,\nOur payroll shows Marcus Reed earned about $1095 a week before the injury.\nJob description attached.\nIncident report was sent on 11/27/25.\n\nThanks,\nCarla Lindqvist', n.word_count = 48, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
