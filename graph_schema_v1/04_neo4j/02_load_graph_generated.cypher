MERGE (n:Note {note_id: 'SYN-6977178-014'}) SET n.claim_id = '6977178', n.note_date = '2025-12-22', n.note_type = 'Medical Update', n.author_name = 'Dr Okafor', n.author_role = 'treating provider', n.text = 'Dr note rec\'d December 22 from Brooklyn Occupational Medicine: ROM: Knee/ankle ROM near full, some pain at end range.', n.word_count = 19, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977178-015'}) SET n.claim_id = '6977178', n.note_date = '2025-12-24', n.note_type = 'Supervisor Incident Statement', n.author_name = 'Joan Brennan', n.author_role = 'ER supervisor', n.text = 'SUP STMT December 24 - Joan Brennan. I was on shift December 16. Julian Bell told me he slipped on ice in the lot and went down. Julian looked like he was in pain, sent him to Brooklyn Occupational Medicine. Location was service site. Julian finished the shift but was favoring it. Julian has been relialbe, no attendance issues. We did a safety huddle the next morning.\nDOI December 16, Julian slipped on ice in the lot and went down at service site. First seen at Brooklyn Occupational Medicine on December 19, dx contusion of the left hip/buttock, xray neg for fracture.', n.word_count = 102, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977178-016'}) SET n.claim_id = '6977178', n.note_date = '2025-12-25', n.note_type = 'Work Status', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'Work status: Julian is back to full duty. Restr per Dr Okafor: No standing over 2 hrs, no ladders, no kneeling. Full duty release expected 1/15. Asked Dr Okafor for updated work status. The company should have the new restrictions in writing.', n.word_count = 42, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977178-017'}) SET n.claim_id = '6977178', n.note_date = '2025-12-25', n.note_type = 'Contact Attempt', n.author_name = 'Gita Rao', n.author_role = 'assistant', n.text = '2nd attempt to reach EE, nothing.', n.word_count = 6, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977178-018'}) SET n.claim_id = '6977178', n.note_date = '2025-12-26', n.note_type = 'Compensability Review', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'Compensability 12/26/25: Accepting as work related, the company confirms Julian was on shift. No lost time to date, medical only so far. Statement taken 12/19/25. The company report matches Julian\'s account. No witnesses per Joan Brennan. Will revisit once the medical comes in. Julian\'s account is consistent with Dr Okafor\'s first note. We will diary for the wage statement. No signs of a prior injury in the records so far.\nDOI 12/16/25, Julian slipped on ice in the lot and went down at service site. First seen at Brooklyn Occupational Medicine on December 19, dx contusion of the left hip/buttock, xray neg for fracture. Still waiting on wage statement from the company and initial medical report from Brooklyn Occupational Medicine.', n.word_count = 120, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977178-019'}) SET n.claim_id = '6977178', n.note_date = '2025-12-26', n.note_type = 'Statement / Investigation', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'Recorded statement Julian Bell 12/26/25: Julian states he slipped on ice in the lot and went down at service site around end of shift. No one saw it, a coworker came over after. Denies prior problems with hip/buttock. Julian said it was raining out. Photos requested, none were taken. Julian understood the statement is recorded.\nDOI 12/16/25, Julian slipped on ice in the lot and went down at service site. First seen at Brooklyn Occupational Medicine on 12/19/25, dx contusion of the left hip/buttock, xray neg for fracture. DOI 12/15/25.', n.word_count = 90, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977178-020'}) SET n.claim_id = '6977178', n.note_date = '2025-12-29', n.note_type = 'Contact - Injured Worker', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = '12/29/25 outbound call to Julian. Julian Bell states sore tailbone area, pain sitting long. Worried about the company cutting hours. Back to full duty. Asked about mileage reimbursement, told to send C-257 with receipts. Address and phone confirmed same as file. Julian understood.\nDOI 12/16/25, Julian slipped on ice in the lot and went down at service site. First seen at Brooklyn Occupational Medicine on Dec 19, dx contusion of the left hip/buttock, xray neg for fracrure. Still waiting on wage statement from the company and records from prior provider.', n.word_count = 90, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977178-021'}) SET n.claim_id = '6977178', n.note_date = '2025-12-29', n.note_type = 'Correction', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'Correction to my Dec 26 note - DOI is 12/16/25 not 12/15/25.', n.word_count = 12, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977178-022'}) SET n.claim_id = '6977178', n.note_date = '2025-12-31', n.note_type = 'Benefits Payment', n.author_name = 'Pam Whitfield', n.author_role = 'specialist', n.text = 'Ledger 12/31/2025: No lost time, no wage payments due.', n.word_count = 9, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977178-023'}) SET n.claim_id = '6977178', n.note_date = '2026-01-07', n.note_type = 'Bill Question', n.author_name = 'Gita Rao', n.author_role = 'assistant', n.text = '01/07/2026 bill rvw (Priya): office visit from Brooklyn Occupational Medicine $277 pended for records. EE called worrried about a bill from Lakeview Pharmacy.', n.word_count = 23, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977178-024'}) SET n.claim_id = '6977178', n.note_date = '2026-01-08', n.note_type = 'Pharmacy', n.author_name = 'Pam Whitfield', n.author_role = 'specialist', n.text = 'Rx check 01/08/2026: Lakeview Pharmacy billed Amtrust Insurance Company directly.', n.word_count = 10, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977178-025'}) SET n.claim_id = '6977178', n.note_date = '2026-01-08', n.note_type = 'Worker Message', n.author_name = 'Gita Rao', n.author_role = 'assistant', n.text = 'voicemail Jan 8 from Julian: i cant sleep bc of my hip/buttock -GR', n.word_count = 13, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977178-026'}) SET n.claim_id = '6977178', n.note_date = '2026-01-15', n.note_type = 'Medical Update', n.author_name = 'Dr Okafor', n.author_role = 'treating provider', n.text = 'Dr note rec\'d January 15 from Brooklyn Occupational Medicine:\nSUBJECTIVE: pt c/o bruising on the buttock and hip, hurts to sit. pain 4/10. pt states compliant w/ tx.\nOBJECTIVE: swelling, TTP over the area, no deformity. xray neg for fracture. ROM: knee/ankle ROM near full, some pain at end range.\nASSESSMENT: contusion of the left hip/buttock, no change.\nPLAN: brace/splint prn, ice. restr: no standing over 2 hrs, no ladders, no kneeling. work status: back to full duty. f/u 2/9.', n.word_count = 80, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977178-027'}) SET n.claim_id = '6977178', n.note_date = '2026-01-16', n.note_type = 'Contact - Injured Worker', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'Julian Bell called in re: Claim 6977178. Julian states bruising on the buttock and hip hurts to sit. Taking naproxen as needed. Asked if Priya is still the adjuster confirmed. next appt 2/8.', n.word_count = 33, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977178-028'}) SET n.claim_id = '6977178', n.note_date = '2026-01-20', n.note_type = 'Supervisor Direction', n.author_name = 'Carol Jennings', n.author_role = 'supervisor', n.text = 'From: Carol Jennings <carol@gbclaims.example>\nSent: Tue, Jan 20, 2026 7:58\nTo: Priya Shah\nSubject: RE: Claim 6977178 - Bell\n\nHi Priya,\nPlease confirm the reserve is still $8,500.\nSend a status report to Amtrust Insurance Company by February 3.\n\nThank you,\nCarol Jennings', n.word_count = 43, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977178-029'}) SET n.claim_id = '6977178', n.note_date = '2026-01-21', n.note_type = 'Reserve Review', n.author_name = 'Carol Jennings', n.author_role = 'supervisor', n.text = 'January 21 reserves - Priya\'s file: increased med reserve bc hearing scheduled. ok to keep the reserve as is. we should revisit after next medical -CJ', n.word_count = 26, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977178-030'}) SET n.claim_id = '6977178', n.note_date = '2026-01-23', n.note_type = 'File Review', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'STATUS: Julian Bell, left hip/buttock contusion, DOI 12/16/2025. file is open.\nMEDICAL: seeing Dr Okafor at Brooklyn Occupational Medicine; pain 4/10 per last note; sore tailbone area, pain sitting long.\nWORK: working regular duty, no issues; restr: no kneeling or squatting, limited stairs.\nPAY: no lost time, no wage payments, medical bills only.\nLEGAL: no Board activity.\nPENDING: records from prior provider.\nPLAN: call Julian, follow up with Dr Okafor, review again 13FEB26.', n.word_count = 73, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977178-031'}) SET n.claim_id = '6977178', n.note_date = '2026-01-23', n.note_type = 'Contact - Injured Worker', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = '1/23/26 - spoke with Julian Bell by phone. Pain about 4/10 todday per Julian. Says he saw Dr Okafor on 1/15/26. Said he slipped on ice in the lot and went down. Asked about mileage reimbursement, told to send C-257 with receipts. Still hard to stand or walk for long. Address and phone confirmed same as file. Next appt with Dr Okafor is 2/9.\nDOI 12/16/25, Julian slipped on ice in the lot and went down at service site. First seen at Brooklyn Occupational Medicine on 12/19/25, dx contusion of the left hip/buttock, xray neg for fracture.', n.word_count = 97, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977178-032'}) SET n.claim_id = '6977178', n.note_date = '2026-01-23', n.note_type = 'Correction', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'Correction to my 1/16/26 note - next appt w/ the Dr is 2/9, not 2/8.', n.word_count = 15, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977178-033'}) SET n.claim_id = '6977178', n.note_date = '2026-01-27', n.note_type = 'Pharmacy', n.author_name = 'Pam Whitfield', n.author_role = 'specialist', n.text = 'Rx check 01/27/2026: Naproxen filled, qty 30, $45.00.', n.word_count = 8, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977178-034'}) SET n.claim_id = '6977178', n.note_date = '2026-02-05', n.note_type = 'Contact - Injured Worker', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'Outbound call to Julian. Julian states hip sore climbing stairs. Says he saw Dr Okafor on 1/15/26. Asked who pays for Brooklyn Occupational Medicine visits, told Amtrust Insurance Company pays per fee schedule and to keep receipts. Taking naproxen as needed. Asked about mileage reimbursement, told to send C-257 with receipts. Trouble sleeping because of the pain. Address and phone confirmed same as file. Asked if Priya is still the adjuster, confirmed. Next appt with Dr Okafor is 2/9. Julian got a bill for $210.50 from Brooklyn Occupational Medicine, I told him not to pay it, we will check it.\nDOI 12/16/25, Julian slipped on ice in the lot and went down at service site. First seen at Brooklyn Occupational Medicine on 12/19/25, dx contusion of the left hip/buttock, xray neg for fracture. No wage payments, medical bills only, approx $410 paid to date. Contacts: Adjuster Priya Shah, ER contact Joan Nakamura, ER supervisor Joan Brennan, treating Dr Okafor. Coverage: Amtrust Insurance Company on the risk, Richmond county, service site.', n.word_count = 170, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977178-035'}) SET n.claim_id = '6977178', n.note_date = '2026-02-10', n.note_type = 'Contact Attempt', n.author_name = 'Gita Rao', n.author_role = 'assistant', n.text = 'emailed Joan Nakamura, no reply yet. -GR', n.word_count = 7, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977178-036'}) SET n.claim_id = '6977178', n.note_date = '2026-02-10', n.note_type = 'Medical Update', n.author_name = 'Dr Okafor', n.author_role = 'treating provider', n.text = 'Dr note rec\'d 02/10/2026 from Brooklyn Occupational Medicine:\nSUBJECTIVE: pt c/o sore tailbone area, pain sitting long. pain 4/10. pt states compliant w/ tx.\nOBJECTIVE: tender, FROM w/ pain at end range. xray neg for fracture. ROM: knee/ankle ROM near full, some pain at end range.\nASSESSMENT: contusion of the left hip/buttock, no change.\nPLAN: ice, heat, nsaids. restr: no kneeling or squatting, limited stairs. work status: back to full duty. f/u 2/26.', n.word_count = 73, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977178-037'}) SET n.claim_id = '6977178', n.note_date = '2026-02-11', n.note_type = 'Status Report', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'Subject: Status Report - Claim 6977178 - Julian Bell\nHi Carla,\n\nPlease see the update below on Julian Bell\'s claim (Empire Logistics, DOI 12/16/25, service site). I have kept the history short, call me if you want more.\n\nCLAIM HISTORY\nDOI 12-16-2025, Julian Bell slipped on ice in the lot and went down at service site. First seen at Brooklyn Occupational Medicine on 12/19/25, dx contusion of the left hip/buttock, xray neg for fracture. No wage payments, medical bills only, approx $465 paid to date. Contacts: adjuster Priya Shah, ER contact Joan Nakamura, ER supervisor Joan Brennan, treating Dr Okafor. Coverage: Amtrust Insurance Company on the risk, Richmond county, service site.\n\nCURRENT MEDICAL: treating with Dr Okafor at Brooklyn Occupational Medicine. Pain was 4/10 at the last visit (2/9/26) and Julian reports sore tailbone area, pain sitting long. Restrictions: no kneeling or squatting, limited stairs.\nWORK STATUS: Julian is working regular duty, no issues.\nBENEFITS: no lost time, no wage benefits due at this point. Medical bills are being paid per the fee schedule.\nLEGAL: no hearings or conciliation set, nothing from the Board that needs a response.\nCONTACTS: adjuster Priya Shah, ER contact Joan Nakamura (Empire Logistics), ER supervisor Joan Brennan, treating Dr Okafor at Brooklyn Occupational Medicine.\nCOVERAGE: Amtrust Insurance Company is on the risk. Claim is in Richmond county, injury location service site. No prior claims found on Julian.\nOUTSTANDING: nothing.\nRESERVES: no change recommended right now, med reserve $6,000. We will revisit after the next medical report.\nPLAN: continue to monitor, speak with Julian and the company again this month, and send the next update by March 13. Please let me know if you need anything else in the meantime.\n\nThanks,\nPriya Shah', n.word_count = 287, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977178-038'}) SET n.claim_id = '6977178', n.note_date = '2026-02-12', n.note_type = 'Bill Question', n.author_name = 'Gita Rao', n.author_role = 'assistant', n.text = 'bill review 02/12/2026: xray from Brooklyn Occupational Medicine $191 reduced to fee schedule. Amtrust Insurance Company paid per fee schhedule. sitll need the records from Brooklyn Occupational Medicine for this. -GR', n.word_count = 31, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977178-039'}) SET n.claim_id = '6977178', n.note_date = '2026-02-13', n.note_type = 'Contact - Provider', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'Can we approve this?\nFrom: Kevin (front desk) <kevin@brooklynoccupationalmedicine.example>\nSent: Fri, Feb 13, 2026 13:18\nTo: Priya Shah\nSubject: RE: Claim 6977178 - Bell\n\nHi Priya,\nWork status: back to full duty.\nAttached is the note from Julian Bell\'s visit on 2/9/26.\n\nRegards,\nKevin (front desk)', n.word_count = 46, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
