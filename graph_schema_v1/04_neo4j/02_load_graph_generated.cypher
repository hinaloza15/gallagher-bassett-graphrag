MERGE (n:Chunk {chunk_id: 'SYN-6977156-027-C01'}) SET n.parent_id = 'SYN-6977156-027', n.parent_kind = 'Note', n.position = 1, n.text = 'called Harborview Community Health, s/w Greg Romano. IW is on light duty. no modified duty offered yet. Greg Romano says IW has been fine, no problems lately. Tasha Kowalski says no other injuries like this at the site. told Tasha Kowalski we cant discuss reserves. Tasha Kowalski will send job description. payroll has not sent the wage statement. no further questions.\nDOI 12/21/2025, IW missed the last few steps and fell at operations facility. First seen at North Shore Occupational Health on 12/25/2025, dx strain of the low back, hip and both knees, lumbar xray no acute findings. -MH', n.char_start = 0, n.char_end = 591, n.word_count = 99;
MERGE (n:Chunk {chunk_id: 'SYN-6977156-028-C01'}) SET n.parent_id = 'SYN-6977156-028', n.parent_kind = 'Note', n.position = 1, n.text = 'OFFICE NOTE 1/14/26 (Dr Haddad): Restr: No lifting over 10 lbs, no repeated bending. ROM: Lumbar flexion limited, extension ok. No new injury reported.', n.char_start = 0, n.char_end = 151, n.word_count = 24;
