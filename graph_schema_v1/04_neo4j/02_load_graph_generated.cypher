MERGE (n:Note {note_id: 'SYN-6977178-065'}) SET n.claim_id = '6977178', n.note_date = '2026-04-07', n.note_type = 'Reserve Review', n.author_name = 'Carol Jennings', n.author_role = 'supervisor', n.text = 'April 7 reserves - Priya\'s file: med reserve $8,500. increased med reserve bc more PT requested. ok to send the status report. -CJ', n.word_count = 23, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977178-066'}) SET n.claim_id = '6977178', n.note_date = '2026-04-21', n.note_type = 'File Review', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'File review 4/21/26. Julian has a contusion of the left hip/buttock from 12/16/25, claim is still open. Julian is seeing Dr Okafor at Brooklyn Occupational Medicine and last reported pain at 0/10, no complaints. Restrictions are: Released to full duty, no restrictions. Julian is working regular duty, no issues. No lost time and no wage payments due. Pending: Nothing. Plan: We get the nothing, then close the diary 5/12/26.\nDOI 12/16/25, Julian slipped on ice in the lot and went down at servicce site. First seen at Brooklyn Occupational Medicine on 12/19/25, dx contusion of the left hip/buttock, xray neg for fracture. No wage payments, medical bills only, approx $520 paid to date. Contacts: Adjuster Priya Shah, ER contact Joan Nakamura, ER supervisor Joan Brennan, treating Dr Okafor.', n.word_count = 128, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977178-067'}) SET n.claim_id = '6977178', n.note_date = '2026-04-27', n.note_type = 'Status Report', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'Subject: Status Report - Claim 6977178 - Julian Bell\nHi Tom,\n\nPlease see the update below on Julian Bell\'s claim (Empire Logistics, DOI 12/16/25, service site). I have kept the history short, call me if you want more.\n\nCLAIM HISTORY\nDOI 12/16/25, Julian Bell slipped on ice in the lot and went down at service site. First seen at Brooklyn Occupational Medicine on 12/19/25, dx contusion of the left hip/buttock, xray neg for fracture. No wage payments, medical bills only, approx $520 paid to date. Contacts: adjuster Priya Shah, ER contact Joan Nakamura, ER supervisor Joan Brennan, treating Dr Okafor. Coverage: Amtrust Insurance Company on the risk, Richmond county, service site.\n\nCURRENT MEDICAL: treating with Dr Okafor at Brooklyn Occupational Medicine. Pain was 0/10 at the last visit (2/26/26) and Julian reports mild stiffness only. Restrictions: released to full duty, no restrictions.\nWORK STATUS: Julian is back to full duty.\nBENEFITS: no lost time, no wage benefits due at this point. Medical bills are being paid per the fee schedule.\nLEGAL: no hearings or conciliation set, nothing from the Board that needs a response.\nCONTACTS: adjuster Priya Shah, ER contact Joan Nakamura (Empire Logistics), ER supervisor Joan Brennan, treating Dr Okafor at Brooklyn Occupational Medicine.\nCOVERAGE: Amtrust Insurance Company is on the risk. Claim is in Richmond county, injury location service site. No prior claims found on Julian.\nOUTSTANDING: nothing.\nRESERVES: no change recommended right now, med reserve $4,500. We will revisit after the next medical report.\nPLAN: continue to monitor, speak with Julian and the company again this month, and send the next update by 27MAY26. Please let me know if you need anything else in the meantime.\n\nThanks,\nPriya Shah', n.word_count = 282, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977178-068'}) SET n.claim_id = '6977178', n.note_date = '2026-05-01', n.note_type = 'Bill Question', n.author_name = 'Gita Rao', n.author_role = 'assistant', n.text = 'From: Lena (front desk) <lena@brooklynoccupationalmedicine.example>\nSent: Fri, May 1, 2026 14:08\nTo: Priya Shah\nSubject: RE: Claim 6977178 - Bell\n\nHi Priya,\nNext visit is scheduled for as needed.\nRestrictions remain: released to full duty, no restrictions.\nPlease confirm authorization for the PT visits.\nOur billing for $262.00 was sent on 02/26/2026, please confirm receeipt.\n\nRegards,\nLena (front desk)', n.word_count = 59, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
