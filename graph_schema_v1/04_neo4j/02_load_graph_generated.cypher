MERGE (n:Note {note_id: 'SYN-6977178-011'}) SET n.claim_id = '6977178', n.note_date = '2025-12-22', n.note_type = 'Contact - Provider', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'See below.\nFrom: Greg (front desk) <greg@brooklynoccupationalmedicine.example>\nSent: Mon, Dec 22, 2025 10:46\nTo: Priya Shah\nSubject: RE: Claim 6977178 - Bell\n\nHi Priya,\nNext visit is scheduled for 1/15.\nOur billing for $154.75 was sent on 12/19/25, pleawe confirm receipt.\nAttached is the note from Julian Bell\'s visit on 12/19/25.\nPlease confrim authorization for the office visit.\n\nThanks,\nGreg (front desk)', n.word_count = 62, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
