MERGE (n:Chunk {chunk_id: 'SYN-6977163-044-C01'}) SET n.parent_id = 'SYN-6977163-044', n.parent_kind = 'Note', n.position = 1, n.text = 'STATUS: cx, ears hearing loss, DOI 5-1-2015. file is open, no Board date yet.\nMEDICAL: seeing Dr Haddad at Upstate Joint & Rehab Center; pain 7/10 per last note; trouble hearing in noisy areas.\nWORK: working regular duty, no issues; restr: hearing protection, annual testing.\nPAY: no lost time, no wage payments, medical bills only.\nLEGAL: first hearing is on Feb 2, notice went to all parties.\nPENDING: nothing.\nPLAN: continue to monitor, next review 1/2/26.\nHISTORY: DOI 5/1/15, cx has had noise exposure for years on the production floor at retail store. First seen at Upstate Joint & Rehab Center on 11/17/25, dx hearing loss of the ears, audiogram shows high-frequency loss. On modified duty from 11/13/25. Back to full duty from December 11.', n.char_start = 0, n.char_end = 747, n.word_count = 125;
MERGE (n:Chunk {chunk_id: 'SYN-6977163-045-C01'}) SET n.parent_id = 'SYN-6977163-045', n.parent_kind = 'Note', n.position = 1, n.text = '2nd attempt to reach EE, nothing -GR', n.char_start = 0, n.char_end = 36, n.word_count = 7;
MERGE (n:Chunk {chunk_id: 'SYN-6977163-046-C01'}) SET n.parent_id = 'SYN-6977163-046', n.parent_kind = 'Note', n.position = 1, n.text = 'Spoke with front desk at Upstate Joint & Rehab Center, they will fax the note Asked Dr Haddad for an updated work status, fax request sent Upstate Joint & Rehab Center rec\'d our auth, visits scheduled.', n.char_start = 0, n.char_end = 201, n.word_count = 36;
MERGE (n:Chunk {chunk_id: 'SYN-6977163-047-C01'}) SET n.parent_id = 'SYN-6977163-047', n.parent_kind = 'Note', n.position = 1, n.text = 'Called Mia, reached on 2nd try. Working regular duty, no issues. Wants to know if she has to go to the IME, told yes and the letter went out. Asked her to call Alicia Fischer about the light duty at the employer.', n.char_start = 0, n.char_end = 212, n.word_count = 42;
MERGE (n:Chunk {chunk_id: 'SYN-6977163-048-C01'}) SET n.parent_id = 'SYN-6977163-048', n.parent_kind = 'Note', n.position = 1, n.text = 'Subject: Status Report - Claim 6977163 - Mia Lopez\nHi Frank,\n\nPlease see the update below on Mia Lopez\'s claim (Orange Supply Cooperative, DOI 5/1/15, retail store). I have kept the history short, call me if you want more.\n\nCLAIM HISTORY\nDOI 5/1/15, cx has had noise exposure for years on the production floor at retail store. First seen at Upstate Joint & Rehab Center on 11/17/25, dx hearing loss of the ears, audiogram shows high-frequency loss. On modified duty from 11/13/25. Back to full duty from December 11. Lena Castillo is the worker\'s attorney. No wage payments, medical bills only, approx $410 paid to date. Contacts: adjuster Olivia Grant, ER contact Alicia Fischer, ER supervisor Carla Fischer, treating Dr Haddad. Coverage: NEW HAMPSHIRE INSURANCE CO on the risk, Allegany county, retail store.', n.char_start = 0, n.char_end = 810, n.word_count = 133;
MERGE (n:Chunk {chunk_id: 'SYN-6977163-048-C02'}) SET n.parent_id = 'SYN-6977163-048', n.parent_kind = 'Note', n.position = 2, n.text = 'CURRENT MEDICAL: treating with Dr Haddad at Upstate Joint & Rehab Center. Pain was 0/10 at the last visit (12/9/25) and cx reports mild stiffness only. Restrictions: released to full duty, no restrictions.\nWORK STATUS: Mia is working regular duty, no issues.\nBENEFITS: no lost time, no wage benefits due at this point. Medical bills are being paid per the fee schedule.\nLEGAL: first hearing is on 2/2/26, notice went to all parties.\ncx is represented by Lena Castillo, who has asked for the claim file and our position on added treatment. We are responding by letter.\nCONTACTS: adjuster Olivia Grant, ER contact Alicia Fischer (Orange Supply Cooperative), ER supervisor Carla Fischer, treating Dr Haddad at Upstate Joint & Rehab Center.\nCOVERAGE: NEW HAMPSHIRE INSURANCE CO is on the risk. Claim is in Allegany county, injury location retail store. No prior claims found on cx.\nOUTSTANDING: nothing.\nRESERVES: no change recommended right now, med reserve $22,000. We will revisit after the next medical report.\nPLAN: continue to monitor, speak with Mia and the employer again this month, and send the next update by 1/30/26. Please let me know if you need anything else in the meantime.\n\nThanks,\nOlivia Grant', n.char_start = 812, n.char_end = 2020, n.word_count = 199;
MERGE (n:Chunk {chunk_id: 'SYN-6977163-049-C01'}) SET n.parent_id = 'SYN-6977163-049', n.parent_kind = 'Note', n.position = 1, n.text = 'bill rvw (Olivia): MRI from Upstate Joint & Rehab Center $176.75 denied - no auth on file. EE called worried about a bill from Harbor Drug. -GR', n.char_start = 0, n.char_end = 143, n.word_count = 27;
MERGE (n:Chunk {chunk_id: 'SYN-6977163-050-C01'}) SET n.parent_id = 'SYN-6977163-050', n.parent_kind = 'Note', n.position = 1, n.text = 'STATUS: cx, ears hearing loss, DOI 5/1/15. file is still open.\nMEDICAL: seeing Dr Haddad at Upstate Joint & Rehab Center; pain 0/10 per last note; no complaints.\nWORK: back to full duty; restr: released to full duty, no restritcions.\nPAY: no lost time, no wage payments, medical bills only.\nLEGAL: first hearing is on 2/2/26, notice went to all parties.\nPENDING: nothing.\nPLAN: continue to monitor, next review 2/2/26.\nHISTORY: DOI 5/1/15, cx has had noise exposure for years on the production floor at retail store. First seen at Upstate Joint & Rehab Center on 11/17/2025, dx heaing loss of the ears, audiogram shows high-frequency loss. On modified duty from 11/13/25. Back to full duty from 12/11/25.', n.char_start = 0, n.char_end = 704, n.word_count = 118;
MERGE (n:Chunk {chunk_id: 'SYN-6977163-051-C01'}) SET n.parent_id = 'SYN-6977163-051', n.parent_kind = 'Note', n.position = 1, n.text = 'IME update: Purpose: Causation + need for further tx for ears. Cx not happy with the exam, says it lasted 10 min. Dr Haddad may disagree. Need to decide if we dispute. Report due approx 2 wks after the exam. Cx told to bring imaging and ID. IME fee $8,500.\nDOI 5/1/15, cx has had noise exposure for years on the production floor at retail store. First seen at Upstate Joint & Rehab Center on 11/17/25, dx hearing loss of the ears, audiogram shows high-frequency loss.', n.char_start = 0, n.char_end = 467, n.word_count = 86;
