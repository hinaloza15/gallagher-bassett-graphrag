MERGE (n:Chunk {chunk_id: 'SYN-6977100-004-C01'}) SET n.parent_id = 'SYN-6977100-004', n.parent_kind = 'Note', n.position = 1, n.text = 'First report: Marcus Reed / Hudson Public Services, DOI 11/21/25, Wesco Insurance Co. Marcus says he tripped on something on the floor and went down at service site. Reported to Carla Brennan same day. Sx: Hand swelling, pain w/ gripping. Treating at Brooklyn Occ Medicine with Dr Osei. The company sent the C-2F, rec\'d 11/25/25. Dx per first visit: Hand injury. No prior claims that I can see. Marcus still working, light tasks only. We have not received any wage info yet. The company says Marcus has worked there a while, no prior injuries per Carla Lindqvist. We need the job description and wage statement from the company. Claim # 6977100, Nassau county. Wage info still needed.\nDOI 11/21/25, Marcus tripped on something on the floor and went down at service site. On modified duty from 11/24/25.', n.char_start = 0, n.char_end = 802, n.word_count = 137;
MERGE (n:Chunk {chunk_id: 'SYN-6977100-005-C01'}) SET n.parent_id = 'SYN-6977100-005', n.parent_kind = 'Note', n.position = 1, n.text = 'prior claims: none, 6977100 is the only one on file', n.char_start = 0, n.char_end = 51, n.word_count = 10;
