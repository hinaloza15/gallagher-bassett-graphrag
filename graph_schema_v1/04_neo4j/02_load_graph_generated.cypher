MERGE (n:Note {note_id: 'SYN-6977197-044'}) SET n.claim_id = '6977197', n.note_date = '2026-02-10', n.note_type = 'Attorney Correspondence', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'Carla Brennan called 2/10/26 re: Cx. Requesting copies of medical, wage statement and C-2F for claim 6977197. Asks status of the hearing before the judge. Wants to know if Starbucks Corporation will authorize more tx.', n.word_count = 35, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977197-045'}) SET n.claim_id = '6977197', n.note_date = '2026-02-10', n.note_type = 'Status Report', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'Subject: Status Report - Claim 6977197 - Camila Morris\nHi Dana,\n\nPlease see the update below on Camila Morris\'s claim (MetroClean Services, DOI 12/15/25, retail store). I have kept the history short, call me if you want more.\n\nCLAIM HISTORY\nDOI 12/15/25, cx slipped on a spill near the counter at retail store. First seen at Hudson Valley Ortho & Rehab on 12/18/25, dx strain of the left knee, xray neg for fracture. On modified duty from 12/17/25. PT at Summit Rehab & Sports PT started 12-31-2025, 8 of 16 authorized visits used so far. MRI ordered 1/6/26, result 1-18-2026: mild effusion, possible meniscus signal change. Carla Brennan is the worker\'s attorney. No wage payments, medical bills only, approx $1,025 paid to date. Contacts: adjuster Olivia Grant, ER contact Dev Sato, ER supervisor Lena Haddad, treating Dr Lindqvist, PT Carla Castillo at Summit Rehab & Sports PT. Coverage: Starbucks Corporation on the risk, Nassau county, retail store.\n\nCURRENT MEDICAL: treating with Dr Lindqvist at Hudson Valley Ortho & Rehab. Pain was 6/10 at the last visit (1/26/26) and cx reports pain at the front of the knee, catches. Restrictions: no kneeling or squatting, limited stairs.\nWORK STATUS: cx is working w/ restrictions.\nBENEFITS: no lost time, no wage benefits due at this point. Medical bills are being paid per the fee schedule.\nLEGAL: first hearing is on February 24, notice went to all parties.\ncx is represented by Carla Brennan, who has asked for the claim file and our position on added treatment. We are responding by letter.\nCONTACTS: adjuster Olivia Grant, ER contact Dev Sato (MetroClean Services), ER supervisor Lena Haddad, treating Dr Lindqvist at Hudson Valley Ortho & Rehab. PT is Carla Castillo at Summit Rehab & Sports PT.\nCOVERAGE: Starbucks Corporation is on the risk. Claim is in Nassau county, injury location retail store. No prior claims found on cx.\nOUTSTANDING: nothing.\nRESERVES: no change recommended right now, med reserve $12,000. We will revisit after the next medical report.\nPLAN: continue to monitor, speak with cx and the employer again this month, and send the next update by 2/24/26. Please let me know if you need anything else in the meantime.\n\nThanks,\nOlivia Grant', n.word_count = 367, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977197-046'}) SET n.claim_id = '6977197', n.note_date = '2026-02-11', n.note_type = 'Diary Entry', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'February 11 checked eCase, nothing new. Cx working modified duty.', n.word_count = 10, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
