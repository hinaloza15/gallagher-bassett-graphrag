MERGE (n:Chunk {chunk_id: 'SYN-6977144-032-C01'}) SET n.parent_id = 'SYN-6977144-032', n.parent_kind = 'Note', n.position = 1, n.text = 'OFFICE NOTE January 21 (Dr Okafor): Exam: Paraspinal spasm, FROM limited. ROM: Lumbar flexion limited, extension ok. C-4.2 to follow.', n.char_start = 0, n.char_end = 133, n.word_count = 20;
MERGE (n:Chunk {chunk_id: 'SYN-6977144-033-C01'}) SET n.parent_id = 'SYN-6977144-033', n.parent_kind = 'Note', n.position = 1, n.text = 'January 23 - auth note: Approved 6 PT visits at Riverbend Physical Therapy, auth # 11203. Dr Okafor requested more PT, we are checking against the guideline. MG-2 rec\'d for neck and low back, reviewing. MRI auth\'d, Northeast Diagnostic Imaging to schedule. Waiting on the MRI report from Northeast Diagnostic Imaging.', n.char_start = 0, n.char_end = 317, n.word_count = 51;
MERGE (n:Chunk {chunk_id: 'SYN-6977144-034-C01'}) SET n.parent_id = 'SYN-6977144-034', n.parent_kind = 'Note', n.position = 1, n.text = 'Rehab note Jan 26: Visit 4 of 6. Pain 3/10 pre-tx, 3/10 after. Did core stabilization, hamstring stretching, bridging + ice. Progressing w/ HEP. ROM: Lumbar flexion limited, extension ok. Pt arrived late, shortened session. Auth pending w/ Wegmans Food Markets.', n.char_start = 0, n.char_end = 261, n.word_count = 41;
MERGE (n:Chunk {chunk_id: 'SYN-6977144-035-C01'}) SET n.parent_id = 'SYN-6977144-035', n.parent_kind = 'Note', n.position = 1, n.text = 'Imaging note lumbar xray no acute findings. Ordered by Dr Okafor. Report faxed to WEGMANS FOOD MARKETS. Radiologist says full report in 2 days. Priya had to reschedule once. Copy to Priya. Bill for $361.75 from Northeast Diagnostic Imaging, sent to bill review.', n.char_start = 0, n.char_end = 261, n.word_count = 43;
