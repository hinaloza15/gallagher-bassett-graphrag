MERGE (n:Note {note_id: 'SYN-6977163-046'}) SET n.claim_id = '6977163', n.note_date = '2025-12-23', n.note_type = 'Contact - Provider', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'Spoke with front desk at Upstate Joint & Rehab Center, they will fax the note Asked Dr Haddad for an updated work status, fax request sent Upstate Joint & Rehab Center rec\'d our auth, visits scheduled.', n.word_count = 36, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977163-047'}) SET n.claim_id = '6977163', n.note_date = '2025-12-25', n.note_type = 'Contact - Injured Worker', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'Called Mia, reached on 2nd try. Working regular duty, no issues. Wants to know if she has to go to the IME, told yes and the letter went out. Asked her to call Alicia Fischer about the light duty at the employer.', n.word_count = 42, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977163-048'}) SET n.claim_id = '6977163', n.note_date = '2025-12-31', n.note_type = 'Status Report', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'Subject: Status Report - Claim 6977163 - Mia Lopez\nHi Frank,\n\nPlease see the update below on Mia Lopez\'s claim (Orange Supply Cooperative, DOI 5/1/15, retail store). I have kept the history short, call me if you want more.\n\nCLAIM HISTORY\nDOI 5/1/15, cx has had noise exposure for years on the production floor at retail store. First seen at Upstate Joint & Rehab Center on 11/17/25, dx hearing loss of the ears, audiogram shows high-frequency loss. On modified duty from 11/13/25. Back to full duty from December 11. Lena Castillo is the worker\'s attorney. No wage payments, medical bills only, approx $410 paid to date. Contacts: adjuster Olivia Grant, ER contact Alicia Fischer, ER supervisor Carla Fischer, treating Dr Haddad. Coverage: NEW HAMPSHIRE INSURANCE CO on the risk, Allegany county, retail store.\n\nCURRENT MEDICAL: treating with Dr Haddad at Upstate Joint & Rehab Center. Pain was 0/10 at the last visit (12/9/25) and cx reports mild stiffness only. Restrictions: released to full duty, no restrictions.\nWORK STATUS: Mia is working regular duty, no issues.\nBENEFITS: no lost time, no wage benefits due at this point. Medical bills are being paid per the fee schedule.\nLEGAL: first hearing is on 2/2/26, notice went to all parties.\ncx is represented by Lena Castillo, who has asked for the claim file and our position on added treatment. We are responding by letter.\nCONTACTS: adjuster Olivia Grant, ER contact Alicia Fischer (Orange Supply Cooperative), ER supervisor Carla Fischer, treating Dr Haddad at Upstate Joint & Rehab Center.\nCOVERAGE: NEW HAMPSHIRE INSURANCE CO is on the risk. Claim is in Allegany county, injury location retail store. No prior claims found on cx.\nOUTSTANDING: nothing.\nRESERVES: no change recommended right now, med reserve $22,000. We will revisit after the next medical report.\nPLAN: continue to monitor, speak with Mia and the employer again this month, and send the next update by 1/30/26. Please let me know if you need anything else in the meantime.\n\nThanks,\nOlivia Grant', n.word_count = 332, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977163-049'}) SET n.claim_id = '6977163', n.note_date = '2026-01-14', n.note_type = 'Bill Question', n.author_name = 'Gita Rao', n.author_role = 'assistant', n.text = 'bill rvw (Olivia): MRI from Upstate Joint & Rehab Center $176.75 denied - no auth on file. EE called worried about a bill from Harbor Drug. -GR', n.word_count = 27, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
