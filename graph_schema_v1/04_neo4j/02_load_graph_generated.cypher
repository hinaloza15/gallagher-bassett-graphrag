MERGE (n:Note {note_id: 'SYN-6977137-102'}) SET n.claim_id = '6977137', n.note_date = '2026-08-10', n.note_type = 'Status Report', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'Subject: Status Report - Claim 6977137 - Noah Bennett\nHi Mei,\n\nPlease see the update below on Noah Bennett\'s claim (Buffalo Care Network, DOI 12/23/25, retail sttore). I have kept the history short, call me if you want more.\n\nCLAIM HISTORY\nDOI 12-23-2025, Noah tripped on something on the floor and went down at retail store. First seen at Hudson Valley Ortho & Rehab on Dec 29, dx sprain of the right knee, xray neg for fracture. Off work from 12/25/25. On modified duty from 01/10/2026. Back to full duty from 5/11/26. PT at Summit Rehab & Sports PT started 01/05/2026, 18 of 18 authorized visits used so far. MRI ordered 1/13/26, result 1/24/26: mild effusion, possible meniscus signal change. Admin determination notice 1/22/26. Weekly payments of $657 started 1/3/26, approx $14,454 paid to date.\n\nCURRENT MEDICAL: treating with Dr Sato at Hudson Valley Ortho & Rehab. Pain was 0/10 at the last visit (5/18/26) and cx reports mild stiffness only. Restrictions: released to full duty, no restrictions.\nWORK STATUS: Noah is back to full duty.\nBENEFITS: no lost time, no wage benefits due at this point. Medical bills are being paid per the fee schedule.\nLEGAL: no hearings or conciliation set, nothing from the Board that needs a response.\nCONTACTS: adjuster Olivia Grant, ER contact Mei Doyle (Buffalo Care Network), ER supervisor Nora Okafor, treating Dr Sato at Hudson Valley Ortho & Rehab. PT is Dev Whitaker at Summit Rehab & Sports PT.\nCOVERAGE: State Insurance Fund is on the risk. Claim is in Franklin county, injury location retail store. No prior claims found on cx.\nOUTSTANDING: nothing.\nRESERVES: no cyange recommended right now, med reserve $4,500. We will revisit after the next medical report.\nPLAN: continue to monitor, speak with cx and the employer again this month, and send the next update by 8/31/26. Please let me know if you need anything else in the meantime.\n\nThanks,\nOlivia Grant', n.word_count = 321, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977137-103'}) SET n.claim_id = '6977137', n.note_date = '2026-08-10', n.note_type = 'File Review', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'STATUS: cx, right knee sprain, DOI 12/23/25. file is still open.\nMEDICAL: seeing Dr Sato at Hudson Valley Ortho & Rehab; pain 0/10 per last note; no complaints.\nWORK: back to full duty; restr: released to full duty, no restrictions.\nPAY: no lost time, no wage payments, medical bills only.\nLEGAL: no Board activity.\nPENDING: nothing.\nPLAN: call cx, follow up with Dr Sato, review again 8/24/26.\nHISTORY: DOI 12/23/25, cx tripped on something on the floor and went down at retail store. First seen at Hudson Valley Ortho & Rehab on 12/29/25, dx sprain of the right knee, xray neg for fracture. Off work from 12/25/25. On modified duty from 1/10/26.', n.word_count = 112, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
