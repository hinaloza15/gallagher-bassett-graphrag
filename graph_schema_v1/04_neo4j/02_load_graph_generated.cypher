MERGE (n:ProcessStep {step_id: 'PS01'}) SET n.name = 'Worker notifies employer of injury', n.rule_text = 'You must notify your employer within 30 days, but it is best to do so as soon as possible.', n.deadline_days = 30, n.deadline_text = 'within 30 days';
MERGE (n:ProcessStep {step_id: 'PS02'}) SET n.name = 'Worker files Form C-3', n.rule_text = 'Form C-3 must be filed within two years of the accident', n.deadline_days = 730, n.deadline_text = 'within two years of the accident';
MERGE (n:ProcessStep {step_id: 'PS03'}) SET n.name = 'Employer reports injury to insurer', n.rule_text = 'Report most injuries and occupational diseases to the employer\'s insurance carrier within 10 days after an accident', n.deadline_days = 10, n.deadline_text = 'within 10 days after an accident';
MERGE (n:ProcessStep {step_id: 'PS04'}) SET n.name = 'Insurer gives worker a written statement of rights', n.rule_text = 'This must be provided within 14 days after the employers\' notification of injury/illness', n.deadline_days = 14, n.deadline_text = 'within 14 days after the employer\'s notification';
MERGE (n:ProcessStep {step_id: 'PS05'}) SET n.name = 'Insurer files notice of controversy to dispute a claim', n.rule_text = 'To contest a claim, an insurer must notify you and file a notice of controversy with the Board within 18 days', n.deadline_text = 'RD02 says 18 days; RD03 also says "a notice of controversy shall be filed with the Board within 25 days". The two time limits run from different start points; check the full text.';
MERGE (n:ProcessStep {step_id: 'PS06'}) SET n.name = 'Insurer starts lost-wage payments when lost time exceeds seven days', n.rule_text = 'The insurer begins the payment of benefits if lost time exceeds seven days.', n.deadline_days = 7, n.deadline_text = 'lost time over seven days';
MERGE (n:ProcessStep {step_id: 'PS07'}) SET n.name = 'Weekly benefit set at two-thirds of average weekly wage', n.rule_text = 'To calculate your benefit, the Board uses two-thirds of your AWW and then adjusts it by your degree of disability.';
MERGE (n:ProcessStep {step_id: 'PS08'}) SET n.name = 'Treatment follows the Medical Treatment Guidelines', n.rule_text = 'Use of the guidelines is mandatory for treatment rendered for conditions for which there is a final effective MTG.';
MERGE (n:ProcessStep {step_id: 'PS09'}) SET n.name = 'Doctor requests a variance before care that differs from the guidelines', n.rule_text = 'A variance must be requested before medical care that varies from the MTGs is provided to the patient', n.deadline_text = 'before the care is provided';
MERGE (n:ProcessStep {step_id: 'PS10'}) SET n.name = 'Worker requests reimbursement of medical travel and expenses', n.rule_text = 'Submit the completed form and copies of all receipts or bills to the workers\' compensation insurance carrier';
MERGE (n:ProcessStep {step_id: 'PS11'}) SET n.name = 'Prior authorization for a drug outside the formulary', n.rule_text = 'A medical provider must obtain prior authorization before prescribing or dispensing a drug other than as described', n.deadline_text = 'before prescribing';
MERGE (n:ProcessStep {step_id: 'PS12'}) SET n.name = 'Law judge hears the case and decides', n.rule_text = 'The judge hears testimony, reviews medical records and wages, then decides on a resolution and the amount of any award.';
MERGE (n:ProcessStep {step_id: 'PS13'}) SET n.name = 'Attorney asks the Board for further action', n.rule_text = 'This form is for use by claimant\'s attorney or licensed representative ONLY.';
MERGE (n:ProcessStep {step_id: 'PS14'}) SET n.name = 'Section 32 settlement negotiated and sent to the Board', n.rule_text = 'A Section 32 Waiver Agreement is a negotiated settlement between you and the insurer.';
MERGE (n:ProcessStep {step_id: 'PS15'}) SET n.name = 'Medicare\'s interests considered in a settlement', n.rule_text = 'When settling a workers\' compensation claim, the parties must take into account Medicare\'s interests.';
MERGE (n:ProcessStep {step_id: 'PS16'}) SET n.name = 'Worker may withdraw from a Section 32 agreement', n.rule_text = 'You have 10 calendar days from the date that the Section 32 Waiver Agreement was submitted to the Board', n.deadline_days = 10, n.deadline_text = '10 calendar days after submission';
MERGE (n:ProcessStep {step_id: 'PS17'}) SET n.name = 'Worker shares restrictions with employer to find duty within limits', n.rule_text = 'Communicate your medical restrictions to your employer for duty options within your limitations.';
MERGE (n:ProcessStep {step_id: 'PS18'}) SET n.name = 'Employer reports changes in pay or work status', n.rule_text = 'Report any changes in an injured worker’s pay or work status to the Board';
MERGE (n:Role {role_name: 'claimant'}) SET n.description = 'Injured worker', n.instance_labels = ['Claimant'];
MERGE (n:Role {role_name: 'claimant_attorney'}) SET n.description = 'Attorney or licensed representative of the claimant', n.instance_labels = ['Attorney'];
MERGE (n:Role {role_name: 'employer'}) SET n.description = 'Employer of the injured worker', n.instance_labels = ['Employer', 'EmployerContact'];
MERGE (n:Role {role_name: 'health_care_provider'}) SET n.description = 'Authorized treating provider', n.instance_labels = ['Clinician', 'HealthcareFacility'];
MERGE (n:Role {role_name: 'insurer'}) SET n.description = 'Insurance carrier, State Insurance Fund or self-insured employer, and its claims administrator', n.instance_labels = ['Carrier', 'ClaimsStaff'];
MERGE (n:Role {role_name: 'workers_compensation_board'}) SET n.description = 'NY Workers\' Compensation Board', n.instance_labels = [];
MERGE (n:Role {role_name: 'workers_compensation_law_judge'}) SET n.description = 'Judge who holds Board hearings', n.instance_labels = [];
MERGE (n:Treatment {treatment_id: 'activity-modification'}) SET n.name = 'activity modification';
MERGE (n:Treatment {treatment_id: 'brace-or-splint'}) SET n.name = 'brace or splint';
MERGE (n:Treatment {treatment_id: 'hearing-protection'}) SET n.name = 'hearing protection';
MERGE (n:Treatment {treatment_id: 'heat'}) SET n.name = 'heat';
MERGE (n:Treatment {treatment_id: 'home-exercise-program'}) SET n.name = 'home exercise program';
MERGE (n:Treatment {treatment_id: 'ice'}) SET n.name = 'ice';
MERGE (n:Treatment {treatment_id: 'orthopedic-consult'}) SET n.name = 'orthopedic consult';
MERGE (n:Treatment {treatment_id: 'physical-therapy'}) SET n.name = 'physical therapy';
MERGE (n:Treatment {treatment_id: 'therapeutic-exercise'}) SET n.name = 'therapeutic exercise';
MERGE (n:Treatment {treatment_id: 'walking-program'}) SET n.name = 'walking program';

