MERGE (n:Chunk {chunk_id: 'SYN-6977163-006-C01'}) SET n.parent_id = 'SYN-6977163-006', n.parent_kind = 'Note', n.position = 1, n.text = 'FYI\nFrom: Lena (front desk) <lena@upstatejointrehabcenter.example>\nSent: Fri, Nov 14, 2025 10:39\nTo: Olivia Grant\nSubject: RE: Claim 6977163 - Lopez\n\nHi Olivia,\nAttached is the note from Mia Lopez\'s visit on 11/13/25.\nWe are requesting 6 PT visits, please advise.\n\nRegards,\nLena (front desk)', n.char_start = 0, n.char_end = 291, n.word_count = 45;
