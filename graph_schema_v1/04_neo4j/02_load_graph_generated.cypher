MERGE (n:Chunk {chunk_id: 'SYN-6977178-075-C01'}) SET n.parent_id = 'SYN-6977178-075', n.parent_kind = 'Note', n.position = 1, n.text = 'STATUS: Julian Bell, left hip/buttock contusion, DOI 12/16/25. file is open, no Board date yet.\nMEDICAL: seeing Dr Okafor at Brooklyn Occupational Medicine; pain 0/10 per last note; no complaints.\nWORK: back to full duty; restr: released to full duty, no restrictions.\nPAY: no lost time, no wage payments, medical bills only.\nLEGAL: no Board activity.\nPENDING: nothing.\nPLAN: call Julian, follow up with Dr Okafor, review again 6/8/26.\nHISTORY: DOI 12/16/25, Julian slipped on ice in the lot and went down at service site. First seen at Brooklyn Occupational Medicine on 12/19/25, dx contusion of the left hip/buttock, xray neg for fracture. No wage payments, medical bills only, approx $520 paid to date. Contacts: adjuster Priya Shah, ER contact Joan Nakamura, ER supervisor Joan Brennan, treating Dr Okafor.', n.char_start = 0, n.char_end = 810, n.word_count = 129;
MERGE (n:Chunk {chunk_id: 'SYN-6977178-076-C01'}) SET n.parent_id = 'SYN-6977178-076', n.parent_kind = 'Note', n.position = 1, n.text = 'bill review MRI from Brooklyn Occupational Medicine $338.75 denied - no auth on file. -GR', n.char_start = 0, n.char_end = 89, n.word_count = 15;
MERGE (n:Chunk {chunk_id: 'SYN-6977178-077-C01'}) SET n.parent_id = 'SYN-6977178-077', n.parent_kind = 'Note', n.position = 1, n.text = 'tried EE again, VM full. -GR', n.char_start = 0, n.char_end = 28, n.word_count = 6;
MERGE (n:Chunk {chunk_id: 'SYN-6977178-078-C01'}) SET n.parent_id = 'SYN-6977178-078', n.parent_kind = 'Note', n.position = 1, n.text = '6/16/26 ER call, Joan Brennan. Joan Nakamura says wage info coming from payroll. Asked Joan Nakamura about restrictions: Released to full duty, no restrictions. The company says Julian Bell missed 4 days last month. Told Joan Nakamura we cant discuss reserves. Payroll has not sent the wage statement. No further questions.\nDOI 12/16/25, Julian slipped on ice in the lot and went down at service site. First seen at Brooklyn Occupational Medicine on 12/19/25, dx contusion of the left hip/buttock, xray neg for fracture. No wage payments, medical bills only, approx $520 paid to date.', n.char_start = 0, n.char_end = 584, n.word_count = 95;
MERGE (n:Chunk {chunk_id: 'SYN-6977178-079-C01'}) SET n.parent_id = 'SYN-6977178-079', n.parent_kind = 'Note', n.position = 1, n.text = 'File review 06/16/2026. Julian has a contusion of the left hip/buttock from 12/16/25, claim is open, no Board date yet. Julian is seeing Dr Okafor at Brooklyn Occupational Medicine and last reported pain at 0/10, feeling much better, occasional soreness. Restrictions are: Released to full duty, no restrictioons. Julian is working regular duty, no issues. No lost time and no wage payments due. Pending: Nothing. Plan: Continue to mnoitor, next review 7/7/26.\nDOI 12/16/25, Julian slipped on ice in the lot and went down at service site. First seen at Brooklyn Occupational Medicine on 12/19/25, dx contusion of the left hip/buttock, xray neg for fracture. No wage payments, medical bills only, approx $520 paid to date. Contacts: Adjuster Priya Shah, ER contact Joan Nakamura, ER supervisor Joan Brennan, treating Dr Okafor.', n.char_start = 0, n.char_end = 826, n.word_count = 131;
MERGE (n:Chunk {chunk_id: 'SYN-6977178-080-C01'}) SET n.parent_id = 'SYN-6977178-080', n.parent_kind = 'Note', n.position = 1, n.text = 'reserve review June 16: Priya requested more authority. -CJ', n.char_start = 0, n.char_end = 59, n.word_count = 9;
MERGE (n:Chunk {chunk_id: 'SYN-6977178-081-C01'}) SET n.parent_id = 'SYN-6977178-081', n.parent_kind = 'Note', n.position = 1, n.text = 'FYI -GR\nFrom: Julian Bell <julian@mail.example>\nSent: Tue, Jun 16, 2026 9:36\nTo: Priya Shah\nSubject: RE: Claim 6977178 - Bell\n\nHello\nplease call me back, my number is the same.\nmy boss Joan Brennan has not given me light duty yet.\nplease let me know when my next check is coming.\nmy hip/buttock is still bothering me, about 0 out of 10.\n\nthank you\nJulian', n.char_start = 0, n.char_end = 354, n.word_count = 66;
MERGE (n:Chunk {chunk_id: 'SYN-6977178-082-C01'}) SET n.parent_id = 'SYN-6977178-082', n.parent_kind = 'Note', n.position = 1, n.text = 'bill review 6/16/26: office visit from Brooklyn Occupational Medicine $117.50 pended for records -GR', n.char_start = 0, n.char_end = 100, n.word_count = 14;
MERGE (n:Chunk {chunk_id: 'SYN-6977178-083-C01'}) SET n.parent_id = 'SYN-6977178-083', n.parent_kind = 'Note', n.position = 1, n.text = 'STATUS: Julian Bell, left hip/buttock contusion, DOI 12-16-2025. file is open.\nMEDICAL: seeing Dr Okafor at Brooklyn Occupational Medicine; pain 0/10 per last note; feeling much better, occasional soreness.\nWORK: working regular duty, no issues; restr: released to full duty, no restrictions.\nPAY: no lost time, no wage payments, medical bills only.\nLEGAL: no Board activity.\nPENDING: nothing.\nPLAN: continue to monitor, next review Jul 27.\nHISTORY: DOI 12/16/25, Julian slipped on ice in the lot and went down at service site. First seen at Brooklyn Occupational Medicine on 12/19/25, dx contusion of the left hip/buttock, xray neg for fracture. No wage payments, medical bills only, approx $520 paid to date. Contacts: adjuster Priya Shah, ER contact Joan Nakamura, ER supervisor Joan Brennan, treating Dr Okafor.', n.char_start = 0, n.char_end = 815, n.word_count = 126;
MERGE (n:Chunk {chunk_id: 'SYN-6977178-084-C01'}) SET n.parent_id = 'SYN-6977178-084', n.parent_kind = 'Note', n.position = 1, n.text = 'Spoke with Juliann Bell 7/14/26. Asked about the status of the claim, explained it is still open. Next appt with Dr Okafor is prn. Asked him to call Joan Nakamura about the light duty at the company.', n.char_start = 0, n.char_end = 199, n.word_count = 37;
MERGE (n:Chunk {chunk_id: 'SYN-6977178-085-C01'}) SET n.parent_id = 'SYN-6977178-085', n.parent_kind = 'Note', n.position = 1, n.text = '7/14/26 outbound call to Julian. Julian Bell states mild stiffness only. Says he saw Dr Okafor on 2/26/26. Asked about the status of the claim, explained it is open, no Board date yet. Worried about the company cutting hours. Taking naproxen as needed. Back to full duty. Still hard to stand or walk for long. Julian understood.\nDOI 12/16/25, Julian slipped on ice in the lot and went down at service site. First seen at Brooklyn Occupational Medicine on 19DEC25, dx contusion of the left hip/buttock, xray neg for fracture.', n.char_start = 0, n.char_end = 524, n.word_count = 90;
MERGE (n:Chunk {chunk_id: 'SYN-6977178-086-C01'}) SET n.parent_id = 'SYN-6977178-086', n.parent_kind = 'Note', n.position = 1, n.text = 'see below -GR\nFrom: Lena (front desk) <lena@brooklynoccupationalmedicine.example>\nSent: Mon, Jul 20, 2026 14:53\nTo: Priya Shah\nSubject: RE: Claim 6977178 - Bell\n\nHi Priya,\nJulian Bell is being seen for contusion of the hip/buttock.\nAttached is the note from Julian Bell\'s visit on 02/26/2026.\nNext visit is scheduled for prn.\n\nThanks,\nLena (front desk)', n.char_start = 0, n.char_end = 352, n.word_count = 55;
