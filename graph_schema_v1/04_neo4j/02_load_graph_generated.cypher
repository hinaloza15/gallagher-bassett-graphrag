MERGE (n:Note {note_id: 'SYN-6977163-043'}) SET n.claim_id = '6977163', n.note_date = '2025-12-19', n.note_type = 'Bill Question', n.author_name = 'Gita Rao', n.author_role = 'assistant', n.text = 'bill review MRI from Upstate Joint & Rehab Center $128.75 paid -GR', n.word_count = 12, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977163-044'}) SET n.claim_id = '6977163', n.note_date = '2025-12-19', n.note_type = 'File Review', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'STATUS: cx, ears hearing loss, DOI 5-1-2015. file is open, no Board date yet.\nMEDICAL: seeing Dr Haddad at Upstate Joint & Rehab Center; pain 7/10 per last note; trouble hearing in noisy areas.\nWORK: working regular duty, no issues; restr: hearing protection, annual testing.\nPAY: no lost time, no wage payments, medical bills only.\nLEGAL: first hearing is on Feb 2, notice went to all parties.\nPENDING: nothing.\nPLAN: continue to monitor, next review 1/2/26.\nHISTORY: DOI 5/1/15, cx has had noise exposure for years on the production floor at retail store. First seen at Upstate Joint & Rehab Center on 11/17/25, dx hearing loss of the ears, audiogram shows high-frequency loss. On modified duty from 11/13/25. Back to full duty from December 11.', n.word_count = 125, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
