MERGE (n:Chunk {chunk_id: 'SYN-6977156-037-C01'}) SET n.parent_id = 'SYN-6977156-037', n.parent_kind = 'Note', n.position = 1, n.text = 'STATUS: IW, low back, hip and both knees strain, DOI 12/21/2025. file is open.\nMEDICAL: seeing DR Haddad at North Shore Occ Health; pain 5/10 per last note; sore all over, stiff in the mornings.\nWORK: working w/ restrictions; restr: no lifting over 10 lbs, no repeated bending.\nPAY: paying $710.00/wk, approx $2,840 paid to date.\nLEGAL: first hearing is on 03/03/2026, notice went to all parties.\nPENDING: auth for more PT visits.\nPLAN: continue to monitor, next review 02/25/2026.\nHISTORY: DOI 12/21/2025, IW missed the last few steps and fell at operations facility. First seen at North Shore Occupational Health on 12/25/2025, dx strain of the low back, hip and both knees, lumbar xray no acute findings. Off work from 12/22/2025. On modified duty from 01/15/2026.', n.char_start = 0, n.char_end = 767, n.word_count = 127;
