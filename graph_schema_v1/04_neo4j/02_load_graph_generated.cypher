MERGE (n:Note {note_id: 'SYN-6977118-054'}) SET n.claim_id = '6977118', n.note_date = '2026-02-11', n.note_type = 'Contact - Injured Worker', n.author_name = 'Elena Cruz', n.author_role = 'adjuster', n.text = 'Feb 11 - spoke with Nina Foster by phone Wants a copy of the C-3, will mail Asked about mileage reimbursement, told to send C-257 with receipts.', n.word_count = 27, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977118-055'}) SET n.claim_id = '6977118', n.note_date = '2026-02-11', n.note_type = 'Work Status', n.author_name = 'Elena Cruz', n.author_role = 'adjuster', n.text = 'Work status: Nina is workijg regular duty no issues. Restr per Dr Whitaker: No lifting over 20 lbs limit bending. Full duty release expected 2/23. Asked Dr Whitaker for updated work status. The company should have the new restrictions in writing.', n.word_count = 41, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977118-056'}) SET n.claim_id = '6977118', n.note_date = '2026-02-16', n.note_type = 'Status Report', n.author_name = 'Elena Cruz', n.author_role = 'adjuster', n.text = 'Subject: Status Report - Claim 6977118 - Nina Foster\nHi Joan,\n\nPlease see the update below on Nina Foster\'s claim (Orange Supply Cooperative, DOI Dec 27, office stairwell). I have kept the history short, call me if you want more.\n\nCLAIM HISTORY\nDOI Dec 27, Nina Foster got the low back and both shoulders caught between a pallet and a rack handling stock at office stairwell. First seen at Upstate Joint & Rehab Center on Jan 1, dx sprain of the low back and both shoulders, lumbar xray no acute findings. PT at Lakeview Physical Therapy started Jan 12, 6 of 12 authorized visits used so far. MRI ordered Jan 19, result Jan 29: mild disc bulge L4-5, no stenosis. No wage payments, medical bills only, approx $885 paid to date. Contacts: adjuster Elena Cruz, ER contact Lena Brandt, ER supervisor Greg Sato, treating Dr Whitaker, PT Lena Castillo at Lakeview Physical Therapy. Coverage: Police on the risk, Kings county, office stairwell. Still waiting on records from prior provider.\n\nCURRENT MEDICAL: treating with Dr Whitaker at Upstate Joint & Rehab Center. Pain was 4/10 at the last visit (09FEB26) and Nina reports pain in the low back and both shoulders, worse by end of shift. Restrictions: no lifting over 20 lbs, limit bending.\nWORK STATUS: Nina is back to full duty.\nBENEFITS: no lost time, no wage benefits due at this point. Medical bills are being paid per the fee schedule.\nLEGAL: no hearings or conciliation set, nothing from the Board that needs a response.\nCONTACTS: adjuster Elena Cruz, ER contact Lena Brandt (Orange Supply Cooperative), ER supervisor Greg Sato, treating Dr Whitaker at Upstate Joint & Rehab Center. PT is Lena Castillo at Lakeview Physical Therapy.\nCOVERAGE: Police is on the risk. Claim is in Kings county, injury location office stairwell. No prior claims found on Nina.\nOUTSTANDING: records from prior provider.\nRESERVES: no change recommended right now, med reserve $15,000. We will revisit after the next medical report.\nPLAN: continue to monitor, speak with Nina and the company again this month, and send the next update by Mar 18. Please let me know if you need anything else in the meantime.\n\nThanks,\nElena Cruz', n.word_count = 366, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977118-057'}) SET n.claim_id = '6977118', n.note_date = '2026-02-16', n.note_type = 'Bill Question', n.author_name = 'Tina Morales', n.author_role = 'assistant', n.text = 'per email, will f/u\nFrom: Carla (front desk) <carla@upstatejointrehabcenter.example>\nSent: Mon, Feb 16, 2026 16:07\nTo: Elena Cruz\nSubject: RE: Claim 6977118 - Foster\n\nHi Elena,\nNina Foster is being seen for sprain of the low back and both shoulders.\nOur billing for $168.75 was sent on 02/09/2026, please confirm receipt.\n\nRegards,\nCarla (front desk)', n.word_count = 55, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
