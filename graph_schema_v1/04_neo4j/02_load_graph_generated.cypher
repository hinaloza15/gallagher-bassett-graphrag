MERGE (n:Note {note_id: 'SYN-6977197-066'}) SET n.claim_id = '6977197', n.note_date = '2026-03-18', n.note_type = 'File Review', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'STATUS: cx, left knee strain, DOI 12/15/25. file is still open.\nMEDICAL: seeing Dr Lindqvist at Hudson Valley Ortho & Rehab; pain 6/10 per last note; knee sore, swelling after standing.\nWORK: back to full duty; restr: no kneeling or squatting, limited stairs.\nPAY: no lost time, no wage payments, medical biols only.\nLEGAL: hearing held Feb 24, adjourned for IME report.\nPENDING: IME report.\nPLAN: we get the IME report, then close the diary 4/8/26.\nHISTORY: DOI 12/15/25, cx slipped on a spill near the counter at retail store. First seen at Hudson Valley Ortho & Rehab on 12/18/25, dx strain of the left knee, xray neg for fracture. On modified duty from 12/17/25. Back to full duty from 3/6/26. PT at Summit Rehab & Sports PT started 12/31/25, 16 of 16 authorized visits used so far. MRI ordered 1/6/26, result 1/18/26: mild effusion, possible meniscus signal change. IME with Dr Doyle on 3/9/26, report pending. Carla Brennan is the worker\'s attorney. Hearing held 2/24/26. No wage payments, medical bills only, approx $1,695 paid to date. Contacts: adjuster Olivia Grant, ER contact Dev Sato, ER supervisor Lena Haddad, treating Dr Lindqvist, PT Carla Castillo at Summit Rehab & Sports PT. Coverage: Starbucks Corporation on the risk, Nassau county, retail store. Still waiting on IME report.', n.word_count = 216, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977197-067'}) SET n.claim_id = '6977197', n.note_date = '2026-03-19', n.note_type = 'IME Note', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = '3/19/26 - IME update: Purpose: Causation + need for further tx for knee. IME report in: Finds partial disability, recommends more PT. Cx not happy with the exam, says it lasted 10 min. Dr Lindqvist may disagree. Need to decide if we dispute. Cx told to bring imaging and ID. IME fee $15,000.\nDOI 12/15/25, cx slipped on a spill near the counter at retail store. First seen at Hudson Valley Ortho & Rehab on 12/18/25, dx strain of the left knee, xray neg for fracture.', n.word_count = 86, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
