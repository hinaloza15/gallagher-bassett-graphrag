MERGE (n:Chunk {chunk_id: 'SYN-6977121-021-C01'}) SET n.parent_id = 'SYN-6977121-021', n.parent_kind = 'Note', n.position = 1, n.text = 'January 2 diary - no change. Last med report December 24. No concerns re: Compliance. Waiting on the wage statement from employer.', n.char_start = 0, n.char_end = 130, n.word_count = 22;
MERGE (n:Chunk {chunk_id: 'SYN-6977121-022-C01'}) SET n.parent_id = 'SYN-6977121-022', n.parent_kind = 'Note', n.position = 1, n.text = 'need to respond to this. -GR\nFrom: Leo Morgan <leo@mail.example>\nSent: Fri, Jan 2, 2026 13:34\nTo: Daniel Brooks\nSubject: RE: Claim 6977121 - Morgan\n\nhi,\ni went to Capital Region Occupational Health on December 24.\nthis is Leo Morgan, claim 6977121.\nmy neck, upper back and shoulder is still bothering me, about 4 out of 10.\n\n\nLeo', n.char_start = 0, n.char_end = 329, n.word_count = 58;
