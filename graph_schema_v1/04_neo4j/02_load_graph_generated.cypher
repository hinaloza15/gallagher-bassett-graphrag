MERGE (n:Chunk {chunk_id: 'SYN-6977156-008-C01'}) SET n.parent_id = 'SYN-6977156-008', n.parent_kind = 'Note', n.position = 1, n.text = '12/24/2025 - DR HADDAD\'S OFFICE. DR HADDAD WANTS IW TO CONTINUE CORE STABILIZATION, HAMSTRING STRETCHING, BRIDGING. -MH', n.char_start = 0, n.char_end = 119, n.word_count = 17;
