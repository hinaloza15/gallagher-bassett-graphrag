MERGE (n:Chunk {chunk_id: 'SYN-6977118-043-C01'}) SET n.parent_id = 'SYN-6977118-043', n.parent_kind = 'Note', n.position = 1, n.text = 'Rec\'d this today, will call.\nFrom: Frank (front desk) <frank@upstatejointrehabcenter.example>\nSent: Tue, Feb 3, 2026 7:39\nTo: Elena Cruz\nSubject: RE: Claim 6977118 - Foster\n\nHi Elena,\nNext visit is scheduled for 2/9.\nPlease confirm authorization for the ortho consult.\n\nThank you,\nFrank (front desk)', n.char_start = 0, n.char_end = 299, n.word_count = 45;
