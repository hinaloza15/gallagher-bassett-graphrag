MERGE (n:Note {note_id: 'SYN-6977197-091'}) SET n.claim_id = '6977197', n.note_date = '2026-06-16', n.note_type = 'File Review', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'STATUS: cx, left knee strain, DOI 12/15/25. file is open.\nMEDICAL: seeing Dr Lindqvist at Hudson Valley Ortho & Rehab; pain 0/10 per last note; no complaints.\nWORK: working regular duty, no issues; restr: released to full duty, no restrictions.\nPAY: no lost time, no wage payments, medical bills only.\nLEGAL: second hearing 4/19/26 held, judge reserved decision.\nPENDING: nothing.\nPLAN: call cx, follow up with Dr Lindqvist, review again 7/16/26.\nHISTORY: DOI 12/15/25, cx slipped on a spill near the counter at retail store. First seen at Hudson Valley Ortho & Rehab on 12/18/25, dx strain of the left knee, xray neg for fracture. On modified duty from 12/17/25. Back to full duty from 3/6/26.', n.word_count = 116, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977197-092'}) SET n.claim_id = '6977197', n.note_date = '2026-06-29', n.note_type = 'Reserve Review', n.author_name = 'Carol Jennings', n.author_role = 'supervisor', n.text = 'June 29 reserves - Olivia\'s file: med reserve $4,500. reserves unchanged. increased med reserve bc IME pending. Olivia requested more authority. ok to close the diary. paid to date approx $22,000. we should revisit after the next medical.\nDOI December 15, EE slipped on a spill near counter at retail store. first seen at Hudson Valley Ortho & Rehab on 12-18-2025, dx strain of lt knee, xray neg for fracture. On modified duty from 17DEC25. Back to full duty from March 6. PT at Summit Rehab & Sports PT started December 31, 16 of 16 authorized visits used so far. -CJ', n.word_count = 101, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977197-093'}) SET n.claim_id = '6977197', n.note_date = '2026-07-06', n.note_type = 'Status Report', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'Subject: Status Report - Claim 6977197 - Camila Morris\nHi Dev,\n\nPlease see the update below on Camila Morris\'s claim (MetroClean Services, DOI 12/15/25, retail store). I have kept the history short, call me if you want more.\n\nCLAIM HISTORY\nDOI 12/15/25, cx slipped on a spill near the counter at retail store. First seen at Hudson Valley Ortho & Rehab on 12/18/25, dx strain of the left knee, xray neg for fracture. On modified duty from 12/17/25. Back to full duty from 3/6/26. PT at Summit Rehab & Sports PT started 12/31/25, 16 of 16 authorized visits used so far. MRI ordered 1/6/26, result 1/18/26: mild effusion, possible meniscus signal change. IME with Dr Doyle on 3/9/26, report 3/19/26 says finds partial disability, recommends more PT. Carla Brennan is the worker\'s attorney. Hearing held 2/24/26.\n\nCURRENT MEDICAL: treating with Dr Lindqvist at Hudson Valley Ortho & Rehab. Pain was 0/10 at the last visit (4/22/26) and cx reports mild stiffness only. Restrictions: released to full duty, no restrictions.\nWORK STATUS: cx is working regular duty, no issues.\nBENEFITS: no lost time, no wage benefits due at this point. Medical bills are being paid per the fee schedule.\nLEGAL: second hearing 4/19/26 held, judge reserved decision.\nIME: Dr Doyle saw cx and the report says finds partial disability, recommends more PT. We are reviewing whether to dispute any of the ongoing treatment.\ncx is represented by Carla Brennan, who has asked for the claim file and our position on added treatment. We are responding by letter.\nCONTACTS: adjuster Olivia Grant, ER contact Dev Sato (MetroClean Services), ER supervisor Lena Haddad, treating Dr Lindqvist at Hudson Valley Ortho & Rehab. PT is Carla Castillo at Summit Rehab & Sports PT.\nCOVERAGE: STARBUCKS CORPORATION is on the risk. Claim is in Nassau county, injury location retail store. No prior claims found on cx.\nOUTSTANDING: nothing.\nRESERVES: no change recommended right now, med reserve $12,000. We will revisit after the next medical report.\nPLAN: continue to monitor, speak with cx and the employer again this month, and send the next update by 7/20/26. Please let me know if you need anything else in the meantime.\n\nThanks,\nOlivia Grant', n.word_count = 365, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977197-094'}) SET n.claim_id = '6977197', n.note_date = '2026-07-13', n.note_type = 'File Review', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'File review 7/13/26. Camila has a strain of the left knee from 12/15/25, claim is open. Camila is seeing Dr Lindqvist at Hudson Valley Ortho & Rehab and last reported pain at 0/10, no complaints. Restrictions are: Released to full duty, no restrictions. Camila is back to full duty. No lost time and no wage payments due. Pending: Nothing. Plan: Call Camila, follow up with Dr Lindqvist, review again 8/12/26.\nDOI 12/15/25, Camila slipped on a spill near the counter at retail store. First seen at Hudson Valley Ortho & Rehab on 12/18/25, dx strain of the left knee, xray neg for fracture. On modified duty from 12/17/25. Back to full duty from 3/6/26. PT at Summit Rehab & Sports PT started 12/31/25, 16 of 16 authorized visits used so far. MRI ordered 1/6/26, result 1/18/26: Mild effusion, possible meniscus signal change. IME with Dr Doyle on 3/9/26, report 3/19/26 says finds partial disability, recommends more PT. Carla Brennan is the worker\'s atty. Hearing held 2/24/26. Second hearing 4/19/26. No wage payments, medical bills only, approx $1,805 paid to date. Contacts: Adjuster Priya Shah, ER contact Dev Sato, ER supervisor Lena Haddad, treating Dr Lindqvist, PT Carla Castillo at Summit Rehab & Sports PT. Coverage: Starbucks Corporation on the risk, Nassau county, retail store.', n.word_count = 214, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977197-095'}) SET n.claim_id = '6977197', n.note_date = '2026-07-23', n.note_type = 'Contact - Injured Worker', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'Called Camila Morris, reached on 2nd try. Says she saw Dr Lindqvist on 4/22/26. Back to full duty. Camila confirmed DOI 12/15/25 at retail store. Said she slipped on a spill near the counter. Trouble sleeping because of the pain. Still hard to stand or walk for long. Asked if Priya is still the adjuster, confirmed. Camila says Carla Brennan will call me.\nDOI 12/15/25, Camila slipped on a spill near the counter at retail store. First seen at Hudson Valley Ortho & Rehab on 12/18/25, dx strain of the left knee, xray neg for fracture.', n.word_count = 96, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977197-096'}) SET n.claim_id = '6977197', n.note_date = '2026-07-23', n.note_type = 'Contact - Employer', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'Called MetroClean Svcs, spoke with Lena Haddad. Camila is on light duty. Safety review done, no changes to the retail store yet. Told Dev Sato we cant discuss reserves.', n.word_count = 29, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
