MERGE (n:Chunk {chunk_id: 'SYN-6977194-024-C01'}) SET n.parent_id = 'SYN-6977194-024', n.parent_kind = 'Note', n.position = 1, n.text = 'bill review 01DEC25: ortho consult from Capital Region Occupational Health $119.75 paid -Jamal', n.char_start = 0, n.char_end = 94, n.word_count = 13;
MERGE (n:Chunk {chunk_id: 'SYN-6977194-025-C01'}) SET n.parent_id = 'SYN-6977194-025', n.parent_kind = 'Note', n.position = 1, n.text = '12/3/25 therapy session #1 - Joan Haddad PT. Tolerated tx well. Pt reports knee sore swelling after standing. Pt arrived early no problems.', n.char_start = 0, n.char_end = 139, n.word_count = 23;
MERGE (n:Chunk {chunk_id: 'SYN-6977194-026-C01'}) SET n.parent_id = 'SYN-6977194-026', n.parent_kind = 'Note', n.position = 1, n.text = 'FYI\nFrom: Mei (front desk) <mei@capitalregionoccupationalhealth.example>\nSent: Wed, Dec 3, 2025 10:23\nTo: Daniel Brooks\nSubject: RE: Claim 6977194 - Bailey\n\nHi Daniel,\nOur biling for $370.75 was sent on 11/24/2025, please confirm receipt.\nRestrictions remain: no stsnding over 2 hrs, no ladders, no kneeling.\nAttached is the note from Naomi Bailey\'s visit on November 24.\n\nThank you,\nMei (front desk)', n.char_start = 0, n.char_end = 400, n.word_count = 61;
MERGE (n:Chunk {chunk_id: 'SYN-6977194-027-C01'}) SET n.parent_id = 'SYN-6977194-027', n.parent_kind = 'Note', n.position = 1, n.text = 'PT visit 2/6 12-8-2025 (Summit Rehab & Sports PT). Tolerated tx well. Pt reports knee swelling, feels unstable on stairs. Pain 5/10 pre-tx, 5/10 after. Did quad sets, straight leg raises, step-ups, stationary bike + ice. Progressing w/ HEP. ROM: Knee/ankle ROM near full, some pain at end range. Strength 4+/5. Pt asked if more visits will be approved.', n.char_start = 0, n.char_end = 352, n.word_count = 59;
MERGE (n:Chunk {chunk_id: 'SYN-6977194-028-C01'}) SET n.parent_id = 'SYN-6977194-028', n.parent_kind = 'Note', n.position = 1, n.text = 'PT visit 3/6 12/11/25 (Summit Rehab and Sports PT). Pt reports knee swelling, feels unstabble on stairs.', n.char_start = 0, n.char_end = 104, n.word_count = 17;
MERGE (n:Chunk {chunk_id: 'SYN-6977194-029-C01'}) SET n.parent_id = 'SYN-6977194-029', n.parent_kind = 'Note', n.position = 1, n.text = '12/15/25 therapy session #4 - Joan Haddad PT. Tolerated tx well. Pain 5/10 pre-tx 5/10 after. Did quad sets straight leg raises step-ups stationary bike + ice. Progressing w/ HEP. Goal: Stand a full shift w/o pain. Reviewed HEP pt demonstrates correctly.', n.char_start = 0, n.char_end = 254, n.word_count = 42;
MERGE (n:Chunk {chunk_id: 'SYN-6977194-030-C01'}) SET n.parent_id = 'SYN-6977194-030', n.parent_kind = 'Note', n.position = 1, n.text = 'OFFICE NOTE 12/15/2025 (Dr Fischer): Pain 5/10. ROM: Knee/ankle ROM near full, some pain at end range. Pt asks about stand or walk for long, advised to modify.', n.char_start = 0, n.char_end = 159, n.word_count = 28;
MERGE (n:Chunk {chunk_id: 'SYN-6977194-031-C01'}) SET n.parent_id = 'SYN-6977194-031', n.parent_kind = 'Note', n.position = 1, n.text = 'Spoke with Naomi December 15. Pain about 5/10 today per Naomi. Says she saw Dr Fischer on November 24. Wants a copy of the C-3, will mail. Worried about employer cutting hours. Taking ibuprofen as needed. Working regular duty, no issues. Said she got grabbed by another person during a transfer. Asked about mkleage reimbursement, told to send C-257 with receipts. Still hard to stand or walk for long. Address and phone confirmed same as file. Asked if Daniel is still the adjuster, confirmed. Naomi got a bill for $53.00 from Capital Region Occupational Health, I told her not to pay it, we will check it. Asked her to call Frank Kowalski about the light duty at employer.\nDOI June 29, Naomi got grabbed by another person during a transfer at warehouse. First seen at Capital Region Occupational Health on 11/24/2025, dx strain of the right knee, xray neg for fracture. PT at Summit Rehab & Sports PT stated December 3, 4 of 6 authorized visits used so far. No wage payments, medical bills only, approx $690 paid to date. Contacts: Adjuster Daniel Brooks, ER contact Frank Kowalski, ER supervisor Dev Alvarez, treating Dr Fischer, PT Joan Haddad at Summit Rehab & Sports PT. Coverage: SIF on the risk, Warren county, warehouse. Still waiting on records from prior provider.', n.char_start = 0, n.char_end = 1275, n.word_count = 219;
MERGE (n:Chunk {chunk_id: 'SYN-6977194-032-C01'}) SET n.parent_id = 'SYN-6977194-032', n.parent_kind = 'Note', n.position = 1, n.text = 'reserves - Daniel\'s file: increased med reserve because IME pending ok to set up the IME paid to date approx $6,000.', n.char_start = 0, n.char_end = 116, n.word_count = 21;
MERGE (n:Chunk {chunk_id: 'SYN-6977194-033-C01'}) SET n.parent_id = 'SYN-6977194-033', n.parent_kind = 'Note', n.position = 1, n.text = 'December 19 - auth note: Approved 6 PT visits at Summit Rehab & Sports PT, auth # 75603. Dr Fischer requested more PT, we are checking against the guideline. MG-2 rec\'d for knee, reviewing.', n.char_start = 0, n.char_end = 189, n.word_count = 34;
MERGE (n:Chunk {chunk_id: 'SYN-6977194-034-C01'}) SET n.parent_id = 'SYN-6977194-034', n.parent_kind = 'Note', n.position = 1, n.text = 'Spoke with Naomi December 22. Says she saw Dr Fischer on December 15. Asked her to call Frank Kowalski about the light duty at emplkyer.', n.char_start = 0, n.char_end = 136, n.word_count = 25;
MERGE (n:Chunk {chunk_id: 'SYN-6977194-035-C01'}) SET n.parent_id = 'SYN-6977194-035', n.parent_kind = 'Note', n.position = 1, n.text = 'Need to respond to this.\nFrom: Frank Kowalski <frank@albanypublicworks.example>\nSent: Mon, Dec 22, 2025 7:52\nTo: Daniel Brooks\nSubject: RE: Claim 6977194 - Bailey\n\nHi Daniel,\nPlease confirm whether the claim has been accepted.\nOur payroll shows Naomi Bailey earned about $1040 a week before the injury.\nPlease send us the restrictions in writing.\nOur insurer is SIF, adjuster is Daniel.\n\nThanks,\nFrank Kowalski', n.char_start = 0, n.char_end = 410, n.word_count = 64;
MERGE (n:Chunk {chunk_id: 'SYN-6977194-036-C01'}) SET n.parent_id = 'SYN-6977194-036', n.parent_kind = 'Note', n.position = 1, n.text = 'From: Tasha (front desk) <tasha@capitalregionoccupationalhealth.example>\nSent: Wed, Dec 24, 2025 11:56\nTo: Daniel Brooks\nSubject: RE: Claim 6977914 - Bailey\n\nHi Daniel,\nRestrictions remain: no kneeling or squatting, limited stairs.\nWork status: working regular duty, no issues.\nAttached is the note from Naomi Bailey\'s visit on 12/15/2025.\n\nThank you,\nTasha (front desk)', n.char_start = 0, n.char_end = 370, n.word_count = 52;
MERGE (n:Chunk {chunk_id: 'SYN-6977194-037-C01'}) SET n.parent_id = 'SYN-6977194-037', n.parent_kind = 'Note', n.position = 1, n.text = 'File review December 25. Naomi has a strain of the right knee from June 29, claim is still open. Naomi is seeing Dr Fischer at Capital Region Occupational Health and last reported pain at 5/10, pain at the front of the knee, catches. Restr are: No kneeling or squatting, limited stairs. Naomi is back to full duty. No lost time and no wage payments due. Pending: Nothing. Plan: We get the nothing, then close the diary January 24.\nDOI June 29, Naomi got grabbed by another person during a transfer at warehouse. First seen at Capital Region Occupational Health on November 24, dx strain of the right knee, xray neg for fracture. PT at Summit Rehab & Sports PT started December 3, 5 of 12 authorized visits used so far. No wage payments, medical bills only, approx $760 paid to date.', n.char_start = 0, n.char_end = 782, n.word_count = 141;
MERGE (n:Chunk {chunk_id: 'SYN-6977194-038-C01'}) SET n.parent_id = 'SYN-6977194-038', n.parent_kind = 'Note', n.position = 1, n.text = 'Rehab note visit 6 of 12. Tolerated tx well. Pt reports pain at the front of the knee, catches. Pt asked if more visits will be approved.', n.char_start = 0, n.char_end = 137, n.word_count = 27;
