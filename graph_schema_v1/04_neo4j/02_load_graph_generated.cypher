MERGE (n:Note {note_id: 'SYN-6977140-022'}) SET n.claim_id = '6977140', n.note_date = '2025-12-24', n.note_type = 'Therapy Update', n.author_name = 'Hector Osei', n.author_role = 'physical therapist', n.text = 'PT visit 2/6 December 24 (Lakeview Physical Therapy). Did pendulums scapular stabilization theraband rows + ice.', n.word_count = 16, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
