MERGE (n:Chunk {chunk_id: 'SYN-6977197-064-C01'}) SET n.parent_id = 'SYN-6977197-064', n.parent_kind = 'Note', n.position = 1, n.text = 'see below. -Jamal\nFrom: Nora (front desk) <nora@hudsonvalleyorthorehab.example>\nSent: Mon, Mar 16, 2026 9:01\nTo: Olivia Grant\nSubject: RE: Claim 6977197 - Morris\n\nHi Olivia,\nAttached is the note from Camila Morris\'s visit on 3/11/26.\nOur billing for $415.00 was sent on 3/11/26, please confirm receipt.\n\nThank you,\nNora (front desk)', n.char_start = 0, n.char_end = 332, n.word_count = 51;
