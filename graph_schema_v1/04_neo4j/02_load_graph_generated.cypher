MERGE (n:Note {note_id: 'SYN-6977178-070'}) SET n.claim_id = '6977178', n.note_date = '2026-05-06', n.note_type = 'Contact - Employer', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'Can we approve this?\nFrom: Joan Nakamura <joan@empirelogistics.example>\nSent: Wed, May 6, 2026 10:19\nTo: Priya Shah\nSubject: RE: Claim 6977178 - Bell\n\nHi Priya,\nPlease confirm whether the claim has been accepted.\nOur payroll shows Julian Bell earned about $890 a week before the injury.\n\nRegards,\nJoan Nakamura', n.word_count = 49, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
