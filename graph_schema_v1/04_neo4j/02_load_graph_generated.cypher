MERGE (n:Note {note_id: 'SYN-6977160-004'}) SET n.claim_id = '6977160', n.note_date = '2025-12-10', n.note_type = 'Prior Claims Check', n.author_name = 'Jamal Webb', n.author_role = 'assistant', n.text = 'Dec 10 prior claims search done, no hits -Jamal', n.word_count = 9, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977160-005'}) SET n.claim_id = '6977160', n.note_date = '2025-12-10', n.note_type = 'First Report Summary', n.author_name = 'Daniel Brooks', n.author_role = 'adjuster', n.text = 'First report: Chloe Nguyen / City Operations Dept, DOI December 9, SIF. Chloe Nguyen says she was hit at an intersection driving the company vehicle at warehouse. Reported to Ravi Brandt same day. Sx: Low back, hip and both knees sore and stiff. Dx per first visit: Strain. No prior claims that I can see. We have not received any wage info yet. Coverage confirmed, SIF is on the risk. We need the job descripttion and wage statement from employer. Diary 14 days.\nDOI December 9, Chloe was hit at an intersection driving the company vehicle at warehouae.', n.word_count = 98, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977160-006'}) SET n.claim_id = '6977160', n.note_date = '2025-12-10', n.note_type = 'Diary Entry', n.author_name = 'Daniel Brooks', n.author_role = 'adjuster', n.text = '12-10-2025 no activity, diary +30. Last med report December 10. No concerns re: Compliance. Will call Upstate Hearing & Balance Center if nothing by 12/16/2025.', n.word_count = 25, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977160-007'}) SET n.claim_id = '6977160', n.note_date = '2025-12-11', n.note_type = 'Contact - Employer', n.author_name = 'Daniel Brooks', n.author_role = 'adjuster', n.text = 'Forwarding to file.\nFrom: Frank Nakamura <frank@cityoperationsdepartment.example>\nSent: Thu, Dec 11, 2025 9:34\nTo: Daniel Brooks\nSubject: RE: Claim 6977160 - Nguyen\n\nHi Daniel,\nPlease confirm whether the clim has been accepted.\nOur payroll shows Chloe Nguyen earned about $690 a week before the injury.\n\nThanks,\nFrank Nakamura', n.word_count = 48, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977160-008'}) SET n.claim_id = '6977160', n.note_date = '2025-12-11', n.note_type = 'Contact - Injured Worker', n.author_name = 'Daniel Brooks', n.author_role = 'adjuster', n.text = 'Called Chloe Nguyen, reached on 2nd try. Asked who pays for Upstate Hearing & Balance Center visits, told State Insurance Fund pays per fee schedule and too keep receipts. Worried about employer cutting hours. Asked about mileage reimbursement, told to send C-257 with receipts. Trouble sleeping because of the pain. Address and phone confirmed same as file. Asked if Daniel is still the adjuster, confirmed. Chloe says she is not sure she can do the light duty offered, I told her to talk to Dr Haddad. Chloe got a bill for $403.75 from Upstate Hearing & Balance Center, I told her not to pay it, we will check it. Chloe understood. next appt 12/14.', n.word_count = 114, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977160-009'}) SET n.claim_id = '6977160', n.note_date = '2025-12-12', n.note_type = 'Contact - Provider', n.author_name = 'Daniel Brooks', n.author_role = 'adjuster', n.text = 'Called Upstate Hearing & Balance Center for records, 5-7 business days.', n.word_count = 11, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977160-010'}) SET n.claim_id = '6977160', n.note_date = '2025-12-12', n.note_type = 'Medical Update', n.author_name = 'Dr Haddad', n.author_role = 'treating provider', n.text = 'Dr note rec\'d 12/12/25 from Upstate Hearing & Balance Center: Pt c/o low back, hip and both knees sore and stiff. Pain 6/10. Lumbar xray no acute findings. Restr: No lifting over 10 lbs, no repeated bending. Work status: Back on light duty. ROM: Lumbar flexion limited, extension ok. RTC 12/29.', n.word_count = 51, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
