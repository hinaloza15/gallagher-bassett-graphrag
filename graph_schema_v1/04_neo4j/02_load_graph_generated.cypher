MERGE (n:Note {note_id: 'SYN-6977098-053'}) SET n.claim_id = '6977098', n.note_date = '2026-02-19', n.note_type = 'Contact - Employer', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = 'From: Rita Haddad <rita@harborviewcommunityhealth.example>\nSent: Thu, Feb 19, 2026 12:28\nTo: Maya Patel\nSubject: RE: Claim 6977098 - Lee\n\nHi Maya,\nIncident report was sent on Dec 29.\nPlease send us the restrictions in writing.\n\nThanks,\nRita Haddad', n.word_count = 38, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977098-054'}) SET n.claim_id = '6977098', n.note_date = '2026-02-19', n.note_type = 'Status Report', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = 'Subject: Status Report - Claim 6977098 - Jordan Lee\nHi Mei,\n\nPlease see the update below on Jordan Lee\'s claim (Harborview Community Health, DOI Dec 27, facility parking area). I have kept the history short, call me if you want more.\n\nCLAIM HISTORY\nDOI Dec 27, clmt backed the work van into a bollard in the lot at facility parking area. First seen at North Shore Occupational Health on Dec 31, dx contusion of the rt lower leg, xray neg for fracture. On modified duty from Dec 29. Back to full duty from Feb 19. PT at Riverbend Physical Therapy started 01/12/2026, 9 of 12 authorized visits used so far. MRI ordered Jan 20, result Feb 1: mild effusion, possible meniscus signal change. No wage payments, medical bills only, approx $1,040 paid to date. Contacts: adjuster Maya Patel, ER contact Rita Haddad, ER supervisor Paula Kowalski, treating Dr Fischer, PT Tom Nakamura at Riverbend Physical Therapy. Coverage: State Insurance Fund on the risk, Nassau county, facility parking area.\n\nCURRENT MEDICAL: treating with Dr Fischer at North Shore Occupational Health. Pain was 3/10 at the last visit (1/27/26) and clmt reports sore over the shin, swelling at end of day. Restrictions: no kneeling or squatting, limited stairs.\nWORK STATUS: clmt is back to full duty.\nBENEFITS: no lost time, no wage benefits due at this point. Medical bills are being paid per the fee schedule.\nLEGAL: conciliation conference is on Feb 23.\nCONTACTS: adjuster Maya Patel, ER contact Rita Haddad (Harborview Community Health), ER supervisor Paula Kowalski, treating Dr Fischer at North Shore Occupational Health. PT is Tom Nakamura at Riverbend Physical Therapy.\nCOVERAGE: State Insurance Fund is on the risk. Claim is in Nassau county, injury location facility parking area. No prior claims found on clmt.\nOUTSTANDING: nothing.\nRESERVES: no change recommended right now, med reserve $6,000. We will revisit after the next medical report.\nPLAN: continue to monitor, speak with clmt and the company again this month, and send the next update by 3/21/26. Please let me know if you need anything else in the meantime.\n\nThanks,\nMaya Patel', n.word_count = 350, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977098-055'}) SET n.claim_id = '6977098', n.note_date = '2026-02-19', n.note_type = 'Work Status', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = 'Feb 19 - RTW: full duty release expected 2/23', n.word_count = 9, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
