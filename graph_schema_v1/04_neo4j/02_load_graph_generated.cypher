MERGE (n:Note {note_id: 'SYN-6977121-008'}) SET n.claim_id = '6977121', n.note_date = '2025-12-23', n.note_type = 'Contact - Employer', n.author_name = 'Daniel Brooks', n.author_role = 'adjuster', n.text = 'From: Victor Alvarez <victor@lakesidecoffeeretail.example>\nSent: Tue, Dec 23, 2025 8:04\nTo: Daniel Brooks\nSubject: RE: Claim 6977121 - Morgan\n\nHi Daniel,\nIncident report was sent on December 25.\nOur insurer is Hartford Casualty Insurance Co, adjuster is Daniel.\nPlease confirm whether the claim has been accepted.\n\nThank you,\nVictor Alvarez', n.word_count = 50, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977121-009'}) SET n.claim_id = '6977121', n.note_date = '2025-12-23', n.note_type = 'Worker Message', n.author_name = 'Gita Rao', n.author_role = 'assistant', n.text = 'email from Leo 12/23/2025: calling about my claim 6977121. my neck upper back and shoulder still hurts when i reach overhead or lift. nobody called me back about the wage statement from ER. my boss Alicia Whitaker keeps asking when i can come back. my number changed new one is on file now. flexeril is not really helping. i need to know who to talk to about mileage. i cant sleep bc of my neck upper back and shoulder -GR', n.word_count = 80, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977121-010'}) SET n.claim_id = '6977121', n.note_date = '2025-12-23', n.note_type = 'Contact - Injured Worker', n.author_name = 'Daniel Brooks', n.author_role = 'adjuster', n.text = '12/23/2025 outbound call to Leo Asked about mileage reimbursement, told to send C-257 with receipts.', n.word_count = 15, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977121-011'}) SET n.claim_id = '6977121', n.note_date = '2025-12-24', n.note_type = 'Contact - Provider', n.author_name = 'Daniel Brooks', n.author_role = 'adjuster', n.text = 'December 24 called Capital Region Occupational Health for records, 5-7 business days. Asked Dr Lindqvist for an updated work status, fax request sent. Capital Region Occupational Health billing called about a denied visit, referred to Hartford Casualty Insurance Co. Capital Region Occupational Health says Leo Morgan no showed the last appt. Records rec\'d from Capital Region Occupational Health, 13 pages. Need the C-4.2 from Dr Lindqvist. Dr Lindqvist wants Leo to continue pendulums, scapular stabilization, theraband rows. Capital Region Occupational Health sent a bill for $137.75, forwarded to bill review.', n.word_count = 90, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977121-012'}) SET n.claim_id = '6977121', n.note_date = '2025-12-24', n.note_type = 'Medical Update', n.author_name = 'Dr Lindqvist', n.author_role = 'treating provider', n.text = 'Dr Lindqvist progress 12/24/2025.\nSUBJECTIVE: pt c/o neck, upper back and shoulder sore and stiff. pain 4/10. pt states compliant w/ tx.\nOBJECTIVE: TTP, ROM limited overhead. xray neg. ROM: ROM improving, still guarded overhead.\nASSESSMENT: strain of the neck, upper back and shoulder, no change.\nPLAN: flexeril, activity modification. restr: no overhead reaching, no lifting over 10 lbs. work status: back to full duty. f/u 1/7.', n.word_count = 67, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977121-013'}) SET n.claim_id = '6977121', n.note_date = '2025-12-24', n.note_type = 'Work Status', n.author_name = 'Daniel Brooks', n.author_role = 'adjuster', n.text = 'December 24 - RTW: Leo is back to full duty. Restr per Dr Lindqvist: No overhead reaching, no lifting over 10 lbs. Full duty release expected 1/7. Asked Dr Lindqvist for updated work status. Employer should have the new restr in writing.', n.word_count = 42, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977121-014'}) SET n.claim_id = '6977121', n.note_date = '2025-12-26', n.note_type = 'Supervisor Incident Statement', n.author_name = 'Alicia Whitaker', n.author_role = 'ER supervisor', n.text = 'SUP STMT Alicia Whitaker. I was on shift December 19. Leo told me he was repositioning stock and felt a pull. I did not see it happen. Leo looked like he was in pain, sent him to Capital Region Occupational Health. No other witnesses that i know of. Location was warehouse. Incident form given to Victor Alvarez. No prior complaints that i recall. Leo finished the shift but was favoring it. The floor was dry that day as far as i know. Leo has been reliable, no attendance issues. We did a safety huddle the next morning. I can send the schedule for that week if needed. Signed Alicia Whitaker\nDOI December 19, Leo was repositioning stock and felt a pull at warehouse. First seen at Capital Region Occupational Health on December 24, dx strain of the neck, upper back and shoulder, xray neg. Still waiting on wage statement from ER and initial medical report from Capital Region Occupational Health.', n.word_count = 160, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977121-015'}) SET n.claim_id = '6977121', n.note_date = '2025-12-26', n.note_type = 'Imaging Result', n.author_name = 'Daniel Brooks', n.author_role = 'adjuster', n.text = 'Valley Radiology report rec\'d. Xray neg. Ordered by Dr Lindqvist. Report faxed to Hartford Casualty Insurance Co.', n.word_count = 17, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977121-016'}) SET n.claim_id = '6977121', n.note_date = '2025-12-29', n.note_type = 'Statement / Investigation', n.author_name = 'Daniel Brooks', n.author_role = 'adjuster', n.text = 'Statement from Leo Morgan: Leo states he was repositioning stock and felt a pull at warehouse around around noon. No one saw it a coworker came over after.', n.word_count = 28, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977121-017'}) SET n.claim_id = '6977121', n.note_date = '2025-12-30', n.note_type = 'Compensability Review', n.author_name = 'Daniel Brooks', n.author_role = 'adjuster', n.text = 'Compensability December 30: Accepting as work related, employer confirms Leo was on shift. No lost time to date, medical only so far. Statement taken December 24. Employer report matches Leo\'s account. No witnesses per Alicia Whitaker. Will revisit once the medical comes in. Leo\'s account is consistent with Dr Lindqvist\'s first note. We will diary for the wage statement. No signs of a prior injury in the records so far.\nDOI December 19, Leo was repositioning stock and felt a pull at warehouse. First seen at Capital Region Occupational Health on December 24, dx strain of the neck, upper back and shoullder, xray neg. Still waiting on wage statement from employer and initial medical repport from Capital Region Occupational Health.', n.word_count = 120, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
