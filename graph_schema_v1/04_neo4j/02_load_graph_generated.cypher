MERGE (n:Chunk {chunk_id: 'SYN-6977194-042-C01'}) SET n.parent_id = 'SYN-6977194-042', n.parent_kind = 'Note', n.position = 1, n.text = 'can we approve this?\nFrom: Dev (front desk) <dev@capitalregionoccupationalhealth.example>\nSent: Fri, Jan 2, 2026 9:05\nTo: Daniel Brooks\nSubject: RE: Claim 6977149 - Bailey\n\nHi Daniel,\nNaomi Bailey is being seen for strain of the knee.\nRestrictions remain: no kneeling or squatting, limited stairs.\nOur billing for $146.50 was sent on 12/15/25, please confirm receipt.\nNext visit is scheduled for 1/5.\n\nThanks,\nDev (front desk)', n.char_start = 0, n.char_end = 426, n.word_count = 65;
