MERGE (n:Chunk {chunk_id: 'SYN-6977175-054-C01'}) SET n.parent_id = 'SYN-6977175-054', n.parent_kind = 'Note', n.position = 1, n.text = 'Rx check Feb 2: Clmt paid out of pocket $60.50, asked for reimbursement', n.char_start = 0, n.char_end = 71, n.word_count = 13;
MERGE (n:Chunk {chunk_id: 'SYN-6977175-055-C01'}) SET n.parent_id = 'SYN-6977175-055', n.parent_kind = 'Note', n.position = 1, n.text = 'forwarding to file. -GR\nFrom: Mei (front desk) <mei@northshoreoccupationalhealth.example>\nSent: Fri, Feb 6, 2026 17:06\nTo: Maya Patel\nSubject: RE: Claim 6977175 - Ward\n\nHi Maya,\nWork status: working regular duty, no issues.\nOur billing for $197.00 was sent on 02/05/2026, please confirm receipt.\nRestrictions remain: lifting up to 30 lbs ok, no prolonged bending.\n\nRegards,\nMei (front desk)', n.char_start = 0, n.char_end = 390, n.word_count = 59;
MERGE (n:Chunk {chunk_id: 'SYN-6977175-056-C01'}) SET n.parent_id = 'SYN-6977175-056', n.parent_kind = 'Note', n.position = 1, n.text = 'OFFICE NOTE Feb 6 (Dr Romano):\nSUBJECTIVE: pt c/o pain in the neck, worse by end of shift. pain 5/10. pt states compliant w/ tx.\nOBJECTIVE: guarded flexion, strength 5/5. lumbar xray no acute findings. ROM: lumbar flexion limited, extension ok.\nASSESSMENT: strain of the neck, back and wrists, no change.\nPLAN: PT, home exercise program. restr: lifting up to 30 lbs ok, no prolonged bending. work status: working regular duty, no issues. f/u 2/19.', n.char_start = 0, n.char_end = 447, n.word_count = 75;
MERGE (n:Chunk {chunk_id: 'SYN-6977175-057-C01'}) SET n.parent_id = 'SYN-6977175-057', n.parent_kind = 'Note', n.position = 1, n.text = 'Caleb, neck, back and wrists strain, DOI Nov 11. file is open, no Board date yet. seeing Dr Romano at North Shore Occupational Health; pain 5/10 per last note; sore all over, stiff in the mornings. back to full duty; restr: lifting up to 30 lbs ok, no prolonged bending. no Board activity. nothing. call clmt, f/u w/ Dr Romano, review again Mar 9. DOI Nov 11, clmt was struck by coworker during a pallet move at facility parking area. first seen at North Shore Occupational Health on Nov 14, dx strain of neck, back and wrists, lumbar xray no acute findings. Victor Brandt is the worker\'s attorney. no wage payments, medical bills only, approx $575 paid to date. Contacts: adjuster Maya Patel, ER contact Carla Iyer, ER supervisor Alicia Fischer, treating Dr Romano. Coverage: State Insurance Fund on the risk, Warren county, facility parking area.', n.char_start = 0, n.char_end = 848, n.word_count = 146;
