MERGE (n:Note {note_id: 'SYN-6977178-081'}) SET n.claim_id = '6977178', n.note_date = '2026-06-16', n.note_type = 'Worker Message', n.author_name = 'Gita Rao', n.author_role = 'assistant', n.text = 'FYI -GR\nFrom: Julian Bell <julian@mail.example>\nSent: Tue, Jun 16, 2026 9:36\nTo: Priya Shah\nSubject: RE: Claim 6977178 - Bell\n\nHello\nplease call me back, my number is the same.\nmy boss Joan Brennan has not given me light duty yet.\nplease let me know when my next check is coming.\nmy hip/buttock is still bothering me, about 0 out of 10.\n\nthank you\nJulian', n.word_count = 66, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
