MERGE (n:Chunk {chunk_id: 'SYN-6977144-040-C01'}) SET n.parent_id = 'SYN-6977144-040', n.parent_kind = 'Note', n.position = 1, n.text = 'Forwarding to file.\nFrom: Paula Nakamura <paula@riversidefoodservices.example>\nSent: Thu, Jan 29, 2026 16:00\nTo: Priya Shah\nSubject: RE: Claim 6977144 - Shah\n\nHi Priya,\nAttached is the wage statement for Priya Shah.\nWe can offer light duty starting 2/10/26, 4 hrs/day.\nOur insurer is Wegmans Food Markets, adjuster is Priya.\nIncident report was sent on 31DEC25.\n\nThank you,\nPaula Nakamura', n.char_start = 0, n.char_end = 388, n.word_count = 60;
MERGE (n:Chunk {chunk_id: 'SYN-6977144-041-C01'}) SET n.parent_id = 'SYN-6977144-041', n.parent_kind = 'Note', n.position = 1, n.text = '1/30/26 checked eCase, nothing new. No concerns re: Compliance.', n.char_start = 0, n.char_end = 63, n.word_count = 9;
MERGE (n:Chunk {chunk_id: 'SYN-6977144-042-C01'}) SET n.parent_id = 'SYN-6977144-042', n.parent_kind = 'Note', n.position = 1, n.text = 'File review 1/30/26. Priya has a contusion of the neck and low back from 12/26/25, claim is still open. Priya is seeing Dr Okafor at Empire Physical Medicine and last reported pain at 3/10, pain in the neck and low back, worse by end of shift. Restrictions are: No lifting over 20 lbs, limit bending. Priya is working modified duty. No lost time and no wage payments due. Pending: MRI report. Plan: Continue to monitor, next review 2/13/26.\nDOI 12-26-2025, Priya tripped on something on the floor and went down at service site. First seen at Empire Physical Medicine on 12/30/25, dx contusion of the neck and low back, lumbar xray no acute findings. On modified duty from 12/29/25. PT at Riverbend Physical Therapy started 01/12/2026, 4 of 6 authorized visits used so far.', n.char_start = 0, n.char_end = 772, n.word_count = 134;
