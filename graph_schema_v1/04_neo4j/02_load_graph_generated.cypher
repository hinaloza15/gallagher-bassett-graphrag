MERGE (n:Note {note_id: 'SYN-6977160-076'}) SET n.claim_id = '6977160', n.note_date = '2026-04-06', n.note_type = 'Attorney Correspondence', n.author_name = 'Daniel Brooks', n.author_role = 'adjuster', n.text = 'Per email, will follow up\nFrom: Alicia Romano <alicia@romanolaw.example>\nSent: Mon, Apr 6, 2026 15:13\nTo: Daniel Brooks\nSubject: RE: Claim 6977160 - Nguyen\n\nHi Daniel,\nThe nothing is still outstanding on our end.\nWe request authorization for the treatment recommended by Dr Haddad.\nPlease send the claim file, medical and wage records for my client Chloe Nguyen, claim 6977160.\nMy client is available for a call, my office number is on file.\n\nRegards,\nAlicia Romano', n.word_count = 76, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977160-077'}) SET n.claim_id = '6977160', n.note_date = '2026-04-13', n.note_type = 'Hearing / Legal', n.author_name = 'Daniel Brooks', n.author_role = 'adjuster', n.text = 'Legal note April 13: Next hearing is on November 10, notice to employer and Alicia Romano. Daniel aware. Nothing else scheduled that I can see.', n.word_count = 25, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
