MERGE (n:Chunk {chunk_id: 'SYN-6977163-009-C01'}) SET n.parent_id = 'SYN-6977163-009', n.parent_kind = 'Note', n.position = 1, n.text = 'Spoke with Alicia Fischer at the employer Alicia Fischer says no other injuries like this at the site.', n.char_start = 0, n.char_end = 102, n.word_count = 18;
