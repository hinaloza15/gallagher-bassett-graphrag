MERGE (n:Note {note_id: 'SYN-6977197-080'}) SET n.claim_id = '6977197', n.note_date = '2026-04-17', n.note_type = 'File Review', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'STATUS: cx, left knee strain, DOI 12/15/25. file is open, no Board date yet.\nMEDICAL: seeing Dr Lindqvist at Hudson Valley Ortho & Rehab; pain 6/10 per last note; knee sore, swelling after standing.\nWORK: back to full duty; restr: no kneeling, otherwise ok for full shift.\nPAY: no lost time, no wage payments, medical bills only.\nLEGAL: hearing held 2/24/26, adjourned for IME report.\nPENDING: nothing.\nPLAN: continue to monitor, next review 5/1/26.\nHISTORY: DOI 12/15/25, Camila slipped on a spill near the counter at retail store. First seen at Hudson Valley Ortho & Rehab on 12/18/25, dx strain of the left knee, xray neg for fracture. On modified duty from 12/17/25. Back to full duty from March 6.', n.word_count = 120, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
