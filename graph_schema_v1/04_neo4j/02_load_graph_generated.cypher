MERGE (n:Chunk {chunk_id: 'SYN-6977137-039-C01'}) SET n.parent_id = 'SYN-6977137-039', n.parent_kind = 'Note', n.position = 1, n.text = 'STATUS: cx, right knee sprain, DOI 12/23/2025. file is still open.\nMEDICAL: seeing Dr Sato at Hudson Valley Ortho & Rehab; pain 7/10 per last note; knee swelling, feels unstable on stairs.\nWORK: working modified duty; restr: no standing over 2 hrs, no ladders, no kneeling.\nPAY: paying $657.00/wk, approx $2,628 paid to date.\nLEGAL: no Board activity.\nPENDING: records from prior provider.\nPLAN: continue to monitor, next review 2/13/26.\nHISTORY: DOI 12/23/25, cx tripped on something on the floor and went down at retail store. First seen at Hudson Valley Ortho & Rehab on 12/29/25, dx sprain of the right knee, xray neg four fracture. Off work from 12/25/25. On modified duty from 1/10/26.', n.char_start = 0, n.char_end = 691, n.word_count = 115;
MERGE (n:Chunk {chunk_id: 'SYN-6977137-040-C01'}) SET n.parent_id = 'SYN-6977137-040', n.parent_kind = 'Note', n.position = 1, n.text = '1/30/26 therapy session #8 - Dev Whitaker, PT Did quad sets, straight leg raises, step-ups, stationary bike + ice Pt arrived late, shortened session Pt asked if more visits will be approved.', n.char_start = 0, n.char_end = 190, n.word_count = 32;
