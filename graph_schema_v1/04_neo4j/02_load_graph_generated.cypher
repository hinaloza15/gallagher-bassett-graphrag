MERGE (n:Note {note_id: 'SYN-6977197-039'}) SET n.claim_id = '6977197', n.note_date = '2026-01-26', n.note_type = 'Supervisor Direction', n.author_name = 'Carol Jennings', n.author_role = 'supervisor', n.text = 'From: Carol Jennings <carol@gbclaims.example>\nSent: Mon, Jan 26, 2026 17:17\nTo: Olivia Grant\nSubject: RE: Claim 6977197 - Morris\n\nHi Olivia,\nPlease confirm the reserve is still $4,500.\nPlease see the file for Camila Morris, claim 6977197.\nLet me know if you need authority for the PT visits.\nWe need the auth for more PT visits before the next review.\n\nRegards,\nCarol Jennings', n.word_count = 63, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
