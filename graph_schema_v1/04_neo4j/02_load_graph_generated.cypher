MERGE (n:Note {note_id: 'SYN-6977100-109'}) SET n.claim_id = '6977100', n.note_date = '2026-08-31', n.note_type = 'Closure / Reopen', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'Closing note cx back to full duty since 3/23/26, no f/u needed. Board closed the case, nothing open. No activity in 60 days, closing diary. If cx calls with a flare up, reopen and send back to Dr Osei. All bills paid, nothing pending. Total paid on the file approx $12,000.\nDOI 11/21/25, cx tripped on something on the floor and went down at service site. First seen at Brooklyn Occ Medicine on 11/25/25, dx hand injury of the right hand, xray neg. On modified duty from 11/24/25.', n.word_count = 88, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977100-110'}) SET n.claim_id = '6977100', n.note_date = '2026-09-07', n.note_type = 'Reopen Inquiry', n.author_name = 'Jamal Webb', n.author_role = 'assistant', n.text = '9/7/26 - clmt called says hand flared up again. told clmt to see Dr Osei first. sent to Olivia to reeview. -Jamal', n.word_count = 22, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
