MERGE (n:Chunk {chunk_id: 'SYN-6977144-029-C01'}) SET n.parent_id = 'SYN-6977144-029', n.parent_kind = 'Note', n.position = 1, n.text = 'Can we approve this?\nFrom: Paula Nakamura <paula@riversidefoodservices.example>\nSent: Thu, Jan 15, 2026 10:15\nTo: Priya Shah\nSubject: RE: Claim 6977144 - Shah\n\nHi Priya,\nPriya Shah has not returned our calls aboyt the modified duty offer.\nOur payroll shows Priya Shah earned about $1140 a week before the injury.\nWe can offer light duty starting 1/29/26, 4 hrs/day.\n\nThanks,\nPaula Nakamura', n.char_start = 0, n.char_end = 389, n.word_count = 62;
