MERGE (n:Note {note_id: 'SYN-6977137-039'}) SET n.claim_id = '6977137', n.note_date = '2026-01-30', n.note_type = 'File Review', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'STATUS: cx, right knee sprain, DOI 12/23/2025. file is still open.\nMEDICAL: seeing Dr Sato at Hudson Valley Ortho & Rehab; pain 7/10 per last note; knee swelling, feels unstable on stairs.\nWORK: working modified duty; restr: no standing over 2 hrs, no ladders, no kneeling.\nPAY: paying $657.00/wk, approx $2,628 paid to date.\nLEGAL: no Board activity.\nPENDING: records from prior provider.\nPLAN: continue to monitor, next review 2/13/26.\nHISTORY: DOI 12/23/25, cx tripped on something on the floor and went down at retail store. First seen at Hudson Valley Ortho & Rehab on 12/29/25, dx sprain of the right knee, xray neg four fracture. Off work from 12/25/25. On modified duty from 1/10/26.', n.word_count = 115, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
