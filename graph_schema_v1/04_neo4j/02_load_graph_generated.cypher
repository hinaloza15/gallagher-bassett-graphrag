MERGE (n:Note {note_id: 'SYN-6977182-074'}) SET n.claim_id = '6977182', n.note_date = '2026-02-09', n.note_type = 'Reserve Review', n.author_name = 'Ray Delgado', n.author_role = 'supervisor', n.text = 'reserve review 2/9/26: med reserve $8,500. reserves unchanged. increased med reserve because lost time continuing. Marcus requested more authority. ok to set up IME. paid to date approx $22,000. we should revisit after the next medical.\nDOI 10-20-2025, Aaron was moving a heavy tote and felt something give at operations facility. first seen at Rochester Work Injury Clinic on October 27, dx strain of rt forearm, xray neg. no wage payments, medical bills only, approx $630 paid to date. Contacts: adjuster Marcus Hill, ER contact Paula Nakamura, ER supervisor Lena Brennan, treating Dr Doyle', n.word_count = 94, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977182-075'}) SET n.claim_id = '6977182', n.note_date = '2026-02-09', n.note_type = 'Medical Update', n.author_name = 'Dr Doyle', n.author_role = 'treating provider', n.text = 'Dr note rec\'d 2/9/26 from Rochester Work Injury Clinic:\nSUBJECTIVE: pt c/o forearm tender, weak grip. pain 4/10. pt states compliant w/ tx.\nOBJECTIVE: swelling, grip weak, sensation intact. xray neg. ROM: wrist ROM limited by pain, grip weak.\nASSESSMENT: strain of the left forearm, no change.\nPLAN: brace/splint prn, ice. restr: lifting to 20 lbs, splint as needed. work status: working regular duty, no issues. f/u prn.', n.word_count = 68, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977182-076'}) SET n.claim_id = '6977182', n.note_date = '2026-02-11', n.note_type = 'Correction', n.author_name = 'Marcus Hill', n.author_role = 'adjuster', n.text = 'CORRECTION TO MY 02/09/2026 NOTE - IT IS RIGHT FOREARM, NOT LEFT', n.word_count = 12, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977182-077'}) SET n.claim_id = '6977182', n.note_date = '2026-02-16', n.note_type = 'Status Report', n.author_name = 'Marcus Hill', n.author_role = 'adjuster', n.text = 'Subject: Status Report - Claim 6977182 - Aaron Wood\nHi Tom,\n\nPlease see the update below on Aaron Wood\'s claim (Hudson Valley Hospitality, DOI 10/20/2025, operations facility). I have kept the history short, call me if you want more.\n\nCLAIM HISTORY\nDOI 10-20-2025, IW was moving a heavy tote and felt smething give at operations facility. First seen at Rochester Work Injury Clinic on 10/27/2025, dx strain of the rt forearm, xray neg. No wage payments, medical bills only, approx $630 paid to date. Contacts: adjuster Marcus Hill, ER contact Paula Nakamura, ER supervisor Lena Brennan, treating DR Doyle. Coverage: Wegmans Food Markets on the risk, Monroe county, operations facility.\n\nCURRENT MEDICAL: treating with DR Doyle at Rochester Work Injury Clinic. Pain was 0/10 at the last visit (02/09/2026) and IW reports no complaints. Restrictions: released to full duty, no restrictions.\nWORK STATUS: IW is working regular duty, no issues.\nBENEFITS: no lost time, no wage benefits due at this point. Medical bills are being paid per the fee schedule.\nLEGAL: no hearings or conciliation set, nothing from the Board that needs a response.\nCONTACTS: adjuster Marcus Hill, ER contact Paula Nakamura (Hudson Valley Hospitality), ER supervisor Lena Brennan, treating DR Doyle at Rochester Work Injury Clinic.\nCOVERAGE: Wegmans Food Markets is on the risk. Claim is in Monroe county, injury location operations facility. No prior claims found on IW.\nOUTSTANDING: nothhing.\nRESERVES: no change recommended right now, med reserve $15,000. We will revisit after the next medical report.\nPLAN: continue to monitor, speak with IW and employer again this month, and send the next update by 03/09/2026. Please let me know if you need anything else in the meantime.\n\nThanks,\nMarcus Hill', n.word_count = 283, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977182-078'}) SET n.claim_id = '6977182', n.note_date = '2026-02-26', n.note_type = 'File Review', n.author_name = 'Marcus Hill', n.author_role = 'adjuster', n.text = 'STATUS: IW, rt forearm strain, DOI 10/20/2025. file is open.\nMEDICAL: seeing DR Doyle at Rochester Work Injury Clinic; pain 0/10 per last note; mild stiffness only.\nWORK: back to full duty; restr: released to full duty, no restrictions.\nPAY: no lost time, no wage payments, medical bills only.\nLEGAL: no Board activity.\nPENDING: nothing.\nPLAN: continue to monitor, next review 03/19/2026.\nHISTORY: DOI 10/20/2025, IW was moving a heavy tote and felt something give at operations facility. First seen at Rochester Work Injury Clinic on 10/27/2025, dx strain of the rt forearm, xray neg. No wage payments, medical bills only, approx $630 paid to date. Contacts: adjuster Marcus Hill, ER contact Paula Nakamura, ER supervisor Lena Brennan, treating DR Doyle. Coverage: Wegmans Food Markets on the risk, Monroe county, operations facility.', n.word_count = 132, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
