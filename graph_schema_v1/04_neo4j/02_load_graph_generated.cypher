MERGE (n:Note {note_id: 'SYN-6977100-016'}) SET n.claim_id = '6977100', n.note_date = '2025-11-27', n.note_type = 'Contact - Injured Worker', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'Spoke with Marcus Reed 11/27/25 Asked who pays for Brooklyn Occupational Medicine visits, told WESCO INSURANCE CO pays per fee schedule and to keep receipts Marcus confirmed DOI 11/21/25 at service site.', n.word_count = 32, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977100-017'}) SET n.claim_id = '6977100', n.note_date = '2025-11-28', n.note_type = 'Contact - Injured Worker', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'Spoke with Marcus . Working w/ restrictions. Said he tripped on something on the floor and went down. Asked him to call Carla Lindqvist aboht the light duty at the comapny.', n.word_count = 31, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977100-018'}) SET n.claim_id = '6977100', n.note_date = '2025-12-01', n.note_type = 'Statement / Investigation', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'Recorded statement Marcus Marcus states he tripped on something on the floor and went down at service site around around noon. No one saw it, a coworker came over after. Denies prior problems with hand. No other jobs. Dominant hand is the right. Marcus said it was end of a long shift. Photos requested, none were taken. Supervisor statement requested from Carla Brennan. Asked Marcus if he had any trouble with hand before, said no. Marcus says he told Carla Brennan before the end of the shift. Pain level that day was about 4/10 per Marcus. Marcus says nobody has offered light duty yet.\nDOI 11/21/25, Marcus tripped on something on the floor and went down at service site. First seen at Brooklyn Occupational Medicine on Nov 25, dx hand injury of the right hand, xray neg. On modified duty from 11/24/25. Still waiting on wage statement from the company and initial medical report from Brooklyn Occupational Medicine.', n.word_count = 158, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977100-019'}) SET n.claim_id = '6977100', n.note_date = '2025-12-01', n.note_type = 'Supervisor Incident Statement', n.author_name = 'Carla Brennan', n.author_role = 'ER supervisor', n.text = 'Statement from Carla Brennan at Hudson Public Services: I was on shift 11/21/2025. Marcus Reed told me he tripped on something on the floor and went down. No prior complaints that i recall. Marcus finished the shift but was favoring it. I offered to call an ambulance, he said no. Marcus has been reliable, no attendance issues.\nDOI 11/21/2025, Marcus tripped on something on the floor and went down at service site. First seen at Brooklyn Occupational Medicine on 11/25/2025, dx hand injury of the right hand, xray neg.', n.word_count = 89, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977100-020'}) SET n.claim_id = '6977100', n.note_date = '2025-12-02', n.note_type = 'Contact - Provider', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = '12/2/25 - Brooklyn Occupational Medicine called. Asked Dr Osei for an updated work status fax request sent. Records rec\'d from Brooklyn Occupational Medicine 5 pages. Dr Osei wants Marcus Reed to continue wrist ROM grip strengthening putty.', n.word_count = 37, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
