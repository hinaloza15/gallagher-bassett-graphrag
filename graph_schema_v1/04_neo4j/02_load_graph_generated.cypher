MERGE (n:Note {note_id: 'SYN-6977163-095'}) SET n.claim_id = '6977163', n.note_date = '2026-05-18', n.note_type = 'Worker Message', n.author_name = 'Gita Rao', n.author_role = 'assistant', n.text = 'see below. -GR\nFrom: Mia Lopez <mia@mail.example>\nSent: Mon, May 18, 2026 8:10\nTo: Olivia Grant\nSubject: RE: Claim 6977163 - Lopez\n\nhello,\ni went to Upstate Joint & Rehab Center on 12/09/2025.\nmy ears is still bothering me, about 0 out of 10.\nthis is Mia Lopez, claim 6977163.\n\nthanks\nMia', n.word_count = 52, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977163-096'}) SET n.claim_id = '6977163', n.note_date = '2026-06-01', n.note_type = 'File Review', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'STATUS: Mia, ears hearing loss, DOI 5/1/15. file is still open.\nMEDICAL: seeing Dr Haddad at Upstate Joint & Rehab Center; pain 0/10 per last note; no complaints.\nWORK: working regular duty, no issues; restr: released to full duty, no restrictions.\nPAY: no lost time, no wage payments, medical bills only.\nLEGAL: second hearing 3/31/26 held, judge reserved decision.\nPENDING: nothing.\nPLAN: call Mia, follow up with Dr Haddad, review again 7/1/26.\nHISTORY: DOI 5/1/15, cx has had noise exposure for years on the production floor at retail store. First seen at Upstate Joint & Rehab Center on 11/17/25, dx hearing loss of the ears, audiogram shows high-frequency loss. On modified duty from 11/13/25. Back to full duty from 12/11/2025. IME with Dr Nakamura on 1/30/26, report 02/12/2026 says finds partial disability, recommends more PT. Lena Castillo is the worker\'s attorney. Hearing held 2/2/26. Second hearing 3/31/26. No wage payments, medical bills only, approx $410 paid to date. Contacts: adjuster Olivia Grant, ER contact Alicia Fischer, ER supervisor Carla Fischer, treating Dr Haddad. Coverage: NEW HAMPSHIRE INSURANCE CO on the risk, Allegany county, retail store.', n.word_count = 185, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977163-097'}) SET n.claim_id = '6977163', n.note_date = '2026-06-03', n.note_type = 'Attorney Correspondence', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'Lena Castillo called re: Cx. Requesting copies of medical, wage statement and C-2F for claim 6977163. Asks status of the hearing before the judge. Sent request to NEW HAMPSHIRE INSURANCE CO records unit. Requests a copy of the IME report. We will respond by letter.\nDOI 5/1/15, cx has had noise exposure for years on the production floor at retail store. First seen at Upstate Joint & Rehab Center on November 17, dx hearing loss of the ears, audiogram shows high-frequency loss. On modified duty from 11/13/25.', n.word_count = 87, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977163-098'}) SET n.claim_id = '6977163', n.note_date = '2026-06-10', n.note_type = 'Bill Question', n.author_name = 'Gita Rao', n.author_role = 'assistant', n.text = 'bill review 06/10/2026: MRI from Upstate Joint & Rehab Center $381 paid per fee schedule -GR', n.word_count = 16, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977163-099'}) SET n.claim_id = '6977163', n.note_date = '2026-06-16', n.note_type = 'Reserve Review', n.author_name = 'Ray Delgado', n.author_role = 'supervisor', n.text = 'June 16 reserves - Olivia\'s file: Olivia requested more authority. ok to set up the IME. paid to date approx $22,000.', n.word_count = 21, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977163-100'}) SET n.claim_id = '6977163', n.note_date = '2026-06-19', n.note_type = 'Status Report', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'Subject: Status Report - Claim 6977163 - Mia Lopez\nHi Ravi,\n\nPlease see the update below on Mia Lopez\'s claim (Orange Supply Cooperative, DOI 5/1/15, retail store). I have kept the history short, call me if you want more.\n\nCLAIM HISTORY\nDOI 5/1/15, cx has had noise exposure for years on the production floor at retail store. First seen at Upstate Joint & Rehab Center on 11/17/25, dx hearing loss of the ears, audiogram shows high-frequency loss. On modified duty from 11/13/25. Back to full duty from 12/11/25. IME with Dr Nakamura on 1/30/26, report 2/12/26 says finds partial disability, recommends more PT. Lena Castillo is the worker\'s attorney. Hearing held 2/2/26. Second hearing 3/31/26. No wage payments, medical bills only, approx $410 paid to date.\n\nCURRENT MEDICAL: treating with Dr Haddad at Upstate Joint & Rehab Center. Pain was 0/10 at the last visit (Dec 9) and cx reports mild stiffness only. Restrictions: released to full duty, no restrictions.\nWORK STATUS: cx is back to full duty.\nBENEFITS: no lost time, no wage benefits due at this point. Medical bills are being paid per the fee schedule.\nLEGAL: second hearing 3/31/26 held, judge reserved decision.\nIME: Dr Nakamura saw cx and the report says finds partial disability, recommends more PT. We are reviewing whether to dispute any of the ongoing treatment.\ncx is represented by Lena Castillo, who has asked for the claim file and our position on added treatment. We are responding by letter.\nCONTACTS: adjuster Olivia Grant, ER contact Alicia Fischer (Orange Supply Cooperative), ER supervisor Carla Fischer, treating Dr Haddad at Upstate Joint & Rehab Center.\nCOVERAGE: NEW HAMPSHIRE INSURANCE CO is on the risk. Claim is in Allegany county, injury location retail store. No prior claims found on cx.\nOUTSTANDING: nothing.\nRESERVES: no change recommended right now, med reserve $4,500. We will revisit after the next medical report.\nPLAN: continue to monitor, speak with cx and the employer again this month, and send the next update by 7/19/26. Please let me know if you need anything else in the meantime.\n\nThanks,\nOlivia Grant', n.word_count = 348, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977163-101'}) SET n.claim_id = '6977163', n.note_date = '2026-06-29', n.note_type = 'File Review', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'STATUS: cx, ears hearing loss, DOI 5/1/15. file is open, no Board date yet.\nMEDICAL: seeing Dr Haddad at Upstate Joint and Rehab Center; pain 0/10 per last note; feeling much better, occasional soreness.\nWORK: back to full duty; restr: released to full duty, no restrictions.\nPAY: no lost time, no wage payments, medical bills only.\nLEGAL: second hearing 3/31/26 held, judge reserved decision.\nPENDING: nothing.\nPLAN: continue to monitor, next review 7/13/26.\nHISTORY: DOI 5/1/15, cx has had noise exposure for years on the production floor at retail store. First seen at Upstate Joint & Rehab Center on 11/17/25, dx hearing loss of the ears, audiogram shows high-frequency loss. On modified duty from 11/13/25. Back to full duty from 12/11/25. IME with Dr Nakamura on 1/30/26, report 2/12/26 says finds partial disability, recommends more PT. Lena Castillo is the worker\'s attorney. Hearing held 02/02/2026. Second hearing 3/31/26. No wage payments, medical bills only, approx $410 paid to date. Contacts: adjuster Olivia Grant, ER contact Alicia Fischer, ER supervisor Carla Fischer, treating Dr Haddad. Coverage: NEW HAMPSHIRE INSURANCE CO on the risk, Allegany county, retail store.', n.word_count = 186, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
