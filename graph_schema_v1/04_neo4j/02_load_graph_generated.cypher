MERGE (n:Chunk {chunk_id: 'SYN-6977178-097-C01'}) SET n.parent_id = 'SYN-6977178-097', n.parent_kind = 'Note', n.position = 1, n.text = '8/25/26 - spoke with Julian Bell by phone. Working regular duty no issues. Next appt with Dr Okafor is as needed.', n.char_start = 0, n.char_end = 113, n.word_count = 21;
MERGE (n:Chunk {chunk_id: 'SYN-6977178-098-C01'}) SET n.parent_id = 'SYN-6977178-098', n.parent_kind = 'Note', n.position = 1, n.text = 'Closing note Julian Bell back to full duty since 02/26/2026, no f/u needed. Board closed the case, nothing open. No activity in 60 days, closing diary. Treated at Brooklyn Occupational Medicine, released, no restrictions. If Julian calls with a flare up, reopen and send back to Dr Okafor. All bills paid, nothing pending. Final med report rec\'d, contusion resolved. Total paid on the file approx $8,500.\nDOI 12/16/25, Julian slipped on ice in the lot and went down at service site. First seen at Brooklyn Occupational Medicine on 12/19/25, dx contusion of the left hip/buttock, xray neg for fracture.', n.char_start = 0, n.char_end = 601, n.word_count = 99;
MERGE (n:Chunk {chunk_id: 'SYN-6977182-004-C01'}) SET n.parent_id = 'SYN-6977182-004', n.parent_kind = 'Note', n.position = 1, n.text = 'first report: Aaron Wood / Hudson Valley Hospitality, DOI 10/20/2025, Wegmans Food Markets. IW says he was moving a heavy tote and felt something give at operations facility. treating at Rochester Work Injury Clinic w/ DR Doyle. employer sent C-2F, rec\'d 10/25/2025. will call IW and employer today. we have not rec\'d any wage info yet. coverage confirmed, Wegmans Food Markets is on the risk. claim # 6977182, Monroe county.\nDOI 10/20/2025, IW was moving heavy tote and felt something give at operations facility.', n.char_start = 0, n.char_end = 514, n.word_count = 84;
MERGE (n:Chunk {chunk_id: 'SYN-6977182-005-C01'}) SET n.parent_id = 'SYN-6977182-005', n.parent_kind = 'Note', n.position = 1, n.text = 'prior claims: none, 6977182 is only one on file. -WP', n.char_start = 0, n.char_end = 52, n.word_count = 10;
MERGE (n:Chunk {chunk_id: 'SYN-6977182-006-C01'}) SET n.parent_id = 'SYN-6977182-006', n.parent_kind = 'Note', n.position = 1, n.text = 'diary 10/23/2025: nothing new from employer or Rochester Work Injury Clinic.', n.char_start = 0, n.char_end = 76, n.word_count = 11;
MERGE (n:Chunk {chunk_id: 'SYN-6977182-007-C01'}) SET n.parent_id = 'SYN-6977182-007', n.parent_kind = 'Note', n.position = 1, n.text = 'From: Paula Nakamura <paula@hudsonvalleyhospitality.example>\nSent: Thu, Oct 23, 2025 11:38\nTo: Marcus Hill\nSubject: RE: Claim 6977182 - Wood\n\nHi Marcus,\nIW was out on sick time last week, no call to us.\nWe can offer light duty starting 10/28/2025, 4 hrs/day.\nPlease confirm whether the claim has been accepted.\nIncident report was sent on 10/23/2025.\n\nThanks,\nPaula Nakamura', n.char_start = 0, n.char_end = 374, n.word_count = 59;
MERGE (n:Chunk {chunk_id: 'SYN-6977182-008-C01'}) SET n.parent_id = 'SYN-6977182-008', n.parent_kind = 'Note', n.position = 1, n.text = 's/w IW . pain about 5/10 today per IW. says he saw DR Doyle on 10/22/2025. asked about status of the claim, explained it is open. worried about employer cutting hours. working regular duty, no issues. IW confirmed DOI 10/20/2025 at operations facility. said he was moving a heavy tote and felt something give. asked about mileage reimbursement, told to send C-257 w/ receipts. address and phone confirmed same as file. next appt w/ DR Doyle is 10/27. IW got bill for $400 from Rochester Work Injury Clinic, I told him not to pay it, we will check it. asked him to call Paula Nakamura about the light duty at employer.\nDOI 10/20/2025, IW was moving heavy tote and felt something give at operations facility. Still waiting on wage statement from employer.', n.char_start = 0, n.char_end = 753, n.word_count = 132;
MERGE (n:Chunk {chunk_id: 'SYN-6977182-009-C01'}) SET n.parent_id = 'SYN-6977182-009', n.parent_kind = 'Note', n.position = 1, n.text = 'OUTBOUND CALL TO AARON. STILL HARD TO GRIP OR CARRY. IW GOT A BILL FOR $163.50 FROM ROCHESTER WORK INJURY CLINIC, I TOLD HIM NOT TO PAY IT, WE WILL CHECK IT', n.char_start = 0, n.char_end = 156, n.word_count = 32;
MERGE (n:Chunk {chunk_id: 'SYN-6977182-010-C01'}) SET n.parent_id = 'SYN-6977182-010', n.parent_kind = 'Note', n.position = 1, n.text = 'LM for Lena Brennan re the incident form.', n.char_start = 0, n.char_end = 41, n.word_count = 8;
MERGE (n:Chunk {chunk_id: 'SYN-6977182-011-C01'}) SET n.parent_id = 'SYN-6977182-011', n.parent_kind = 'Note', n.position = 1, n.text = 'CHECKED ECASE, NOTHING NEW. IW BACK TO FULL DUTY -MH', n.char_start = 0, n.char_end = 52, n.word_count = 10;
MERGE (n:Chunk {chunk_id: 'SYN-6977182-012-C01'}) SET n.parent_id = 'SYN-6977182-012', n.parent_kind = 'Note', n.position = 1, n.text = 'NEED TO RESPOND TO THIS. -MH\nFrom: Paula Nakamura <paula@hudsonvalleyhospitality.example>\nSent: Thu, Oct 23, 2025 7:30\nTo: Marcus Hill\nSubject: RE: Claim 6977182 - Wood\n\nHi Marcus,\nOur insurer is Wegmans Food Markets, adjuster is Marcus.\nWe can offer light duty starting 11/01/2025, 4 hrs/day.\nPlease confirm whether the claim has been accepted.\nAaron Wood has not returned our calls about the modified duty offer.\n\nRegards,\nPaula Nakamura', n.char_start = 0, n.char_end = 439, n.word_count = 68;
