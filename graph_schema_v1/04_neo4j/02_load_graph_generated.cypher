MERGE (n:Chunk {chunk_id: 'SYN-6977156-031-C01'}) SET n.parent_id = 'SYN-6977156-031', n.parent_kind = 'Note', n.position = 1, n.text = 'NEED TO RESPOND TO THIS -MH\nFrom: Tasha Kowalski <tasha@harborviewcommunityhealth.example>\nSent: Thu, Jan 15, 2026 10:07\nTo: Marcus Hill\nSubject: RE: Claim 6977156 - Rivera\n\nHi Marcus,\nPlease send us the restrictions in writing.\nWe can offer light duty starting 01/28/2026, 4 hrs/day.\n\nThank you,\nTasha Kowalski', n.char_start = 0, n.char_end = 311, n.word_count = 47;
