MERGE (n:Chunk {chunk_id: 'SYN-6977144-048-C01'}) SET n.parent_id = 'SYN-6977144-048', n.parent_kind = 'Note', n.position = 1, n.text = '2/10/26 auth: Approved 12 PT visits at Riverbend Physical Therapy, auth # 51443. Dr Okafor requested more PT, we are checking against the guideline. MG-2 rec\'d for neck and low back, reviewing. MRI auth\'d, Northeast Diagnostic Imaging to schedule. Waiting on the MRI report from Northeast Diagnostic Imaging.', n.char_start = 0, n.char_end = 308, n.word_count = 48;
