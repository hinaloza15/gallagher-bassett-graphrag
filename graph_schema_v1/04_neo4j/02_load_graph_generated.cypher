MERGE (n:Chunk {chunk_id: 'SYN-6977098-067-C01'}) SET n.parent_id = 'SYN-6977098-067', n.parent_kind = 'Note', n.position = 1, n.text = 'Dr note rec\'d Mar 10 from North Shore Occupational Health: Pt c/o bruising and swelling, shin tender to touch. Pain 2/10. MRI: Mild effusion, possible meniscus signal change. Tx: PT, home exercise program. Restr: No kneeling, otherwise ok for full shift. No new injury reported. MRI shows mild effusion, possible meniscus signal change.', n.char_start = 0, n.char_end = 336, n.word_count = 53;
