MERGE (n:Note {note_id: 'SYN-6977182-030'}) SET n.claim_id = '6977182', n.note_date = '2025-11-17', n.note_type = 'Contact - Injured Worker', n.author_name = 'Marcus Hill', n.author_role = 'adjuster', n.text = 'called IW, reached on 2nd try. address and phone confirmed same as file. asked him to call Paula Nakamura about light duty at employer. -MH', n.word_count = 25, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977182-031'}) SET n.claim_id = '6977182', n.note_date = '2025-11-17', n.note_type = 'Contact - Injured Worker', n.author_name = 'Marcus Hill', n.author_role = 'adjuster', n.text = 'called IW, reached on 2nd try. asked who pays for Rochester Work Injury Clinic visits, told Wegmans Food Markets pays per fee schedule and to keep receipts. asked about the status of the claim, explained it is open. said he was moving a heavy tote and felt something give. trouble sleeping because of the pain. still hard to grip or carry. next appt w/ DR Doyle is 12/6. asked him to call Paula Nakamura about the light duty at employer. will call back.\nDOI 10/20/2025, Aaron was moving a heavy tote and felt something give at operations facility -MH', n.word_count = 99, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977182-032'}) SET n.claim_id = '6977182', n.note_date = '2025-11-18', n.note_type = 'Supervisor Direction', n.author_name = 'Ray Delgado', n.author_role = 'supervisor', n.text = 'FYI\nFrom: Ray Delgado <ray@gbclaims.example>\nSent: Tue, Nov 18, 2025 7:15\nTo: Marcus Hill\nSubject: RE: Claim 6977182 - Wood\n\nHi Marcus,\nPlease confirm the reserve is still $15,000.\nSend a status report to Wegmans Food Markets by November 28.\n\nThanks,\nRay Delgado', n.word_count = 43, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977182-033'}) SET n.claim_id = '6977182', n.note_date = '2025-11-21', n.note_type = 'File Review', n.author_name = 'Marcus Hill', n.author_role = 'adjuster', n.text = 'STATUS: IW, rt forearm strain, DOI 10/20/2025. file is still open.\nMEDICAL: seeing DR Doyle at Rochester Work Injury Clinic; pain 6/10 per last note; forearm sore and tight w/ lifting.\nWORK: working regular duty, no issues; restr: no gripping or lifting over 5 lbs with that hand.\nPAY: no lost time, no wage payments, medical bills only.\nLEGAL: no Board activity.\nPENDING: records from prior provider.\nPLAN: we get the records from prior provider, then close the diary 12/12/2025.\nHISTORY: DOI Oct 20, IW was moving a heavy tote and felt something give at operations facility. First seen at Rochester Work Injury Clinic on 10/27/2025, dx strain of the rt forearm, xray neg. No wage payments, medical bills only, approx $410 paid to date. Contacts: adjuster Marcus Hill, ER contact Paula Nakamura, ER supervisor Lena Brennan, treating DR Doyle.', n.word_count = 140, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977182-034'}) SET n.claim_id = '6977182', n.note_date = '2025-11-24', n.note_type = 'Diary Entry', n.author_name = 'Marcus Hill', n.author_role = 'adjuster', n.text = 'diary 11/24/25: nothing new from employer or Rochester Work Injury Clinic.', n.word_count = 11, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977182-035'}) SET n.claim_id = '6977182', n.note_date = '2025-11-24', n.note_type = 'Correction', n.author_name = 'Marcus Hill', n.author_role = 'adjuster', n.text = 'correction to my 11/17/25 note - next appt w/ the Dr is 12/4, not 12/6.', n.word_count = 15, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977182-036'}) SET n.claim_id = '6977182', n.note_date = '2025-11-25', n.note_type = 'Reserve Review', n.author_name = 'Ray Delgado', n.author_role = 'supervisor', n.text = 'reserve review November 25: increased med reserve because more PT requested Marcus requested more authority ok to send the status report.', n.word_count = 21, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977182-037'}) SET n.claim_id = '6977182', n.note_date = '2025-11-25', n.note_type = 'Contact - Injured Worker', n.author_name = 'Marcus Hill', n.author_role = 'adjuster', n.text = 'Called IW, reached on 2nd try IW got bill for $430.50 from Rochester Work Injury Clinic, I told him not to pay it, we will check it -MH', n.word_count = 28, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977182-038'}) SET n.claim_id = '6977182', n.note_date = '2025-12-03', n.note_type = 'Work Status', n.author_name = 'Marcus Hill', n.author_role = 'adjuster', n.text = '12/3/25 - RTW: restr per DR Doyle: no repetitive gripping lifting to 10 lbs. full duty release expected 12/4. ased DR Doyle for updated work status. -MH', n.word_count = 27, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977182-039'}) SET n.claim_id = '6977182', n.note_date = '2025-12-04', n.note_type = 'Contact - Employer', n.author_name = 'Marcus Hill', n.author_role = 'adjuster', n.text = 'called Hudson Valley Hospitality, s/w Lena Brennan. IW is on sick time. Paula Nakamura says wage info coming from payroll. asked Paula Nakamura about restrictions: no repetitive gripping, lifting to 10 lbs. employer concerned about overtime coverage. safety review done, no changes to operations facility yet. employer says Aaron missed 4 days last month. told Paula Nakamura we cant discuss reserves. asked employer for a copy of incident report. payroll has not sent wage statement. I asked Paula Nakamura to put light duty offer in writing. no further questions.\nDOI 10/20/2025, IW was moving heavy tote and felt something give at operations facility. first seen at Rochester Work Injury Clinic on 10/27/2025, dx strain of the rt forearm, xray neg. no wage payments, medical bills only, approx $465 paid to date. Contacts: adjuster Marcus Hill, ER contact Paula Nakamura, ER supervisor Lena Brennan, treating DR Doyle. Coverage: Wegmans Food Markets on the risk, Monroe county, operations facility. -MH', n.word_count = 158, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977182-040'}) SET n.claim_id = '6977182', n.note_date = '2025-12-05', n.note_type = 'Medical Update', n.author_name = 'Dr Doyle', n.author_role = 'treating provider', n.text = 'Dr note rec\'d 12/5/25 from Rochester Work Injury Clinic: Exam: TTP, pain w/ ROM. Restr: No repetitive gripping, liftign to 10 lbs. Pt states compliant w/ tx. No new injury reported. Pt asks about grip or carry, advised to modify. Continue wrist ROM, grip strengthening, putty. RTC 12/22.', n.word_count = 48, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977182-041'}) SET n.claim_id = '6977182', n.note_date = '2025-12-08', n.note_type = 'Contact - Injured Worker', n.author_name = 'Marcus Hill', n.author_role = 'adjuster', n.text = 'OUTBOUND CALL TO AARON ASKED ABOUT MILEAGE REIMBURSEMENT, TOLD TO SEND C-257 W/ RECEIPTS.', n.word_count = 14, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977182-042'}) SET n.claim_id = '6977182', n.note_date = '2025-12-10', n.note_type = 'Status Report', n.author_name = 'Marcus Hill', n.author_role = 'adjuster', n.text = 'Subject: Status Report - Claim 6977182 - Aaron Wood\nHi Sam,\n\nPlease see the update below on Aaron Wood\'s claim (Hudson Valley Hospitality, DOI 10/20/2025, operations facility). I have kept the history short, call me if you want more.\n\nCLAIM HISTORY\nDOI 10/20/2025, IW was moving a heavy tote and felt something give at operations facility. First seen at Rochester Work Injury Clinic on 10/27/2025, dx strain of the rt forearm, xray neg. No wage payments, medical bills only, approx $465 paid to date. Contacts: adjuster Marcus Hill, ER contact Paula Nakamura, ER supervisor Lena Brennan, treating DR Doyle. Coverage: Wegmans Food Markets on the risk, Monroe county, operations facility.\n\nCURRENT MEDICAL: treating with DR Doyle at Rochester Work Injury Clinic. Pain was 5/10 at the last visit (12/04/2025) and IW reports forearm sore and tight w/ lifting. Restrictions: no repetitive gripping, lifting to 10 lbs.\nWORK STATUS: IW is working regular duty, no issues.\nBENEFITS: no lost time, no wage benefits due at this point. Medical bills are being paid per the fee schedule.\nLEGAL: no hearings or conciliation set, nothing from the Board that needs a response.\nCONTACTS: adjuster Marcus Hill, ER contact Paula Nakamura (Hudson Valley Hospitality), ER supervisor Lena Brennan, treating DR Doyle at Rochester Work Injury Clinic.\nCOVERAGE: Wegmans Food Markets is on the risk. Claim is in Monroe county, injury location operations facility. No prior claims found on IW.\nOUTSTANDING: nothing.\nRESERVES: no change recommended right now, med reserve $8,500. We will revisit after the next medical report.\nPLAN: continue to monitor, speak with IW and employer again this month, and send the next update by 12/31/2025. Please let me know if you need anything else in the meantime.\n\nThanks,\nMarcus Hill', n.word_count = 288, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977182-043'}) SET n.claim_id = '6977182', n.note_date = '2025-12-10', n.note_type = 'Contact - Injured Worker', n.author_name = 'Marcus Hill', n.author_role = 'adjuster', n.text = 'called IW, reached on 2nd try. pain about 5/10 today per IW. says he saw DR Doyle on 12/04/2025. worried about employer cutting hours. taking tylenol as needed. asked about mileage reimbursement, told to send C-257 w/ receipts.\nDOI 10/20/2025, IW was moving heavy tote and felt something give at operations facility. first seen at Rochester Work Injury Clinic on 10/27/2025, dx strain of the rt forearm, xray neg. no wage payments, medical bills only, approx $465 paid to date. Contacts: adjuster Marcus Hill, ER contact Paula Nakamura, ER supervisor Lena Brennan, treating DR Doyle', n.word_count = 95, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
