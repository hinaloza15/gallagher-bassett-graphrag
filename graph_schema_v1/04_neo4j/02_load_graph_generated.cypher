MERGE (n:Note {note_id: 'SYN-6977163-091'}) SET n.claim_id = '6977163', n.note_date = '2026-04-13', n.note_type = 'Supervisor Direction', n.author_name = 'Ray Delgado', n.author_role = 'supervisor', n.text = 'sup review - Olivia: refer to Lila for case mgmt. send status report to New Hampshire Insurance Co by April 18. dont close until the Board notice is rec\'d. call EE this week hasnt been contacted since December 9. pull prior claim history again. need hearing prep done by April 21', n.word_count = 51, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977163-092'}) SET n.claim_id = '6977163', n.note_date = '2026-04-30', n.note_type = 'Bill Question', n.author_name = 'Gita Rao', n.author_role = 'assistant', n.text = 'need to respond to this. -GR\nFrom: Ravi (front desk) <ravi@upstatejointrehabcenter.example>\nSent: Thu, Apr 30, 2026 17:44\nTo: Olivia Grant\nSubject: RE: Claim 6977163 - Lopez\n\nHi Olivia,\nMia Lopez is being seen for hearing loss of the ears.\nWe are requesting 6 PT visits, please advise.\nOur billing for $401.00 was sent on 12/09/2025, please confirm receipt.\n\nThanks,\nRavi (front desk)', n.word_count = 62, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977163-093'}) SET n.claim_id = '6977163', n.note_date = '2026-05-01', n.note_type = 'Attorney Correspondence', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'FYI\nFrom: Lena Castillo <lena@castillolaw.example>\nSent: Fri, May 1, 2026 9:22\nTo: Olivia Grant\nSubject: RE: Claim 6977163 - Lopez\n\nHi Olivia,\nWe will be askihg for a hearing if there is no response within 10 days.\nWe request authorization for the treatment recommended by Dr Haddad.\nPlease provide a copy of the IME report.\n\nThanks,\nLena Castillo', n.word_count = 58, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
