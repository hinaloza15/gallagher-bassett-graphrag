MERGE (n:Note {note_id: 'SYN-6977098-004'}) SET n.claim_id = '6977098', n.note_date = '2025-12-29', n.note_type = 'First Report Summary', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = 'First report: Jordan Lee / Harborview Community Health, DOI Dec 27, State Insurance Fund. clmt says he backed work van into bollard in lot at facility parking area. reported to Paula Kowalski same day. sx: bruising and swelling, shin tender to touch. treating at North Shore Occupational Health w/ Dr Fischer. the company sent C-2F, rec\'d Jan 2. dx per first visit: contusion. no prior claims that I can see. clmt still working, light tasks only. C-3 not yet rec\'d. we have not rec\'d any wage info yet. company says clmt has worked there a while, no prior injuries per Rita Haddad. coverage confirmed, State Insurance Fund is on the risk. we need the job description and wage statement from company. wage info still needed.\nDOI Dec 27, clmt backed work van into a bollard in lot at facility parking area. On modified duty from Dec 29.', n.word_count = 147, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977098-005'}) SET n.claim_id = '6977098', n.note_date = '2025-12-29', n.note_type = 'Diary Entry', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = 'Dec 29 file check - nothing still outstanding', n.word_count = 8, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977098-006'}) SET n.claim_id = '6977098', n.note_date = '2025-12-29', n.note_type = 'Contact Attempt', n.author_name = 'Gita Rao', n.author_role = 'assistant', n.text = 'EE not answeing, will try again tmrw. -GR', n.word_count = 8, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977098-007'}) SET n.claim_id = '6977098', n.note_date = '2025-12-29', n.note_type = 'Prior Claims Check', n.author_name = 'Gita Rao', n.author_role = 'assistant', n.text = 'pror claims check 12/29/2025 - nothing under Lee -GR', n.word_count = 9, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977098-008'}) SET n.claim_id = '6977098', n.note_date = '2025-12-29', n.note_type = 'Contact - Injured Worker', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = 'spoke w/ clmt . asked about the status of claim, explained it is open. address and phone confirmed same as file.', n.word_count = 21, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977098-009'}) SET n.claim_id = '6977098', n.note_date = '2025-12-30', n.note_type = 'Contact - Employer', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = 'rec\'d this today, will call.\nFrom: Rita Haddad <rita@harborviewcommunityhealth.example>\nSent: Tue, Dec 30, 2025 14:16\nTo: Maya Patel\nSubject: RE: Claim 6977098 - Lee\n\nHi Maya,\nOur insurer is State Ins Fund, adjustr is Maya.\nPlease cofirm whether the claim has been accepted.\nJob description attached.\nJordan Lee has not returned our calls about the modified duty offer.\n\nRegards,\nRita Haddad', n.word_count = 61, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977098-010'}) SET n.claim_id = '6977098', n.note_date = '2025-12-30', n.note_type = 'Contact - Injured Worker', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = 'spoke w/ clmt Dec 30 wants copy of C-3, will mail taking ibuprofen as needed clmt confirmed DOI Dec 27 at facility parking area still hard to stand or walk for long asked if Maya is still the adjuster, confirmed clmt says he is not sure he can do the light duty offered, I told him to talk to Dr Fischer clmt asked about hiring an attorney, told that is up to him, gave Board number clmt got bill for $296.75 from North Shore Occupational Health, I told him not to pay it, we will check it.', n.word_count = 97, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977098-011'}) SET n.claim_id = '6977098', n.note_date = '2025-12-30', n.note_type = 'Contact - Injured Worker', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = 'called clmt, reached on 2nd try. says he saw Dr Fischer on Dec 29. asked about mileage reimbursement, told to send C-257 w/ receipts. address and phone confirmed same as file.', n.word_count = 31, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977098-012'}) SET n.claim_id = '6977098', n.note_date = '2025-12-31', n.note_type = 'Medical Update', n.author_name = 'Dr Fischer', n.author_role = 'treating provider', n.text = 'Dr Fischer progressss 12/31/2025.\nSUBJECTIVE: pt c/o bruising and swelling, shin tender to touch. pain 4/10.\nOBJECTIVE: swelling, TTP over the area, no deformity. xray neg for fracture. ROM: knee/ankle ROM near full, some pain at end range.\nASSESSMENT: contusion of the right lower leg, no change.\nPLAN: ibuprofen, activity modification. restr: no standing over 2 hrs, no ladders, no kneeling. work status: working w/ restrictions. f/u 1/27.', n.word_count = 68, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977098-013'}) SET n.claim_id = '6977098', n.note_date = '2025-12-31', n.note_type = 'Contact - Provider', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = 'spoke w/ front desk at North Shore Occupational Health, they will fax the note. North Shore Occupational Health says clmt no showed last appt. need C-4.2 from Dr Fischer.', n.word_count = 29, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977098-014'}) SET n.claim_id = '6977098', n.note_date = '2026-01-01', n.note_type = 'Imaging Result', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = 'imaging note xray neg for fracture.', n.word_count = 6, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977098-015'}) SET n.claim_id = '6977098', n.note_date = '2026-01-01', n.note_type = 'Work Status', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = 'Jan 1 work status: clmt says he isnt rsaxy, pain 4/10.', n.word_count = 11, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977098-016'}) SET n.claim_id = '6977098', n.note_date = '2026-01-02', n.note_type = 'Statement / Investigation', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = 'recorded statement Jordan January 2: clmt states he backed the work van into bolllard in the lot at facility parking area around aroudn noon.', n.word_count = 24, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977098-017'}) SET n.claim_id = '6977098', n.note_date = '2026-01-05', n.note_type = 'Bill Question', n.author_name = 'Gita Rao', n.author_role = 'assistant', n.text = '01/05/2026 bill rvw (Maya): Rx from North Shore Occupational Health $96.00 paid per fee schedule. State Ins Fund paid per fee schedule. mileage request (C-257) rec\'d from EE, forwarded. duplicate bill rec\'d, flagged. EE called worried about bill from Lakeview Pharmacy. $322.50 reduced to fee schedule $239.00. auth # 43149 for xray. still need records from North Shore Occupational Health for this. -GR', n.word_count = 63, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977098-018'}) SET n.claim_id = '6977098', n.note_date = '2026-01-05', n.note_type = 'Work Status', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = '1/5/26 work status: restr per Dr Fischer: no standing over 2 hrs no ladders no kneeling. clmt says he isnt ready pain 4/10.', n.word_count = 23, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977098-019'}) SET n.claim_id = '6977098', n.note_date = '2026-01-05', n.note_type = 'Supervisor Incident Statement', n.author_name = 'Paula Kowalski', n.author_role = 'ER supervisor', n.text = 'Statement January 5 from Paula Kowalski at Harborview Community Health: I was on shift December 27. Jordan Lee told me he backed the work van into a bollard in the lot. I did not see it happen. Jordan has been reliable, no attendance issues. We did a safety huddle the next morning. Signed Paula Kowalski\nDOI December 27, Jordan backed the work van into a bollard in the lot at facillity parking area. First seen at North Shore Occupational Health on 12/31/25, dx contusion of the right lowr leg, xray neg for fracture.', n.word_count = 93, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977098-020'}) SET n.claim_id = '6977098', n.note_date = '2026-01-06', n.note_type = 'Compensability Review', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = 'compensability 06JAN26: disputing for now, we need causation supporrt, C-7 sent to the Board. no lost time to date, medical only so far. statement taken Dec 31. will revisit once medical comes in. clmt\'s account is consistent w/ Dr Fischer\'s first note.\nDOI Dec 27, clmt backed work van into a bollard in the lot at facility parking area. First seen at North Shore Occupational Health on Dec 31, dx contusion of the rt lower leg, xray neg for fracture. On modified duty from Dec 29', n.word_count = 86, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977098-021'}) SET n.claim_id = '6977098', n.note_date = '2026-01-06', n.note_type = 'Contact - Injured Worker', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = 'called clmt, reached on 2nd try.', n.word_count = 6, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977098-022'}) SET n.claim_id = '6977098', n.note_date = '2026-01-06', n.note_type = 'Authorization', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = 'From: Mei (front desk) <mei@northshoreoccupationalhealth.example>\nSent: Tue, Jan 6, 2026 16:52\nTo: Maya Patel\nSubject: RE: Claim 6977098 - Lee\n\nHi Maya,\nNext visit is scheduled for 1/27.\nWork status: working modified duty.\nJordan Lee is benig seen for contusion of the lower leg.\n\nThank you,\nMei (front desk)', n.word_count = 49, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977098-023'}) SET n.claim_id = '6977098', n.note_date = '2026-01-06', n.note_type = 'Bill Question', n.author_name = 'Gita Rao', n.author_role = 'assistant', n.text = 'bill review 01/06/2026: ortho consult from North Shore Occupational Health $103.00 paid. -GR', n.word_count = 13, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977098-024'}) SET n.claim_id = '6977098', n.note_date = '2026-01-07', n.note_type = 'Worker Message', n.author_name = 'Gita Rao', n.author_role = 'assistant', n.text = 'per email, will f/u -GR\nFrom: Jordan Lee <jordan@mail.example>\nSent: Wed, Jan 7, 2026 7:08\nTo: Maya Patel\nSubject: RE: Claim 6977098 - Lee\n\nHello\nplease let me know when my next check is coming.\ni went to North Shore Occupational Health on 12/31/2025.\n\nthank you\nJordan', n.word_count = 47, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977098-025'}) SET n.claim_id = '6977098', n.note_date = '2026-01-08', n.note_type = 'Contact - Injured Worker', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = 'clmt called in re: claim 6977098. asked about status of claim, explained it is still open. trouble sleeping bc of the pain. aksed him to call Rita Haddad about light duty at the company.', n.word_count = 34, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977098-026'}) SET n.claim_id = '6977098', n.note_date = '2026-01-09', n.note_type = 'Hearing / Legal', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = 'Jan 9 Board noice rec\'d. conciliation conference is on Feb 23. claim 6977098, conciliation conference. copy to State Insurance Fund and company. clmt asked if he has to attend - told to check the notice. Maya aware. nothing else scheduled that I can see. clmt notified by letter. IME report needs to be in by then.\nDOI Dec 27, clmt backed the work van into a bollard in lot at facility parking area. first seen at North Shore Occupational Health on 12-31-2025, dx contusion of the rt lower leg, xray neg for fracture. On modified duty from Dec 29. still waiting on wage statement from the company and initial medical report from North Shore Occupational Health.', n.word_count = 116, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
