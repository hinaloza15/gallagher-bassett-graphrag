MERGE (n:Note {note_id: 'SYN-6977182-004'}) SET n.claim_id = '6977182', n.note_date = '2025-10-22', n.note_type = 'First Report Summary', n.author_name = 'Marcus Hill', n.author_role = 'adjuster', n.text = 'first report: Aaron Wood / Hudson Valley Hospitality, DOI 10/20/2025, Wegmans Food Markets. IW says he was moving a heavy tote and felt something give at operations facility. treating at Rochester Work Injury Clinic w/ DR Doyle. employer sent C-2F, rec\'d 10/25/2025. will call IW and employer today. we have not rec\'d any wage info yet. coverage confirmed, Wegmans Food Markets is on the risk. claim # 6977182, Monroe county.\nDOI 10/20/2025, IW was moving heavy tote and felt something give at operations facility.', n.word_count = 84, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
