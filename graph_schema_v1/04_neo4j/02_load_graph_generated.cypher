MERGE (n:Note {note_id: 'SYN-6977100-064'}) SET n.claim_id = '6977100', n.note_date = '2026-01-08', n.note_type = 'Therapy Update', n.author_name = 'Beth Mehta', n.author_role = 'physical therapist', n.text = 'Rehab note visit 7 of 8 Tolerated tx well Pt reports sore across the palm, weak grip Pain 4/10 pre-tx, 4/10 after Did wrist ROM, grip strengthening, putty + ice Progressing w/ HEP ROM: Wrist ROM limited by pain, grip weak Strength 4-/5 Pt arrived late, shortened session Reviewed HEP, pt demonstrates correctly.', n.word_count = 53, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
