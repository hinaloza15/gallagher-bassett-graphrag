MERGE (n:Chunk {chunk_id: 'SYN-6977156-025-C01'}) SET n.parent_id = 'SYN-6977156-025', n.parent_kind = 'Note', n.position = 1, n.text = 'Capital Open MRI report rec\'d. lumbar xray no acute findings. report faxed to State Insurance Fund. radiologist says full report in 2 days. copy to Marcus. bill for $423.00 from Capital Open MRI, sent to bill review', n.char_start = 0, n.char_end = 215, n.word_count = 37;
