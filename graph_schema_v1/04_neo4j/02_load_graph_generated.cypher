MERGE (n:Chunk {chunk_id: 'SYN-6977100-064-C01'}) SET n.parent_id = 'SYN-6977100-064', n.parent_kind = 'Note', n.position = 1, n.text = 'Rehab note visit 7 of 8 Tolerated tx well Pt reports sore across the palm, weak grip Pain 4/10 pre-tx, 4/10 after Did wrist ROM, grip strengthening, putty + ice Progressing w/ HEP ROM: Wrist ROM limited by pain, grip weak Strength 4-/5 Pt arrived late, shortened session Reviewed HEP, pt demonstrates correctly.', n.char_start = 0, n.char_end = 311, n.word_count = 53;
MERGE (n:Chunk {chunk_id: 'SYN-6977100-065-C01'}) SET n.parent_id = 'SYN-6977100-065', n.parent_kind = 'Note', n.position = 1, n.text = 'Legal note 1/9/26: Conciliation held 1/9/26, issue narrowed to wage rate.', n.char_start = 0, n.char_end = 73, n.word_count = 11;
MERGE (n:Chunk {chunk_id: 'SYN-6977100-066-C01'}) SET n.parent_id = 'SYN-6977100-066', n.parent_kind = 'Note', n.position = 1, n.text = 'Marcus called in re: Claim 6977100. Asked about mileage reimbursement, told to send C-257 with receipts. Marcus got a bill for $132.50 from Brooklyn Occupational Medicine, I told him not to pay it, we will check it.', n.char_start = 0, n.char_end = 215, n.word_count = 37;
MERGE (n:Chunk {chunk_id: 'SYN-6977100-067-C01'}) SET n.parent_id = 'SYN-6977100-067', n.parent_kind = 'Note', n.position = 1, n.text = 'Rehab note January 12: Visit 8 of 8. Pt reports sore across the palm, weak grip. Goal: Carry 20 lbs without pain.', n.char_start = 0, n.char_end = 113, n.word_count = 22;
MERGE (n:Chunk {chunk_id: 'SYN-6977100-068-C01'}) SET n.parent_id = 'SYN-6977100-068', n.parent_kind = 'Note', n.position = 1, n.text = 'Legal note conciliation held Jan 9, no agreement, Board keeps it open.', n.char_start = 0, n.char_end = 70, n.word_count = 12;
MERGE (n:Chunk {chunk_id: 'SYN-6977100-069-C01'}) SET n.parent_id = 'SYN-6977100-069', n.parent_kind = 'Note', n.position = 1, n.text = 'Subject: Status Report - Claim 6977100 - Marcus Reed\nHi Paula,\n\nPlease see the update below on Marcus Reed\'s claim (Hudson Public Services, DOI 11/21/25, service site). I have kept the history short, call me if you want more.\n\nCLAIM HISTORY\nDOI 11/21/25, Marcus Reed tripped on something on the floor and went down at service site. First seen at Brooklyn Occupational Medicine on 11/25/25, dx hand injury of the right hand, xray neg. On modified duty from Nov 24. PT at Lakeview Physical Therapy started 12/9/25, 8 of 8 authorized visits used so far. Conciliation held 1/9/26. No wage payments, medical bills only, approx $970 paid to date. Contacts: adjuster Priya Shah, ER contact Carla Lindqvist, ER supervisor Carla Brennan, treating Dr Osei, PT Beth Mehta at Lakeview Physical Therapy. Coverage: Wesco Insurance Co on the risk, Nassau county, service site.', n.char_start = 0, n.char_end = 861, n.word_count = 142;
MERGE (n:Chunk {chunk_id: 'SYN-6977100-069-C02'}) SET n.parent_id = 'SYN-6977100-069', n.parent_kind = 'Note', n.position = 2, n.text = 'CURRENT MEDICAL: treating with Dr Osei at Brooklyn Occupational Medicine. Pain was 4/10 at the last visit (12/23/25) and Marcus reports sore across the palm, weak grip. Restrictions: no repetitive gripping, lifting to 10 lbs.\nWORK STATUS: Marcus is working modified duty.\nBENEFITS: no lost time, no wage benefits due at this point. Medical bills are being paid per the fee schedule.\nLEGAL: conciliation held 1/9/26, no agreement, Board keeps it open.\nCONTACTS: adjuster Priya Shah, ER contact Carla Lindqvist (Hudson Public Services), ER supervisor Carla Brennan, treating Dr Osei at Brooklyn Occupational Medicine. PT is Beth Mehta at Lakeview Physical Therapy.\nCOVERAGE: Wesco Insurance Co is on the risk. Claim is in Nassau county, injury location service site. No prior claims found on Marcus.\nOUTSTANDING: nothing.\nRESERVES: no change recommended right now, med reserve $4,500. We will revisit after the next medical report.\nPLAN: continue to monitor, speak with Marcus and the company again this month, and send the next update by 2/11/26. Please let me know if you need anything else in the meantime.\n\nThanks,\nPriya Shah', n.char_start = 863, n.char_end = 1990, n.word_count = 179;
MERGE (n:Chunk {chunk_id: 'SYN-6977100-070-C01'}) SET n.parent_id = 'SYN-6977100-070', n.parent_kind = 'Note', n.position = 1, n.text = 'Dr Osei progress . Pt c/o sore across the palm, weak grip. C-4.2 to follow. Continue wrist ROM, grip strengthening, putty.', n.char_start = 0, n.char_end = 122, n.word_count = 21;
MERGE (n:Chunk {chunk_id: 'SYN-6977100-071-C01'}) SET n.parent_id = 'SYN-6977100-071', n.parent_kind = 'Note', n.position = 1, n.text = '2/4/26 work status: Asked Dr Osei for updated work status Marcus says he isnt ready, pain 3/10 Marcus worried about the commute.', n.char_start = 0, n.char_end = 128, n.word_count = 22;
MERGE (n:Chunk {chunk_id: 'SYN-6977100-072-C01'}) SET n.parent_id = 'SYN-6977100-072', n.parent_kind = 'Note', n.position = 1, n.text = 'File review 2/6/26. Marcus has a hand injury of the right hand from 11/21/25, claim is open. Marcus is seeing Dr Osei at Brooklyn Occupational Medicine and last reported pain at 3/10, sore across the palm, weak grip. Restrictions are: No repetitive gripping, lifting to 10 lbs. Marcus is working modified duty. No lost time and no wage payments due. Pending: Nothing. Plan: Continue to monitor, next review 3/8/26.\nDOI November 21, Marcus tripped on something on the floor and went down at service site. First seen at Brooklyn Occupational Medicine on 11/25/25, dx hand injury of the right hand, xray neg. On modified duty from 11/24/25. PT at Lakeview Physical Therapy started 12/9/25, 8 of 8 authorized visits used so far. Conciliation held 1/9/26. No wage payments, medical bills only, approx $1,025 paid to date. Contacts: Adjuster Priya Shah, ER contact Carla Lindqvist, ER supervisor Carla Brennan, treating Dr Osei, PT Beth Mehta at Lakeview Physical Therapy. Coverage: WESCO INSURANCE CO on the risk, Nassau county, service site.', n.char_start = 0, n.char_end = 1037, n.word_count = 169;
MERGE (n:Chunk {chunk_id: 'SYN-6977100-073-C01'}) SET n.parent_id = 'SYN-6977100-073', n.parent_kind = 'Note', n.position = 1, n.text = '2/10/26 - RTW: Marcus is working regular duty, no issues Restr per Dr Osei: No repetitive gripping, lifting to 10 lbs Full duty release expected 2/26 Asked Dr Osei for updated work status The company should have the new restrictions in writing.', n.char_start = 0, n.char_end = 244, n.word_count = 42;
MERGE (n:Chunk {chunk_id: 'SYN-6977100-074-C01'}) SET n.parent_id = 'SYN-6977100-074', n.parent_kind = 'Note', n.position = 1, n.text = 'Can we approve this?\nFrom: Carla Lindqvist <carla@hudsonpublicservices.example>\nSent: Tue, Feb 10, 2026 9:40\nTo: Priya Shah\nSubject: RE: Claim 6977100 - Reed\n\nHi Priya,\nJob description attached.\nPlease send us the restrictions in writing.\nMarcus Reed was out on vacation last week, no call to us.\n\nRegards,\nCarla Lindqvist', n.char_start = 0, n.char_end = 322, n.word_count = 50;
MERGE (n:Chunk {chunk_id: 'SYN-6977100-075-C01'}) SET n.parent_id = 'SYN-6977100-075', n.parent_kind = 'Note', n.position = 1, n.text = 'OFFICE NOTE 2/11/26 (Dr Osei): Exam: Grip 4/5, cap refill ok. Xray neg. Tx: Brace/splint prn, ice. Work status: Working regular duty, no issues. Pt states compliant w/ tx. ROM: Wrist ROM limited by pain, grip weak. C-4.2 to follow. F/u 2/26.', n.char_start = 0, n.char_end = 241, n.word_count = 42;
