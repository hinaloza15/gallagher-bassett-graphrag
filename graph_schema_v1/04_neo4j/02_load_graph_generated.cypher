MERGE (n:Chunk {chunk_id: 'SYN-6977182-046-C01'}) SET n.parent_id = 'SYN-6977182-046', n.parent_kind = 'Note', n.position = 1, n.text = 'need to respond to this. -WP\nFrom: Aaron Wood <aaron@mail.example>\nSent: Fri, Dec 12, 2025 9:48\nTo: Marcus Hill\nSubject: RE: Claim 6977182 - Wood\n\nhi,\nplease call me back, my number is the same.\ni got a bill for $263.00, not sure if i pay it.\nplease let me know when my next check is coming.\n\nthank you\nAaron', n.char_start = 0, n.char_end = 308, n.word_count = 60;
