MERGE (n:Note {note_id: 'SYN-6977175-071'}) SET n.claim_id = '6977175', n.note_date = '2026-03-09', n.note_type = 'Contact - Provider', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = 'can we approve this?\nFrom: Rita (front desk) <rita@northshoreoccupationalhealth.example>\nSent: Mon, Mar 9, 2026 11:13\nTo: Maya Patel\nSubject: RE: Claim 6977175 - Ward\n\nHi Maya,\nPlease confirm authorization for the PT visits.\nCaleb Ward is being seen for strain of the neck, back and wrists.\nAttached is the note from Caleb Ward\'s visit on Feb 19.\n\nRegards,\nRita (front desk)', n.word_count = 61, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977175-072'}) SET n.claim_id = '6977175', n.note_date = '2026-03-13', n.note_type = 'File Review', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = 'clmt neck back and wrists strain DOI Nov 11. file is still open. seeing Dr Romano at North Shore Occupational Health; pain 0/10 per last note; feeling much better occasional soreness. working regular duty no issues; restr: released to full duty no restrictions. no Board activity. nothing. call clmt f/u w/ Dr Romano review again Apr 12. DOI Nov 11 clmt was struck by a coworker during a pallet move at facility parking area. first seen at North Shore Occupational Health on Nov 14 dx strain of neck back and wrists lumbar xray no acute findings. Victor Brandt is worker\'s attorney. no wage payments medical bills only approx $630 paid to date. Contacts: adjuster Maya Patel ER contact Carla Iyer ER supervisor Alicia Fischer treating Dr Romano. Coverage: State Insurance Fund on the risk Warren county facility parking area.', n.word_count = 139, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
