MERGE (n:Note {note_id: 'SYN-6977098-080'}) SET n.claim_id = '6977098', n.note_date = '2026-05-01', n.note_type = 'Reserve Review', n.author_name = 'Carol Jennings', n.author_role = 'supervisor', n.text = 'reserve review 5-1-2026: increased med reserve bc lost time continuing. paid to date approx $4,500. we should revisit after the next medical. -CJ', n.word_count = 23, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977098-081'}) SET n.claim_id = '6977098', n.note_date = '2026-05-11', n.note_type = 'Status Report', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = 'Subject: Status Report - Claim 6977098 - Jordan Lee\nHi Frank,\n\nPlease see the update below on Jordan Lee\'s claim (Harborview Community Health, DOI Dec 27, facility parking area). I have kept the history short, call me if you want more.\n\nCLAIM HISTORY\nDOI Dec 27, Jordan backed the work van into a bollard in the lot at facility parking area. First seen at North Shore Occupational Health on Dec 31, dx contusion of the rt lower leg, xray neg for fracture. On modified duty from Dec 29. Back to full duty from Feb 19. PT at Riverbend Physical Therapy started Jan 12, 12 of 12 authorized visits used so far. MRI ordered Jan 20, result Feb 1: mild effusion, possible meniscus signal change. Conciliation held Feb 23. No wage payments, medical bills only, approx $1,360 paid to date. Contacts: adjuster Maya Patel, ER contact Rita Haddad, ER supervisor Paula Kowalski, treating Dr Fischer, PT Tom Nakamura at Riverbend Physical Therapy.\n\nCURRENT MEDICAL: treating with Dr Fischer at North Shore Occupational Health. Pain was 0/10 at the last visit (Mar 10) and Jordan reports no complaints. Restrictions: released to full duty, no restrictions.\nWORK STATUS: clmt is working regular duty, no issues.\nBENEFITS: no lost time, no wage benefits due at this point. Medical bills are being paid per the fee schedule.\nLEGAL: conciliation held 2/23/26, no agreement, Board keeps it open.\nCONTACTS: adjuster Maya Patel, ER contact Rita Haddad (Harborview Community Health), ER supervisor Paula Kowalski, treating Dr Fischer at North Shore Occupational Health. PT is Tom Nakamura at Riverbend Physical Therapy.\nCOVERAGE: State Ins Fund is on the risk. Claim is in Nassau county, injury location facility parking area. No prior claims found on clmt.\nOUTSTANDING: nothing.\nRESERVES: no change recommended right now, med reserve $8,500. We will revisit after the next medical report.\nPLAN: continue to monitor, speak with clmt and the company again this month, and send the next update by Jun 1. Please let me know if you need anything else in the meantime.\n\nThanks,\nMaya Patel', n.word_count = 342, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977098-082'}) SET n.claim_id = '6977098', n.note_date = '2026-05-22', n.note_type = 'File Review', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = 'clmt, rt lower leg contusion, DOI Dec 27. file is open. seeing Dr Fischer at North Shore Occupational Health; pain 0/10 per last note; mild stiffness only. working regular duty, no issues; restr: released to full duty, no restrictions. conciliation held Feb 23, issue narrowed to medical bills. nothing. we get the nothing, then close the diary 6/5/26. DOI Dec 27, clmt backed the work van into a bollard in the lot at facility parking area. first seen at North Shore Occupational Health on Dec 31, dx contusion of the rt lower leg, xray neg for fracture. On modified duty from Dec 29. Back to full duty from Feb 19.', n.word_count = 110, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
