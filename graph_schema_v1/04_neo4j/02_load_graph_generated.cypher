MERGE (n:Note {note_id: 'SYN-6977182-018'}) SET n.claim_id = '6977182', n.note_date = '2025-10-27', n.note_type = 'Supervisor Incident Statement', n.author_name = 'Lena Brennan', n.author_role = 'ER supervisor', n.text = 'Statement Oct 27 from Lena Brennan at Hudson Valley Hospitality: I was on shift 10-20-2025. Aaron told me he was moving a heavy tote and felt something give. I did not see it happen. No other witnesses that i know of. We have a camera but not sure it covers operations facility. I offered to call an ambulance, he said no. The floor was dry that day as far as i know. Aaron has been reliable, no attendance issues. I can send the schedule for that week if needed.\nDOI 10/20/2025, Aaron was moving a heavy tote and felt something give at operations facility. First seen at Rochester Work Injury Clinic on 10/27/2025, dx strain of the right forearm, xray neg. Still waiting on wage statement from the company and initial medical report from Rochester Work Injury Clinic.', n.word_count = 138, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977182-019'}) SET n.claim_id = '6977182', n.note_date = '2025-10-29', n.note_type = 'Statement / Investigation', n.author_name = 'Marcus Hill', n.author_role = 'adjuster', n.text = 'Recorded statement IW 10/29/2025: IW states he was moving heavy tote and felt something give at operations facility around around noon. he reported to Lena Brennan right away, told to see Rochester Work Injury Clinic. denies prior problems w/ forearm. supervisor statement requested from Lena Brennan. IW understood the statement is recorded. IW says he told Lena Brennan before end of the shift. asked about any activities outside work, nothing unusual.\nDOI 10/20/2025, IW was moving a heavy tote and felt something give at operations facility -MH', n.word_count = 87, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977182-020'}) SET n.claim_id = '6977182', n.note_date = '2025-10-30', n.note_type = 'Compensability Review', n.author_name = 'Marcus Hill', n.author_role = 'adjuster', n.text = '10/30/2025 - decision on claim 6977182: accepting as work related, employer confirms IW was on shift. no lost time to date, medical only so far. statement taken 10/27/2025. employer report matches IW\'s account. no witnesses per Lena Brennan. will revisit once the medical comes in. IW\'s account is consistent w/ DR Doyle\'s first note. we will diary for wage statement. no signs of a prior injury in the records so far.\nDOI 10/20/2025, IW was moving a heavy tote and felt something give at operations facility. first seen at Rochester Work Injury Clinic on 10/27/2025, dx strain of the rt forearm, xray neg. still waiting on wage statemet from employer and initial medical report from Rochester Work Injury Clinic -MH', n.word_count = 120, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977182-021'}) SET n.claim_id = '6977182', n.note_date = '2025-11-03', n.note_type = 'Contact - Injured Worker', n.author_name = 'Marcus Hill', n.author_role = 'adjuster', n.text = '11/03/2025 outbound call to Aaron. asked about status of claim, explained it is still open. worried about employer cutting hours. asked about mileage reimbursement, told to send C-257 w/ receipts. IW got a bill for $59.00 from Rochester Work Injury Clinic, I told him not to pay it, we will check it. asked him to call Paula Nakamura about the light duty at employer. will call back.\nDOI 10/20/2025, IW was moving a heavy tote and felt something give at operations facility. first seen at Rochester Work Injury Clinic on 10/27/2025, dx strain of the rt forearm, xray neg -MH', n.word_count = 100, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
