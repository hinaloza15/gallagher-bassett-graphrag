MERGE (n:Note {note_id: 'SYN-6977156-089'}) SET n.claim_id = '6977156', n.note_date = '2026-05-20', n.note_type = 'Medical Update', n.author_name = 'Dr Haddad', n.author_role = 'treating provider', n.text = 'Dr Haddad progress 5/20/26.\nSUBJECTIVE: pt c/o sore all over, stiff in the mornings. pain 2/10. pt states compliant w/ tx.\nOBJECTIVE: paraspinal spasm, FROM limited. MRI: mild disc bulge L4-5, no stenosis. ROM: lumbar flexion limited, extension ok.\nASSESSMENT: strain of the low back, hip and both knees, improving.\nPLAN: ice, heat, nsaids. restr: lifting up to 30 lbs ok, no prolonged bending. work status: working modified duty. f/u 6/8.', n.word_count = 71, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977156-090'}) SET n.claim_id = '6977156', n.note_date = '2026-05-22', n.note_type = 'File Review', n.author_name = 'Marcus Hill', n.author_role = 'adjuster', n.text = 'STATUS: Emma, low back, hip and both knees strain, DOI 12/21/2025. file is still open.\nMEDICAL: seeing DR Haddad at North Shore Occupational Health; pain 2/10 per last note; sore all over, stiff in the mornings.\nWORK: back on light duty; restr: lifting up to 30 lbs ok, no prolonged bending.\nPAY: paying $710.00/wk, approx $14,200 paid to date.\nLEGAL: second hearing 04/14/2026 held, judge reserved decision.\nPENDING: nothing.\nPLAN: call IW, follow up with DR Haddad, review again 06/05/2026.\nHISTORY: DOI December 21, IW missed the last few steps and fell at operations facility. First seen at North Shore Occupational Health on 12/25/2025, dx strain of the low back, hip and both knees, lumbar xray no acute findings. Off work from 12/22/2025. On modified duty from 01/15/2026. PT at Summit Rehab & Sports PT started 01/06/2026, 16 of 16 authorized visits used so far. MRI ordered Jan 12, result 01/24/2026: mild disc bulge L4-5, no stenosis. IME with Dr Iyer on 03/05/2026, report 03/20/2026 says supports a work-related injury, no ongoing disability. Lena Alvarez is the worker\'s attorney. Hearing held Mar 3. Second hearing 04/14/2026. Weekly payments of $710 started 12/31/2025, approx $14,200 paid to date. Contacts: adjuster Marcus Hill, ER contact Tasha Kowalski, ER supervisor Greg Romano, treating DR Haddad, PT Lena Mehta at Summit Rehab & Sports PT. Coverage: State Ins Fund on the risk, Queens county, operations facility.', n.word_count = 232, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977156-091'}) SET n.claim_id = '6977156', n.note_date = '2026-05-27', n.note_type = 'Contact - Injured Worker', n.author_name = 'Marcus Hill', n.author_role = 'adjuster', n.text = 'IW called in re: claim 6977156. pain about 2/10 today per IW. worried about employer cutting hours. working modified duty. asked when the next check is due, told IW checks are $710.00/wk. address and phone confirmed same as file. IW says she is not sure she can do the light duty offered, I told her to talk to DR Haddad. IW got bill for $215.75 from North Shore Occupational Health, I told her not to pay it, we will check it.\nDOI 12/21/2025, IW missed last few steps and fell at operations facility.', n.word_count = 93, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977156-092'}) SET n.claim_id = '6977156', n.note_date = '2026-05-28', n.note_type = 'Benefits Payment', n.author_name = 'Pam Whitfield', n.author_role = 'specialist', n.text = 'Ledger clmt called about a late check, $107 outstanding. Direct deposit set up for clmt.', n.word_count = 15, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977156-093'}) SET n.claim_id = '6977156', n.note_date = '2026-05-29', n.note_type = 'Contact - Employer', n.author_name = 'Marcus Hill', n.author_role = 'adjuster', n.text = 'see bleow. -MH\nFrom: Tasha Kowalski <tasha@harborviewcommunityhealth.example>\nSent: Fri, May 29, 2026 13:06\nTo: Marcus Hill\nSubject: RE: Claim 6977156 - Rivera\n\nHi Marcus,\nJob description attached.\nAttached is the wage statement for Emma Rivera.\n\nThank you,\nTasha Kowalski', n.word_count = 39, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977156-094'}) SET n.claim_id = '6977156', n.note_date = '2026-06-01', n.note_type = 'Work Status', n.author_name = 'Marcus Hill', n.author_role = 'adjuster', n.text = 'RTW: IW is back to full duty. restr per DR Haddad: lifting up to 30 lbs ok, no prolonged bending. full duty release expected 6/8. asked DR Haddad for updated work status. employer should have new restrictions in writing -MH', n.word_count = 40, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977156-095'}) SET n.claim_id = '6977156', n.note_date = '2026-06-02', n.note_type = 'Bill Question', n.author_name = 'Tina Morales', n.author_role = 'assistant', n.text = 'can we approve this? -Tina\nFrom: Ravi (front desk) <ravi@northshoreoccupationalhealth.example>\nSent: Tue, Jun 2, 2026 8:54\nTo: Marcus Hill\nSubject: RE: Claim 6977156 - Rivera\n\nHi Marcus,\nRestrictions remain: lifting up to 30 lbs ok, no prolonged bending.\nWork status: working regular duty, no issues.\nWe are requesting 16 PT visits, please advise.\nPlease confirm authorization for the PT visits.\n\nThanks,\nRavi (front desk)', n.word_count = 64, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977156-096'}) SET n.claim_id = '6977156', n.note_date = '2026-06-03', n.note_type = 'Permanency / Settlement', n.author_name = 'Marcus Hill', n.author_role = 'adjuster', n.text = 'perm eval update: DR Haddad says MMI reached, rating pending. Lena Alvarez asking about settlement numbers, none authorized yet. need Medicare status check before any Section 32. IW wants to know what Section 32 mans, explained it is negotiated settlement filed w/ the Board. classification still open, waiting on the report. Marcus to request authority. we are not ready to talk numbers until rating comes in.\nDOI 12/21/2025, IW missed last few steps and fell at operations facility. First seen at North Shore Occupational Health on Dec 25, dx strain of the low back, hip and both knees, lumbar xray no acute findings. Off work from 12/22/2025. On modified duty from 1/15/26. Back to full duty from 05/30/2026. PT at Summit Rehab & Sports PT started 01/06/2026, 16 of 16 authorized visits used so far. MRI ordered 01/12/2026, result 01/24/2026: mild disc bulge L4-5, no stenosis. IME w/ Dr Iyer on 03/05/2026, report March 20 says supports work-related injury, no ongoing disability. Lena Alvarez is the worker\'s attorney. hearing held 03MAR26. Second hearing 04/14/2026. Weekly payments of $710 started 12/31/2025, approx $15,620 paid to date. Contacts: adjuster Marcus Hill, ER contact Tasha Kowalski, ER supervisor Greg Romano, treating DR Haddad, PT Lena Mehta at Summit Rehab & Sports PT. Coverage: State Insurance Fund on risk, Queens county, operations facility -MH', n.word_count = 220, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977156-097'}) SET n.claim_id = '6977156', n.note_date = '2026-06-12', n.note_type = 'Attorney Correspondence', n.author_name = 'Marcus Hill', n.author_role = 'adjuster', n.text = 'FYI -MH\nFrom: Lena Alvarez <lena@alvarezlaw.example>\nSent: Fri, Jun 12, 2026 13:21\nTo: Marcus Hill\nSubject: RE: Claim 6977156 - Rivera\n\nHi Marcus,\nPlease provide a copy of the IME report.\nMy client is available for a call, my office number is on file.\n\nRegards,\nLena Alvarez', n.word_count = 47, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
