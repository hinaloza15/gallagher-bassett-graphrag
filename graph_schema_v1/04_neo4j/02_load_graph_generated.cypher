MERGE (n:Chunk {chunk_id: 'SYN-6977144-006-C01'}) SET n.parent_id = 'SYN-6977144-006', n.parent_kind = 'Note', n.position = 1, n.text = 'Priya Shah called in re: Claim 6977144 Trouble sleeping because of the pain Address and phone confirmed same as file.', n.char_start = 0, n.char_end = 117, n.word_count = 20;
MERGE (n:Chunk {chunk_id: 'SYN-6977144-007-C01'}) SET n.parent_id = 'SYN-6977144-007', n.parent_kind = 'Note', n.position = 1, n.text = 'ER call, Tasha Okafor. Asked Paula Nakamura about restrictions: No lifting over 10 lbs, no repeated bending. Safety review done, no changes to the service site yet. Paula Nakamura will send the job description. Payroll has not sent the wage statement. I asked Paula Nakamura to put the light duty offer in writing. No further questions.\nDOI 12/26/25, Priya Shah tripped on something on the floor and went down at service site. First seen at Empire Phys Med on December 30, dx contusion of the neck and low back, lumbar xray no acute findings.', n.char_start = 0, n.char_end = 542, n.word_count = 94;
MERGE (n:Chunk {chunk_id: 'SYN-6977144-008-C01'}) SET n.parent_id = 'SYN-6977144-008', n.parent_kind = 'Note', n.position = 1, n.text = 'Dr note rec\'d Dec 31 from Empire Physical Medicine:\nSUBJECTIVE: pt c/o neck and low back sore and stiff. pain 4/10.\nOBJECTIVE: TTP lumbar paraspinals, neg SLR. lumbar xray no acute findings. ROM: lumbar flexion limited, extension ok.\nASSESSMENT: contusion of the neck and low back, no change.\nPLAN: tylenol, activity modification. restr: no lifting over 10 lbs, no repeated bending. work status: working modified duty. f/u 1/20.', n.char_start = 0, n.char_end = 428, n.word_count = 68;
MERGE (n:Chunk {chunk_id: 'SYN-6977144-009-C01'}) SET n.parent_id = 'SYN-6977144-009', n.parent_kind = 'Note', n.position = 1, n.text = '12/31/25 diary - no change. Waiting on the initial medical report from Empire Physical Medicine.', n.char_start = 0, n.char_end = 96, n.word_count = 15;
MERGE (n:Chunk {chunk_id: 'SYN-6977144-010-C01'}) SET n.parent_id = 'SYN-6977144-010', n.parent_kind = 'Note', n.position = 1, n.text = 'Diary 12/31/25: Nothing new from the company or Empire Physical Medicine.', n.char_start = 0, n.char_end = 73, n.word_count = 11;
MERGE (n:Chunk {chunk_id: 'SYN-6977144-011-C01'}) SET n.parent_id = 'SYN-6977144-011', n.parent_kind = 'Note', n.position = 1, n.text = 'text msg rec\'d Dec 31 from Priya: can someone tell me if Empire Physical Medicine got paid -WP', n.char_start = 0, n.char_end = 94, n.word_count = 18;
MERGE (n:Chunk {chunk_id: 'SYN-6977144-012-C01'}) SET n.parent_id = 'SYN-6977144-012', n.parent_kind = 'Note', n.position = 1, n.text = 'Empire Physical Medicine called. Dr Okafor\'s office says next appt 1/23. Asked Dr Okafor for an updated work status, fax request sent. Empire Physical Medicine billing called about a denied visit, referred to WEGMANS FOOD MARKETS. Empire Physical Medicine says Priya no showed the last appt. Need the C-4.2 from Dr Okafor. Dr Okafor wants Priya to continue core stabilization, hamstring stretching, bridging. Empire Physical Medicine sent a bill for $316.50, forwarded to bill review.', n.char_start = 0, n.char_end = 484, n.word_count = 75;
