MERGE (n:Note {note_id: 'SYN-6977160-035'}) SET n.claim_id = '6977160', n.note_date = '2026-01-16', n.note_type = 'Worker Message', n.author_name = 'Jamal Webb', n.author_role = 'assistant', n.text = 'portal msg (Chloe): nobody called me back abt MRI report. i have a bill from Main St Pharmacy. my boss Ravi Brandt keeps asking when i can come back. i sent the forms last week did you get them. tylenol is not really helping. my appt got moved to 2/2. i need to know who to talk to abt mileage. i cant sleep bc of my low back, hip and both knees.', n.word_count = 72, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977160-036'}) SET n.claim_id = '6977160', n.note_date = '2026-01-16', n.note_type = 'Worker Message', n.author_name = 'Jamal Webb', n.author_role = 'assistant', n.text = 'text msg rec\'d 1/16/26 from Chloe: my low back hip and both knees still hurts when i bend or lift. nobody called me back abt the MRI report. i sent forms last week did you get them. my number changed new one is on file now. tylenol is not really helping. do i need to go to IME i dont have a ride. i need to know who to talk to abt mileage. i cant sleep bc of my low back hip and both knees. thx -Jamal', n.word_count = 87, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977160-037'}) SET n.claim_id = '6977160', n.note_date = '2026-01-19', n.note_type = 'Imaging Result', n.author_name = 'Daniel Brooks', n.author_role = 'adjuster', n.text = 'See below.\nFrom: Lena (front desk) <lena@upstatehearingbalancecenter.example>\nSent: Mon, Jan 19, 2026 12:53\nTo: Daniel Brooks\nSubject: RE: Claim 6977160 - Nguyen\n\nHi Daniel,\nRestrictions remain: no lifting over 20 lbs, limit bending.\nWork status: workiing modified duty.\nPlease confirm authorization for the xray.\nOur billing for $380.00 was sent on January 12, please confirm receipt.\n\nThank you,\nLena (front desk)', n.word_count = 61, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977160-038'}) SET n.claim_id = '6977160', n.note_date = '2026-01-20', n.note_type = 'Contact Attempt', n.author_name = 'Jamal Webb', n.author_role = 'assistant', n.text = 'no answer at Upstate Hearing & Balance Center, LM for rcords. -Jamal', n.word_count = 12, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977160-039'}) SET n.claim_id = '6977160', n.note_date = '2026-01-26', n.note_type = 'Status Report', n.author_name = 'Daniel Brooks', n.author_role = 'adjuster', n.text = 'Subject: Status Report - Claim 6977160 - Chloe Nguyen\nHi Alicia,\n\nPlease see the update below on Chloe Nguyen\'s claim (City Operations Department, DOI December 9, warehouse). I have kept the history short, call me if you want more.\n\nCLAIM HISTORY\nDOI December 9, Chloe Nguyen was hit at an intersection driving the company vehicle at warehouse. First seen at Upstate Hearing & Balance Center on December 12, dx strain of the low back, hip and both knees, lumbar xray no acute findings. On modified duty from December 10. MRI ordered January 7, result January 18: mild disc bulge L4-5, no stenosis. Alicia Romano is the worker\'s attorney. No wage payments, medical bills only, approx $465 paid to date. Contacts: adjuster Daniel Brooks, ER contact Frank Nakamura, ER supervisor Ravi Brandt, treating Dr Haddad. Coverage: State Insurance Fund on the risk, Rockland county, warehouse.\n\nCURRENT MEDICAL: treating with Dr Haddad at Upstate Hearing & Balance Center. Pain was 4/10 at the last visit (Jan 12) and Chloe reports pain in the low back, worse by end of shift. Restrictions: no lifting over 20 lbs, limit bending.\nWORK STATUS: Chloe is working w/ restrictions.\nBENEFITS: no lost time, no wage benefits due at this point. Medical bills are being paid per the fee schedule.\nLEGAL: first hearing is on 02/20/2026, notice went to all parties.\nChloe is represented by Alicia Romano, who has asked for the claim file and our position on added treatment. We are responding by letter.\nCONTACTS: adjuster Daniel Brooks, ER contact Frank Nakamura (City Operations Department), ER supervisor Ravi Brandt, treating Dr Haddad at Upstate Hearing & Balance Center.\nCOVERAGE: State Insurance Fund is on the risk. Claim is in Rockland county, injury location warehouse. No prior claims found on Chloe.\nOUTSTANDING: nothing.\nRESERVES: no change recommended right now, med reserve $6,000. We will revisit after the next medical report.\nPLAN: continue to monitor, speak with Chloe and employer again this month, and send the next update by February 9. Please let me know if you need anything else in the meantime.\n\nThanks,\nDaniel Brooks', n.word_count = 348, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977160-040'}) SET n.claim_id = '6977160', n.note_date = '2026-01-28', n.note_type = 'Pharmacy', n.author_name = 'Pam Whitfield', n.author_role = 'specialist', n.text = '01/28/2026 pharmacy note (Main St Pharmacy): PPO pharmacy nettwork rule explained to clmt.', n.word_count = 13, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977160-041'}) SET n.claim_id = '6977160', n.note_date = '2026-01-28', n.note_type = 'Contact - Injured Worker', n.author_name = 'Daniel Brooks', n.author_role = 'adjuster', n.text = 'Spoke with Chloe January 28 Chloe states pain in the low back, worse by end of shift Trouble sleeping because of the pain Chloe says she is not sure she can do the light duty offered, I told her to talk to Dr Haddad.', n.word_count = 44, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977160-042'}) SET n.claim_id = '6977160', n.note_date = '2026-02-09', n.note_type = 'Bill Question', n.author_name = 'Jamal Webb', n.author_role = 'assistant', n.text = 'FYI -Jamal\nFrom: Rita (front desk) <rita@upstatehearingbalancecenter.example>\nSent: Mon, Feb 9, 2026 15:07\nTo: Daniel Brooks\nSubject: RE: Claim 6977160 - Nguyen\n\nHi Daniel,\nNext visit is scheduled for 3/2.\nWe are requesting 6 PT visits, please advise.\nAttached is the note from Chloe Nguyen\'s visit on 2/2/26.\nWork status: working w/ restrictions.\n\nRegards,\nRita (front desk)', n.word_count = 57, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977160-043'}) SET n.claim_id = '6977160', n.note_date = '2026-02-09', n.note_type = 'IME Note', n.author_name = 'Daniel Brooks', n.author_role = 'adjuster', n.text = 'IME sched February 20 with Dr Fischer. Purpose: Causation + need for further tx for low back, hip and both knees. Chloe Nguyen not happy with the exam, says it lasted 10 min. Dr Haddad may disagree. Report due approx 2 wks after the exam. Chloe told to bring imaging and ID.\nDOI 12/9/25, Chloe was hit at an intersection driving the company vehicle at warehouse. First seen at Upstate Hearing & Balance Center on December 12, dx strain of the low back, hip and both knees, lumbar xray no acute findings.', n.word_count = 92, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
