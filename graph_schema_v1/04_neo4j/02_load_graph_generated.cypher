MERGE (n:Note {note_id: 'SYN-6977140-007'}) SET n.claim_id = '6977140', n.note_date = '2025-12-04', n.note_type = 'Contact - Employer', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = 'Called Hudson Valley Hospitality, spoke w/ Nora Brennan. company wants to know if the claim is accepted, told them it is open, no Board date yet. Nora Brennan says clmt has been fine, no problems lately. company says clmt missed 7 days last month. Lena Castillo says no other injuries like this at site. told Lena Castillo we cant discuss reserves. payroll has not sent the wage statement.\nDOI Dec 2, Maya was struck by a coworker during pallet move at facility parking area.', n.word_count = 84, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977140-008'}) SET n.claim_id = '6977140', n.note_date = '2025-12-05', n.note_type = 'Contact - Provider', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = 'Dr Brennan\'s office. asked Dr Brennan for an updated work status, fax request sent.', n.word_count = 14, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
