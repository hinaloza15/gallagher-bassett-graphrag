MERGE (n:Note {note_id: 'SYN-6977098-051'}) SET n.claim_id = '6977098', n.note_date = '2026-02-16', n.note_type = 'Bill Question', n.author_name = 'Gita Rao', n.author_role = 'assistant', n.text = 'can we approve this? -GR\nFrom: Greg (front desk) <greg@northshoreoccupationalhealth.example>\nSent: Mon, Feb 16, 2026 9:43\nTo: Maya Patel\nSubject: RE: Claim 6977098 - Lee\n\nHi Maya,\nOur billing for $234.50 was sent on 01/27/2026, please confirm receipt.\nNext visit is scheduled for 2/23.\nWork status: back on light duty.\n\nRegards,\nGreg (front desk)', n.word_count = 54, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
