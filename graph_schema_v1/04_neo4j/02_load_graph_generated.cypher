MERGE (n:Chunk {chunk_id: 'SYN-6977140-071-C01'}) SET n.parent_id = 'SYN-6977140-071', n.parent_kind = 'Note', n.position = 1, n.text = 'clmt, lt upper arm strain, DOI Dec 2. file is still open. seeing Dr Brennan at Rochester Work Injury Clinic; pain 0/10 per last note; feeling much better, occasional soreness. back to full duty; restr: released to full duty, no restrictions. no Board activity. nothing. we get nothing, then close the diary May 13. DOI Dec 2, clmt was struck by coworker during pallet move at facility parking area. first seen at Rochester Work Injury Clinic on 12-8-2025, dx strain of lt upper arm, xray neg. PT at Lakeview Physical Therapy started Dec 19, 12 of 12 authorized visits used so far. no wage payments, medical bills only, approx $1,470 paid to date.', n.char_start = 0, n.char_end = 646, n.word_count = 113;
MERGE (n:Chunk {chunk_id: 'SYN-6977140-072-C01'}) SET n.parent_id = 'SYN-6977140-072', n.parent_kind = 'Note', n.position = 1, n.text = 'can we approve this?\nFrom: Beth (front desk) <beth@rochesterworkinjuryclinic.example>\nSent: Fri, Apr 24, 2026 15:25\nTo: Maya Patel\nSubject: RE: Claim 6977140 - Patel\n\nHi Maya,\nWe are requesting 12 PT visits, please advise.\nRestrictions remain: released to full duty, no restrictions.\n\nThanks,\nBeth (front desk)', n.char_start = 0, n.char_end = 310, n.word_count = 46;
