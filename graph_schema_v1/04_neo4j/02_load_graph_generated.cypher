MERGE (n:Chunk {chunk_id: 'SYN-6977163-062-C01'}) SET n.parent_id = 'SYN-6977163-062', n.parent_kind = 'Note', n.position = 1, n.text = 'Per email, will follow up\nFrom: Lena Castillo <lena@castillolaw.example>\nSent: Wed, Feb 18, 2026 13:42\nTo: Olivia Grant\nSubject: RE: Claim 6977163 - Lopez\n\nHi Olivia,\nThe nothing is still outstanding on our end.\nPlease send the claim file, medical and wage records for my client Mia Lopez, claim 6977163.\nKindly confirm NEW HAMPSHIRE INSURANCE CO\'s position on the ears treatment.\n\nThank you,\nLena Castillo', n.char_start = 0, n.char_end = 406, n.word_count = 65;
