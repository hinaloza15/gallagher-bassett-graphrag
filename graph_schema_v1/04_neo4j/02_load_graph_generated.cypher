MERGE (n:Note {note_id: 'SYN-6977182-015'}) SET n.claim_id = '6977182', n.note_date = '2025-10-24', n.note_type = 'Contact - Provider', n.author_name = 'Marcus Hill', n.author_role = 'adjuster', n.text = '24OCT25 - DR DOYLE\'S OFFICE NEED C-4.2 FROM DR DOYLE -MH', n.word_count = 11, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977182-016'}) SET n.claim_id = '6977182', n.note_date = '2025-10-27', n.note_type = 'Medical Update', n.author_name = 'Dr Doyle', n.author_role = 'treating provider', n.text = 'Rochester Work Injury Clinic f/u 10/27/25 Exam: Grip 4/5, cap refill ok ROM: Wrist ROM limited by pain, grip weak.', n.word_count = 20, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
