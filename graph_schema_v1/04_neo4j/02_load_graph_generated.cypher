MERGE (n:Chunk {chunk_id: 'SYN-6977100-082-C01'}) SET n.parent_id = 'SYN-6977100-082', n.parent_kind = 'Note', n.position = 1, n.text = 'Brooklyn Occupational Medicine called Asked Dr Osei for an updated work status, fax request sent Brooklyn Occupational Medicine billing called abot a denied visit, referred to WESCO INSURANCE CO Records rec\'d from Brooklyn Occupational Medicine, 13 pages Need the C-4.2 from Dr Osei Dr Osei wants Marcus to continue wrist ROM, grip strengthening, putty.', n.char_start = 0, n.char_end = 353, n.word_count = 54;
MERGE (n:Chunk {chunk_id: 'SYN-6977100-083-C01'}) SET n.parent_id = 'SYN-6977100-083', n.parent_kind = 'Note', n.position = 1, n.text = 'Mar 3 reserves - Priya\'s file: med reserve $8,500 increased med reserve bc more PT requested Priya requested more authority -CJ', n.char_start = 0, n.char_end = 127, n.word_count = 21;
MERGE (n:Chunk {chunk_id: 'SYN-6977100-084-C01'}) SET n.parent_id = 'SYN-6977100-084', n.parent_kind = 'Note', n.position = 1, n.text = 'File review 3/9/26. Marcus has a hand injury of the right hand from 11/21/25, claim is still open. Marcus is seeing Dr Osei at Brooklyn Occupational Medicine and last reported pain at 3/10, swelling at the knuckles, hurts to make a fist. Restrictions are: Lifting to 20 lbs, splint as needed. Marcus is working regular duty, no issues. No lost time and no wage payments due. Pending: Nothing. Plan: Call Marcus, follow up with Dr Osei, review again 4/8/26.\nDOI 11/21/2025, Marcus tripped on something on the floor and went down at service site. First seen at Brooklyn Occupational Medicine on 11/25/25, dx hand injury of the right hand, xray neg. On modified duty from 24NOV25. Back to full duty from 2/10/26. PT at Lakeview Physical Therapy started 12/9/25, 8 of 8 authorized visits used so far. Conciliation held 1/9/26. No wage payments, medical bills only, approx $1,135 paid to date. Contacts: Adjuster Priya Shah, ER contact Carla Lindqvist, ER supervisor Carla Brennan, treating Dr Osei, PT Beth Mehta at Lakeview Physical Therapy. Coverage: Wesco Insurance Co on the risk, Nassau county, service site.', n.char_start = 0, n.char_end = 1109, n.word_count = 184;
MERGE (n:Chunk {chunk_id: 'SYN-6977100-085-C01'}) SET n.parent_id = 'SYN-6977100-085', n.parent_kind = 'Note', n.position = 1, n.text = 'Rx check 3/16/26: PPO pharmacy network rule explained to Marcus. -AK', n.char_start = 0, n.char_end = 68, n.word_count = 11;
MERGE (n:Chunk {chunk_id: 'SYN-6977100-086-C01'}) SET n.parent_id = 'SYN-6977100-086', n.parent_kind = 'Note', n.position = 1, n.text = 'Dr Osei progress 3/25/26.\nSUBJECTIVE: pt c/o swelling at the knuckles, hurts to make a fist. pain 2/10. pt states compliant w/ tx.\nOBJECTIVE: grip 4/5, cap refill ok. xray neg. ROM: wrist ROM limited by pain, grip weak.\nASSESSMENT: hand injury of the right hand, improving.\nPLAN: PT, home exercise program. restr: lifting to 20 lbs, splint as needed. work status: working regular duty, no issues. f/u prn.', n.char_start = 0, n.char_end = 405, n.word_count = 69;
MERGE (n:Chunk {chunk_id: 'SYN-6977100-087-C01'}) SET n.parent_id = 'SYN-6977100-087', n.parent_kind = 'Note', n.position = 1, n.text = 'Subject: Status Report - Claim 6977100 - Marcus Reed\nHi Rita,\n\nPlease see the update below on Marcus Reed\'s claim (Hudson Public Services, DOI 11/21/25, service site). I have kept the history short, call me if you want more.\n\nCLAIM HISTORY\nDOI 11/21/25, Marcus Reed tripped on something on the floor and went down at service site. First seen at Brooklyn Occupational Medicine on 11/25/25, dx hand injury of the right hand, xray neg. On modified duty from 11/24/25. Back to full duty from 2/10/26. PT at Lakeview Physical Therapy started 12/9/25, 8 of 8 authorized visits used so far. Conciliation held 1/9/26. No wage payments, medical bills only, approx $1,190 paid to date. Contacts: adjuster Priya Shah, ER contact Carla Lindqvist, ER supervisor Carla Brennan, treating Dr Osei, PT Beth Mehta at Lakeview Physical Therapy. Coverage: Wesco Insurance Co on the risk, Nassau county, service site.', n.char_start = 0, n.char_end = 896, n.word_count = 147;
MERGE (n:Chunk {chunk_id: 'SYN-6977100-087-C02'}) SET n.parent_id = 'SYN-6977100-087', n.parent_kind = 'Note', n.position = 2, n.text = 'CURRENT MEDICAL: treating with Dr Osei at Brooklyn Occupational Medicine. Pain was 2/10 at the last visit (3-23-2026) and Marcus reports swelling at the knuckles, hurts to make a fist. Restrictions: lifting to 20 lbs, splint as needed.\nWORK STATUS: Marcus is working regular duty, no issues.\nBENEFITS: no lost time, no wage benefits due at this point. Medical bills are being paid per the fee schedule.\nLEGAL: conciliation held 1/9/26, issue narrowed to medical bills.\nCONTACTS: adjuster Priya Shah, ER contact Carla Lindqvist (Hudson Public Services), ER supervisor Carla Brennan, treating Dr Osei at Brooklyn Occupational Medicine. PT is Beth Mehta at Lakeview Physical Therapy.\nCOVERAGE: Wesco Insurance Co is on the risk. Claim is in Nassau county, injury location service site. No prior claims found on Marcus.\nOUTSTANDING: nothing.\nRESERVES: no change recommended right now, med reserve $8,500. We will revisit after the next medical report.\nPLAN: continue to monitor, speak with Marcus and the company again this month, and send the next update by 4/9/26. Please let me know if you need anything else in the meantime.\n\nThanks,\nPriya Shah', n.char_start = 898, n.char_end = 2042, n.word_count = 183;
MERGE (n:Chunk {chunk_id: 'SYN-6977100-088-C01'}) SET n.parent_id = 'SYN-6977100-088', n.parent_kind = 'Note', n.position = 1, n.text = 'emailed Carla Lindqvist, no reply yet -Jamal', n.char_start = 0, n.char_end = 44, n.word_count = 7;
MERGE (n:Chunk {chunk_id: 'SYN-6977100-089-C01'}) SET n.parent_id = 'SYN-6977100-089', n.parent_kind = 'Note', n.position = 1, n.text = 'Can we approve this?\nFrom: Carla Lindqvist <carla@hudsonpublicservices.example>\nSent: Mon, Mar 30, 2026 15:50\nTo: Priya Shah\nSubject: RE: Claim 6977100 - Reed\n\nHi Priya,\nPlease send us the restrictions in writing.\nPlease confirm whether the claim has been accepted.\nOur insurer is WESCO INSURANCE CO, adjuster is Priya.\n\nThanks,\nCarla Lindqvist', n.char_start = 0, n.char_end = 344, n.word_count = 52;
