MERGE (n:Note {note_id: 'SYN-6977182-007'}) SET n.claim_id = '6977182', n.note_date = '2025-10-23', n.note_type = 'Contact - Employer', n.author_name = 'Marcus Hill', n.author_role = 'adjuster', n.text = 'From: Paula Nakamura <paula@hudsonvalleyhospitality.example>\nSent: Thu, Oct 23, 2025 11:38\nTo: Marcus Hill\nSubject: RE: Claim 6977182 - Wood\n\nHi Marcus,\nIW was out on sick time last week, no call to us.\nWe can offer light duty starting 10/28/2025, 4 hrs/day.\nPlease confirm whether the claim has been accepted.\nIncident report was sent on 10/23/2025.\n\nThanks,\nPaula Nakamura', n.word_count = 59, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977182-008'}) SET n.claim_id = '6977182', n.note_date = '2025-10-23', n.note_type = 'Contact - Injured Worker', n.author_name = 'Marcus Hill', n.author_role = 'adjuster', n.text = 's/w IW . pain about 5/10 today per IW. says he saw DR Doyle on 10/22/2025. asked about status of the claim, explained it is open. worried about employer cutting hours. working regular duty, no issues. IW confirmed DOI 10/20/2025 at operations facility. said he was moving a heavy tote and felt something give. asked about mileage reimbursement, told to send C-257 w/ receipts. address and phone confirmed same as file. next appt w/ DR Doyle is 10/27. IW got bill for $400 from Rochester Work Injury Clinic, I told him not to pay it, we will check it. asked him to call Paula Nakamura about the light duty at employer.\nDOI 10/20/2025, IW was moving heavy tote and felt something give at operations facility. Still waiting on wage statement from employer.', n.word_count = 132, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977182-009'}) SET n.claim_id = '6977182', n.note_date = '2025-10-23', n.note_type = 'Contact - Injured Worker', n.author_name = 'Marcus Hill', n.author_role = 'adjuster', n.text = 'OUTBOUND CALL TO AARON. STILL HARD TO GRIP OR CARRY. IW GOT A BILL FOR $163.50 FROM ROCHESTER WORK INJURY CLINIC, I TOLD HIM NOT TO PAY IT, WE WILL CHECK IT', n.word_count = 32, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977182-010'}) SET n.claim_id = '6977182', n.note_date = '2025-10-23', n.note_type = 'Contact Attempt', n.author_name = 'Wendell Pratt', n.author_role = 'assistant', n.text = 'LM for Lena Brennan re the incident form.', n.word_count = 8, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977182-011'}) SET n.claim_id = '6977182', n.note_date = '2025-10-23', n.note_type = 'Diary Entry', n.author_name = 'Marcus Hill', n.author_role = 'adjuster', n.text = 'CHECKED ECASE, NOTHING NEW. IW BACK TO FULL DUTY -MH', n.word_count = 10, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977182-012'}) SET n.claim_id = '6977182', n.note_date = '2025-10-23', n.note_type = 'Contact - Employer', n.author_name = 'Marcus Hill', n.author_role = 'adjuster', n.text = 'NEED TO RESPOND TO THIS. -MH\nFrom: Paula Nakamura <paula@hudsonvalleyhospitality.example>\nSent: Thu, Oct 23, 2025 7:30\nTo: Marcus Hill\nSubject: RE: Claim 6977182 - Wood\n\nHi Marcus,\nOur insurer is Wegmans Food Markets, adjuster is Marcus.\nWe can offer light duty starting 11/01/2025, 4 hrs/day.\nPlease confirm whether the claim has been accepted.\nAaron Wood has not returned our calls about the modified duty offer.\n\nRegards,\nPaula Nakamura', n.word_count = 68, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
