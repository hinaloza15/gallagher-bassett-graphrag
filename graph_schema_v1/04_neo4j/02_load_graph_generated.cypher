MERGE (n:Note {note_id: 'SYN-6977178-078'}) SET n.claim_id = '6977178', n.note_date = '2026-06-16', n.note_type = 'Contact - Employer', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = '6/16/26 ER call, Joan Brennan. Joan Nakamura says wage info coming from payroll. Asked Joan Nakamura about restrictions: Released to full duty, no restrictions. The company says Julian Bell missed 4 days last month. Told Joan Nakamura we cant discuss reserves. Payroll has not sent the wage statement. No further questions.\nDOI 12/16/25, Julian slipped on ice in the lot and went down at service site. First seen at Brooklyn Occupational Medicine on 12/19/25, dx contusion of the left hip/buttock, xray neg for fracture. No wage payments, medical bills only, approx $520 paid to date.', n.word_count = 95, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977178-079'}) SET n.claim_id = '6977178', n.note_date = '2026-06-16', n.note_type = 'File Review', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'File review 06/16/2026. Julian has a contusion of the left hip/buttock from 12/16/25, claim is open, no Board date yet. Julian is seeing Dr Okafor at Brooklyn Occupational Medicine and last reported pain at 0/10, feeling much better, occasional soreness. Restrictions are: Released to full duty, no restrictioons. Julian is working regular duty, no issues. No lost time and no wage payments due. Pending: Nothing. Plan: Continue to mnoitor, next review 7/7/26.\nDOI 12/16/25, Julian slipped on ice in the lot and went down at service site. First seen at Brooklyn Occupational Medicine on 12/19/25, dx contusion of the left hip/buttock, xray neg for fracture. No wage payments, medical bills only, approx $520 paid to date. Contacts: Adjuster Priya Shah, ER contact Joan Nakamura, ER supervisor Joan Brennan, treating Dr Okafor.', n.word_count = 131, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
