MERGE (n:Chunk {chunk_id: 'SYN-6977137-032-C01'}) SET n.parent_id = 'SYN-6977137-032', n.parent_kind = 'Note', n.position = 1, n.text = 'Per email, will follow up\nFrom: Sam (front desk) <sam@hudsonvalleyorthorehab.example>\nSent: Mon, Jan 26, 2026 7:53\nTo: Olivia Grant\nSubject: RE: Claim 6977137 - Bennett\n\nHi Olivia,\nNoah Bennett is being seen for sprain of the knee.\nRestrictions remain: no standing over 2 hrs, no ladders, no kneeling.\n\nThank you,\nSam (front desk)', n.char_start = 0, n.char_end = 330, n.word_count = 53;
