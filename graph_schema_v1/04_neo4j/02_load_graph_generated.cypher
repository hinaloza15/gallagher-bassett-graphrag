MERGE (n:Chunk {chunk_id: 'SYN-6977121-040-C01'}) SET n.parent_id = 'SYN-6977121-040', n.parent_kind = 'Note', n.position = 1, n.text = 'Called Leo Morgan, reached on 2nd try.', n.char_start = 0, n.char_end = 38, n.word_count = 7;
MERGE (n:Chunk {chunk_id: 'SYN-6977121-041-C01'}) SET n.parent_id = 'SYN-6977121-041', n.parent_kind = 'Note', n.position = 1, n.text = 'RTW: Restr per Dr Lindqvist: No overhead work, lifting to 15 lbs. Employer should have the new restr in writing.', n.char_start = 0, n.char_end = 112, n.word_count = 20;
MERGE (n:Chunk {chunk_id: 'SYN-6977121-042-C01'}) SET n.parent_id = 'SYN-6977121-042', n.parent_kind = 'Note', n.position = 1, n.text = 'February 4 - RTW: Full duty release exepcted 2/9.', n.char_start = 0, n.char_end = 49, n.word_count = 9;
MERGE (n:Chunk {chunk_id: 'SYN-6977121-043-C01'}) SET n.parent_id = 'SYN-6977121-043', n.parent_kind = 'Note', n.position = 1, n.text = 'Email from Victor Alvarez February 4. Leo Morgan is on sick time. Employer wants to know if the claim is accepted, told them it is still open. Asked Victor Alvarez about restr: No overhead work, lifting to 15 lbs. Employer concerned about overtime coverage. Employer says Leo missed 3 days last month. Told Victor Alvarez we cant discuss reserves.\nDOI December 19, Leo was repositioning stock and felt a pull at warehouse. First seen at Capital Region Occupational Health on December 24, dx strain of the neck, upper back and shoulder, xray neg.', n.char_start = 0, n.char_end = 545, n.word_count = 93;
MERGE (n:Chunk {chunk_id: 'SYN-6977121-044-C01'}) SET n.parent_id = 'SYN-6977121-044', n.parent_kind = 'Note', n.position = 1, n.text = 'Spoke with Leo Morgan February 9. Worried about employer cutting hours.', n.char_start = 0, n.char_end = 71, n.word_count = 11;
MERGE (n:Chunk {chunk_id: 'SYN-6977121-045-C01'}) SET n.parent_id = 'SYN-6977121-045', n.parent_kind = 'Note', n.position = 1, n.text = 'Subject: Status Report - Claim 6977121 - Leo Morgan\nHi Dana,\n\nPlease see the update below on Leo Morgan\'s claim (Lakeside Coffee Retail, DOI 12-19-2025, warehouse). I have kept the history short, call me if you want more.\n\nCLAIM HISTORY\nDOI December 19, Leo Morgan was repositioning stock and felt a pull at warehouse. First seen at Capital Region Occupational Health on December 24, dx strain of the neck, upper back and shoulder, xray neg. No wage payments, medical bills only, approx $520 paid to date. Contacts: adjuster Daniel Brooks, ER contact Victor Alvarez, ER supervisor Alicia Whitaker, treating Dr Lindqvist. Coverage: HARTFORD CASUALTY INSURANCE CO on the risk, Queens county, warehouse.', n.char_start = 0, n.char_end = 700, n.word_count = 112;
MERGE (n:Chunk {chunk_id: 'SYN-6977121-045-C02'}) SET n.parent_id = 'SYN-6977121-045', n.parent_kind = 'Note', n.position = 2, n.text = 'CURRENT MEDICAL: treating with Dr Lindqvist at Capital Region Occupational Health. Pain was 3/10 at the last visit (09FEB26) and Leo reports pain in the neck, worse by end of shift. Restrictions: no overhead work, lifting to 15 lbs.\nWORK STATUS: Leo is back to full duty.\nBENEFITS: no lost time, no wage benefits due at this point. Medical bills are being paid per the fee schedule.\nLEGAL: no hearings or conciliation set, nothing from the Board that needs a response.\nCONTACTS: adjuster Daniel Brooks, ER contact Victor Alvarez (Lakeside Coffee Retail), ER supervisor Alicia Whitaker, treating Dr Lindqvist at Capital Region Occupational Health.\nCOVERAGE: HARTFORD CASUALTY INSURANCE CO is on the risk. Claim is in Queens county, injury location warehouse. No prior claims found on Leo.\nOUTSTANDING: nothing.\nRESERVES: no change recommended right now, med reserve $8,500. We will revisit after the next medical report.\nPLAN: continue to monitor, speak with Leo and employer again this month, and send the next update by 2-24-2026. Please let me know if you need anything else in the meantime.\n\nThanks,\nDaniel Brooks', n.char_start = 702, n.char_end = 1818, n.word_count = 180;
MERGE (n:Chunk {chunk_id: 'SYN-6977121-046-C01'}) SET n.parent_id = 'SYN-6977121-046', n.parent_kind = 'Note', n.position = 1, n.text = 'OFFICE NOTE 02/11/2026 (Dr Lindqvist):\nSUBJECTIVE: pt c/o pain in the neck, worse by end of shift. pain 3/10. pt states compliant w/ tx.\nOBJECTIVE: TTP, ROM limited overhead. xray neg. ROM: ROM improving, still guarded overhead.\nASSESSMENT: strain of the neck, upper back and shoulder, improving.\nPLAN: ice, heat, nsaids. restr: no overhead work, lifting to 15 lbs. work status: back to full duty. f/u 3/9.', n.char_start = 0, n.char_end = 406, n.word_count = 67;
MERGE (n:Chunk {chunk_id: 'SYN-6977121-047-C01'}) SET n.parent_id = 'SYN-6977121-047', n.parent_kind = 'Note', n.position = 1, n.text = 'left message for Dr Lindqvist\'s office, C-4.2 rec\'d. -GR', n.char_start = 0, n.char_end = 56, n.word_count = 9;
MERGE (n:Chunk {chunk_id: 'SYN-6977121-048-C01'}) SET n.parent_id = 'SYN-6977121-048', n.parent_kind = 'Note', n.position = 1, n.text = '02/12/2026 bill rvw (Daniel): Rx from Capital Region Occupational', n.char_start = 0, n.char_end = 65, n.word_count = 9;
MERGE (n:Chunk {chunk_id: 'SYN-6977121-049-C01'}) SET n.parent_id = 'SYN-6977121-049', n.parent_kind = 'Note', n.position = 1, n.text = 'Called Capital Region Occupational Health for records, 5-7 business days Asked Dr Lindqvist for an updated work status, fax request sent Capital Region Occupational Health billing called about a denied visit, referred to Hartford Casualty Insurance Co Capital Region Occupational Health says Leo Morgan no showed the last appt Records rec\'d from Capital Region Occupational Health, 15 pages Need the C-4.2 from Dr Lindqvist Dr Lindqvist wants Leo', n.char_start = 0, n.char_end = 446, n.word_count = 68;
MERGE (n:Chunk {chunk_id: 'SYN-6977121-050-C01'}) SET n.parent_id = 'SYN-6977121-050', n.parent_kind = 'Note', n.position = 1, n.text = 'FYI -GR\nFrom: Leo Morgan <leo@mail.example>\nSent: Thu, Feb 12, 2026 8:14\nTo: Daniel Brooks\nSubject: RE: Claim 6977121 - Morgan\n\nhi,\ni went to Capital Region Occupational Health on 02/09/2026.\nplease call me back, my number is the same.\nmy boss Alicia Whitaker has not given me light duty yet.\nthis is Leo Morgan, claim 6977121.\n\nthank you\nLeo', n.char_start = 0, n.char_end = 342, n.word_count = 60;
MERGE (n:Chunk {chunk_id: 'SYN-6977121-051-C01'}) SET n.parent_id = 'SYN-6977121-051', n.parent_kind = 'Note', n.position = 1, n.text = '02/19/2026 bill rvw (Daniel): office visit from Capital Region Occupational Health $116 denied - no auth on file. mileage request (C-257) rec\'d from EE, forwarded. EE called worried about a bill from Harbor Drug. -GR', n.char_start = 0, n.char_end = 216, n.word_count = 35;
