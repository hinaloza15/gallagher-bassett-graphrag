MERGE (n:Chunk {chunk_id: 'SYN-6977100-050-C01'}) SET n.parent_id = 'SYN-6977100-050', n.parent_kind = 'Note', n.position = 1, n.text = 'Dr Osei progresss 12/24/25.\nSUBJECTIVE: pt c/o sore across the palm, weak grip. pain 4/10. pt states compliant w/ tx.\nOBJECTIVE: TTP, pain w/ ROM. xray neg. ROM: wrist ROM limited by pain, grip weak.\nASSESSMENT: hand injury of the right hand, no change.\nPLAN: ice, heat, nsaids. restr: no gripping or lifting over 5 lbs with that hand. work status: back on light duty. f/u 1/14.', n.char_start = 0, n.char_end = 378, n.word_count = 67;
