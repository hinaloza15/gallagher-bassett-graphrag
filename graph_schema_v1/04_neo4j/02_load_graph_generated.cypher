MERGE (n:Note {note_id: 'SYN-6977197-042'}) SET n.claim_id = '6977197', n.note_date = '2026-02-03', n.note_type = 'Authorization', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'Need to respond to this.\nFrom: Beth (front desk) <beth@hudsonvalleyorthorehab.example>\nSent: Tue, Feb 3, 2026 12:28\nTo: Olivia Grant\nSubject: RE: Claim 6977197 - Morris\n\nHi Olivia,\nCamila Morris is being seen for strain of the knee.\nNext visit is scheduled for 2/11.\nWe are requesting 16 PT visits, please advise.\nPlease confirm authorization for the Rx.\n\nRegards,\nBeth (front desk)', n.word_count = 61, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
