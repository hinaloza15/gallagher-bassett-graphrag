MERGE (n:Chunk {chunk_id: 'SYN-6977121-024-C01'}) SET n.parent_id = 'SYN-6977121-024', n.parent_kind = 'Note', n.position = 1, n.text = 'Spoke with front desk at Capital Region Occupational Health they will fax the note. Dr Lindqvist\'s office says next appt 1/7. Asked Dr Lindqvist for an updated work status fax request sent. Capital Region Occupational Health billing called about a denied visit referred to Hartford Casualty Insurance Co. Capital Region Occupational Health says Leo Morgan no showed the last appt. Need the C-4.2 from Dr Lindqvist. Dr Lindqvist wants Leo to continue pendulums scapular stabilization theraband rows. Capital Region Occupational Health sent a bill for $209.50 forwarded to bill review.', n.char_start = 0, n.char_end = 583, n.word_count = 90;
