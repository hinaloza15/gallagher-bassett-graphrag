MERGE (n:Chunk {chunk_id: 'SYN-6977140-065-C01'}) SET n.parent_id = 'SYN-6977140-065', n.parent_kind = 'Note', n.position = 1, n.text = 'From: Carla (front desk) <carla@rochesterworkinjuryclinic.example>\nSent: Thu, Feb 26, 2026 17:35\nTo: Maya Patel\nSubject: RE: Claim 6977140 - Patel\n\nHi Maya,\nWe are requesting 12 PT visits, please advies.\nAttached is the note from Maya Patel\'s visit on Feb 6.\nNext visit is schedueld for 3/3.\nPlease confirm authorization for the office visit.\n\nThanks,\nCarla (front desk)', n.char_start = 0, n.char_end = 370, n.word_count = 58;
