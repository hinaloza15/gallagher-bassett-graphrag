MERGE (n:Chunk {chunk_id: 'SYN-6977137-068-C01'}) SET n.parent_id = 'SYN-6977137-068', n.parent_kind = 'Note', n.position = 1, n.text = 'STATUS: cx, right knee sprain, DOI 12/23/25. file is still open.\nMEDICAL: seeing Dr Sato at Hudson Valley Ortho & Rehab; pain 5/10 per last note; pain at the front of the knee, catches.\nWORK: back on light duty; restr: no kneeling or squatting, limited stairs.\nPAY: paying $657.00/wk, approx $7,227 paid to date.\nLEGAL: no Board activity.\nPENDING: nothing.\nPLAN: we get the nothing, then close the diary 4/6/26.\nHISTORY: DOI 12/23/25, cx tripped on something on the floor and went down at retail store. First seen at Hudson Valley Ortho & Rehab on 12/29/25, dx sprain of the right knee, xray neg for fracture. Off work from 12/25/25. On modified duty from 1/10/26.', n.char_start = 0, n.char_end = 664, n.word_count = 115;
MERGE (n:Chunk {chunk_id: 'SYN-6977137-069-C01'}) SET n.parent_id = 'SYN-6977137-069', n.parent_kind = 'Note', n.position = 1, n.text = 'Hudson Valley Ortho & Rehab f/u March 27.\nSUBJECTIVE: pt c/o pain at the front of the knee, catches. pain 5/10. pt states compliant w/ tx.\nOBJECTIVE: swelling, TTP over the area, no deformity. MRI: mild effusion, possible meniscus signal change. ROM: knee/ankle ROM near full, some pain at end range.\nASSESSMENT: sprain of the right knee, no change.\nPLAN: brace/splint prn, ice. restr: no kneeling or squatting, limited stairs. work status: back on light duty. f/u 4/22.', n.char_start = 0, n.char_end = 470, n.word_count = 78;
