MERGE (n:Chunk {chunk_id: 'SYN-6977118-045-C01'}) SET n.parent_id = 'SYN-6977118-045', n.parent_kind = 'Note', n.position = 1, n.text = 'Dr note rec\'d 2/9/26 from Upstate Joint & Rehab Center:\nSUBJECTIVE: pt c/o pain in the low back and both shoulders, worse by end of shift. pain 4/10. pt states compliant w/ tx.\nOBJECTIVE: guarded flexion, strength 5/5. MRI: mild disc bulge L4-5, no stenosis. ROM: lumbar flexion limited, extension ok.\nASSESSMENT: sprain of the low back and both shoulders, no change.\nPLAN: PT, home exercise program. restr: no lifting over 20 lbs, limit bending. work status: back to full duty. f/u 2/23.', n.char_start = 0, n.char_end = 488, n.word_count = 83;
