MERGE (n:Note {note_id: 'SYN-6977144-017'}) SET n.claim_id = '6977144', n.note_date = '2026-01-02', n.note_type = 'Supervisor Incident Statement', n.author_name = 'Tasha Okafor', n.author_role = 'ER supervisor', n.text = 'Incident statment (Tasha Okafor Jan 2): I was on shift 12-26-2025. Priya Shah told me she tripped on something on the floor and went down.', n.word_count = 25, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977144-018'}) SET n.claim_id = '6977144', n.note_date = '2026-01-05', n.note_type = 'Statement / Investigation', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'Recorded statement Priya Shah 1/5/26: Priya states she tripped on something on the floor and went down at service site around 2pm. She reported to Tasha Okafor right away, told to see Empire Physical Medicine. No other jobs. Photos requested, none were taken. Supervisor statement requested from Tasha Okafor. Pain level that day was about 4/10 per Priya. Priya drove home, went to Empire Physical Medicine the next morning.\nDOI 12/26/25, Priya tripped on something on the floor and went down at service site. First seen at Empire Physical Medicine on 12/30/25, dx contusion of the neck and low back, lumbar xray no acute findings.', n.word_count = 105, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977144-019'}) SET n.claim_id = '6977144', n.note_date = '2026-01-06', n.note_type = 'Work Status', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = '1/6/26 work status: Priya did 5 days of modified duty then called out. Full duty release expected 1/20. Priya worried about the commute.', n.word_count = 23, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
