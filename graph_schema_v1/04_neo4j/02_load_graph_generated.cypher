MERGE (n:Chunk {chunk_id: 'SYN-6977178-004-C01'}) SET n.parent_id = 'SYN-6977178-004', n.parent_kind = 'Note', n.position = 1, n.text = 'New assignment 12/18/25, DOI 12/16/25 at service site. Julian says he slipped on ice in the lot and went down at service site. The company sent the C-2F, rec\'d 12/18/25. No prior claims that I can see. Julian still working, light tasks only. C-3 not yet rec\'d. We have not received any wage info yet. The company says Julian has worked there a while, no prior injuries per Joan Nakamura. Coverage confirmed, AMTRUST INSURANCE COMPANY is on the risk.\nDOI 12/16/25, Julian slipped on ice in the lot and went down at service site.', n.char_start = 0, n.char_end = 527, n.word_count = 94;
MERGE (n:Chunk {chunk_id: 'SYN-6977178-005-C01'}) SET n.parent_id = 'SYN-6977178-005', n.parent_kind = 'Note', n.position = 1, n.text = '12/18/2025 prior claims search done, no hits -GR', n.char_start = 0, n.char_end = 48, n.word_count = 8;
MERGE (n:Chunk {chunk_id: 'SYN-6977178-006-C01'}) SET n.parent_id = 'SYN-6977178-006', n.parent_kind = 'Note', n.position = 1, n.text = 'Forwarding to file.\nFrom: Mei (front desk) <mei@brooklynoccupationalmedicine.example>\nSent: Fri, Dec 19, 2025 17:04\nTo: Priya Shah\nSubject: RE: Claim 6977178 - Bell\n\nHi Priya,\nNext visit is scheduleed for 1/15.\nRestrictions remain: no standing over 2 hrs, no ldaders, no kneeling.\nAttached is the note from Julian Bell\'s visit on 12/18/25.\n\nThanks,\nMei (front desk)', n.char_start = 0, n.char_end = 365, n.word_count = 56;
MERGE (n:Chunk {chunk_id: 'SYN-6977178-007-C01'}) SET n.parent_id = 'SYN-6977178-007', n.parent_kind = 'Note', n.position = 1, n.text = 'Forwarding to file.\nFrom: Alicia (front desk) <alicia@brooklynoccupationalmedicine.example>\nSent: Fri, Dec 19, 2025 17:35\nTo: Priya Shah\nSubject: RE: Claim 6971778 - Bell\n\nHi Priya,\nAttached is the note from Julian Bell\'s visit on 12/18/25.\nJulian Bell is being seen for contusion of the hip/buttock.\n\nThank you,\nAlicia (front desk)', n.char_start = 0, n.char_end = 332, n.word_count = 50;
MERGE (n:Chunk {chunk_id: 'SYN-6977178-008-C01'}) SET n.parent_id = 'SYN-6977178-008', n.parent_kind = 'Note', n.position = 1, n.text = 'See below.\nFrom: Joan Nakamura <joan@empirelogistics.example>\nSent: Fri, Dec 19, 2025 9:51\nTo: Priya Shah\nSubject: RE: Claim 6977178 - Bell\n\nHi Priya,\nPlease confirm whether the claim has been accepted.\nOur insurer is AMTRUST INSURANCE COMPANY, adjuster is Priya.\nOur payroll shows Julian Bell earned about $890 a week before the injury.\n\nThanks,\nJoan Nakamura', n.char_start = 0, n.char_end = 360, n.word_count = 56;
