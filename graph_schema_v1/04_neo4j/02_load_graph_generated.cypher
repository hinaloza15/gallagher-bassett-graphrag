MERGE (n:Chunk {chunk_id: 'SYN-6977098-059-C01'}) SET n.parent_id = 'SYN-6977098-059', n.parent_kind = 'Note', n.position = 1, n.text = 'rec\'d this today, will call. -CJ\nFrom: Carol Jennings <carol@gbclaims.example>\nSent: Mon, Feb 23, 2026 14:03\nTo: Maya Patel\nSubject: RE: Claim 6977098 - Lee\n\nHi Maya,\nLet me know if you need authority for the office visit.\nPlease see the file for Jordan Lee, claim 6977098.\n\nThanks,\nCarol Jennings', n.char_start = 0, n.char_end = 297, n.word_count = 50;
MERGE (n:Chunk {chunk_id: 'SYN-6977098-060-C01'}) SET n.parent_id = 'SYN-6977098-060', n.parent_kind = 'Note', n.position = 1, n.text = 'North Shore Occupational Health f/u 2-24-2026. Exam: Mild effusion, gait guarded. Tx: Ibuprofen, activity modification. Restr: No kneeling or squatting, limited stairs. Meds: Ibuprofen prn. Pt states compliant w/ tx. ROM: Knee/ankle ROM near full, some pain at end range. MRI shows mild effusion, possible meniscus signal change. C-4.2 to follow. Pt asks about stand or walk for long, advised to modify. Continue quad sets, straight leg raises, step-ups, stationary bike.', n.char_start = 0, n.char_end = 471, n.word_count = 71;
