MERGE (n:Note {note_id: 'SYN-6977163-076'}) SET n.claim_id = '6977163', n.note_date = '2026-03-11', n.note_type = 'Contact - Injured Worker', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'Cx called in re: Claim 6977163 Pain about 0/10 today per cx Said she has had noise exposure for years on the production floor Cx got a bill for $140.00 from Upstate Joint & Rehab Center, I told her not to pay it, we will check it.', n.word_count = 47, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977163-077'}) SET n.claim_id = '6977163', n.note_date = '2026-03-16', n.note_type = 'File Review', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'STATUS: cx, ears hearing loss, DOI 5/1/15. file is still open.\nMEDICAL: seeing Dr Haddad at Upstate Joint & Rehab Center; pain 0/10 per last note; feeling much better, occasional soreness.\nWORK: working regular duty, no issues; restr: released to full duty, no restrictions.\nPAY: no lost time, no wage payments, medical bills only.\nLEGAL: hearing held 2/2/26, adjourned for wage info.\nPENDING: nothing.\nPLAN: we get the nothing, then close the diary 4/15/26.\nHISTORY: DOI 5/1/15, Mia has had noise exposure for years on the production floor at retail store. First seen at Upstate Joint & Rehab Center on 11/17/25, dx hearing loss of the ears, audiogram shows high-frequency loss. On modified duty from 11/13/25. Back to full duty from 12/11/25.', n.word_count = 122, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977163-078'}) SET n.claim_id = '6977163', n.note_date = '2026-03-16', n.note_type = 'Reserve Review', n.author_name = 'Ray Delgado', n.author_role = 'supervisor', n.text = 'reserve review March 16: med reserve $22,000. reserves unchanged. increased med reserve because IME pending. Olivia requested more authority. ok to approve the added PT. paid to date approx $6,000. we should revisit after next medical.\nDOI May 1, Mia has had noise exposure for years on the production floor at retail store. first seen at Upstate Joint & Rehab Center on 11/17/2025, dx hearing loss of ears, audiogram shows high-frequency loss. On modified duty from November 13. Back to full duty from 11DEC25.', n.word_count = 84, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977163-079'}) SET n.claim_id = '6977163', n.note_date = '2026-03-18', n.note_type = 'Hearing / Legal', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'Legal note hearing held 2/2/26, adjourned for IME report. Claim 6977163, hearing before the judge. Copy to New Hampshire Insurance Co and the employer. Olivia aware. Nothing else scheduled that I can see. Cx notified by letter. The IME report needs to be in by then. Will monitor.\nDOI 01MAY15, cx has had noise exposure for years on the production floor at retail store. First seen at Upstate Joint & Rehab Center on 17NOV25, dx hearing loss of the ears, audiogram shows high-frequency loss. On modified duty from 11/13/25.', n.word_count = 89, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977163-080'}) SET n.claim_id = '6977163', n.note_date = '2026-03-20', n.note_type = 'Status Report', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'Subject: Status Report - Claim 6977163 - Mia Lopez\nHi Tasha,\n\nPlease see the update below on Mia Lopez\'s claim (Orange Supply Cooperative, DOI 5/1/15, retail store). I have kept the history short, call me if you want more.\n\nCLAIM HISTORY\nDOI 5/1/15, cx has had noise exposure for years on the production floor at retail store. First seen at Upstate Joint & Rehab Center on 11/17/25, dx hearing loss of the ears, audiogram shows high-frequency loss. On modified duty from November 13. Back to full duty from 12/11/25. IME with Dr Nakamura on 1/30/26, report 2/12/26 says finds partial disability, recommends more PT. Lena Castillo is the worker\'s attorney. Hearing held 2/2/26. No wage payments, medical bills only, approx $410 paid to date. Contacts: adjuster Olivia Grant, ER contact Alicia Fischer, ER supervisor Carla Fischer, treating Dr Haddad.\n\nCURRENT MEDICAL: treating with Dr Haddad at Upstate Joint & Rehab Center. Pain was 0/10 at the last visit (12/9/25) and cx reports feeling much better, occasional soreness. Restrictions: released to full duty, no restrictions.\nWORK STATUS: cx is back to full duty.\nBENEFITS: no lost time, no wage benefits due at this point. Medical bills are being paid per the fee schedule.\nLEGAL: hearing held 2/2/26, adjourned for medical records.\nIME: Dr Nakamura saw cx and the report says finds partial disability, recommends more PT. We are reviewing whether to dispute any of the ongoing treatment.\ncx is represented by Lena Castillo, who has asked for the claim file and our position on added treatment. We are responding by letter.\nCONTACTS: adjuster Olivia Grant, ER contact Alicia Fischer (Orange Supply Cooperative), ER supervisor Carla Fischer, treating Dr Haddad at Upstate Joint & Rehab Center.\nCOVERAGE: New Hampshire Insurance Co is on the risk. Claim is in Allegany county, injury location retail store. No prior claims found on cx.\nOUTSTANDING: nothing.\nRESERVES: no change recommended right now, med reserve $6,000. We will revisit after the next medical report.\nPLAN: continue to monitor, speak with Mia and the employer again this month, and send the next update by 4-10-2026. Please let me know if you need anything else in the meantime.\n\nThanks,\nOlivia Grant', n.word_count = 362, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977163-081'}) SET n.claim_id = '6977163', n.note_date = '2026-03-23', n.note_type = 'Attorney Correspondence', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'FYI\nFrom: Lena Castillo <lena@castillolaw.example>\nSent: Mon, Mar 23, 2026 9:35\nTo: Olivia Grant\nSubject: RE: Claim 6977163 - Lopez\n\nHi Olivia,\nPlease provide a copy of the IME report.\nMy client has not been paid for MRI, please advise.\nKindly confirm New Hampshire Insurance Co\'s position on the ears treatment.\n\nThanks,\nLena Castillo', n.word_count = 54, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
