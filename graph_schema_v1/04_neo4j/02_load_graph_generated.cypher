MERGE (n:Note {note_id: 'SYN-6977197-037'}) SET n.claim_id = '6977197', n.note_date = '2026-01-23', n.note_type = 'File Review', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'STATUS: cx, left knee strain, DOI December 15. file is still open.\nMEDICAL: seeing Dr Lindqvist at Hudson Valley Ortho & Rehab; pain 7/10 per last note; pain at the front of the knee, catches.\nWORK: back on light duty; restr: no standing over 2 hrs, no ladders, no kneeling.\nPAY: no lost time, no wage payments, medical bills only.\nLEGAL: first hearing is on 2/24/26, notice went to all parties.\nPENDING: written light duty offer from the employer.\nPLAN: we get the written light duty offer from the employer, then close the diary 2/6/26.\nHISTORY: DOI 12/15/25, cx slipped on a spill near the counter at retail store. First seen at Hudson Valley Ortho & Rehab on 12/18/25, dx strain of the left knee, xray neg for fracture. On modified duty from 12/17/25. PT at Summit Rehab & Sports PT started December 31, 4 of 6 authorized visits used so far.', n.word_count = 152, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
