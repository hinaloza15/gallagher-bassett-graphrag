MERGE (n:Chunk {chunk_id: 'SYN-6977137-021-C01'}) SET n.parent_id = 'SYN-6977137-021', n.parent_kind = 'Note', n.position = 1, n.text = 'Spoke with cx . Cx states knee swelling, feels unstable on stairs. Worried about the employer cutting hours. Noah confirmed DOI 12/23/25 at retail store. Address and phone confirmed same as file. Cx got a bill for $356 from Hudson Valley Ortho & Rehab, I told him not to pay it, we will check it.\nDOI 12/23/25, cx tripped on something on the floor and went down at retail store. First seen at Hudson Valley Ortho & Rehab on 12/29/25, dx sprain of the right knee, xray neg for fracture. next appt 1/21.', n.char_start = 0, n.char_end = 501, n.word_count = 93;
