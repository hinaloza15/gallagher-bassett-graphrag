MERGE (n:Note {note_id: 'SYN-6977100-059'}) SET n.claim_id = '6977100', n.note_date = '2025-12-31', n.note_type = 'Contact - Employer', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'From: Carla Lindqvist <carla@hudsonpublicservices.example>\nSent: Wed, Dec 31, 2025 8:22\nTo: Priya Shah\nSubject: RE: Claim 6977100 - Reed\n\nHi Priya,\nAttached is the wage statement for Marcus Reed.\nOur insurer is Wesco Insurance Co, adjuster is Priya.\nMarcus Reed has not returned our calls about the modified duty offer.\nMarcus Reed was out on his regular schedule last week, no call to us.\n\nThanks,\nCarla Lindqvist', n.word_count = 67, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977100-060'}) SET n.claim_id = '6977100', n.note_date = '2026-01-02', n.note_type = 'File Review', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'STATUS: Marcus Reed, right hand hand injury, DOI 11/21/25. file is open, no Board date yet.\nMEDICAL: seeing Dr Osei at Brooklyn Occupational Medicine; pain 4/10 per last note; sore across the palm, weak grip.\nWORK: back on light duty; restr: no gripping or lifting over 5 lbs with that hand.\nPAY: no lost time, no wage payments, medical bills only.\nLEGAL: conciliation conference is on 01/09/2026.\nPENDING: auth for more PT visits.\nPLAN: continue to monitor, next review 1/23/26.\nHISTORY: DOI 11/21/25, Marcus tripped on something on the floor and went down at service site. First seen at Brooklyn Occupational Medicine on 25NOV25, dx hand injury of the right hand, xray neg. On modified duty from 11-24-2025. PT at Lakeview Physical Therapy started 12/9/25, 6 of 6 authorized visits used so far.', n.word_count = 133, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977100-061'}) SET n.claim_id = '6977100', n.note_date = '2026-01-06', n.note_type = 'Authorization', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = '1/6/26 - auth note: Approved 8 PT visits at Lakeview Physical Therapy auth # 70035. Dr Osei requested more PT we are checking against the guideline. MG-2 rec\'d for hand reviewing.', n.word_count = 31, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977100-062'}) SET n.claim_id = '6977100', n.note_date = '2026-01-07', n.note_type = 'Work Status', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'Work status: Marcus did 7 days of modified duty then called out. Full duty release expected 1/14. Asked Dr Osei for updated work status. Marcus says he isnt ready, pain 4/10. Marcus worrid about the commute.', n.word_count = 36, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
