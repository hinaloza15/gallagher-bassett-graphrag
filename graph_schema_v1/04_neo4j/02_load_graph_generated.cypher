MERGE (n:Note {note_id: 'SYN-6977175-033'}) SET n.claim_id = '6977175', n.note_date = '2025-12-11', n.note_type = 'Medical Update', n.author_name = 'Dr Romano', n.author_role = 'treating provider', n.text = 'OFFICE NOTE Dec 11 (Dr Romano):\nSUBJECTIVE: pt c/o neck, back and wrists sore and stiff. pain 6/10. pt states compliant w/ tx.\nOBJECTIVE: TTP lumbar paraspinals, neg SLR. lumbar xray no acute findings. ROM: lumbar flexion limited, extension ok.\nASSESSMENT: strain of the neck, back and wrists, no change.\nPLAN: ice, heat, nsaids. restr: no lifting over 10 lbs, no repeated bending. work status: working regular duty, no issues. f/u 1/5.', n.word_count = 72, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
