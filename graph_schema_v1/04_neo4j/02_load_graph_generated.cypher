MERGE (n:Note {note_id: 'SYN-6977178-004'}) SET n.claim_id = '6977178', n.note_date = '2025-12-18', n.note_type = 'First Report Summary', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'New assignment 12/18/25, DOI 12/16/25 at service site. Julian says he slipped on ice in the lot and went down at service site. The company sent the C-2F, rec\'d 12/18/25. No prior claims that I can see. Julian still working, light tasks only. C-3 not yet rec\'d. We have not received any wage info yet. The company says Julian has worked there a while, no prior injuries per Joan Nakamura. Coverage confirmed, AMTRUST INSURANCE COMPANY is on the risk.\nDOI 12/16/25, Julian slipped on ice in the lot and went down at service site.', n.word_count = 94, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977178-005'}) SET n.claim_id = '6977178', n.note_date = '2025-12-18', n.note_type = 'Prior Claims Check', n.author_name = 'Gita Rao', n.author_role = 'assistant', n.text = '12/18/2025 prior claims search done, no hits -GR', n.word_count = 8, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977178-006'}) SET n.claim_id = '6977178', n.note_date = '2025-12-19', n.note_type = 'Contact - Provider', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'Forwarding to file.\nFrom: Mei (front desk) <mei@brooklynoccupationalmedicine.example>\nSent: Fri, Dec 19, 2025 17:04\nTo: Priya Shah\nSubject: RE: Claim 6977178 - Bell\n\nHi Priya,\nNext visit is scheduleed for 1/15.\nRestrictions remain: no standing over 2 hrs, no ldaders, no kneeling.\nAttached is the note from Julian Bell\'s visit on 12/18/25.\n\nThanks,\nMei (front desk)', n.word_count = 56, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
