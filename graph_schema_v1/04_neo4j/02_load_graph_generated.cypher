MERGE (n:Chunk {chunk_id: 'SYN-6977156-110-C01'}) SET n.parent_id = 'SYN-6977156-110', n.parent_kind = 'Note', n.position = 1, n.text = 'STATUS: IW, low back, hip and both knnees strain, DOI 12/21/2025. file is still open.\nMEDICAL: seeing DR Haddad at North Shore Occupational Health; pain 0/10 per last note; mild stiffness only.\nWORK: back to full duty; restr: released to full duty, no restrictons.\nPAY: no lost time, no wage payments, medical bills only.\nLEGAL: judge\'s decision rec\'d after the 04/14/2026 hearing, nothing more needed from us.\nPENDING: nothing.\nPLAN: we get the nothing, then close the diary 08/26/2026.', n.char_start = 0, n.char_end = 487, n.word_count = 79;
MERGE (n:Chunk {chunk_id: 'SYN-6977156-111-C01'}) SET n.parent_id = 'SYN-6977156-111', n.parent_kind = 'Note', n.position = 1, n.text = 'forwarding to file.\nFrom: Lena Alvarez <lena@alvarezlaw.example>\nSent: Mon, Aug 17, 2026 14:24\nTo: Marcus Hill\nSubject: RE: Claim 6977156 - Rivera\n\nHi Marcus,\nPlease provide a copy of the IME report.\nWe request authorization for the treatment recommended by DR Haddad.\nMy client has not been paid for Rx, please advise.\n\nThanks,\nLena Alvarez', n.char_start = 0, n.char_end = 341, n.word_count = 55;
MERGE (n:Chunk {chunk_id: 'SYN-6977156-112-C01'}) SET n.parent_id = 'SYN-6977156-112', n.parent_kind = 'Note', n.position = 1, n.text = 'STATUS: IW, low back, hip and both knees strain, DOI 12/21/2025. file is open.\nMEDICAL: seeing DR Haddad at North Shore Occupational Health; pain 0/10 per last note; feeling much better, occasional soreness.\nWORK: working regular duty, no issues; restr: released to full duty, no restrictions.\nPAY: no lost time, no wage payments, medical bills only.\nLEGAL: second hearing 4-14-2026 held, judge reserved decision.\nPENDING: nothing.\nPLAN: call IW, follow up with DR Haddad, review again 09/21/2026.\nHISTORY: DOI 12/21/2025, IW missed the last few steps and fell at operations facility. First seen at North Shore Occupational Health on 12/25/2025, dx strain of the low back, hip and both knees, lumbar xray no acute findings. Off work from 12/22/2025. On modified duty from 01/15/2026.', n.char_start = 0, n.char_end = 783, n.word_count = 124;
MERGE (n:Chunk {chunk_id: 'SYN-6977156-113-C01'}) SET n.parent_id = 'SYN-6977156-113', n.parent_kind = 'Note', n.position = 1, n.text = 'closing note 09/15/2026: IW back to full duty since 06/08/2026, no f/u needed. treated at North Shore Occupational Health, released, no restrictions. if IW calls w/ a flare up, reopen and send back to DR Haddad. all bills paid, nothing pending. final med report rec\'d, strain resolved. total paid on file approx $4,500.\nDOI 12/21/2025, IW missed the last few steps and fell at operations facility. first seen at North Shore Occupational Health on 12/25/2025, dx strain of the low back, hip and both knees, lumbar xray no acute findings. -MH', n.char_start = 0, n.char_end = 540, n.word_count = 91;
MERGE (n:Chunk {chunk_id: 'SYN-6977156-114-C01'}) SET n.parent_id = 'SYN-6977156-114', n.parent_kind = 'Note', n.position = 1, n.text = 'closing review: IW back to full duty since 06/08/2026, no f/u needed. Board closed the case, nothing open. no activity in 60 days, closing diary. treated at North Shore Occupational Health, released, no restrictions. if Emma calls w/ flare up, reopen and send back to DR Haddad. all bills paid, nothing pending. final med report rec\'d, strain resolved. total paid on the file approx $12,000.\nDOI 12/21/2025, IW missed last few steps and fell at operations facility. first seen at North Shore Occupational Health on 12/25/2025, dx strain of the low back, hip and both knees, lumbar xray no acute findings -MH', n.char_start = 0, n.char_end = 607, n.word_count = 102;
