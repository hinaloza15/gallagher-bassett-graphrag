MERGE (n:Note {note_id: 'SYN-6977140-014'}) SET n.claim_id = '6977140', n.note_date = '2025-12-10', n.note_type = 'Contact - Provider', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = 'Dec 10 called Rochester Work Injury Clinic for records, 5-7 business days. asked Dr Brennan for an updated work status, fax request sent. Rochester Work Injury Clinic billing called about a denied visit, referred to State Ins Fund. Rochester Work Injury Clinic rec\'d our auth, visits scheduled. Rochester Work Injury Clinic says clmt no showed last appt. need the C-4.2 from Dr Brennan. Dr Brennan wants clmt to continue pendulums, scapular stabilization, theraband rows. Rochester Work Injury Clinic sent a bill for $293.50, forwarded to bill review', n.word_count = 87, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977140-015'}) SET n.claim_id = '6977140', n.note_date = '2025-12-11', n.note_type = 'Contact - Injured Worker', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = 'called clmt, reached on 2nd try. pain about 6/10 today per clmt. worried about company cutting hours. still hard to reach overhead or lift', n.word_count = 24, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
