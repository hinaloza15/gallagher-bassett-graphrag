MERGE (n:Chunk {chunk_id: 'SYN-6977098-071-C01'}) SET n.parent_id = 'SYN-6977098-071', n.parent_kind = 'Note', n.position = 1, n.text = 'per email, will f/u\nFrom: Rita Haddad <rita@harborviewcommunityhealth.example>\nSent: Mon, Mar 16, 2026 11:37\nTo: Maya Patel\nSubject: RE: Claim 6977098 - Lee\n\nHi Maya,\nPlease confirm whether the claim has been accepted.\nClmt was out on light duty last week, no call to us.\nPlease send us the restrictions in writing.\n\nThank you,\nRita Haddad', n.char_start = 0, n.char_end = 339, n.word_count = 56;
MERGE (n:Chunk {chunk_id: 'SYN-6977098-072-C01'}) SET n.parent_id = 'SYN-6977098-072', n.parent_kind = 'Note', n.position = 1, n.text = 'clmt called in re: claim 6977098. pain about 2/10 today per Jordan. asked who pays for North Shore Occupational Health visits, told State Insurance Fund pays per fee schedule and to keep receipts. wants a copy of C-3, will mail. worried about the company cutting hours. back to full duty. clmt confirmed DOI Dec 27 at facility parking area. asked about mileage reimbursement, told to send C-257 w/ receipts. still hard to stand or walk for long. address and phone confirmed same as file. asked if Maya is still adjuster, confirmed. next appt w/ Dr Fischer is as needed. Jordan got a bill for $420.75 from North Shore Occupational Health, I told him not to pay it, we will check it. asked him to call Rita Haddad about light duty at company.\nDOI 12-27-2025, clmt backed the work van into bollard in lot at facility parking area. first seen at North Shore Occupational Health on Dec 31, dx contusion of rt lower leg, xray neg for fracture. On modified duty from 29DEC25. Back to full duty from Feb 19. PT at Riverbend Physical Therapy started Jan 12, 12 of 12 authorized visits used so far. MRI ordered Jan 20, result Feb 1: mild effusion, possible meniscus signal change. Conciliation held 23FEB26. no wage payments, medical bills only, approx $1,360 paid to date. Contacts: adjuster Maya Patel, ER contact Rita Haddad, ER supervisor Paula Kowalski, treating Dr Fischer, PT Tom Nakamura at Riverbend Physical Therapy. Coverage: State Insurance Fund on the risk, Nassau county, facility parking area.', n.char_start = 0, n.char_end = 1498, n.word_count = 256;
MERGE (n:Chunk {chunk_id: 'SYN-6977098-073-C01'}) SET n.parent_id = 'SYN-6977098-073', n.parent_kind = 'Note', n.position = 1, n.text = 'spoke w/ clmt . clmt asked about hiring an attorney, told that is up to him, gave the Board number.', n.char_start = 0, n.char_end = 99, n.word_count = 20;
MERGE (n:Chunk {chunk_id: 'SYN-6977098-074-C01'}) SET n.parent_id = 'SYN-6977098-074', n.parent_kind = 'Note', n.position = 1, n.text = 'clmt, rt lower leg contusion, DOI Dec 27. file is open. seeing Dr Fischer at North Shore Occupational Health; pain 2/10 per last note; sore over shin, swelling at end of day. working regular duty, no issues; restr: no kneeling, otherwise ok for full shift. conciliation held Feb 23, issue narrowed to medical bills. nothing. call clmt, f/u w/ Dr Fischer, review again April 2. DOI Dec 27, clmt backed the work van into bollard in lot at facility parking area. first seen at North Shore Occupational Health on Dec 31, dx contusion of the rt lower leg, xray neg for fracture. On modified duty from Dec 29. Back to full duty from Feb 19. PT at Riverbend Physical Therapy started Jan 12, 12 of 12 authorized visits used so far. MRI ordered Jan 20, result Feb 1: mild effusion, possible meniscus signal change. Conciliation held Feb 23. no wage payments, medical bills only, approx $1,360 paid to date. Contacts: adjuster Maya Patel, ER contact Rita Haddad, ER supervisor Paula Kowalski, treating Dr Fischer, PT Tom Nakamura at Riverbend Physical Therapy. Coverage: State Ins Fund on risk, Nassau county, facility parking area', n.char_start = 0, n.char_end = 1121, n.word_count = 192;
