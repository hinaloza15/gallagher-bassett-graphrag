MERGE (n:Chunk {chunk_id: 'SYN-6977098-085-C01'}) SET n.parent_id = 'SYN-6977098-085', n.parent_kind = 'Note', n.position = 1, n.text = 'From: Carol Jennings <carol@gbclaims.example>\nSent: Tue, Jun 16, 2026 15:19\nTo: Maya Patel\nSubject: RE: Claim 6977098 - Lee\n\nHi Maya,\nPlease confirm the reserve is still $12,000.\nWe need the nothing before the next review.\nPlease see the file for Jordan Lee, claim 6977098.\nSend a status report to SIF by June 24.\n\nThanks,\nCarol Jennings', n.char_start = 0, n.char_end = 337, n.word_count = 57;
MERGE (n:Chunk {chunk_id: 'SYN-6977098-086-C01'}) SET n.parent_id = 'SYN-6977098-086', n.parent_kind = 'Note', n.position = 1, n.text = 'STATUS: clmt, rt lower leg contusion, DOI Dec 27. file is still open.\nMEDICAL: seeing Dr Fischer at North Shore Occupational Health; pain 0/10 per last note; no complaints.\nWORK: back to full duty; restr: released to full duty, no restrictions.\nPAY: no lost time, no wage payments, medical bills only.\nLEGAL: conciliation held Feb 23, issue narrowed to medical bills.\nPENDING: nothing.\nPLAN: call clmt, follow up with Dr Fischer, review again Jul 2.\nHISTORY: DOI Dec 27, clmt backed the work van into a bollard in the lot at facility parking area. First seen at North Shore Occupational Health on Dec 31, dx contusion of the rt lower leg, xray neg for fracture. On modified duty from Dec 29. Back to full duty from Feb 19.', n.char_start = 0, n.char_end = 722, n.word_count = 128;
