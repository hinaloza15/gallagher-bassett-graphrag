MERGE (n:Chunk {chunk_id: 'SYN-6977144-015-C01'}) SET n.parent_id = 'SYN-6977144-015', n.parent_kind = 'Note', n.position = 1, n.text = '1/1/26 - RTW: Priya Shah is working modified duty. Restr per Dr Okafor: No lifting over 10 lbs, no repeated bending. Asked Dr Okafor for updated work status.', n.char_start = 0, n.char_end = 157, n.word_count = 28;
MERGE (n:Chunk {chunk_id: 'SYN-6977144-016-C01'}) SET n.parent_id = 'SYN-6977144-016', n.parent_kind = 'Note', n.position = 1, n.text = '1/1/26 Northeast Diagnostic Imaging report rec\'d. Lumbar xray no acute findings. Ordered by Dr Okafor. Radiologist says full report in 2 days.', n.char_start = 0, n.char_end = 142, n.word_count = 22;
MERGE (n:Chunk {chunk_id: 'SYN-6977144-017-C01'}) SET n.parent_id = 'SYN-6977144-017', n.parent_kind = 'Note', n.position = 1, n.text = 'Incident statment (Tasha Okafor Jan 2): I was on shift 12-26-2025. Priya Shah told me she tripped on something on the floor and went down.', n.char_start = 0, n.char_end = 138, n.word_count = 25;
MERGE (n:Chunk {chunk_id: 'SYN-6977144-018-C01'}) SET n.parent_id = 'SYN-6977144-018', n.parent_kind = 'Note', n.position = 1, n.text = 'Recorded statement Priya Shah 1/5/26: Priya states she tripped on something on the floor and went down at service site around 2pm. She reported to Tasha Okafor right away, told to see Empire Physical Medicine. No other jobs. Photos requested, none were taken. Supervisor statement requested from Tasha Okafor. Pain level that day was about 4/10 per Priya. Priya drove home, went to Empire Physical Medicine the next morning.\nDOI 12/26/25, Priya tripped on something on the floor and went down at service site. First seen at Empire Physical Medicine on 12/30/25, dx contusion of the neck and low back, lumbar xray no acute findings.', n.char_start = 0, n.char_end = 631, n.word_count = 105;
MERGE (n:Chunk {chunk_id: 'SYN-6977144-019-C01'}) SET n.parent_id = 'SYN-6977144-019', n.parent_kind = 'Note', n.position = 1, n.text = '1/6/26 work status: Priya did 5 days of modified duty then called out. Full duty release expected 1/20. Priya worried about the commute.', n.char_start = 0, n.char_end = 136, n.word_count = 23;
MERGE (n:Chunk {chunk_id: 'SYN-6977144-020-C01'}) SET n.parent_id = 'SYN-6977144-020', n.parent_kind = 'Note', n.position = 1, n.text = 'Correction to my 12/31/25 note - next appt w/ the Dr is 1/20, not 1/23.', n.char_start = 0, n.char_end = 71, n.word_count = 15;
MERGE (n:Chunk {chunk_id: 'SYN-6977144-021-C01'}) SET n.parent_id = 'SYN-6977144-021', n.parent_kind = 'Note', n.position = 1, n.text = '1/9/26 - decision on claim 6977144: Accepting as work related, the company confirms Priya Shah was on shift. Statement taken 12/30/25. The company report matches Priya\'s account. No witnesses per Tasha Okafor. Will revisit once the medical comes in. We will diary for the wage statement. No signs of a prior injury in the records so far.\nDOI 12/26/25, Priya tripped on something on the floor and went down at service site. First seen at Empire Physical Medicine on 12/30/25, dx contusion of the neck and low back, lumbar xray no acute findings.', n.char_start = 0, n.char_end = 544, n.word_count = 93;
MERGE (n:Chunk {chunk_id: 'SYN-6977144-022-C01'}) SET n.parent_id = 'SYN-6977144-022', n.parent_kind = 'Note', n.position = 1, n.text = 'PT visit 1/6 Jan 12 (Riverbend Physical Therapy). Pain 4/10 pre-tx, 3/10 after. Did core stabilization, hamstring stretching, bridging + ice.', n.char_start = 0, n.char_end = 141, n.word_count = 21;
MERGE (n:Chunk {chunk_id: 'SYN-6977144-023-C01'}) SET n.parent_id = 'SYN-6977144-023', n.parent_kind = 'Note', n.position = 1, n.text = '1/12/26 - spoke with Priya Shah by phone. Says she saw Dr Okafor on 12/30/25. Worried about the company cutting hours. Working modified duty. Priya confirmed DOI 12/26/25 at service site. Trouble sleeping because of the pain. Priya got a bill for $230.00 from Empire Physical Medicine, I told her not to pay it, we will check it.\nDOI 26DEC25, Priya tripped on something on the floor and went down at service site. First seen at Empire Physical Medicine on 12/30/25, dx contusion of the neck and low back, lumbar xray no acute findings.', n.char_start = 0, n.char_end = 535, n.word_count = 94;
MERGE (n:Chunk {chunk_id: 'SYN-6977144-024-C01'}) SET n.parent_id = 'SYN-6977144-024', n.parent_kind = 'Note', n.position = 1, n.text = 'Spoke with Priya Shah by phone. Asked about the status of the claim explained it is open no Board date yet. Taking tylenol as needed. Said she tripped on something on the floor and went down. Asked about mileage reimbursement told to send C-257 with receipts. Address and phone confirmed same as file. Next appt with Dr Okafor is 1/20. Priya got a bill four $176.00 from Empire Physical Medicine I told her not to pay it we will check it. Advised to keep appts.', n.char_start = 0, n.char_end = 461, n.word_count = 85;
MERGE (n:Chunk {chunk_id: 'SYN-6977144-025-C01'}) SET n.parent_id = 'SYN-6977144-025', n.parent_kind = 'Note', n.position = 1, n.text = 'Priya Shah called in re: Claim 6977144. Pain about 4/10 today per Priya. Said she tripped on something on the floor and went down. Asked about mileage reimbursement, told to send C-257 with receipts. Asked if Priya is still the adjuster, confirmed. Next appt with Dr Okafor is 1/20. Priya got a bill for $137.75 from Empire Physical Medicine, I told her not to pay it, we will check it.\nDOI 12/26/25, Priya tripped on something on the floor and went down at service site.', n.char_start = 0, n.char_end = 471, n.word_count = 85;
