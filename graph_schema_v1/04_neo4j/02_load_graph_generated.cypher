MERGE (n:Note {note_id: 'SYN-6977118-078'}) SET n.claim_id = '6977118', n.note_date = '2026-05-04', n.note_type = 'Bill Question', n.author_name = 'Tina Morales', n.author_role = 'assistant', n.text = 'bill review 05/04/2026: xray from Upstate Joint & Rehab Center $137.00 paid. -Tina', n.word_count = 13, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977118-079'}) SET n.claim_id = '6977118', n.note_date = '2026-05-11', n.note_type = 'Supervisor Direction', n.author_name = 'Carol Jennings', n.author_role = 'supervisor', n.text = 'forwarding to file -CJ\nFrom: Carol Jennings <carol@gbclaims.example>\nSent: Mon, May 11, 2026 15:48\nTo: Elena Cruz\nSubject: RE: Claim 6977118 - Foster\n\nHi Elena,\nPlease see the file for Nina Foster, claim 6977118.\nPlease confirm the reserve is still $12,000.\n\nThank you,\nCarol Jennings', n.word_count = 45, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
