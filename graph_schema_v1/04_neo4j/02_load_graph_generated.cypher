MERGE (n:Chunk {chunk_id: 'SYN-6977175-052-C01'}) SET n.parent_id = 'SYN-6977175-052', n.parent_kind = 'Note', n.position = 1, n.text = 'From: Victor Brandt <victor@brandtlaw.example>\nSent: Mon, Jan 19, 2026 7:18\nTo: Maya Patel\nSubject: RE: Claim 6977175 - Ward\n\nHi Maya,\nMy client has not been paid for xray, please advise.\nWe will be askinng for a hearing if there is no response within 10 days.\nThe nothing is still outstanding on our end.\n\nThanks,\nVictor Brandt', n.char_start = 0, n.char_end = 328, n.word_count = 57;
