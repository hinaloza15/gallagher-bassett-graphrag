MERGE (n:Note {note_id: 'SYN-6977175-039'}) SET n.claim_id = '6977175', n.note_date = '2025-12-17', n.note_type = 'Reserve Review', n.author_name = 'Carol Jennings', n.author_role = 'supervisor', n.text = 'reserve review December 17: med reserve $22,000. reserves unchanged. increased med reserve bc MRI ordered. Maya requested more authority. ok to send the status report. paid to date approx $12,000. we should revisit after the next medical.\nDOI November 11, EE was struck by coworker during a pallet move at facility parking area. First seen at North Shore Occupational Health on November 14, dx strain of the neck, back and wrists, lumbar xray no acute findings. Victor Brandt is worker\'s attorney. No wage payments, medical bills only, approx $410 paid to date -CJ', n.word_count = 93, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
