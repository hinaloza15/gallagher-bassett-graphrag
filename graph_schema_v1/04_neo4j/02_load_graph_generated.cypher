MERGE (n:Note {note_id: 'SYN-6977197-082'}) SET n.claim_id = '6977197', n.note_date = '2026-04-20', n.note_type = 'Hearing / Legal', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'Legal note 4/20/26: Second hearing 4/19/26 held, judge reserved decision. Copy to Starbucks Corporation and the employer. Cx asked if she has to attend - told to check the notice. Nothing else scheduled that I can see. Cx notified by letter. The IME report needs to be in by then.\nDOI 12/15/25, cx slipped on a spill near the counter at retail store. First seen at Hudson Valley Ortho & Rehab on 18DEC25, dx strain of the left knee, xray neg for fracture. On modified duty from 17DEC25.', n.word_count = 88, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977197-083'}) SET n.claim_id = '6977197', n.note_date = '2026-04-20', n.note_type = 'Attorney Correspondence', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'Carla Brennan called 4/20/26 re: Cx. Requesting copies of medical, wage statement and C-2F for claim 6977197. Asks status of the hearing before the judge. Wants to know if Starbucks Corporation will authorize more tx. Said a hearing may be needed if no response in 2 wks. Sent request to Starbucks Corporation records unit. Requests a copy of the IME report. Demand for payment of ortho consult, $123.00. RFA-1 filed for knee tx. We will respond by letter. Olivia to respond.\nDOI 15DEC25, cx slipped on a spill near the counter at retail store. First seen at Hudson Valley Ortho & Rehab on 12/18/25, dx strain of the left knee, xray neg for fracture. On modified duty from 12/17/25. Back to full duty from 3/6/26. PT at Summit Rehab & Sports PT started December 31, 16 of 16 authorized visits used so far. MRI ordered 1/6/26, result 1/18/26: Mild effusion, possible meniscus signal change. IME with Dr Doyle on 3/9/26, report 3/19/26 says finds partial disability, recommends more PT. Carla Brennan is the worker\'s attorney. Hearing held February 24. Second hearing 4/19/26. No wage payments, medical bills only, approx $1,750 paid to date. Contacts: Adjuster Olivia Grant, ER contact Dev Sato, ER supervisor Lena Haddad, treating Dr Lindqvist, PT Carla Castillo at Summit Rehab & Sports PT. Coverage: Starbucks Corporation on the risk, Nassau county, retail store.', n.word_count = 227, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977197-084'}) SET n.claim_id = '6977197', n.note_date = '2026-04-23', n.note_type = 'Medical Update', n.author_name = 'Dr Lindqvist', n.author_role = 'treating provider', n.text = 'OFFICE NOTE (Dr Lindqvist): Pain 6/10. Pt asks about stand or walk for long, advised to modify. Continue quad sets, straight leg raises, step-ups, stationary bike.', n.word_count = 26, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977197-085'}) SET n.claim_id = '6977197', n.note_date = '2026-05-07', n.note_type = 'Worker Message', n.author_name = 'Jamal Webb', n.author_role = 'assistant', n.text = 'text msg rec\'d from Camila: my number changed new one is on file now. tylenol is not really helping. i need to know who to talk to about mileage. -Jamal', n.word_count = 30, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977197-086'}) SET n.claim_id = '6977197', n.note_date = '2026-05-07', n.note_type = 'Status Report', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'Subject: Status Report - Claim 6977197 - Camila Morris\nHi Greg,\n\nPlease see the update below on Camila Morris\'s claim (MetroClean Services, DOI 12/15/2025, retail store). I have kept the history short, call me if you want more.\n\nCLAIM HISTORY\nDOI 12/15/25, cx slipped on a spill near the counter at retail store. First seen at Hudson Valley Ortho & Rehab on 12/18/25, dx strain of the left knee, xray neg for fracture. On modified duty from 12/17/25. Back to full duty from Mar 6. PT at Summit Rehab & Sports PT started 12/31/25, 16 of 16 authorized visits used so far. MRI ordered 1/6/26, result 1/18/26: mild effusion, possible meniscus signal change. IME with Dr Doyle on March 9, report 3/19/26 says finds partial disability, recommends more PT. Carla Brennan is the worker\'s attorney. Hearing held 2/24/26.\n\nCURRENT MEDICAL: treating with Dr Lindqvist at Hudson Valley Ortho & Rehab. Pain was 0/10 at the last visit (4/22/26) and Camila reports feeling much better, occasional soreness. Restrictions: released to full duty, no restrictions.\nWORK STATUS: cx is back to full duty.\nBENEFITS: no lost time, no wage benefits due at this point. Medical bills are being paid per the fee schedule.\nLEGAL: judge\'s decision rec\'d after the 04/19/2026 hearing, nothing more needed from us.\nIME: Dr Doyle saw cx and the report says finds partial disability, recommends more PT. We are reviewing whether to dispute any of the ongoing treatment.\ncx is represented by Carla Brennan, who has asked for the claim file and our position on added treatment. We are responding by letter.\nCONTACTS: adjuster Olivia Grant, ER contact Dev Sato (MetroClean Services), ER supervisor Lena Haddad, treating Dr Lindqvist at Hudson Valley Ortho & Rehab. PT is Carla Castillo at Summit Rehab & Sports PT.\nCOVERAGE: STARBUCKS CORPORATION is on the risk. Claim is in Nassau county, injury location retail store. No prior claims found on cx.\nOUTSTANDING: nothing.\nRESERVES: no change recommended right now, med reserve $4,500. We will revisit after the next medical report.\nPLAN: continue to monitor, speak with cx and the employer again this month, and send the next update by 5/21/26. Please let me know if you need anything else in the meantime.\n\nThanks,\nOlivia Grant', n.word_count = 373, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977197-087'}) SET n.claim_id = '6977197', n.note_date = '2026-05-07', n.note_type = 'Worker Message', n.author_name = 'Jamal Webb', n.author_role = 'assistant', n.text = 'FYI -Jamal\nFrom: Camila Morris <camila@mail.example>\nSent: Thu, May 7, 2026 11:05\nTo: Olivia Grant\nSubject: RE: Claim 6977197 - Morris\n\nhi,\nthis is Camila Morris, claim 6977197.\ni got a bill for $128.75, not sure if i pay it.\n\nthanks\nCamila', n.word_count = 42, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
