MERGE (n:Chunk {chunk_id: 'SYN-6977182-026-C01'}) SET n.parent_id = 'SYN-6977182-026', n.parent_kind = 'Note', n.position = 1, n.text = 's/w front desk at Rochester Work Injury Clinic they will fax the note. Rochester Work Injury Clinic billing called about denied visit referred to Wegmans Food Markets. Rochester Work Injury Clinic says IW no showed last appt. records rec\'d from Rochester Work Injury Clinic 20 pages.', n.char_start = 0, n.char_end = 283, n.word_count = 46;
