MERGE (n:Chunk {chunk_id: 'SYN-6977118-038-C01'}) SET n.parent_id = 'SYN-6977118-038', n.parent_kind = 'Note', n.position = 1, n.text = 'Jan 27 called Upstate Joint & Rehab Center for records, 5-7 business days Asked Dr Whitaker for an updated work status, fax request sent Upstate Joint & Rehab Center billing called about a denied visit, referred to Police Upstate Joint & Rehab Center says Nina Foster know showed the last appt Records rec\'d from Upstate Joint & Rehab Center, 14 pages Need the C-4.2 from Dr Whitaker Dr Whitaker wants Nina to continue core stabilization, hamstring stretching, bridging Upstate Joint & Rehab Center sent a bill for $256.00, forwarded to bill review.', n.char_start = 0, n.char_end = 549, n.word_count = 92;
MERGE (n:Chunk {chunk_id: 'SYN-6977118-039-C01'}) SET n.parent_id = 'SYN-6977118-039', n.parent_kind = 'Note', n.position = 1, n.text = 'Jan 29 Northeast Diagnostic Imaging report rec\'d MRI: Mild disc bulge L4-5, no stenosis Radiologist says full report in 2 days.', n.char_start = 0, n.char_end = 127, n.word_count = 21;
MERGE (n:Chunk {chunk_id: 'SYN-6977118-040-C01'}) SET n.parent_id = 'SYN-6977118-040', n.parent_kind = 'Note', n.position = 1, n.text = 'File review Jan 30. Nina has a sprain of the low back and both shoulders from 12-27-2025, claim is open. Nina is seeing Dr Whitaker at Upstate Joint & Rehab Center and last reported pain at 5/10, pain in the low back and both shoulders, worse by end of shift. Restrictions are: No lifting over 10 lbs, no repeated bending. Nina is back to full duty. No lost time and no wage payments due. Pending: Records from prior provider. Plan: We get the records from prior provider, then close the diary Feb 20.\nDOI Dec 27, Nina got the low back and both shoulders caught betweeen a pallet and a rack handling stock at office stairwell. First seen at Upstate Joint & Rehab Center on 1/1/26, dx sprain of the low back and both shoulders, lumbar xray no acute findings. PT at Lakeview PT started Jan 12, 4 of 6 authorized visits used so far. MRI ordered Jan 19, result Jan 29: Mild disc bulge L4-5, no stenosis.', n.char_start = 0, n.char_end = 899, n.word_count = 168;
MERGE (n:Chunk {chunk_id: 'SYN-6977118-041-C01'}) SET n.parent_id = 'SYN-6977118-041', n.parent_kind = 'Note', n.position = 1, n.text = 'reserve review February 2: we should revisit after next medical -CJ', n.char_start = 0, n.char_end = 67, n.word_count = 11;
