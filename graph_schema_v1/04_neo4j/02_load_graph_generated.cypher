MERGE (n:Note {note_id: 'SYN-6977140-018'}) SET n.claim_id = '6977140', n.note_date = '2025-12-15', n.note_type = 'Bill Question', n.author_name = 'Wendell Pratt', n.author_role = 'assistant', n.text = 'forwarding to file\nFrom: Alicia (front desk) <alicia@rochesterworkinjuryclinic.example>\nSent: Mon, Dec 15, 2025 9:41\nTo: Maya Patel\nSubject: RE: Claim 6977140 - Patel\n\nHi Maya,\nWe are requesting 6 PT visits, please advise.\nWork status: working regular duty, no issues.\nRestrictions remain: no overhead reaching, no lifting over 10 lbs.\nPlease confirm authorization for the office visit.\n\nRegards,\nAlicia (front desk)', n.word_count = 61, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
