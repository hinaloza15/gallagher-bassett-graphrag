MERGE (n:Note {note_id: 'SYN-6977144-084'}) SET n.claim_id = '6977144', n.note_date = '2026-05-19', n.note_type = 'Supervisor Direction', n.author_name = 'Carol Jennings', n.author_role = 'supervisor', n.text = 'per email, will f/u\nFrom: Carol Jennings <carol@gbclaims.example>\nSent: Tue, May 19, 2026 12:58\nTo: Priya Shah\nSubject: RE: Claim 6977144 - Shah\n\nHi Priya,\nSend a status report to WEGMANS FOOD MARKETS by May 25.\nPlease confirm the reserve is still $4,500.\n\nThank you,\nCarol Jennings', n.word_count = 47, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977144-085'}) SET n.claim_id = '6977144', n.note_date = '2026-05-22', n.note_type = 'Contact - Injured Worker', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'Priya Shah called in re: Claim 6977144. Says she saw Dr Okafor on 3/18/26. Asked who pays for Empire Physical Medicine visits, told Wegmans Food Markets pays per fee schedule and to keep receipts. Asked about the status of the claim, explained it is open, no Board date yet. Worried about the company cutting hours. Trouble sleeping because of the pain. Address and phone confirmed same as file. Next appt with Dr Okafor is prn. Asked her to call Paula Nakamura about the light duty at the company. Priya understood.', n.word_count = 90, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977144-086'}) SET n.claim_id = '6977144', n.note_date = '2026-06-01', n.note_type = 'File Review', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'File review 6/1/26. Priya has a contusion of the neck and low back from 12/26/25, claim is open. Priya is seeing Dr Okafor at Empire Physical Medicine and last reported pain at 0/10, mild stiffness only. Restrictions are: Released to full duty, no restrictions. Priya is back to full duty. No lost time and no wage payments due. Pending: Nothing. Plan: Call Priya, follow up with Dr Okafor, review again 6/15/26.\nDOI 12/26/25, Priya tripped on something on the floor and went down at service site. First seen at Empire Physical Medicine on 12/30/25, dx contusion of the neck and low back, lumbar xray no acute findings. On modified duty from 12/29/25. Back to full duty from 2/22/26.', n.word_count = 118, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977144-087'}) SET n.claim_id = '6977144', n.note_date = '2026-06-25', n.note_type = 'Diary Entry', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = '6/25/26 diary - no change. Will call Empire Physical Medicine if nothing by 7/4/26.', n.word_count = 14, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977144-088'}) SET n.claim_id = '6977144', n.note_date = '2026-06-25', n.note_type = 'Contact Attempt', n.author_name = 'Wendell Pratt', n.author_role = 'assistant', n.text = 'called Riverbend Physical Therapy, busy -WP', n.word_count = 6, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977144-089'}) SET n.claim_id = '6977144', n.note_date = '2026-06-26', n.note_type = 'File Review', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'File review 6/26/26. Priya has a contusion of the neck and low back from 12/26/25, claim is open, no Board date yet. Priya is seeing Dr Okafor at Empire Phys Med and last reported pain at 0/10, mild stiffness only. Restrictions are: Released to full duty, no restrictions. Priya is working regular duty, no issues. No lost time and no wage payments due. Pending: Nothing. Plan: Call Priya, follow up with Dr Okafor, review again 7/17/26.\nDOI 12/26/25, Priya tripped on something on the floor and went down at service site. First seen at Empire Physical Medicine on 12/30/25, dx contusion of the neck and low back, lumbar xray no acute findings. On modified duty from 12/29/25. Back to full duty from 2/22/26. PT at Riverbend Physical Therapy started Jan 12, 12 of 12 authorized visits used so far. MRI ordered Jan 26, result 2/7/26: Mild disc bulge L4-5, no stenosis. No wage payments, medical bills only, approx $1,415 paid to date. Contacts: Adjuster Priya Shah, ER contact Paula Nakamura, ER supervisor Tasha Okafor, treating Dr Okafor, PT Victor Haddad at Riverbend Physical Therapy. Coverage: Wegmans Food Markets on the risk, Monroe county, service site.', n.word_count = 195, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
