MERGE (n:Note {note_id: 'SYN-6977175-074'}) SET n.claim_id = '6977175', n.note_date = '2026-03-17', n.note_type = 'Contact - Employer', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = 'see below.\nFrom: Carla Iyer <carla@brooklynretailgroup.example>\nSent: Tue, Mar 17, 2026 8:03\nTo: Maya Patel\nSubject: RE: Claim 6977175 - Ward\n\nHi Maya,\nJob description attached.\nAttached is the wage statement for Caleb Ward.\n\nThank you,\nCarla Iyer', n.word_count = 38, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977175-075'}) SET n.claim_id = '6977175', n.note_date = '2026-03-18', n.note_type = 'Status Report', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = 'Subject: Status Report - Claim 6977175 - Caleb Ward\nHi Mei,\n\nPlease see the update below on Caleb Ward\'s claim (Brooklyn Retail Group, DOI Nov 11, facility parking area). I have kept the history short, call me if you want more.\n\nCLAIM HISTORY\nDOI Nov 11, clmt was struck by a coworker during a pallet move at facility parking area. First seen at North Shore Occupational Health on Nov 14, dx strain of the neck, back and wrists, lumbar xray no acute findings. Victor Brandt is the worker\'s attorney. No wage payments, medical bills only, approx $630 paid to date. Contacts: adjuster Maya Patel, ER contact Carla Iyer, ER supervisor Alicia Fischer, treating Dr Romano. Coverage: SIF on the risk, Warren county, facility parking area.\n\nCURRENT MEDICAL: treating with Dr Romano at North Shore Occupational Health. Pain was 0/10 at the last visit (Feb 19) and clmt reports feeling much better, occasional soreness. Restrictions: released to full duty, no restrictions.\nWORK STATUS: clmt is working regular duty, no issues.\nBENEFITS: no lost time, no wage benefits due at this point. Medical bills are being paid per the fee schedule.\nLEGAL: no hearings or conciliation set, nothing from the Board that needs a response.\nclmt is represented by Victor Brandt, who has asked for the claim file and our position on added treatment. We are responding by letter.\nCONTACTS: adjuster Maya Patel, ER contact Carla Iyer (Brooklyn Retail Group), ER supervisor Alicia Fischer, treating Dr Romano at North Shore Occupational Health.\nCOVERAGE: SIF is on the risk. Claim is in Warren county, injury location facility parking area. No prior claims fuond on clmt.\nOUTSTANDING: nothing.\nRESERVES: no change recommended right now, med reserve $15,000. We will revisit after the next medical report.\nPLAN: continue to monitor, speak with clmt and the company again this month, and send the next update by Apr 1. Please let me know if you need anything else in the meantime.\n\nThanks,\nMaya Patel', n.word_count = 327, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977175-076'}) SET n.claim_id = '6977175', n.note_date = '2026-04-06', n.note_type = 'Attorney Correspondence', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = 'From: Victor Brandt <victor@brandtlaw.example>\nSent: Mon, Apr 6, 2026 16:37\nTo: Maya Patel\nSubject: RE: Claim 6977175 - Ward\n\nHi Maya,\nThe nothing is still outstanding on our end.\nWe will be asking for a hearing if there is no response within 10 days.\nWe request authorization for the treatment recommended by Dr Romano.\nMy client has not been paid for Rx, please advise.\n\nThanks,\nVictor Brandt', n.word_count = 67, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
