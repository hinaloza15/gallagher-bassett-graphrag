MERGE (n:Note {note_id: 'SYN-6977137-027'}) SET n.claim_id = '6977137', n.note_date = '2026-01-15', n.note_type = 'Therapy Update', n.author_name = 'Dev Whitaker', n.author_role = 'physical therapist', n.text = 'PT vissit 4/6 1/15/26 (Summit Rehab & Sports PT). Tolerated tx well. Pt reports knee swelling feels unstable on stairs. Pain 6/10 pre-tx 5/10 after. Did quad sets straight leg raises step-ups stationary bike + ice. Goal: Stand a full shift without pain. Pt asked if more visits will be approevd. Reviewed HEP pt demonstrates correctly.', n.word_count = 56, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
