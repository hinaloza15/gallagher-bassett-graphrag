MERGE (n:Chunk {chunk_id: 'SYN-6977178-045-C01'}) SET n.parent_id = 'SYN-6977178-045', n.parent_kind = 'Note', n.position = 1, n.text = 'see below\nFrom: Julian Bell <julian@mail.example>\nSent: Thu, Feb 19, 2026 7:08\nTo: Priya Shah\nSubject: RE: Claim 6977178 - Bell\n\nhello,\nplease let me know when my next check is coming.\nthis is Julian Bell, claim 6977178.\n\nthank you\nJulian', n.char_start = 0, n.char_end = 238, n.word_count = 41;
