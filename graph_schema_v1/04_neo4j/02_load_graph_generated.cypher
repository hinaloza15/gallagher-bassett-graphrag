MERGE (n:Note {note_id: 'SYN-6977194-048'}) SET n.claim_id = '6977194', n.note_date = '2026-01-05', n.note_type = 'Medical Update', n.author_name = 'Dr Fischer', n.author_role = 'treating provider', n.text = 'OFFICE NOTE 01/05/2026 (Dr Fischer): Pt c/o pain at the front of the knee, catches. Pain 4/10. Xray neg for fracture. C-4.2 to follow. Pt asks about stand or walk for long, advised to modify. F/u 1/19.', n.word_count = 37, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977194-049'}) SET n.claim_id = '6977194', n.note_date = '2026-01-05', n.note_type = 'Therapy Update', n.author_name = 'Joan Haddad', n.author_role = 'physical therapist', n.text = 'Rehab note 1/5/26: Visit 8 of 12. ROM: Knee/akle ROM near full some pain at end range. Pt adked if more visits will be approved.', n.word_count = 25, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977194-050'}) SET n.claim_id = '6977194', n.note_date = '2026-01-06', n.note_type = 'Status Report', n.author_name = 'Daniel Brooks', n.author_role = 'adjuster', n.text = 'Subject: Status Report - Claim 6977194 - Naomi Bailey\nHi Beth,\n\nPlease see the update below on Naomi Bailey\'s claim (Albany Public Works, DOI June 29, warehouse). I have kept the history short, call me if you want more.\n\nCLAIM HISTORY\nDOI June 29, Naomi Bailey got grabbed by another person during a transfer at warehouse. First seen at Capital Region Occupational Health on November 24, dx strain of the right knee, xray neg for fracture. PT at Summit Rehab & Sports PT started 12-3-2025, 8 of 12 authorized visits used so far. No wage payments, medical bills only, approx $1,025 paid to date. Contacts: adjuster Daniel Brooks, ER contact Frank Kowalski, ER supervisor Dev Alvarez, treating Dr Fischer, PT Joan Haddad at Summit Rehab & Sports PT. Coverage: State Ins Fund on the risk, Warren county, warehouse.\n\nCURRENT MEDICAL: treating with Dr Fischer at Capital Region Occupational Health. Pain was 4/10 at the last visit (January 5) and Naomi reports pain at the front of the knee, catches. Restrictions: no kneeling or squatting, limited stairs.\nWORK STATUS: Naomi is working regular duty, no issues.\nBENEFITS: no lost time, no wage benefits due at this point. Medical bills are being paid per the fee schedule.\nLEGAL: no hearings or conciliation set, nothing from the Board that needs a response.\nCONTACTS: adjuster Daniel Brooks, ER contact Frank Kowalski (Albany Public Works), ER supervisor Dev Alvarez, treating Dr Fischer at Capital Region Occupational Health. PT is Joan Haddad at Summit Rehab & Sports PT.\nCOVERAGE: State Ins Fund is on the risk. Claim is in Warren county, injury location warehouse. No prior claims found on Naomi.\nOUTSTANDING: nothing.\nRESERVES: no change recommended right now, med reserve $22,000. We will revisit after the next medical report.\nPLAN: continue to monitor, speak with Naomi and employer again this month, and send the next update by 20JAN26. Please let me know if you need anything else in the meantime.\n\nThanks,\nDaniel Brooks', n.word_count = 327, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
