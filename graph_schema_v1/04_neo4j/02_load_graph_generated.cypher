MERGE (n:Note {note_id: 'SYN-6977118-005'}) SET n.claim_id = '6977118', n.note_date = '2025-12-30', n.note_type = 'Contact - Provider', n.author_name = 'Elena Cruz', n.author_role = 'adjuster', n.text = 'See below.\nFrom: Nora (front desk) <nora@upstatejointrehabcenter.example>\nSent: Tue, Dec 30, 2025 13:26\nTo: Elena Cruz\nSubject: RE: Claim 6977118 - Foster\n\nHi Elena,\nAttached is the note from Nina Foster\'s visit on Dec 30.\nNext visit is scheduled for 1/1.\nWork status: back to full duty.\nNina Foster is being seen for sprain of the low back and both shoulders.\n\nThank you,\nNora (front desk)', n.word_count = 66, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
