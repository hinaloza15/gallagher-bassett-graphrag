MERGE (n:Chunk {chunk_id: 'SYN-6977194-066-C01'}) SET n.parent_id = 'SYN-6977194-066', n.parent_kind = 'Note', n.position = 1, n.text = 'called Summit Rehab & Sports PT, busy -Jamal', n.char_start = 0, n.char_end = 44, n.word_count = 8;
MERGE (n:Chunk {chunk_id: 'SYN-6977194-067-C01'}) SET n.parent_id = 'SYN-6977194-067', n.parent_kind = 'Note', n.position = 1, n.text = 'Called Naomi Bailey, reached on 2nd try Naomi states knee sore, swelling after standing Says she saw Dr Fischer on 19JAN26 Wants a copy of the C-3, will mail Asked about the status of the claim, explained it is open, no Board date yet Naomi confirmed DOI June 29 at warehouse Asked about mileage reimbursement, told to send C-257 with receipts Still hard to stand or walk for long Naomi got a bill for $103.50 from Capital Region Occupational Health, I told her not to pay it, we will check it Naomi understood.', n.char_start = 0, n.char_end = 511, n.word_count = 93;
