MERGE (n:Chunk {chunk_id: 'SYN-6977178-060-C01'}) SET n.parent_id = 'SYN-6977178-060', n.parent_kind = 'Note', n.position = 1, n.text = 'FYI\nFrom: Julian Bell <julian@mail.example>\nSent: Tue, Mar 31, 2026 9:44\nTo: Priya Shah\nSubject: RE: Claim 6977178 - Bell\n\nhi,\nmy boss Joan Brennan has not given me light duty yet.\nthis is Julian Bell, claim 6977178.\ni got a bill for $130, not sure if i pay it.\nplease call me back, my number is the same.\n\n\nJulian', n.char_start = 0, n.char_end = 314, n.word_count = 60;
MERGE (n:Chunk {chunk_id: 'SYN-6977178-061-C01'}) SET n.parent_id = 'SYN-6977178-061', n.parent_kind = 'Note', n.position = 1, n.text = '3/31/26 ER call, Joan Brennan. Julian Bell is on sick time. The company wants to know if the claim is accepted, told them it is open. Joan Brennan says Julian has been on time lately. Joan Nakamura will send the job description. I asked Joan Nakamura to put the light duty offer in writing. HR to follow up friday.\nDOI 12/16/25, Julian slipped on ice in the lot and went down at service site. First seen at Brooklyn Occupational Medicine on 12/19/25, dx contusion of the left hip/buttock, xray neg for fracture.', n.char_start = 0, n.char_end = 511, n.word_count = 92;
MERGE (n:Chunk {chunk_id: 'SYN-6977178-062-C01'}) SET n.parent_id = 'SYN-6977178-062', n.parent_kind = 'Note', n.position = 1, n.text = '03/31/2026 bill rvw (Priya): MRI from Brooklyn Occupational Medicine $291.00 denied - no auth on file. auth # 52227 for office visit.', n.char_start = 0, n.char_end = 133, n.word_count = 22;
MERGE (n:Chunk {chunk_id: 'SYN-6977178-063-C01'}) SET n.parent_id = 'SYN-6977178-063', n.parent_kind = 'Note', n.position = 1, n.text = 'From: Joan Nakamura <joan@empirelogistics.example>\nSent: Tue, Mar 31, 2026 16:39\nTo: Priya Shah\nSubject: RE: Claim 6977178 - Bell\n\nHi Priya,\nIncident report was sent on 12/18/25.\nWe can offer light duty satrting 4/5/26, 4 hrs/day.\nOur payroll shows Julian Bell earned about $890 a week before the injury.\nJob description attached.\n\nRegards,\nJoan Nakamura', n.char_start = 0, n.char_end = 354, n.word_count = 55;
