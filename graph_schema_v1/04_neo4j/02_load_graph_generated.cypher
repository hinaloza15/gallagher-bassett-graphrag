MERGE (n:Note {note_id: 'SYN-6977144-021'}) SET n.claim_id = '6977144', n.note_date = '2026-01-09', n.note_type = 'Compensability Review', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = '1/9/26 - decision on claim 6977144: Accepting as work related, the company confirms Priya Shah was on shift. Statement taken 12/30/25. The company report matches Priya\'s account. No witnesses per Tasha Okafor. Will revisit once the medical comes in. We will diary for the wage statement. No signs of a prior injury in the records so far.\nDOI 12/26/25, Priya tripped on something on the floor and went down at service site. First seen at Empire Physical Medicine on 12/30/25, dx contusion of the neck and low back, lumbar xray no acute findings.', n.word_count = 93, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
