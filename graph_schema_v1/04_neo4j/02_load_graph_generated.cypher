MERGE (n:Note {note_id: 'SYN-6977178-083'}) SET n.claim_id = '6977178', n.note_date = '2026-07-13', n.note_type = 'File Review', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'STATUS: Julian Bell, left hip/buttock contusion, DOI 12-16-2025. file is open.\nMEDICAL: seeing Dr Okafor at Brooklyn Occupational Medicine; pain 0/10 per last note; feeling much better, occasional soreness.\nWORK: working regular duty, no issues; restr: released to full duty, no restrictions.\nPAY: no lost time, no wage payments, medical bills only.\nLEGAL: no Board activity.\nPENDING: nothing.\nPLAN: continue to monitor, next review Jul 27.\nHISTORY: DOI 12/16/25, Julian slipped on ice in the lot and went down at service site. First seen at Brooklyn Occupational Medicine on 12/19/25, dx contusion of the left hip/buttock, xray neg for fracture. No wage payments, medical bills only, approx $520 paid to date. Contacts: adjuster Priya Shah, ER contact Joan Nakamura, ER supervisor Joan Brennan, treating Dr Okafor.', n.word_count = 126, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977178-084'}) SET n.claim_id = '6977178', n.note_date = '2026-07-14', n.note_type = 'Contact - Injured Worker', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = 'Spoke with Juliann Bell 7/14/26. Asked about the status of the claim, explained it is still open. Next appt with Dr Okafor is prn. Asked him to call Joan Nakamura about the light duty at the company.', n.word_count = 37, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977178-085'}) SET n.claim_id = '6977178', n.note_date = '2026-07-14', n.note_type = 'Contact - Injured Worker', n.author_name = 'Priya Shah', n.author_role = 'adjuster', n.text = '7/14/26 outbound call to Julian. Julian Bell states mild stiffness only. Says he saw Dr Okafor on 2/26/26. Asked about the status of the claim, explained it is open, no Board date yet. Worried about the company cutting hours. Taking naproxen as needed. Back to full duty. Still hard to stand or walk for long. Julian understood.\nDOI 12/16/25, Julian slipped on ice in the lot and went down at service site. First seen at Brooklyn Occupational Medicine on 19DEC25, dx contusion of the left hip/buttock, xray neg for fracture.', n.word_count = 90, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
