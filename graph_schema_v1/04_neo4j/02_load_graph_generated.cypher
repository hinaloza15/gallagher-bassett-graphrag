MERGE (n:Chunk {chunk_id: 'SYN-6977140-035-C01'}) SET n.parent_id = 'SYN-6977140-035', n.parent_kind = 'Note', n.position = 1, n.text = 'Maya, lt upper arm strain, DOI Dec 2. file is open, no Board date yet. seeing Dr Brennan at Rochester Work Injury Clinic; pain 4/10 per last note; sore bicep area, weak lifting. working regular duty, no issues; restr: no overhead work, lifting to 15 lbs. no Board activity. auth for more PT visits. continue to monitor, next review 02FEB26. DOI 12-2-2025, clmt was struck by coworker during pallet move at facility parking area. first seen at Rochester Work Injury Clinic on Dec 8, dx strain of the lt upper arm, xray neg. PT at Lakeview Physical Therapy started Dec 19, 5 of 6 authorized visits used so far. no wage payments, medical bills only, approx $815 paid to date.', n.char_start = 0, n.char_end = 672, n.word_count = 120;
