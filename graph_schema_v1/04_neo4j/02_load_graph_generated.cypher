MERGE (n:Note {note_id: 'SYN-6977098-077'}) SET n.claim_id = '6977098', n.note_date = '2026-04-22', n.note_type = 'Authorization', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = 'Apr 22 auth: approved 12 PT visits at Riverbend Physical Therapy auth # 88816. Dr Fischer requested more PT we are checking against the guideline. MRI auth\'d Capital Open MRI to schedule.', n.word_count = 32, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977098-078'}) SET n.claim_id = '6977098', n.note_date = '2026-04-22', n.note_type = 'File Review', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = 'STATUS: Jordan, rt lower leg contusion, DOI Dec 27. file is open.\nMEDICAL: seeing Dr Fischer at North Shore Occupational Health; pain 0/10 per last note; feeling much better, occasional soreness.\nWORK: working regular duty, no issues; restr: released to full duty, no restrictions.\nPAY: no lost time, no wage payments, medical bills only.\nLEGAL: conciliation held Feb 23, no agreement, Board keeps it open.\nPENDING: nothing.\nPLAN: continue to monitor, next review 05/22/2026.\nHISTORY: DOI Dec 27, clmt backed the work van into a bollard in the lot at facility parking area. First seen at North Shore Occupational Health on 31DEC25, dx contusion of the rt lower leg, xray neg for fracture. On modified duty from Dec 29. Back to full duty from Feb 19. PT at Riverbend Physical Therapy started Jan 12, 12 of 12 authorized visits used so far. MRI ordered 20JAN26, result Feb 1: mild effusion, possible meniscus signal change. Conciliation held Feb 23. No wage payments, medical bills only, approx $1,360 paid to date. Contacts: adjuster Maya Patel, ER contact Rita Haddad, ER supervisor Paula Kowalski, treating Dr Fischer, PT Tom Nakamura at Riverbend Physical Therapy. Coverage: SIF on the risk, Nassau county, facility parking area.', n.word_count = 201, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
