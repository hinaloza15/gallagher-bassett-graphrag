MERGE (n:Note {note_id: 'SYN-6977197-014'}) SET n.claim_id = '6977197', n.note_date = '2025-12-22', n.note_type = 'Statement / Investigation', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'Statement from cx: Cx states she slipped on a spill near the counter at retail store around 2pm. No other jobs. Dominant hand is the right. Camila said it was slow that morning. Asked cx if she had any trouble with knee before, said no.\nDOI 12/15/25, cx slipped on a spill near the counter at retail store. First seen at Hudson Valley Ortho & Rehab on December 18, dx strain of the left knee, xray neg for fracture. On modified duty from 12/17/25. Carla Brennan is the worker\'s attorney.', n.word_count = 90, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
