MERGE (n:Chunk {chunk_id: 'SYN-6977182-055-C01'}) SET n.parent_id = 'SYN-6977182-055', n.parent_kind = 'Note', n.position = 1, n.text = 'RTW: IW IS WORKING REGULAR DUTY, NO ISSUES. RESTR PER DR DOYLE: LIFTING TO 20 LBS, SPLINT AS NEEDED. FULL DUTY RELEASE EXPECTED 1/14. ASKED DR DOYLE FOR UPDATED WORK STATUS. EMPLOYER SHOULD HAVE THE NEW RESTRICTIONS IN WRITING -MH', n.char_start = 0, n.char_end = 230, n.word_count = 40;
MERGE (n:Chunk {chunk_id: 'SYN-6977182-056-C01'}) SET n.parent_id = 'SYN-6977182-056', n.parent_kind = 'Note', n.position = 1, n.text = 'Rochester Work Injury Clinic f/u 1/14/26.\nSUBJECTIVE: pt c/o forearm tender, weak grip. pain 4/10. pt states compliant w/ tx.\nOBJECTIVE: swelling, grip weak, sensation intact. xray neg. ROM: wrist ROM limited by pain, grip weak.\nASSESSMENT: strain of the right forearm, no change.\nPLAN: ice, heat, nsaids. restr: lifting to 20 lbs, splint as needed. work status: back to full duty. f/u 2/9.', n.char_start = 0, n.char_end = 390, n.word_count = 64;
