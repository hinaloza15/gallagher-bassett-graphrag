MERGE (n:Note {note_id: 'SYN-6977194-071'}) SET n.claim_id = '6977194', n.note_date = '2026-02-16', n.note_type = 'Contact - Employer', n.author_name = 'Daniel Brooks', n.author_role = 'adjuster', n.text = 'From: Frank Kowalski <frank@albanypublicworks.example>\nSent: Mon, Feb 16, 2026 14:16\nTo: Daniel Brooks\nSubject: RE: Claim 6977194 - Bailey\n\nHi Daniel,\nWe can offer light duty starting Feb 23, 4 hrs/day.\nPlease send us the restrictions in writing.\nIncident report was sent on November 22.\nOur insurer is SIF, adjuster is Daniel.\n\nThank you,\nFrank Kowalski', n.word_count = 56, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
