MERGE (n:Note {note_id: 'SYN-6977118-052'}) SET n.claim_id = '6977118', n.note_date = '2026-02-11', n.note_type = 'Contact - Employer', n.author_name = 'Elena Cruz', n.author_role = 'adjuster', n.text = 'Can we approve this?\nFrom: Lena Brandt <lena@orangesupplycooperative.example>\nSent: Wed, Feb 11, 2026 16:10\nTo: Elena Cruz\nSubject: RE: Claim 6977118 - Foster\n\nHi Elena,\nNina Foster was out on unpaid leave last week, no call to us.\nWe can offer light duty starting Feb 18, 4 hrs/day.\n\nThank you,\nLena Brandt', n.word_count = 52, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
