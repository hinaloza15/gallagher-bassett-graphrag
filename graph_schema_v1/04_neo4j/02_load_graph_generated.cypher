MERGE (n:Note {note_id: 'SYN-6977144-069'}) SET n.claim_id = '6977144', n.note_date = '2026-03-19', n.note_type = 'Supervisor Direction', n.author_name = 'Carol Jennings', n.author_role = 'supervisor', n.text = 'file review, Priya: set reserve review for 30 days. refer to Lila for case mgmt. send status report to WEGMANS FOOD MARKETS by March 25. dont close until the Board notice is rec\'d. call Priya this week, hasnt been contacted since March 18. -CJ', n.word_count = 44, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
