MERGE (n:Chunk {chunk_id: 'SYN-6977100-080-C01'}) SET n.parent_id = 'SYN-6977100-080', n.parent_kind = 'Note', n.position = 1, n.text = 'Forwarding to file.\nFrom: Carla Lindqvist <carla@hudsonpublicservices.example>\nSent: Tue, Feb 24, 2026 15:45\nTo: Priya Shah\nSubject: RE: Claim 6977100 - Reed\n\nHi Priya,\nMarcus Reed was out on his regular schedule last week, no call to us.\nJob description attached.\nOur insurer is WESCO INSURANCE CO, adjuster is Priya.\n\nRegards,\nCarla Lindqvist', n.char_start = 0, n.char_end = 344, n.word_count = 53;
