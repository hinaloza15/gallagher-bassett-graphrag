MERGE (n:Chunk {chunk_id: 'SYN-6977100-048-C01'}) SET n.parent_id = 'SYN-6977100-048', n.parent_kind = 'Note', n.position = 1, n.text = 'reserve review December 22: med reserve $12,000. reserves unchanged. increased med reserve bc IME pending. Priya requested more authority. ok to set up the IME. paid to date approx $12,000. we should revisit after the next medical.\nDOI November 21, Marcus tripped on something on the floor and went down at service site. first seen at Brooklyn Occupational Medicine on November 25, dx hand injury of the rt hand, xray neg. On modified duty from Nov 24. PT at Lakeview Physical Therapy started 12/9/25, 3 of 6 authorized visits used so far. -CJ', n.char_start = 0, n.char_end = 543, n.word_count = 93;
