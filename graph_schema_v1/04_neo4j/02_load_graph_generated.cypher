MERGE (n:Chunk {chunk_id: 'SYN-6977163-055-C01'}) SET n.parent_id = 'SYN-6977163-055', n.parent_kind = 'Note', n.position = 1, n.text = 'Need to respond to this.\nFrom: Lena Castillo <lena@castillolaw.example>\nSent: Tue, Jan 27, 2026 15:04\nTo: Olivia Grant\nSubject: RE: Claim 6977163 - Lopez\n\nHi Olivia,\nWe request authorization for the treatment recommended by Dr Haddad.\nMy client has not been paid for office visit, please advise.\n\nThanks,\nLena Castillo', n.char_start = 0, n.char_end = 318, n.word_count = 50;
