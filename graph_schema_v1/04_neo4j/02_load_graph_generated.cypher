MERGE (n:Chunk {chunk_id: 'SYN-6977140-004-C01'}) SET n.parent_id = 'SYN-6977140-004', n.parent_kind = 'Note', n.position = 1, n.text = 'first report: Maya Patel / Hudson Valley Hospitality, DOI Dec 2, State Ins Fund. clmt says she was struck by coworker during pallet move at facility parking area. sx: upper arm pain, limited overhead reach. treating at Rochester Work Injury Clinic w/ Dr Brennan. no prior claims that I can see. coverage confirmed, State Ins Fund is on risk. we need job description and wage statement from the company.\nDOI Dec 2, clmt was struck by a coworker during pallet move at facility parking area', n.char_start = 0, n.char_end = 487, n.word_count = 85;
