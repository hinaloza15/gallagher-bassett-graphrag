MERGE (n:Chunk {chunk_id: 'SYN-6977156-033-C01'}) SET n.parent_id = 'SYN-6977156-033', n.parent_kind = 'Note', n.position = 1, n.text = 'January 20 reserves - Marcus\'s file: med reserve $6,000. indemnity reserve $22,000. increased med reserve bc more PT requested. Marcus requested more authority. paid to date approx $12,000. we should revisit after the next medical.\nDOI December 21, EE missed the last few steps and fell at operations facility. First seen at North Shore Occupational Health on December 25, dx strain of the low back, hip and both knees, lumbar xray no acute findings. Off work from December 22. On modified duty from January 15', n.char_start = 0, n.char_end = 510, n.word_count = 85;
