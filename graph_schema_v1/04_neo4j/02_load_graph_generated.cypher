MERGE (n:Chunk {chunk_id: 'SYN-6977156-106-C01'}) SET n.parent_id = 'SYN-6977156-106', n.parent_kind = 'Note', n.position = 1, n.text = 'bill review office visit from North Shore Occ Health $135.50 pnded for records. -Tina', n.char_start = 0, n.char_end = 85, n.word_count = 14;
MERGE (n:Chunk {chunk_id: 'SYN-6977156-107-C01'}) SET n.parent_id = 'SYN-6977156-107', n.parent_kind = 'Note', n.position = 1, n.text = 'Subject: Status Report - Claim 6977156 - Emma Rivera\nHi Tom,\n\nPlease see the update below on Emma Rivera\'s claim (Harborview Community Health, DOI 12/21/2025, operations facility). I have kept the history short, call me if you want more.\n\nCLAIM HISTORY\nDOI 12/21/2025, IW missed the last few steps and fell at operations facility. First seen at North Shore Occupational Health on 12/25/2025, dx strain of the low back, hip and both knees, lumbar xray no acute findings. Off work from 12/22/2025. On modified duty from 01/15/2026. Back to full duty from 05/30/2026. PT at Summit Rehab & Sports PT started 01/06/2026, 16 of 16 authorized visits used so far. MRI ordered 01/12/2026, result 01/24/2026: mild disc bulge L4-5, no stenosis. IME with Dr Iyer on 03/05/2026, report 03/20/2026 says supports a work-related injury, no ongoing disability. Lena Alvarez is the worker\'s attorney.', n.char_start = 0, n.char_end = 882, n.word_count = 143;
MERGE (n:Chunk {chunk_id: 'SYN-6977156-107-C02'}) SET n.parent_id = 'SYN-6977156-107', n.parent_kind = 'Note', n.position = 2, n.text = 'CURRENT MEDICAL: treating with DR Haddad at North Shore Occupational Health. Pain was 0/10 at the last visit (06/08/2026) and IW reports mild stiffness only. Restrictions: released to full duty, no restrictions.\nWORK STATUS: IW is back to full duty.\nBENEFITS: no lost time, no wage benefits due at this point. Medical bills are being paid per the fee schedule.\nLEGAL: second hearing 04/14/2026 held, judge reserved decision.\nIME: Dr Iyer saw IW and the report says supports a work-related injury, no ongoing disability. We are reviewing whether to dispute any of the ongoing treatment.\nEmma is represented by Lena Alvarez, who has asked for the claim file and our position on added treatment. We are responding by letter.\nCONTACTS: adjuster Marcus Hill, ER contact Tasha Kowalski (Harborview Community Health), ER supervisor Greg Romano, treating DR Haddad at North Shore Occupational Health. PT is Lena Mehta at Summit Rehab & Sports PT.\nCOVERAGE: SIF is on the risk. Claim is in Queens county, injury location operations facility. No prior claims found on IW.\nOUTSTANDING: nothing.\nRESERVES: no change recommended right now, med reserve $12,000. We will revisit after the next medical report.\nPLAN: continue to monitor, speak with IW and employer again this month, and send the next update by 08/12/2026. Please let me know if you need anything else in the meantime.', n.char_start = 884, n.char_end = 2252, n.word_count = 223;
MERGE (n:Chunk {chunk_id: 'SYN-6977156-107-C03'}) SET n.parent_id = 'SYN-6977156-107', n.parent_kind = 'Note', n.position = 3, n.text = 'Thanks,\nMarcus Hill', n.char_start = 2254, n.char_end = 2273, n.word_count = 3;
MERGE (n:Chunk {chunk_id: 'SYN-6977156-108-C01'}) SET n.parent_id = 'SYN-6977156-108', n.parent_kind = 'Note', n.position = 1, n.text = 'FORWARDING TO FILE. -MH\nFrom: Lena (front desk) <lena@northshoreoccupationalhealth.example>\nSent: Tue, Jul 21, 2026 12:46\nTo: Marcus Hill\nSubject: RE: Claim 6977156 - Rivera\n\nHi Marcus,\nRestrictions remain: released to full duty, no restrictions.\nWe are requesting 16 PT visits, please advise.\nEmma Rivera is being seen for strain of the low back, hip and both knees.\n\nThank you,\nLena (front desk)', n.char_start = 0, n.char_end = 397, n.word_count = 62;
