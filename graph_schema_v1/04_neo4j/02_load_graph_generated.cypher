MERGE (n:Chunk {chunk_id: 'SYN-6977175-004-C01'}) SET n.parent_id = 'SYN-6977175-004', n.parent_kind = 'Note', n.position = 1, n.text = 'prior claism: none, 6977175 is the only one on file -GR', n.char_start = 0, n.char_end = 55, n.word_count = 11;
MERGE (n:Chunk {chunk_id: 'SYN-6977175-005-C01'}) SET n.parent_id = 'SYN-6977175-005', n.parent_kind = 'Note', n.position = 1, n.text = 'new assignment Nov 13, DOI Nov 11 at facility parking area. clmt says he was struck by a coworker during a pallet move at facility parking area.', n.char_start = 0, n.char_end = 144, n.word_count = 27;
MERGE (n:Chunk {chunk_id: 'SYN-6977175-006-C01'}) SET n.parent_id = 'SYN-6977175-006', n.parent_kind = 'Note', n.position = 1, n.text = 'can we approve this?\nFrom: Carla Iyer <carla@brooklynretailgroup.example>\nSent: Fri, Nov 14, 2025 11:37\nTo: Maya Patel\nSubject: RE: Claim 6797175 - Ward\n\nHi Maya,\nJob description attached.\nAttached is the wage statement four Caleb Ward.\nOur insurer is SIF, adjuster is Maya.\nPlease send us the restrictions in writing.\n\nThank you,\nCarla Iyer', n.char_start = 0, n.char_end = 341, n.word_count = 54;
MERGE (n:Chunk {chunk_id: 'SYN-6977175-007-C01'}) SET n.parent_id = 'SYN-6977175-007', n.parent_kind = 'Note', n.position = 1, n.text = 'clmt called in re: claim 6977175. clmt got bill for $181.75 from North Shore Occupational Health, I told him not to pay it, we will check it.', n.char_start = 0, n.char_end = 141, n.word_count = 27;
MERGE (n:Chunk {chunk_id: 'SYN-6977175-008-C01'}) SET n.parent_id = 'SYN-6977175-008', n.parent_kind = 'Note', n.position = 1, n.text = 'called clmt, reached on 2nd try. clmt states neck, back and wrists sore and stiff. says he saw Dr Romano on Nov 13. asked who pays for North Shore Occupational Health visits, told State Ins Fund pays per fee schedule and to keep receipts. wants copy of C-3, will mail. taking naproxen as needed. back to full duty. clmt confirmed DOI Nov 11 at facility parking area. asked about mileage reimbursement, told to send C-257 w/ receipts. address and phone confirmed same as file. asked if Maya is still adjuster, confirmed. clmt says Victor Brandt will call me. next appt w/ Dr Romano is 12/10. Caleb got a bill for $94.75 from North Shore Occupational Health, I told him not to pay it, we will check it.\nDOI Nov 11, clmt was struck by coworker during pallet move at facility parkign area. first seen at North Shore Occupational Health on Nov 14, dx strain of the neck, back and wrists, lumbar xray no acute findings. Victor Brandt is the worker\'s attorney. still waiting on wage statement from the company.', n.char_start = 0, n.char_end = 1003, n.word_count = 179;
MERGE (n:Chunk {chunk_id: 'SYN-6977175-009-C01'}) SET n.parent_id = 'SYN-6977175-009', n.parent_kind = 'Note', n.position = 1, n.text = 'OFFICE NOTE 11-14-2025 (Dr Romano): Pt c/o neck, back and wrists sore and stiff Pain 7/10 Tx: Ice, heat, nsaids Work status: Working regular duty, no issues Meds: Naproxen prn ROM: Lumbar flexion limited, extension ok Pt asks abt bend or lift, advised to modify.', n.char_start = 0, n.char_end = 262, n.word_count = 45;
MERGE (n:Chunk {chunk_id: 'SYN-6977175-010-C01'}) SET n.parent_id = 'SYN-6977175-010', n.parent_kind = 'Note', n.position = 1, n.text = 'Nov 14 Crossroads Imaging report rec\'d. lumbar xray no acute findings. ordered by Dr Romano. report faxed to State Ins Fund. radiologist says full report in 2 days. clmt had to reschedule once. copy to Maya. bill for $125 from Crossroads Imaging, sent to bill review.', n.char_start = 0, n.char_end = 267, n.word_count = 46;
MERGE (n:Chunk {chunk_id: 'SYN-6977175-011-C01'}) SET n.parent_id = 'SYN-6977175-011', n.parent_kind = 'Note', n.position = 1, n.text = 'Nov 14 called North Shore Occupational Health for records, 5-7 business days', n.char_start = 0, n.char_end = 76, n.word_count = 12;
MERGE (n:Chunk {chunk_id: 'SYN-6977175-012-C01'}) SET n.parent_id = 'SYN-6977175-012', n.parent_kind = 'Note', n.position = 1, n.text = 'email from Carla Iyer Nov 18. the company reported it to State Insurance Fund on Nov 17. Carla Iyer says no other injuries like this at the site. asked the company for a copy of incident report', n.char_start = 0, n.char_end = 193, n.word_count = 37;
MERGE (n:Chunk {chunk_id: 'SYN-6977175-013-C01'}) SET n.parent_id = 'SYN-6977175-013', n.parent_kind = 'Note', n.position = 1, n.text = 'Nov 19 - RTW: clmt is working regular duty, no issues restr per Dr Romano: no lifting over 10 lbs, no repeated bending.', n.char_start = 0, n.char_end = 119, n.word_count = 23;
MERGE (n:Chunk {chunk_id: 'SYN-6977175-014-C01'}) SET n.parent_id = 'SYN-6977175-014', n.parent_kind = 'Note', n.position = 1, n.text = 'email from Caleb my boss Alicia Fischer keeps asking when i can come back. i cant sleep bc of my neck, back and wrists.', n.char_start = 0, n.char_end = 119, n.word_count = 24;
MERGE (n:Chunk {chunk_id: 'SYN-6977175-015-C01'}) SET n.parent_id = 'SYN-6977175-015', n.parent_kind = 'Note', n.position = 1, n.text = 'see below -GR\nFrom: Caleb Ward <caleb@mail.example>\nSent: Wed, Nov 19, 2025 12:57\nTo: Maya Patel\nSubject: RE: Claim 6977175 - Ward\n\nHello\ni went to North Shore Occupational Health on 11/14/2025.\nplease let me know when my next check is coming.\nmy boss Alicia Fischer has not given me light duty yet.\n\n\nCaleb', n.char_start = 0, n.char_end = 307, n.word_count = 54;
MERGE (n:Chunk {chunk_id: 'SYN-6977175-016-C01'}) SET n.parent_id = 'SYN-6977175-016', n.parent_kind = 'Note', n.position = 1, n.text = 'Incident statment (Alicia Fischer, 11/19/25): I was on shift 11/11/25. Caleb told me he was struck by a coworker during a pallet move. Caleb looked like he was in pain, sent him to North Shore Occupational Health. Location was facility parking area. We have a camera but not sure it covers facility parking area. No prior complaints that i recall. The floor was dry that day as far as i know. Caleb has been reliable, no attendance issues. I can send the schedule for that week if needed.\nDOI 11/11/25, Caleb was struck by a coworker during a pallet move at facility parking area. First seen at North Shore Occupational Health on 11/14/25, dx strain of the neck, back and wrists, lumbar xray no acute findings. Victor Brandt is the worker\'s attorney. Still waiting on wage statement from the company and initial medical report from North Shore Occupational Health.', n.char_start = 0, n.char_end = 864, n.word_count = 149;
MERGE (n:Chunk {chunk_id: 'SYN-6977175-017-C01'}) SET n.parent_id = 'SYN-6977175-017', n.parent_kind = 'Note', n.position = 1, n.text = 'called clmt, reached on 2nd try asked who pays for North Shore Occupational Health visits, told State Ins Fund pays per fee schedule and to keep receipts clmt confirmed DOI Nov 11 at facility parking area.', n.char_start = 0, n.char_end = 205, n.word_count = 36;
MERGE (n:Chunk {chunk_id: 'SYN-6977175-018-C01'}) SET n.parent_id = 'SYN-6977175-018', n.parent_kind = 'Note', n.position = 1, n.text = 'file check - initial medical report from North Shore Occupational Health still outstanding. last med report Nov 14. reserves unchanged. will call North Shore Occupational Health if nothing by Nov 27', n.char_start = 0, n.char_end = 198, n.word_count = 31;
MERGE (n:Chunk {chunk_id: 'SYN-6977175-019-C01'}) SET n.parent_id = 'SYN-6977175-019', n.parent_kind = 'Note', n.position = 1, n.text = 'Nov 21 statement from clmt: clmt states he was struck by a coworker during a pallet move at facility parking area around 2pm. he reported to Alicia Fischer right away, told to see North Shore Occupational Health. photos requested, none were taken. pain level that day was about 7/10 per clmt. clmt says nobody has offered light duty yet. asked about any activities outside work, nothing unusual.\nDOI Nov 11, clmt was struck by a coworker during pallet move at facility parking area. first seen at North Shore Occupational Health on Nov 14, dx strain of the neck, back and wrists, lumbar xray no acute findings.', n.char_start = 0, n.char_end = 610, n.word_count = 106;
MERGE (n:Chunk {chunk_id: 'SYN-6977175-020-C01'}) SET n.parent_id = 'SYN-6977175-020', n.parent_kind = 'Note', n.position = 1, n.text = 'Nov 24 - decision on claim 6977175: accepting as work related, the company confirms clmt was on shift. statement taken Nov 14. the company report matches clmt\'s account. no witnesses per Alicia Fischer. will revisit once medical comes in. we will diary for the wage statement. no signs of prior injury in records so far.\nDOI Nov 11, clmt was struck by coworker during a pallet move at facility parking area. first seen at North Shore Occupational Health on Nov 14, dx strain of neck, back and wrists, lumbar xray no acute findings.', n.char_start = 0, n.char_end = 531, n.word_count = 93;
MERGE (n:Chunk {chunk_id: 'SYN-6977175-021-C01'}) SET n.parent_id = 'SYN-6977175-021', n.parent_kind = 'Note', n.position = 1, n.text = 'forwarding to file. -GR\nFrom: Lena (front desk) <lena@northshoreoccupationalhealth.example>\nSent: Wed, Nov 26, 2025 13:16\nTo: Maya Patel\nSubject: RE: Claim 6977175 - Ward\n\nHi Maya,\nWe are requesting 6 PT visits, please advise.\nCaleb Ward is being seen for strain of the neck, back and wrists.\nOur billing for $289 was sent on 11/14/2025, please confirm receipt.\n\nRegards,\nLena (front desk)', n.char_start = 0, n.char_end = 389, n.word_count = 62;
MERGE (n:Chunk {chunk_id: 'SYN-6977175-022-C01'}) SET n.parent_id = 'SYN-6977175-022', n.parent_kind = 'Note', n.position = 1, n.text = 'forwarding to file.\nFrom: Carla Iyer <carla@brooklynretailgroup.example>\nSent: Fri, Nov 28, 2025 10:06\nTo: Maya Patel\nSubject: RE: Claim 6977175 - Ward\n\nHi Maya,\nOur payroll shows clmt earned about $980 a week before the injury.\nIncident report was sent on Nov 15.\nWe can offer light duty starting Dec 7, 4 hrs/day.\nAttached is the wage statement for Caleb Ward.\n\nThanks,\nCarla Iyer', n.char_start = 0, n.char_end = 382, n.word_count = 64;
MERGE (n:Chunk {chunk_id: 'SYN-6977175-023-C01'}) SET n.parent_id = 'SYN-6977175-023', n.parent_kind = 'Note', n.position = 1, n.text = 'spoke w/ Caleb by phone wants a copy of C-3, will mail clmt confirmed DOI Nov 11 at facility parking area clmt says Victor Brandt will call me', n.char_start = 0, n.char_end = 142, n.word_count = 28;
MERGE (n:Chunk {chunk_id: 'SYN-6977175-024-C01'}) SET n.parent_id = 'SYN-6977175-024', n.parent_kind = 'Note', n.position = 1, n.text = 'per email, will f/u\nFrom: Frank (front desk) <frank@northshoreoccupationalhealth.example>\nSent: Mon, Dec 1, 2025 7:05\nTo: Maya Patel\nSubject: RE: Claim 6977175 - Ward\n\nHi Maya,\nPlease confirm authorization for the office visit.\nAttached is the note from Caleb Ward\'s visit on Nov 14.\nCaleb Ward is being seen for strain of the neck, back and wrists.\n\nThanks,\nFrank (front desk)', n.char_start = 0, n.char_end = 377, n.word_count = 61;
MERGE (n:Chunk {chunk_id: 'SYN-6977175-025-C01'}) SET n.parent_id = 'SYN-6977175-025', n.parent_kind = 'Note', n.position = 1, n.text = 'Dec 1 ER call, Alicia Fischer. Alicia Fischer says clmt has been fine, no problems lately. the company reported it to SIF on Nov 16. the company concerned about overtime coverage. safety review done, no changes to the facility parking area yet. company says Caleb missed 4 days last month. Carla Iyer says no other injuries like this at site. payroll has not sent wage statement.\nDOI Nov 11, clmt was struck by a coworker during pallet move at facility parking area', n.char_start = 0, n.char_end = 465, n.word_count = 82;
MERGE (n:Chunk {chunk_id: 'SYN-6977175-026-C01'}) SET n.parent_id = 'SYN-6977175-026', n.parent_kind = 'Note', n.position = 1, n.text = 'Called clmt, reached on 2nd try. asked who pays for North Shore Occupational Health visits, told SIF pays per fee schedule and to keep receipts. wanst a copy of the C-3, will mail. back to full duty. assked about mileage reimbursement, told to send C-257 w/ receipts. trouble sleeping bc of pain. still hard to bend or lift. asked if Maya is still adjuster, confirmed. asked him to call Carla Iyer about the light duty at the company.\nDOI Nov 11, clmt was struck by a coworker during pallet move at facility parking area.', n.char_start = 0, n.char_end = 521, n.word_count = 94;
MERGE (n:Chunk {chunk_id: 'SYN-6977175-027-C01'}) SET n.parent_id = 'SYN-6977175-027', n.parent_kind = 'Note', n.position = 1, n.text = 'can we approve this? -GR\nFrom: Caleb Ward <caleb@mail.example>\nSent: Wed, Dec 3, 2025 15:06\nTo: Maya Patel\nSubject: RE: Claim 6977175 - Ward\n\nhi,\ni went to North Shore Occupational Health on 11/14/2025.\nmy neck, back and wrists is still bothering me, about 7 out of 10.\ni got a bill for $379.00, not sure if i pay it.\nplease let me know when my next check is coming.\n\n\nCaleb', n.char_start = 0, n.char_end = 374, n.word_count = 71;
MERGE (n:Chunk {chunk_id: 'SYN-6977175-028-C01'}) SET n.parent_id = 'SYN-6977175-028', n.parent_kind = 'Note', n.position = 1, n.text = 'RTW: asked Dr Romano for updated work status.', n.char_start = 0, n.char_end = 45, n.word_count = 8;
MERGE (n:Chunk {chunk_id: 'SYN-6977175-029-C01'}) SET n.parent_id = 'SYN-6977175-029', n.parent_kind = 'Note', n.position = 1, n.text = 'called North Shore Occupational Health for records, 5-7 business days. asked Dr Romano for an updated work status, fax request sent', n.char_start = 0, n.char_end = 131, n.word_count = 21;
MERGE (n:Chunk {chunk_id: 'SYN-6977175-030-C01'}) SET n.parent_id = 'SYN-6977175-030', n.parent_kind = 'Note', n.position = 1, n.text = 'per email, will follow up\nFrom: Carla Iyer <carla@brooklynretailgroup.example>\nSent: Thu, Dec 4, 2025 8:05\nTo: Maya Patel\nSubject: RE: Claim 6977175 - Ward\n\nHi Maya,\nClmt was out on sick time last week, no call to us.\nJob description attached.\nCaleb Ward has not returned our calls about the modified duty offer.\nAttached is the wage statement for Caleb Ward.\n\nThank you,\nCarla Iyer', n.char_start = 0, n.char_end = 382, n.word_count = 65;
MERGE (n:Chunk {chunk_id: 'SYN-6977175-031-C01'}) SET n.parent_id = 'SYN-6977175-031', n.parent_kind = 'Note', n.position = 1, n.text = 'called clmt, reached on 2nd try. said he was struck by a coworker during a pallet move. asked about mileage reimbursement, told to send C-257 w/ receipts. address and phone confirmed same as file.', n.char_start = 0, n.char_end = 196, n.word_count = 34;
MERGE (n:Chunk {chunk_id: 'SYN-6977175-032-C01'}) SET n.parent_id = 'SYN-6977175-032', n.parent_kind = 'Note', n.position = 1, n.text = 'RTW: clmt is back to full duty. restr per Dr Romano: no lifting over 10 lbs, no repeated bending. full duty release expected 12/10. asked Dr Romano for updated work status. the company should have new restrictions in writing.', n.char_start = 0, n.char_end = 225, n.word_count = 39;
MERGE (n:Chunk {chunk_id: 'SYN-6977175-033-C01'}) SET n.parent_id = 'SYN-6977175-033', n.parent_kind = 'Note', n.position = 1, n.text = 'OFFICE NOTE Dec 11 (Dr Romano):\nSUBJECTIVE: pt c/o neck, back and wrists sore and stiff. pain 6/10. pt states compliant w/ tx.\nOBJECTIVE: TTP lumbar paraspinals, neg SLR. lumbar xray no acute findings. ROM: lumbar flexion limited, extension ok.\nASSESSMENT: strain of the neck, back and wrists, no change.\nPLAN: ice, heat, nsaids. restr: no lifting over 10 lbs, no repeated bending. work status: working regular duty, no issues. f/u 1/5.', n.char_start = 0, n.char_end = 436, n.word_count = 72;
MERGE (n:Chunk {chunk_id: 'SYN-6977175-034-C01'}) SET n.parent_id = 'SYN-6977175-034', n.parent_kind = 'Note', n.position = 1, n.text = 'need to respond to this\nFrom: Carla Iyer <carla@brooklynretailgroup.example>\nSent: Thu, Dec 11, 2025 15:40\nTo: Maya Patel\nSubject: RE: Claim 6977175 - Ward\n\nHi Maya,\nCaleb Ward has not returned our calls about the modified duty offer.\nWe can offer light duty starting Dec 17, 4 hrs/day.\nPlease send us the restrictions in writing.\nOur insurer is SIF, adjuster is Maya.\n\nThank you,\nCarla Iyer', n.char_start = 0, n.char_end = 391, n.word_count = 66;
