MERGE (n:Chunk {chunk_id: 'SYN-6977140-023-C01'}) SET n.parent_id = 'SYN-6977140-023', n.parent_kind = 'Note', n.position = 1, n.text = 'see below\nFrom: Lena Castillo <lena@hudsonvalleyhospitality.example>\nSent: Thu, Dec 25, 2025 9:33\nTo: Maya Patel\nSubject: RE: Claim 6977140 - Patel\n\nHi Maya,\nWe can offer light duty starting January 7, 4 hrs/day.\nOur payroll shows Maya earned about $1105 a week before the injjury.\nPlease confirm whether the claim has been accepted.\nJob description attached.\n\nThanks,\nLena Castillo', n.char_start = 0, n.char_end = 382, n.word_count = 59;
