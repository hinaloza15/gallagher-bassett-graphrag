MERGE (n:Note {note_id: 'SYN-6977137-084'}) SET n.claim_id = '6977137', n.note_date = '2026-05-18', n.note_type = 'Medical Update', n.author_name = 'Dr Sato', n.author_role = 'treating provider', n.text = 'Dr note rec\'d May 18 from Hudson Valley Ortho & Rehab: Pt c/o knee sore, swelling after standing. Exam: Mild effusion, gait guarded. Restr: No kneeling, otherwise ok for full shift. Meds: Naproxen prn. No new injury reported.', n.word_count = 38, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977137-085'}) SET n.claim_id = '6977137', n.note_date = '2026-05-19', n.note_type = 'Status Report', n.author_name = 'Olivia Grant', n.author_role = 'adjuster', n.text = 'Subject: Status Report - Claim 6977137 - Noah Bennett\nHi Joan,\n\nPlease see the update below on Noah Bennett\'s claim (Buffalo Care Network, DOI 12/23/25, retail store). I have kept the history short, call me if you want more.\n\nCLAIM HISTORY\nDOI 12/23/25, cx tripped on something on the floor and went down at retail store. First seen at Hudson Valley Ortho and Rehab on 12/29/25, dx sprain of the right knee, xray neg for fracture. Off work from 12/25/25. On modified duty from 1/10/26. Back to full duty from 5/11/26. PT at Summit Rehab & Sports PT started 1/5/26, 18 of 18 authorized visits used so far. MRI ordered 1/13/26, result 1/24/26: mild effusion, possible meniscus signal change. Admin determination notice 1/22/26. Weekly payments of $657 started 1/3/26, approx $12,483 paid to date.\n\nCURRENT MEDICAL: treating with Dr Sato at Hudson Valley Ortho & Rehab. Pain was 3/10 at the last visit (5/18/26) and cx reports knee sore, swelling after standing. Restrictions: no kneeling, otherwise ok for full shift.\nWORK STATUS: cx is working regular duty, no issues.\nBENEFITS: no lost time, no wage benefits due at this point. Medical bills are being paid per the fee schedule.\nLEGAL: no hearings or conciliation set, nothing from the Board that needs a response.\nCONTACTS: adjuster Olivia Grant, ER contact Mei Doyle (Buffalo Care Network), ER supervisor Nora Okafor, treating Dr Sato at Hudson Valley Ortho & Rehab. PT is Dev Whitaker at Summit Rehab & Sports PT.\nCOVERAGE: State Ins Fund is on the risk. Claim is in Franklin county, injury location retail store. No prior claims found on cx.\nOUTSTANDING: nothing.\nRESERVES: no change recommended right now, med reserve $15,000. We will revisit after the next medical report.\nPLAN: continue to monitor, speak with cx and the employer again this month, and send the next update by 6/2/26. Please let me know if you need anything else in the meantime.\n\nThanks,\nOlivia Grant', n.word_count = 324, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
