MERGE (n:Chunk {chunk_id: 'SYN-6977178-047-C01'}) SET n.parent_id = 'SYN-6977178-047', n.parent_kind = 'Note', n.position = 1, n.text = 'Dr note rec\'d February 26 from Brooklyn Occupational Medicine:\nSUBJECTIVE: pt c/o hip sore climbing stairs. pain 3/10.\nOBJECTIVE: tender, FROM w/ pain at end range. xray neg for fracture. ROM: knee/ankle ROM near full, some pain at end range.\nASSESSMENT: contusion of the left hip/buttock, improving.\nPLAN: naproxen, activity modification. restr: no kneeling, otherwise ok for full shift. work status: working regular duty, no issues. f/u prn.', n.char_start = 0, n.char_end = 443, n.word_count = 68;
MERGE (n:Chunk {chunk_id: 'SYN-6977178-048-C01'}) SET n.parent_id = 'SYN-6977178-048', n.parent_kind = 'Note', n.position = 1, n.text = 'Forwarding too file.\nFrom: Joan Nakamura <joan@empirelogistics.example>\nSent: Tue, Mar 3, 2026 14:18\nTo: Priya Shah\nSubject: RE: Claim 6977187 - Bell\n\nHi Priya,\nPlease send us the restrictions in writing.\nWe can offer light duty starting Mar 10, 4 hrs/day.\n\nThank you,\nJoan Nakamura', n.char_start = 0, n.char_end = 282, n.word_count = 45;
