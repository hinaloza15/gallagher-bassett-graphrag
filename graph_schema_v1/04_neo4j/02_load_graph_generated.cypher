MERGE (n:Note {note_id: 'SYN-6977098-071'}) SET n.claim_id = '6977098', n.note_date = '2026-03-16', n.note_type = 'Contact - Employer', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = 'per email, will f/u\nFrom: Rita Haddad <rita@harborviewcommunityhealth.example>\nSent: Mon, Mar 16, 2026 11:37\nTo: Maya Patel\nSubject: RE: Claim 6977098 - Lee\n\nHi Maya,\nPlease confirm whether the claim has been accepted.\nClmt was out on light duty last week, no call to us.\nPlease send us the restrictions in writing.\n\nThank you,\nRita Haddad', n.word_count = 56, n.has_copied_history = false, n.has_pasted_email = true, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977098-072'}) SET n.claim_id = '6977098', n.note_date = '2026-03-16', n.note_type = 'Contact - Injured Worker', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = 'clmt called in re: claim 6977098. pain about 2/10 today per Jordan. asked who pays for North Shore Occupational Health visits, told State Insurance Fund pays per fee schedule and to keep receipts. wants a copy of C-3, will mail. worried about the company cutting hours. back to full duty. clmt confirmed DOI Dec 27 at facility parking area. asked about mileage reimbursement, told to send C-257 w/ receipts. still hard to stand or walk for long. address and phone confirmed same as file. asked if Maya is still adjuster, confirmed. next appt w/ Dr Fischer is as needed. Jordan got a bill for $420.75 from North Shore Occupational Health, I told him not to pay it, we will check it. asked him to call Rita Haddad about light duty at company.\nDOI 12-27-2025, clmt backed the work van into bollard in lot at facility parking area. first seen at North Shore Occupational Health on Dec 31, dx contusion of rt lower leg, xray neg for fracture. On modified duty from 29DEC25. Back to full duty from Feb 19. PT at Riverbend Physical Therapy started Jan 12, 12 of 12 authorized visits used so far. MRI ordered Jan 20, result Feb 1: mild effusion, possible meniscus signal change. Conciliation held 23FEB26. no wage payments, medical bills only, approx $1,360 paid to date. Contacts: adjuster Maya Patel, ER contact Rita Haddad, ER supervisor Paula Kowalski, treating Dr Fischer, PT Tom Nakamura at Riverbend Physical Therapy. Coverage: State Insurance Fund on the risk, Nassau county, facility parking area.', n.word_count = 256, n.has_copied_history = true, n.has_pasted_email = false, n.looks_truncated = false;
MERGE (n:Note {note_id: 'SYN-6977098-073'}) SET n.claim_id = '6977098', n.note_date = '2026-03-19', n.note_type = 'Contact - Injured Worker', n.author_name = 'Maya Patel', n.author_role = 'adjuster', n.text = 'spoke w/ clmt . clmt asked about hiring an attorney, told that is up to him, gave the Board number.', n.word_count = 20, n.has_copied_history = false, n.has_pasted_email = false, n.looks_truncated = false;
