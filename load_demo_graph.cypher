MERGE (n:Role {role_name: "Claimant"}) SET n += {instance_label: "Claimant", description: "Injured worker who files the claim"};
MERGE (n:Role {role_name: "Employer"}) SET n += {instance_label: "Employer", description: "Employer of the injured worker"};
MERGE (n:Role {role_name: "Carrier or claims administrator"}) SET n += {instance_label: "Carrier", description: "Insurer, self-insured employer, or claims administrator (TPA) that handles the claim; adjusters act for this role"};
MERGE (n:Role {role_name: "Health care provider"}) SET n += {instance_label: "Provider", description: "Board-authorized provider who treats the claimant and files medical reports"};
MERGE (n:Role {role_name: "Workers' Compensation Board"}) SET n += {instance_label: "none", description: "NYS Workers' Compensation Board; holds hearings and decides disputes"};
MERGE (n:Role {role_name: "Attorney or representative"}) SET n += {instance_label: "none", description: "Optional legal representative of the claimant"};
MERGE (n:Form {form_code: "C-3"}) SET n += {name: "Employee Claim"};
MERGE (n:Form {form_code: "C-3.3"}) SET n += {name: "Limited Release of Health Information"};
MERGE (n:Form {form_code: "C-2F"}) SET n += {name: "Employer's Report of Work-Related Injury/Illness"};
MERGE (n:Form {form_code: "C-257"}) SET n += {name: "Claimant's Record of Medical and Travel Expenses and Request for Reimbursement"};
MERGE (n:Form {form_code: "DB-450"}) SET n += {name: "Notice and Proof of Claim for Disability Benefits"};
MERGE (n:ProcessStep {step_id: "PS01"}) SET n += {name: "Seek medical care", deadline_text: "immediately"};
MERGE (n:ProcessStep {step_id: "PS02"}) SET n += {name: "Notify employer in writing of when, where and how the injury happened", deadline_text: "within 30 days of injury", deadline_days: 30};
MERGE (n:ProcessStep {step_id: "PS03"}) SET n += {name: "Tell health care providers the injury is work-related and name the employer's insurer"};
MERGE (n:ProcessStep {step_id: "PS04"}) SET n += {name: "File an Employee Claim with the Board", deadline_text: "within two years of the injury or illness"};
MERGE (n:ProcessStep {step_id: "PS05"}) SET n += {name: "File a Limited Release of Health Information", condition: "same body part injured before, or a similar injury"};
MERGE (n:ProcessStep {step_id: "PS06"}) SET n += {name: "Employer notifies its insurer or claims administrator of the injury", deadline_text: "immediately", condition: "lost time beyond the day or shift of injury, or treatment beyond ordinary first aid"};
MERGE (n:ProcessStep {step_id: "PS07"}) SET n += {name: "Employer reports the injury directly to the Board (optional)", condition: "only if the insurer or claims administrator does not report on the employer's behalf"};
MERGE (n:ProcessStep {step_id: "PS08"}) SET n += {name: "Insurer or claims administrator reports the injury to the Board", deadline_text: "on or before the 18th day after the injury, or within 10 days after the employer learns of it, whichever is greater", deadline_days: 18};
MERGE (n:ProcessStep {step_id: "PS09"}) SET n += {name: "Provider files medical reports with the Board and the insurer"};
MERGE (n:ProcessStep {step_id: "PS10"}) SET n += {name: "Attend follow-up medical visits", deadline_text: "15 days after the injury, then every 90 days while lost time continues", deadline_days: 15, condition: "ongoing lost time"};
MERGE (n:ProcessStep {step_id: "PS11"}) SET n += {name: "Pay lost wage benefits", deadline_text: "within 18 days of the accident or 10 days from when the insurer was informed", deadline_days: 18, condition: "claimant disabled, case accepted, more than seven days of work missed"};
MERGE (n:ProcessStep {step_id: "PS12"}) SET n += {name: "Hold a hearing on a disputed claim", deadline_text: "on average 28 days from the date the claim was disputed", deadline_days: 28, condition: "claim disputed by the insurer"};
MERGE (n:ProcessStep {step_id: "PS13"}) SET n += {name: "Appeal the judge's decision in writing", deadline_text: "within 30 days of the filing date", deadline_days: 30};
MERGE (n:ProcessStep {step_id: "PS14"}) SET n += {name: "Apply for disability benefits while a disputed claim is heard", condition: "claim disputed"};
MERGE (n:ProcessStep {step_id: "PS15"}) SET n += {name: "Request reimbursement of medical travel expenses", deadline_text: "submit receipts at least every six months"};
MERGE (n:BodyPart {wcio_body_code: 38}) SET n += {name: "SHOULDER(S)"};
MERGE (n:BodyPart {wcio_body_code: 36}) SET n += {name: "FINGER(S)"};
MERGE (n:BodyPart {wcio_body_code: 37}) SET n += {name: "THUMB"};
