MERGE (n:BodyPart {wcio_body_code: 63}) SET n += {name: "LUMBAR & OR SACRAL VERTEBRAE (VERTEBRA"};
MERGE (n:BodyPart {wcio_body_code: 43}) SET n += {name: "DISC"};
